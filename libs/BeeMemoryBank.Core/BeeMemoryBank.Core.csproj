<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BeeMemoryBank.Crypto\BeeMemoryBank.Crypto.csproj" />
    <!-- WP-12: SearchService.SearchIndexedContentAsync calls IndexBuilder.SearchRanked directly and
         re-runs the same DefaultTokenizer/DefaultStemmer pipeline IndexBuilder uses at ingestion, so
         Core needs a direct reference to Search's public API. Search itself has no project
         references of its own (see its own csproj), so this creates no dependency cycle. -->
    <ProjectReference Include="..\BeeMemoryBank.Search\BeeMemoryBank.Search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Certes" />
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Hosting + Logging abstractions are needed by MdnsAnnouncer (BackgroundService) and the
         mDNS services' ILogger usage. The same versions are used by BeeMemoryBank.Sync. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <!-- SentencePieceTokenizer has been part of the STABLE (non-preview) API surface since v1.0.1:
         it loads a raw sentencepiece_model.proto stream directly, which is exactly the format
         multilingual-e5-small's sentencepiece.bpe.model ships. -->
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <!-- mDNS / DNS-SD (RFC 6762/6763) for LAN node discovery (TASK_BRIEF §5 Этап 5).
         Chosen over Zeroconf (browse/resolve-only — cannot advertise) and Tmds.MDns
         (Linux/Avahi-only). Makaretu.Dns.Multicast is the only single package that covers
         BOTH advertising (ServiceDiscovery.Advertise) and browsing (QueryServiceInstances)
         on a cross-platform .NET runtime. netstandard2.0 build runs unchanged on net10.0.
         Repo (richardschneider/net-mdns) is active: not archived, commits through 2024, 266★. -->
    <PackageReference Include="Makaretu.Dns.Multicast" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Embeddings\Models\sentencepiece.bpe.model" />
  </ItemGroup>

  <ItemGroup>
    <!-- IArticleRepository.SetFolderIdUnscopedAsync/ClearFolderIdUnscopedAsync are internal
         interface members (no caller-scope check of their own — see their doc comments): Storage
         implements them (ArticleRepository, via explicit interface implementation) and also calls
         one of them from FolderBootstrapper; Sync calls ClearFolderIdUnscopedAsync from its
         folder-delete event replay. Neither BeeMemoryBank.Api nor BeeMemoryBank.Web is listed here
         — that omission is the point: it keeps these two methods off the API/MCP surface at
         compile time, not just by convention. -->
    <InternalsVisibleTo Include="BeeMemoryBank.Storage" />
    <InternalsVisibleTo Include="BeeMemoryBank.Sync" />
  </ItemGroup>

</Project>
