<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BeeMemoryBank.Crypto\BeeMemoryBank.Crypto.csproj" />
    <!-- WP-12: SearchService.SearchIndexedContentAsync calls IndexBuilder.SearchRanked directly and
         re-runs the same DefaultTokenizer/DefaultStemmer pipeline IndexBuilder uses at ingestion, so
         Core needs a direct reference to Search's public API. Search itself has no project
         references of its own (see its own csproj), so this creates no dependency cycle. -->
    <ProjectReference Include="..\BeeMemoryBank.Search\BeeMemoryBank.Search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Hosting + Logging abstractions stay in Core even though MdnsAnnouncer (the only
         BackgroundService consumer) moved to Infrastructure in wave 2 A2. Other Core services
         (NodeResetService, MediaBlobBackfillService, MediaService) still use ILogger<T>, and
         HardDeleteService / others still take IServiceScopeFactory through the hosting surface.
         Stripping these would force a much bigger refactor for no practical win. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- IArticleRepository.SetFolderIdUnscopedAsync/ClearFolderIdUnscopedAsync are internal
         interface members (no caller-scope check of their own — see their doc comments): Storage
         implements them (ArticleRepository, via explicit interface implementation) and also calls
         one of them from FolderBootstrapper; Sync calls ClearFolderIdUnscopedAsync from its
         folder-delete event replay. Neither BeeMemoryBank.Api nor BeeMemoryBank.Web is listed here
         — that omission is the point: it keeps these two methods off the API/MCP surface at
         compile time, not just by convention. -->
    <InternalsVisibleTo Include="BeeMemoryBank.Storage" />
    <InternalsVisibleTo Include="BeeMemoryBank.Sync" />
  </ItemGroup>

</Project>