<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BeeMemoryBank.Crypto\BeeMemoryBank.Crypto.csproj" />
    <!-- SearchService.SearchIndexedContentAsync calls IndexBuilder.SearchRanked directly and re-runs
         the same DefaultTokenizer/DefaultStemmer pipeline IndexBuilder uses at ingestion, so Core
         needs Search's public API. Search has no project references of its own, so this creates no
         dependency cycle. -->
    <ProjectReference Include="..\BeeMemoryBank.Search\BeeMemoryBank.Search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Hosting + Logging abstractions stay in Core: NodeResetService, MediaBlobBackfillService
         and MediaService all use ILogger<T>, and HardDeleteService / others take IServiceScopeFactory
         through the hosting surface. Stripping these would force a much bigger refactor for no
         practical win. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- IArticleRepository.SetFolderIdUnscopedAsync / ClearFolderIdUnscopedAsync are internal
         interface members with no caller-scope check of their own (see their doc comments): Storage
         implements them and calls one of them from FolderBootstrapper; Sync calls
         ClearFolderIdUnscopedAsync from its folder-delete event replay. Neither BeeMemoryBank.Api
         nor BeeMemoryBank.Web is listed — that omission keeps these two methods off the API/MCP
         surface at compile time, not just by convention. -->
    <InternalsVisibleTo Include="BeeMemoryBank.Storage" />
    <InternalsVisibleTo Include="BeeMemoryBank.Sync" />
  </ItemGroup>

</Project>