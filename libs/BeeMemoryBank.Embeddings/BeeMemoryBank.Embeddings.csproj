<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <ProjectReference Include="..\BeeMemoryBank.Crypto\BeeMemoryBank.Crypto.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ChunkedSemanticSearchRecallTests in Core.Tests constructs XlmRobertaTokenizer directly to
         drive a fake embedding generator that respects the tokenizer's own truncation, mirroring
         what the real ONNX path does. The class is internal so this attribute is the seam. -->
    <InternalsVisibleTo Include="BeeMemoryBank.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- ONNX runtime + Microsoft.ML.Tokenizers (SentencePieceTokenizer, used by XlmRobertaTokenizer)
         live here, not in Core: Core is the kernel, and only this project actually embeds
         multilingual-e5-small and runs inference against it. The same "package version lives in
         Directory.Packages.props" rule applies — Central Package Management governs both. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sentencepiece model is embedded here (was Core's Embeddings/Models/) so the tokenizer
         that ships with OnnxEmbeddingGenerator resolves its resource from this assembly, not
         Core's. Model.onnx itself is gitignored and lives at the same path on disk so build.yml's
         download step and every host's <Content Include="..."/> continue to work unchanged. -->
    <EmbeddedResource Include="Models\sentencepiece.bpe.model" />
  </ItemGroup>

</Project>