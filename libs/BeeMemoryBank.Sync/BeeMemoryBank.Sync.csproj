<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <ProjectReference Include="..\BeeMemoryBank.Crypto\BeeMemoryBank.Crypto.csproj" />
    <ProjectReference Include="..\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
    <!-- WP-11: PendingIndexProcessor/SearchIndexLifecycleService drive BeeMemoryBank.Search's
         IndexBuilder directly (Storage's own reference to Search is transitive, but this is a
         direct consumer of Search's public API, not just of Storage's, so it gets its own explicit
         reference, same reasoning Storage's csproj documents for its own Search reference). -->
    <ProjectReference Include="..\BeeMemoryBank.Search\BeeMemoryBank.Search.csproj" />
    <!-- Sync's PendingEmbeddingProcessor / EventApplier resolve EmbeddingProjectionService
         directly from the scope (Core no longer registers it). Core's HybridSearchService already
         pulls EmbeddingProjectionService transitively via Core->Embeddings, but Sync needs the
         direct ref because it constructs PendingEmbeddingProcessor without going through Core. -->
    <ProjectReference Include="..\BeeMemoryBank.Embeddings\BeeMemoryBank.Embeddings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
