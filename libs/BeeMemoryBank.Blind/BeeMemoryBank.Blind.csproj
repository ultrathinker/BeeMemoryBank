<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shared core of every blind node (BMB-91): the part of Core / Storage / Sync / Crypto / Search a node that
    stores and relays ciphertext - and can read none of it - actually uses. It holds no source of its own besides the
    composition root (BlindComposition.cs): the library code is LINKED from the original projects, so a type here is
    the very same code, with the same name and namespace, as in the full application - and cannot drift from it.
    The set is computed by compiling (tools/blind-link) and checked in (linked-lib-files.props).

    A project that references this one must not also reference Core/Storage/Sync/Crypto/Search: both would define the
    same types.
  -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="System.Numerics.Tensors" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <Import Project="linked-lib-files.props" Condition="Exists('linked-lib-files.props')" />

  <!--
    EVERY migration, byte for byte, under the logical name the Storage project gives it
    (BeeMemoryBank.Storage.Migrations.NNN_name.sql). The runner compares a database's ledger with the embedded
    resources by exactly that name, and DELETES the ledger rows it cannot match (it assumes the file was squashed away):
    a node whose binary lacks a migration, or names it differently, would re-run it. Not a subset, not a rename.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\BeeMemoryBank.Storage\Migrations\*.sql"
                      LogicalName="BeeMemoryBank.Storage.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BeeMemoryBank.BlindNode" />
    <InternalsVisibleTo Include="BeeMemoryBank.BlindNode.Tests" />
  </ItemGroup>

</Project>
