<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <!-- WP-09: EncryptedSegmentStore (Search/ subfolder) decodes/encodes SegmentWriter/SegmentReader
         byte layouts and reuses EncryptedSegmentFormat's header/AAD helpers. Search stays
         dependency-free in the other direction: nothing was added to its own csproj. -->
    <ProjectReference Include="..\BeeMemoryBank.Search\BeeMemoryBank.Search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Pin the native SQLite build above the vulnerable 2.1.11 (GHSA-2m69-gcr7-jv3q,
         CVE-2025-6965: memory corruption in SQLite versions prior to 3.50.2).
         Microsoft.Data.Sqlite 10.0.3 transitively pulled SQLitePCLRaw.lib.e_sqlite3 2.1.11;
         this direct reference forces 2.1.12 (which bundles a fixed SQLite) for this project
         and every project that references Storage. Verified via the dotnet vulnerable
         package audit (NU1903 warning clears after this pin).
         Since Microsoft.Data.Sqlite 10.0.11 the whole SQLitePCLRaw set arrives at 2.1.12 on its
         own, so this reference no longer changes the resolved version — it is kept as a floor,
         so a future downgrade of Microsoft.Data.Sqlite cannot quietly bring the vulnerable
         native build back. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- FtsQueryBuilder (WP-07) is internal; the Storage test project exercises it directly. -->
    <InternalsVisibleTo Include="BeeMemoryBank.Storage.Tests" />
  </ItemGroup>

</Project>
