<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <!-- WP-09: EncryptedSegmentStore (Search/ subfolder) decodes/encodes SegmentWriter/SegmentReader
         byte layouts and reuses EncryptedSegmentFormat's header/AAD helpers. Search stays
         dependency-free in the other direction: nothing was added to its own csproj. -->
    <ProjectReference Include="..\BeeMemoryBank.Search\BeeMemoryBank.Search.csproj" />
    <!-- No reference to BeeMemoryBank.Embeddings: that would pull the ONNX runtime into every
         host that uses Storage (the Web process among them). Int8Quantizer, the only piece this
         project needs, is pure math and lives in Core. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- TensorPrimitives in EmbeddingVectorCache (SIMD dot products). -->
    <PackageReference Include="System.Numerics.Tensors" />
    <!-- The native SQLite, for this project and every project and app that references Storage: SQLite3 Multiple Ciphers, used
         without a key (the databases stay plain SQLite files). Microsoft.Data.Sqlite.Core above is the managed API only; the full
         Microsoft.Data.Sqlite package would bring a second SQLitePCLRaw bundle (e_sqlite3) and must not be referenced anywhere.
         Floor: the embedded SQLite must never be older than 3.50.2 (CVE-2025-6965, memory corruption in SQLite before 3.50.2 -
         GHSA-2m69-gcr7-jv3q named SQLitePCLRaw.lib.e_sqlite3 2.1.11, the engine this replaced). Engine/NativeEngineTests in
         BeeMemoryBank.Storage.Tests fails if the loaded library is another engine or older than the floor. -->
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- FtsQueryBuilder (WP-07) is internal; the Storage test project exercises it directly. -->
    <InternalsVisibleTo Include="BeeMemoryBank.Storage.Tests" />
    <!-- BlobRepository.StoreOnAsync (the full-node ArticleVersionRepository stores a version body in the same transaction). -->
    <InternalsVisibleTo Include="BeeMemoryBank.Vault" />
  </ItemGroup>

</Project>
