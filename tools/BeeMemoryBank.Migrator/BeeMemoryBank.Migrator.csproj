<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>bmb-migrate</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <!-- AddOnnxEmbeddings now lives in Embeddings. The migrator imports article
         content; ConceptTagService pulls IEmbeddingGenerator, so it must be registered. -->
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Embeddings\BeeMemoryBank.Embeddings.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Sync\BeeMemoryBank.Sync.csproj" />
  </ItemGroup>

  <!-- model.onnx is NOT in git — download separately (see docs/deployment.md). Wave 2 A2 moved
       the model directory to Embeddings/Models; path updated. -->
  <ItemGroup>
    <Content Include="..\..\libs\BeeMemoryBank.Embeddings\Models\model.onnx"
             Condition="Exists('..\..\libs\BeeMemoryBank.Embeddings\Models\model.onnx')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>model.onnx</Link>
    </Content>
  </ItemGroup>

</Project>