<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>bmb-seedgen</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BeeMemoryBank.SeedGen.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Sync\BeeMemoryBank.Sync.csproj" />
  </ItemGroup>

  <!-- The BERT WordPiece vocabulary is the deterministic English word source for body generation.
       Embedded so the tool is self-contained and does not depend on a build-output copy of the file. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\libs\BeeMemoryBank.Core\Embeddings\Models\vocab.txt">
      <Link>Resources\vocab.txt</Link>
    </EmbeddedResource>
  </ItemGroup>

  <!-- model.onnx is NOT required by the generator itself (it never produces embeddings), but
       AddOnnxEmbeddings must resolve a generator because ConceptTagService takes one as a
       constructor dependency. The model file is gitignored (~87MB) and downloaded separately in CI;
       the content include is conditional so the build never depends on it being present. -->
  <ItemGroup>
    <Content Include="..\..\libs\BeeMemoryBank.Core\Embeddings\Models\model.onnx"
             Condition="Exists('..\..\libs\BeeMemoryBank.Core\Embeddings\Models\model.onnx')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>model.onnx</Link>
    </Content>
  </ItemGroup>

</Project>
