<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>bmb-seedgen</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BeeMemoryBank.SeedGen.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <!-- Wave 2 A2: AddOnnxEmbeddings now lives here. ConceptTagService needs IEmbeddingGenerator,
         so the seedgen wires it the same way the Migrator and CLI do. -->
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Embeddings\BeeMemoryBank.Embeddings.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Sync\BeeMemoryBank.Sync.csproj" />
  </ItemGroup>

  <!-- A BERT WordPiece vocabulary is the deterministic English word source for body generation,
       unrelated to the real embedding model (which moved to a multilingual SentencePiece
       tokenizer; see EmbeddingModelWiring). This is SeedGen's own bundled copy, kept solely as a
       large curated English word list, embedded so the tool is self-contained. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\vocab.txt" />
  </ItemGroup>

  <!-- model.onnx is NOT required by the generator itself (it never produces embeddings), but
       AddOnnxEmbeddings must resolve a generator because ConceptTagService takes one as a
       constructor dependency. The model file is gitignored (~87MB) and downloaded separately in CI;
       the content include is conditional so the build never depends on it being present.
       Wave 2 A2: model directory moved to Embeddings/Models. -->
  <ItemGroup>
    <Content Include="..\..\libs\BeeMemoryBank.Embeddings\Models\model.onnx"
             Condition="Exists('..\..\libs\BeeMemoryBank.Embeddings\Models\model.onnx')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>model.onnx</Link>
    </Content>
  </ItemGroup>

</Project>