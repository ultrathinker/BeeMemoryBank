<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Not shipped. A plain net10.0 library that compiles the Android blind app's own service files (the same files
    BeeMemoryBank.BlindMobile.Tests links) against Blind + Blind.PhoneClient, so that tools/blind-link in phone mode can compute
    what PhoneClient must link without an Android build. The app and its tests reference the same two assemblies.
  -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\libs\BeeMemoryBank.Blind\BeeMemoryBank.Blind.csproj" />
    <ProjectReference Include="..\..\..\libs\BeeMemoryBank.Blind.PhoneClient\BeeMemoryBank.Blind.PhoneClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindIdentityRecord.cs" Link="App\BlindIdentityRecord.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\IBlindNodeKeys.cs" Link="App\IBlindNodeKeys.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindMobilePairing.cs" Link="App\BlindMobilePairing.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindKeystoreNodeAuthSigner.cs" Link="App\BlindKeystoreNodeAuthSigner.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindReplicaSource.cs" Link="App\BlindReplicaSource.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindPhoneSync.cs" Link="App\BlindPhoneSync.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindPackageFetcher.cs" Link="App\BlindPackageFetcher.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindRunReport.cs" Link="App\BlindRunReport.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindBackupExport.cs" Link="App\BlindBackupExport.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindPhoneReset.cs" Link="App\BlindPhoneReset.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\PreferencesBlindStore.cs" Link="App\PreferencesBlindStore.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindHttpHandler.cs" Link="App\BlindHttpHandler.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindHttpClientProvider.cs" Link="App\BlindHttpClientProvider.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\SqliteBlindIdentityRecorder.cs" Link="App\SqliteBlindIdentityRecorder.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindStartup.cs" Link="App\BlindStartup.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindMobileServices.cs" Link="App\BlindMobileServices.cs" />
    <Compile Include="..\..\..\mobile\BeeMemoryBank.BlindMobile\Services\MaintenanceDetectingHandler.cs" Link="App\MaintenanceDetectingHandler.cs" />
  </ItemGroup>

</Project>
