@page
@model BeeMemoryBank.Web.Pages.Article.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "New Article" : "Edit Article";
    var cancelUrl = Model.IsNew
        ? $"/Folder?path={Uri.EscapeDataString(Model.TreePath)}"
        : $"/Article/View?id={Model.ArticleId}";
}

@section HeadStyles {
<link rel="stylesheet" href="/lib/easymde/easymde.min.css" />
<link rel="stylesheet" href="/lib/tagify/tagify.css" />
<style>
    /* EasyMDE toolbar icons are rendered via local Shoelace <sl-icon> (bootstrap-icons),
       replacing EasyMDE's FontAwesome <i> glyphs. Align them with the other toolbar buttons. */
    .editor-toolbar sl-icon.bmb-mde-icon {
        font-size: 1.05rem;
        vertical-align: -0.15em;
        pointer-events: none;
    }
</style>
}

<partial name="Shared/_Sidebar" />

<div id="page-content">
<div class="main-content">
    <button type="button" class="btn-draft-recovery" id="btn-draft-recovery">
        <sl-icon name="exclamation-triangle"></sl-icon>
        Draft found — show comparison?
    </button>

    <sl-dialog id="dlg-draft-compare" label="Compare versions" style="--width: 90vw;">
        <div class="draft-compare-actions">
            <sl-button variant="primary" size="medium" id="btn-draft-pick-current">
                <sl-icon slot="prefix" name="file-earmark-text"></sl-icon> Use current
            </sl-button>
            <sl-button variant="default" size="medium" id="btn-draft-cancel">Cancel</sl-button>
            <sl-button variant="warning" size="medium" id="btn-draft-pick-draft">
                <sl-icon slot="prefix" name="arrow-counterclockwise"></sl-icon> Use draft
            </sl-button>
        </div>
        <div class="draft-compare-container">
            <div class="draft-compare-col">
                <div class="draft-compare-header">Current version</div>
                <div class="draft-compare-content article-content" id="draft-current-panel"></div>
            </div>
            <div class="draft-compare-col">
                <div class="draft-compare-header" id="draft-saved-label">Draft</div>
                <div class="draft-compare-content article-content" id="draft-saved-panel"></div>
            </div>
        </div>
    </sl-dialog>

    <form method="post" class="sl-form" id="edit-form">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <sl-alert variant="danger" open closable style="margin-bottom:16px;">
                <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
                @Model.ErrorMessage
            </sl-alert>
        }
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
            <h2 style="font-size:1.3rem;">
                <sl-icon name="@(Model.IsNew ? "file-earmark-plus" : "pencil-square")"></sl-icon>
                @ViewData["Title"]
            </h2>
            <div class="toolbar">
                <sl-button type="submit" size="small" variant="primary">
                    <sl-icon slot="prefix" name="check-lg"></sl-icon> Save
                </sl-button>
                <sl-button size="small" variant="default" href="@cancelUrl">Cancel</sl-button>
            </div>
        </div>

        <input type="hidden" name="id" value="@Model.ArticleId" />
        <input type="hidden" name="treePath" value="@Model.TreePath" />

        <div style="margin-bottom:16px;">
            <sl-input name="title" label="Title" value="@Model.Title" required size="medium" autofocus></sl-input>
        </div>

        <div style="margin-bottom:16px;">
            <span id="article-treepath-display" class="bmb-path-display bmb-path-clickable"
                  role="button" tabindex="0" aria-label="Change folder"
                  style="font-size:0.88rem;">
                <sl-icon class="bmb-path-icon" name="folder2"></sl-icon>
                <span class="bmb-path-text" id="article-treepath-text">@Model.TreePath</span>
                <sl-icon-button class="bmb-path-edit-btn" name="pencil-square" label="Change folder"></sl-icon-button>
            </span>
        </div>

        <sl-dialog id="dlg-edit-treepath" label="Move to folder" class="bmb-fp-host">
            <div class="bmb-folder-picker" id="edit-treepath-picker" style="position:relative;">
                <sl-input class="bmb-fp-input" placeholder="Type to search folders, or pick / for root" autocomplete="off" autofocus></sl-input>
                <div class="bmb-fp-dropdown" hidden></div>
            </div>
            <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-edit-treepath">Cancel</sl-button>
            <sl-button id="btn-confirm-edit-treepath" slot="footer" variant="primary">Apply</sl-button>
        </sl-dialog>

        <div style="margin-bottom:18px;">
            <label style="display:block;font-size:0.88rem;color:var(--text-secondary);margin-bottom:6px;">
                <sl-icon name="diagram-3"></sl-icon> Tags
                <span style="font-size:0.75rem;color:var(--sl-color-neutral-400);margin-left:6px;">(knowledge graph connections)</span>
            </label>
            <input type="text" name="conceptTags" id="concept-tags-input" value="@Model.ConceptTagsRaw" placeholder="Add tags..." />
        </div>

        @if (Model.IsNew)
        {
            <div style="margin-bottom:16px;">
                <sl-details id="protect-on-create" summary="🔒 Protect with a password (optional)">
                    <sl-alert variant="warning" open style="margin-bottom:12px;">
                        <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                        The password is <strong>separate</strong> from your account and <strong>cannot be recovered</strong>.
                        The article is encrypted before the first save — the plaintext is never written to the database, event log, or sync.
                    </sl-alert>
                    <div style="display:flex;flex-direction:column;gap:10px;max-width:480px;">
                        <sl-input id="create-pass" name="passphrase" type="text" inputmode="text" autocomplete="off" class="bmb-secret" data-1p-ignore data-lpignore="true" label="Password"></sl-input>
                        <sl-input id="create-pass2" type="text" inputmode="text" autocomplete="off" class="bmb-secret" data-1p-ignore data-lpignore="true" label="Confirm password"></sl-input>
                        <sl-input id="create-hint" name="hint" label="Hint (optional)" placeholder="A reminder shown before unlocking — not the password itself"></sl-input>
                        <div id="create-prot-error" style="display:none;color:var(--sl-color-danger-600);font-size:0.9rem;"></div>
                    </div>
                </sl-details>
            </div>
        }

        @if (Model.IsProtected)
        {
            <div id="prot-gate" style="margin-bottom:16px;padding:18px;border:1px solid var(--sl-color-warning-300);border-radius:6px;background:var(--sl-color-warning-50);" @(Model.IsLocked ? "" : "hidden")>
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
                    <sl-icon name="shield-lock" style="color:var(--sl-color-warning-600);"></sl-icon>
                    <strong>This article is password-protected.</strong>
                </div>
                <p style="margin:0 0 10px;font-size:0.9rem;color:var(--sl-color-neutral-600);">Enter its password to edit the content. Drafts are NOT autosaved for protected articles.</p>
                <div style="display:flex;gap:8px;align-items:flex-start;max-width:420px;">
                    <sl-input id="prot-pass" type="text" inputmode="text" autocomplete="off" class="bmb-secret" data-1p-ignore data-lpignore="true" placeholder="Password" style="flex:1;"></sl-input>
                    <sl-button id="prot-unlock" variant="primary">Unlock</sl-button>
                </div>
                <div id="prot-error" style="display:none;color:var(--sl-color-danger-600);font-size:0.9rem;margin-top:8px;"></div>
            </div>
        }

        <div style="margin-bottom:16px;" id="content-block" @(Model.IsLocked ? "hidden" : "")>
            <label style="display:block;font-size:0.88rem;color:var(--text-secondary);margin-bottom:6px;">Content (Markdown)</label>
            <textarea name="content" id="md-editor">@Model.Content</textarea>
        </div>

        @if (!Model.IsProtected)
        {
            <div style="margin-bottom:16px;" id="attachments-block">
                <label style="display:block;font-size:0.88rem;color:var(--text-secondary);margin-bottom:6px;">
                    <sl-icon name="paperclip"></sl-icon> Attachments (<span id="attachments-count">@Model.Attachments.Count</span>)
                    @if (Model.IsNew)
                    {
                        <span style="font-size:0.75rem;color:var(--sl-color-neutral-400);margin-left:6px;">(attached to the article when you save it)</span>
                    }
                </label>
                <div id="attachments-list">
                    @foreach (var att in Model.Attachments)
                    {
                        <div class="attachment-item" id="attachment-@att.Id" style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--sl-color-neutral-200);">
                            <a href="/api-proxy/media/@att.Id" download="@att.FileName" style="display:flex;align-items:center;gap:8px;flex:1;min-width:0;">
                                <sl-icon name="file-earmark"></sl-icon>
                                <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@att.FileName</span>
                                <span style="font-size:0.78rem;color:var(--sl-color-neutral-500);flex-shrink:0;">(@BeeMemoryBank.Web.Pages.Article.ViewModel.FormatFileSize(att.FileSize))</span>
                            </a>
                            <sl-icon-button name="trash" label="Delete" style="font-size:0.9rem;flex-shrink:0;" data-delete-attachment="@att.Id"></sl-icon-button>
                        </div>
                    }
                </div>
                <input type="file" id="attachment-file-input" multiple style="display:none;" />
                <div class="attach-dropzone" id="attachment-dropzone" role="button" tabindex="0" aria-label="Add files">
                    <sl-icon name="cloud-arrow-up"></sl-icon>
                    <span id="attachment-dropzone-text">Drop files here or click to choose</span>
                </div>
                <div id="attachments-protect-note" style="display:none;margin-top:6px;font-size:0.85rem;color:var(--sl-color-warning-600);">
                    A password-protected article can't have attachments.
                </div>
                @if (Model.IsNew)
                {
                    <input type="hidden" name="pendingAttachments" id="pending-attachments" value="@Model.PendingAttachmentsJson" />
                }
            </div>
        }

        <div style="display:flex;justify-content:center;gap:12px;padding-top:8px;">
            <sl-button type="submit" variant="primary" size="large">
                <sl-icon slot="prefix" name="check-lg"></sl-icon> Save
            </sl-button>
            <sl-button variant="default" size="large" href="@cancelUrl">Cancel</sl-button>
        </div>
    </form>
</div>
</div>

<script src="/lib/editor.min.js"></script>
<script type="application/json" id="article-edit-data">
    {
        "isProtected": @(Model.IsProtected ? "true" : "false"),
        "isLocked": @(Model.IsLocked ? "true" : "false"),
        "isNew": @(Model.IsNew ? "true" : "false"),
        "treePath": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TreePath)),
        "originalTitle": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Title ?? "")),
        "originalContent": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Content ?? ""))
    }
</script>
<script src="/js/pages/article-edit.js"></script>
