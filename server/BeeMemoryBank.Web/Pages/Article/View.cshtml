@page
@model BeeMemoryBank.Web.Pages.Article.ViewModel
@{
    ViewData["Title"] = Model.Article?.Title ?? "Article";
}
<partial name="_Sidebar" />
<div id="page-content">
<div class="main-content">
@if (Model.Article != null)
{
    <div style="margin-bottom:12px;">
        <h1 class="article-title">@Model.Article.Title</h1>
        <div class="article-meta">
            <span class="article-id-badge" title="Click to copy" data-bmb-copy="@Model.Article.Id">
                id: @Model.Article.Id
            </span>
            <span><sl-icon name="folder2"></sl-icon> @Model.Article.TreePath</span>
        </div>
    </div>

    <div class="article-actions-bar" id="concept-tags-block">
        <div class="tags-area">
            <span class="tags-label">
                <sl-icon name="diagram-3"></sl-icon> tags:
            </span>
            <span id="concept-tags-chips">
                @foreach (var ct in Model.ConceptTags)
                {
                    <sl-tag size="small" variant="warning" pill removable data-concept="@ct">@ct</sl-tag>
                }
            </span>
            <sl-button id="btn-add-concept" size="small" variant="text" circle title="Add tag">
                <sl-icon name="plus-lg"></sl-icon>
            </sl-button>
            <div id="concept-tag-input-wrap" style="display:none;position:relative;margin-top:8px;max-width:480px;">
                <sl-input id="concept-tag-search" placeholder="Type to search or create tag..." clearable autocomplete="off" size="small"></sl-input>
                <div id="concept-tag-dropdown" style="display:none;position:absolute;z-index:1000;left:0;right:0;max-height:240px;overflow-y:auto;background:var(--sl-color-neutral-0);border:1px solid var(--sl-color-neutral-300);border-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,0.15);margin-top:2px;"></div>
            </div>
        </div>
        <div class="toolbar compact">
            @if (!Model.IsReadOnly)
            {
                <sl-button size="small" variant="primary" href="/Article/Edit?id=@Model.Article.Id">
                    <sl-icon slot="prefix" name="pencil"></sl-icon> Edit
                </sl-button>
            }
            <sl-button size="small" variant="default" href="/Article/History?id=@Model.Article.Id">
                <sl-icon slot="prefix" name="clock-history"></sl-icon> History
            </sl-button>
            <sl-button size="small" variant="default" onclick="document.getElementById('dlg-copy-article').show()">
                <sl-icon slot="prefix" name="copy"></sl-icon> Copy To
            </sl-button>
            <sl-button size="small" variant="default" onclick="openDownloadDialog({kind:'article',id:'@Model.Article.Id'})">
                <sl-icon slot="prefix" name="download"></sl-icon> Export
            </sl-button>
            <sl-button size="small" variant="default" id="btn-print-article">
                <sl-icon slot="prefix" name="printer"></sl-icon> Print
            </sl-button>
            <sl-button size="small" variant="default" href="/Folder?path=@Uri.EscapeDataString(Model.Article.TreePath)">
                <sl-icon slot="prefix" name="arrow-left"></sl-icon> Folder
            </sl-button>
            @if (!Model.IsReadOnly)
            {
                <sl-button size="small" variant="default" onclick="document.getElementById('dlg-move-article').show()">
                    <sl-icon slot="prefix" name="arrows-move"></sl-icon> Move
                </sl-button>
                <sl-button size="small" variant="danger" onclick="document.getElementById('dlg-delete-article').show()">
                    <sl-icon slot="prefix" name="trash"></sl-icon> Delete
                </sl-button>
            }
            else
            {
                <sl-badge variant="warning" pill title="Read-only ACL — write operations are disabled.">
                    <sl-icon slot="prefix" name="lock-fill"></sl-icon> Read-only
                </sl-badge>
            }
        </div>
    </div>

    <div class="card">
        @if (Model.Content == null)
        {
            <sl-alert variant="warning" open>
                <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                Content cannot be decrypted. This article was created on a node with a different encryption key.
            </sl-alert>
        }
        <div class="article-content" id="article-body"></div>
    </div>

    @if (Model.RelatedArticles.Count > 0)
    {
        var totalRelated = Model.RelatedArticles.Count;
        var relatedPageSize = 10;
        var totalRelatedPages = (int)Math.Ceiling(totalRelated / (double)relatedPageSize);
        <div class="card mt-md">
            <h4 style="font-size:0.95rem;margin-bottom:14px;">
                <sl-icon name="diagram-3"></sl-icon> Related Articles (<span id="related-total">@totalRelated</span>)
            </h4>
            <div id="related-list">
                @foreach (var rel in Model.RelatedArticles.OrderByDescending(r => r.Strength).Take(relatedPageSize))
                {
                    <div class="related-item" style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--sl-color-neutral-200);">
                        <div>
                            <a href="/Article/View?id=@rel.Id" style="font-weight:500;">@rel.Title</a>
                            <div style="font-size:0.78rem;color:var(--sl-color-neutral-500);">@string.Join(", ", rel.SharedConcepts)</div>
                        </div>
                        <sl-badge variant="neutral" pill>@rel.Strength</sl-badge>
                    </div>
                }
            </div>
            @if (totalRelatedPages > 1)
            {
                <div id="related-pager" style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;">
                    <span id="related-pager-info" style="font-size:0.85rem;color:var(--sl-color-neutral-500);">Page 1 of @totalRelatedPages · @totalRelated items</span>
                    <div style="display:flex;gap:8px;">
                        <sl-button id="related-prev" size="small" variant="default" disabled>Prev</sl-button>
                        <sl-button id="related-next" size="small" variant="default">Next</sl-button>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Comments -->
    <div class="card mt-md">
        <h4 style="font-size:0.95rem;margin-bottom:14px;">
            <sl-icon name="chat-dots"></sl-icon> Comments (@Model.Comments.Count)
        </h4>

        <div id="comments-list">
        @foreach (var comment in Model.Comments)
        {
            <div class="comment-item" id="comment-@comment.Id">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <span class="comment-author">owner</span>
                        <span class="comment-date">@comment.CreatedAt.ToString("g")</span>
                    </div>
                    <sl-icon-button name="trash" label="Delete" style="font-size:0.9rem;"
                        onclick="deleteComment(@comment.Id)"></sl-icon-button>
                </div>
                <p class="comment-text">@comment.Text</p>
            </div>
        }
        </div>

        <div style="margin-top:14px;">
            <sl-textarea id="new-comment-text" rows="2" placeholder="Add a comment..." style="margin-bottom:8px;"></sl-textarea>
            <sl-button id="btn-add-comment" size="small" variant="primary">
                <sl-icon slot="prefix" name="send"></sl-icon> Add Comment
            </sl-button>
        </div>
    </div>
}
else
{
    <p>Article not found.</p>
}

<!-- Print preview dialog -->
<sl-dialog id="dlg-print-article" label="Print Preview" class="print-dialog" style="--width:90vw;">
    <style>
        /* Default size: 90% of viewport, single scroll inside the iframe wrapper. */
        #dlg-print-article::part(panel) { max-height: 92vh; height: 92vh; }
        #dlg-print-article::part(body) { padding: 0; background: var(--sl-color-neutral-100); overflow: hidden; display: flex; flex-direction: column; }

        /* Maximize: cover the whole viewport, hide chrome — just the article. */
        #dlg-print-article.maximized { --width: 100vw; }
        #dlg-print-article.maximized::part(panel) { max-width: 100vw; max-height: 100vh; height: 100vh; border-radius: 0; }
        #dlg-print-article.maximized::part(header) { display: none; }
        #dlg-print-article.maximized::part(footer) { display: none; }

        .print-preview-toolbar {
            display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px;
            padding: 8px 14px; background: var(--sl-color-neutral-50);
            border-bottom: 1px solid var(--sl-color-neutral-200);
            font-size: 0.85rem; flex-shrink: 0;
        }
        .print-preview-toolbar .group { display: flex; align-items: center; gap: 4px; }
        .print-preview-toolbar .sep { width: 1px; height: 20px; background: var(--sl-color-neutral-300); margin: 0 4px; }
        .print-preview-toolbar .spacer { flex: 1; }
        .print-preview-toolbar sl-select { min-width: 140px; }
        .print-preview-toolbar sl-select::part(form-control-label) { display: none; }
        .print-preview-frame-wrap {
            flex: 1; min-height: 0; overflow: auto;
            background: var(--sl-color-neutral-100);
        }
        #print-iframe { width: 100%; height: 100%; border: 0; background: transparent; display: block; }
        /* Toolbar shown inside the panel when maximized — give Print and Close direct buttons there. */
        .print-maximized-only { display: none; }
        #dlg-print-article.maximized .print-maximized-only { display: inline-flex; }
    </style>
    <div class="print-preview-toolbar">
        <div class="group">
            <sl-icon-button id="print-zoom-out" name="zoom-out" label="Zoom out"></sl-icon-button>
            <span id="print-zoom-label" style="min-width:42px;text-align:center;">100%</span>
            <sl-icon-button id="print-zoom-in" name="zoom-in" label="Zoom in"></sl-icon-button>
        </div>
        <span class="sep"></span>
        <div class="group">
            <sl-select id="print-font" size="small" value="serif" hoist>
                <sl-option value="serif">Serif (Georgia)</sl-option>
                <sl-option value="sans">Sans (Helvetica)</sl-option>
                <sl-option value="times">Times New Roman</sl-option>
                <sl-option value="verdana">Verdana</sl-option>
                <sl-option value="mono">Monospace</sl-option>
            </sl-select>
        </div>
        <div class="group">
            <sl-icon-button id="print-size-down" name="dash-lg" label="Smaller font"></sl-icon-button>
            <span id="print-size-label" style="min-width:42px;text-align:center;">100%</span>
            <sl-icon-button id="print-size-up" name="plus-lg" label="Larger font"></sl-icon-button>
        </div>
        <div class="group">
            <sl-select id="print-margins" size="small" value="normal" hoist>
                <sl-option value="narrow">Narrow margins</sl-option>
                <sl-option value="normal">Normal margins</sl-option>
                <sl-option value="wide">Wide margins</sl-option>
            </sl-select>
        </div>
        <sl-switch id="print-page-numbers" size="small">Page numbers</sl-switch>
        <span class="spacer"></span>
        <span id="print-page-status" style="color:var(--sl-color-neutral-600);">Rendering…</span>
        <sl-icon-button id="print-maximize" name="arrows-fullscreen" label="Maximize"></sl-icon-button>
        <sl-button class="print-maximized-only" size="small" variant="default" onclick="document.getElementById('dlg-print-article').hide()">Close</sl-button>
        <sl-button class="print-maximized-only" size="small" variant="primary" id="btn-do-print-max">
            <sl-icon slot="prefix" name="printer"></sl-icon> Print
        </sl-button>
    </div>
    <div class="print-preview-frame-wrap">
        <iframe id="print-iframe" title="Print preview"></iframe>
    </div>
    <sl-button slot="footer" variant="default" onclick="document.getElementById('dlg-print-article').hide()">Close</sl-button>
    <sl-button slot="footer" variant="primary" id="btn-do-print">
        <sl-icon slot="prefix" name="printer"></sl-icon> Print
    </sl-button>
</sl-dialog>

<!-- Move dialog -->
<sl-dialog id="dlg-move-article" label="Move Article" style="--width:560px;">
    <style>
        #dlg-move-article::part(panel) { overflow: visible; }
        #dlg-move-article::part(body) { overflow: visible; }
    </style>
    <p class="text-muted text-sm">Moving: <code>@Model.Article?.Title</code></p>
    <div style="position:relative;">
        <sl-input id="move-article-search" label="Destination folder" placeholder="Type to search or leave empty for root (/)" autocomplete="off"></sl-input>
        <div id="move-article-dropdown" style="display:none;position:absolute;z-index:1000;left:0;right:0;max-height:240px;overflow-y:auto;background:var(--sl-color-neutral-0);border:1px solid var(--sl-color-neutral-300);border-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,0.15);margin-top:2px;"></div>
    </div>
    <sl-button slot="footer" variant="default" onclick="document.getElementById('dlg-move-article').hide()">Cancel</sl-button>
    <sl-button id="btn-move-article" slot="footer" variant="primary">Move</sl-button>
</sl-dialog>

<!-- Delete dialog -->
<sl-dialog id="dlg-delete-article" label="Delete Article">
    <sl-alert variant="danger" open>
        <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
        Delete «@Model.Article?.Title»?
    </sl-alert>
    <sl-button slot="footer" variant="default" onclick="document.getElementById('dlg-delete-article').hide()">Cancel</sl-button>
    <sl-button id="btn-confirm-delete-article" slot="footer" variant="danger">Delete</sl-button>
</sl-dialog>

<div id="syncToast" class="sync-toast" style="display:none;">
    <div class="sync-toast-content">
        <span class="sync-toast-label">Syncing</span>
        <div class="sync-toast-circles" id="syncToastCircles"></div>
    </div>
</div>

<sl-dialog label="Sync Delivery Status" id="syncModal" class="sync-modal">
    <div id="syncModalContent" class="sync-modal-content">Loading...</div>
    <sl-button slot="footer" variant="primary" onclick="document.getElementById('syncModal').hide()">Close</sl-button>
</sl-dialog>

<script>
(function() {
    var articleId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Article?.Id.ToString() ?? ""));
    var content = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Content ?? ""));
    var treePath = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Article?.TreePath ?? "/"));

    if (content) {
        var body = document.getElementById('article-body');
        var renderer = new marked.Renderer();
        var origImage = renderer.image.bind(renderer);
        renderer.image = function(token) {
            if (token && token.href && token.href.startsWith('/api/media/')) {
                token.href = '/api-proxy/media/' + token.href.substring('/api/media/'.length);
            }
            return origImage(token);
        };
        body.innerHTML = DOMPurify.sanitize(marked.parse(content, { breaks: true, renderer: renderer }));
    }

    // Move
    var moveArticleSelectedPath = null;
    var moveArticleSearchTimer = null;
    var moveArticleSearch = document.getElementById('move-article-search');
    var moveArticleDropdown = document.getElementById('move-article-dropdown');

    function escapeHtmlMove(text) {
        var d = document.createElement('div');
        d.textContent = text;
        return d.innerHTML;
    }

    if (moveArticleSearch) {
        moveArticleSearch.addEventListener('sl-input', function() {
            moveArticleSelectedPath = null;
            clearTimeout(moveArticleSearchTimer);
            var q = moveArticleSearch.value.trim();
            if (q.length < 1) { moveArticleDropdown.style.display = 'none'; return; }
            moveArticleSearchTimer = setTimeout(function() {
                fetch('/api-proxy/folders/search?q=' + encodeURIComponent(q) + '&limit=12')
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        var folders = data.folders || [];
                        if (folders.length === 0) {
                            moveArticleDropdown.innerHTML = '<div style="padding:8px 12px;color:var(--sl-color-neutral-500);font-size:0.9rem;">No matching folders</div>';
                        } else {
                            moveArticleDropdown.innerHTML = folders.map(function(f) {
                                return '<div class="move-article-item" data-path="' + escapeHtmlMove(f.path) + '" style="padding:8px 12px;cursor:pointer;border-bottom:1px solid var(--sl-color-neutral-100);">' +
                                    '<sl-icon name="folder2" style="margin-right:6px;"></sl-icon>' + escapeHtmlMove(f.path) + '</div>';
                            }).join('');
                            if (data.hasMore) {
                                moveArticleDropdown.innerHTML += '<div style="padding:6px 12px;color:var(--sl-color-neutral-400);font-size:0.8rem;text-align:center;">Type more to narrow results...</div>';
                            }
                        }
                        moveArticleDropdown.style.display = 'block';
                    });
            }, 250);
        });

        moveArticleDropdown.addEventListener('click', function(e) {
            var item = e.target.closest('.move-article-item');
            if (!item) return;
            moveArticleSelectedPath = item.dataset.path;
            moveArticleSearch.value = moveArticleSelectedPath;
            moveArticleDropdown.style.display = 'none';
        });

        moveArticleDropdown.addEventListener('mouseover', function(e) {
            var item = e.target.closest('.move-article-item');
            if (item) item.style.background = 'var(--sl-color-primary-50)';
        });
        moveArticleDropdown.addEventListener('mouseout', function(e) {
            var item = e.target.closest('.move-article-item');
            if (item) item.style.background = '';
        });

        document.addEventListener('click', function(e) {
            if (!e.target.closest('#move-article-search') && !e.target.closest('#move-article-dropdown')) {
                moveArticleDropdown.style.display = 'none';
            }
        });
    }

    var moveBtn = document.getElementById('btn-move-article');
    if (moveBtn) {
        moveBtn.addEventListener('click', function() {
            var inputVal = moveArticleSearch.value.trim();
            if (inputVal && !moveArticleSelectedPath) {
                alert('Please select a folder from the search results.');
                return;
            }
            var newPath = moveArticleSelectedPath || '/';
            if (newPath === treePath) { alert('Article is already in that folder'); return; }
            moveBtn.loading = true;
            fetch('/api-proxy/article/' + articleId + '/move', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ newPath: newPath })
            }).then(function(r) {
                if (r.ok) window.location.reload();
                else r.json().then(function(e) { alert(e.error || 'Move failed'); }).catch(function() { alert('Move failed'); });
            }).catch(function() { alert('Error'); }).finally(function() { moveBtn.loading = false; });
        });
    }

    // Delete
    var deleteBtn = document.getElementById('btn-confirm-delete-article');
    if (deleteBtn) {
        deleteBtn.addEventListener('click', function() {
            deleteBtn.loading = true;
            fetch('/api-proxy/article/' + articleId, {
                method: 'DELETE'
            }).then(function(r) {
                if (r.ok) window.location.href = '/Folder?path=' + encodeURIComponent(treePath);
                else r.json().then(function(d) { alert(d.error || 'Delete failed'); }).catch(function() { alert('Delete failed'); });
            }).catch(function() { alert('Error'); }).finally(function() { deleteBtn.loading = false; });
        });
    }

    // Add comment
    var addCommentBtn = document.getElementById('btn-add-comment');
    if (addCommentBtn) {
        addCommentBtn.addEventListener('click', function() {
            var textarea = document.getElementById('new-comment-text');
            var text = textarea.value.trim();
            if (!text) return;
            addCommentBtn.loading = true;
            fetch('/api-proxy/comments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ articleId: articleId, text: text })
            }).then(function(r) {
                if (r.ok) return r.json();
                throw new Error('Failed');
            }).then(function(comment) {
                textarea.value = '';
                var list = document.getElementById('comments-list');
                var div = document.createElement('div');
                div.className = 'comment-item';
                div.id = 'comment-' + comment.id;
                var d = new Date(comment.createdAt);
                div.innerHTML =
                    '<div style="display:flex;align-items:center;justify-content:space-between;">' +
                    '<div><span class="comment-author">owner</span>' +
                    '<span class="comment-date">' + d.toLocaleString() + '</span></div>' +
                    '<sl-icon-button name="trash" label="Delete" style="font-size:0.9rem;" onclick="deleteComment(' + comment.id + ')"></sl-icon-button>' +
                    '</div>' +
                    '<p class="comment-text">' + escHtml(comment.text) + '</p>';
                list.appendChild(div);
                // Update count heading
                var h4 = list.closest('.card').querySelector('h4');
                if (h4) {
                    var cnt = list.querySelectorAll('.comment-item').length;
                    h4.innerHTML = '<sl-icon name="chat-dots"></sl-icon> Comments (' + cnt + ')';
                }
            }).catch(function() { alert('Error adding comment'); })
            .finally(function() { addCommentBtn.loading = false; });
        });
    }

    window.deleteComment = function(id) {
        if (!confirm('Delete this comment?')) return;
        fetch('/api-proxy/comments/' + id, { method: 'DELETE' })
            .then(function(r) {
                if (r.ok || r.status === 204) {
                    var el = document.getElementById('comment-' + id);
                    if (el) el.remove();
                    var list = document.getElementById('comments-list');
                    var h4 = list.closest('.card').querySelector('h4');
                    if (h4) {
                        var cnt = list.querySelectorAll('.comment-item').length;
                        h4.innerHTML = '<sl-icon name="chat-dots"></sl-icon> Comments (' + cnt + ')';
                    }
                } else { alert('Delete failed'); }
            });
    };

    function escHtml(s) {
        return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ─── Print preview (paged.js inside an iframe) ───
    var printBtn = document.getElementById('btn-print-article');
    var printDlg = document.getElementById('dlg-print-article');
    if (printBtn && printDlg) {
        var printIframe = document.getElementById('print-iframe');
        var pageStatus = document.getElementById('print-page-status');
        var zoomLabel = document.getElementById('print-zoom-label');
        var zoomIn = document.getElementById('print-zoom-in');
        var zoomOut = document.getElementById('print-zoom-out');
        var doPrintBtn = document.getElementById('btn-do-print');
        var doPrintBtnMax = document.getElementById('btn-do-print-max');
        var fontSelect = document.getElementById('print-font');
        var marginsSelect = document.getElementById('print-margins');
        var sizeUp = document.getElementById('print-size-up');
        var sizeDown = document.getElementById('print-size-down');
        var sizeLabel = document.getElementById('print-size-label');
        var pageNumbersSwitch = document.getElementById('print-page-numbers');
        var maximizeBtn = document.getElementById('print-maximize');

        // Settings — visual zoom is just a CSS transform on the preview;
        // font/size/margins/page-numbers require a re-pagination, so changing
        // them rebuilds the iframe (debounced).
        var settings = {
            zoom: 1.0,
            fontScale: 1.0,
            font: 'serif',
            margins: 'normal',
            pageNumbers: false
        };
        var rendered = false;
        var rebuildTimer = null;

        var articleTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Article?.Title ?? ""));
        var articleTreePath = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Article?.TreePath ?? "/"));

        var FONT_STACKS = {
            serif:   'Georgia, "Times New Roman", serif',
            sans:    'Helvetica, Arial, sans-serif',
            times:   '"Times New Roman", Times, serif',
            verdana: 'Verdana, Geneva, sans-serif',
            mono:    '"Courier New", Courier, monospace'
        };
        var MARGIN_VALUES = {
            narrow: '12mm 12mm',
            normal: '20mm 18mm',
            wide:   '28mm 25mm'
        };

        function buildPrintDoc(title, bodyHtml, footerMeta) {
            return '<!doctype html><html><head><meta charset="utf-8">' +
                '<base href="/">' +
                '<title>' + escAttr(title) + '</title>' +
                '<style>' + printCss() + '</style>' +
                '<script>' + previewBridgeJs() + '<\/script>' +
                '<script src="/lib/pagedjs/paged.polyfill.js"><\/script>' +
                '</head><body>' +
                '<article class="print-article">' +
                '<header class="print-header"><h1>' + escAttr(title) + '</h1>' +
                '<div class="print-meta">' + escAttr(footerMeta) + '</div></header>' +
                bodyHtml +
                '</article>' +
                '</body></html>';
        }

        function printCss() {
            var fontFamily = FONT_STACKS[settings.font] || FONT_STACKS.serif;
            var margins = MARGIN_VALUES[settings.margins] || MARGIN_VALUES.normal;
            var scale = settings.fontScale;
            // Express every typographic size as calc(Xpt * scale) so the slider
            // multiplies them all uniformly.
            var s = function(pt) { return 'calc(' + pt + 'pt * ' + scale + ')'; };
            var pageNumbersRule = settings.pageNumbers
                ? '@@page { @@bottom-center { content: counter(page) " / " counter(pages); font-family: ' + fontFamily + '; font-size: 9pt; color: #666; } }'
                : '';
            return [
                '@@page { size: A4; margin: ' + margins + '; }',
                pageNumbersRule,
                'html, body { margin: 0; padding: 0; }',
                // Grey backdrop in the preview so the white A4 sheets stand out.
                // Reset to white for actual print so we don't waste ink.
                'html { background: #e5e7eb; }',
                '@@media print { html { background: white; } }',
                'body { font-family: ' + fontFamily + '; color: #111; font-size: ' + s(11) + '; line-height: 1.4; background: transparent; }',
                '.print-header { margin-bottom: 10pt; padding-bottom: 5pt; border-bottom: 1pt solid #888; }',
                '.print-header h1 { margin: 0 0 3pt 0; font-size: ' + s(18) + '; }',
                '.print-meta { color: #555; font-size: ' + s(9) + '; }',
                'h1, h2, h3, h4 { color: #000; page-break-after: avoid; margin: 12pt 0 4pt 0; font-family: ' + fontFamily + '; }',
                'h1 { font-size: ' + s(16) + '; } h2 { font-size: ' + s(14) + '; } h3 { font-size: ' + s(12) + '; }',
                'p { margin: 0 0 4pt 0; orphans: 3; widows: 3; }',
                'p:empty { display: none; }',
                'br + br { display: none; }',
                'pre, code { font-family: "Courier New", monospace; font-size: ' + s(9.5) + '; }',
                'pre { background: #f4f4f4; padding: 6pt 8pt; border: 1pt solid #ddd; border-radius: 3pt; white-space: pre-wrap; word-wrap: break-word; page-break-inside: avoid; margin: 4pt 0; }',
                'code { background: #f4f4f4; padding: 0 3pt; border-radius: 2pt; }',
                'pre code { background: none; padding: 0; }',
                'blockquote { border-left: 2pt solid #888; margin: 4pt 0; padding-left: 10pt; color: #444; }',
                'ul, ol { padding-left: 22pt; margin: 2pt 0 4pt 0; }',
                'li { margin: 0; }',
                'li > p { margin: 0 0 2pt 0; }',
                'li > p:only-child { margin: 0; }',
                'img { max-width: 100%; }',
                'table { border-collapse: collapse; width: 100%; margin: 8pt 0; font-size: ' + s(10) + '; page-break-inside: avoid; }',
                'th, td { border: 1pt solid #ccc; padding: 4pt 8pt; text-align: left; }',
                'th { background: #f0f0f0; }',
                'a { color: inherit; text-decoration: underline; }',
                // Paged.js's own stylesheet sets defaults — override with higher specificity
                // (selectors compound with .pagedjs and !important on critical visual rules)
                // so each rendered sheet shows as a white card on the grey backdrop.
                '.pagedjs_pages { display: flex !important; flex-direction: column !important; align-items: center !important; gap: 20px !important; padding: 20px 0 !important; }',
                '.pagedjs_page { background: white !important; box-shadow: 0 4px 14px rgba(0,0,0,0.22) !important; border: 1px solid rgba(0,0,0,0.08) !important; margin: 0 !important; }',
                '@@media print {',
                '  html, body { background: white !important; }',
                '  .pagedjs_pages { gap: 0 !important; padding: 0 !important; }',
                '  .pagedjs_page { box-shadow: none !important; border: 0 !important; margin: 0 !important; }',
                '}'
            ].join('\n');
        }

        function previewBridgeJs() {
            return [
                "window.PagedConfig = {",
                "  after: function(flow){",
                "    var pages = (flow && flow.total) ? flow.total",
                "      : document.querySelectorAll('.pagedjs_page').length;",
                "    parent.postMessage({ type: 'bmb-print-rendered', pages: pages }, '*');",
                "  }",
                "};"
            ].join('\n');
        }

        function escAttr(s) {
            return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function applyZoom() {
            try {
                var doc = printIframe.contentDocument;
                if (!doc) return;
                var pages = doc.querySelector('.pagedjs_pages');
                if (pages) {
                    pages.style.transform = 'scale(' + settings.zoom + ')';
                    pages.style.transformOrigin = 'top center';
                }
                zoomLabel.textContent = Math.round(settings.zoom * 100) + '%';
            } catch (e) { /* ignore */ }
        }

        function rebuildIframe() {
            var body = document.getElementById('article-body');
            if (!body) return;
            rendered = false;
            pageStatus.textContent = 'Rendering…';
            var meta = articleTreePath + '   ·   ' + new Date().toLocaleString();
            printIframe.srcdoc = buildPrintDoc(articleTitle, body.innerHTML, meta);
        }

        function rebuildDebounced() {
            clearTimeout(rebuildTimer);
            rebuildTimer = setTimeout(rebuildIframe, 250);
        }

        window.addEventListener('message', function(e) {
            if (!e.data || e.data.type !== 'bmb-print-rendered') return;
            rendered = true;
            pageStatus.textContent = e.data.pages + (e.data.pages === 1 ? ' page' : ' pages');
            applyZoom();
        });

        printBtn.addEventListener('click', function() {
            settings.zoom = 1.0;
            zoomLabel.textContent = '100%';
            rebuildIframe();
            printDlg.show();
        });

        zoomIn.addEventListener('click', function() {
            if (settings.zoom < 2.0) { settings.zoom = Math.round((settings.zoom + 0.1) * 10) / 10; applyZoom(); }
        });
        zoomOut.addEventListener('click', function() {
            if (settings.zoom > 0.4) { settings.zoom = Math.round((settings.zoom - 0.1) * 10) / 10; applyZoom(); }
        });

        function updateSizeLabel() { sizeLabel.textContent = Math.round(settings.fontScale * 100) + '%'; }
        sizeUp.addEventListener('click', function() {
            if (settings.fontScale < 1.6) {
                settings.fontScale = Math.round((settings.fontScale + 0.1) * 10) / 10;
                updateSizeLabel(); rebuildDebounced();
            }
        });
        sizeDown.addEventListener('click', function() {
            if (settings.fontScale > 0.6) {
                settings.fontScale = Math.round((settings.fontScale - 0.1) * 10) / 10;
                updateSizeLabel(); rebuildDebounced();
            }
        });

        fontSelect.addEventListener('sl-change', function() {
            settings.font = fontSelect.value;
            rebuildDebounced();
        });
        marginsSelect.addEventListener('sl-change', function() {
            settings.margins = marginsSelect.value;
            rebuildDebounced();
        });
        pageNumbersSwitch.addEventListener('sl-change', function() {
            settings.pageNumbers = pageNumbersSwitch.checked;
            rebuildDebounced();
        });

        maximizeBtn.addEventListener('click', function() {
            var on = printDlg.classList.toggle('maximized');
            maximizeBtn.name = on ? 'fullscreen-exit' : 'arrows-fullscreen';
            maximizeBtn.label = on ? 'Restore' : 'Maximize';
        });

        function doPrint() {
            if (!rendered) return;
            try {
                printIframe.contentWindow.focus();
                printIframe.contentWindow.print();
            } catch (e) { alert('Print failed: ' + e.message); }
        }
        doPrintBtn.addEventListener('click', doPrint);
        if (doPrintBtnMax) doPrintBtnMax.addEventListener('click', doPrint);
    }
})();

(function() {
    var params = new URLSearchParams(window.location.search);
    if (!params.has('justSaved')) return;

    var url = new URL(window.location);
    url.searchParams.delete('justSaved');
    history.replaceState(null, '', url);

    var toast = document.getElementById('syncToast');
    if (!toast) return;

    toast.style.display = 'flex';
    var polling = true;
    var fadeTimer = setTimeout(function() {
        if (!toast.classList.contains('sync-toast-pinned')) {
            toast.style.display = 'none';
            polling = false;
        }
    }, 5000);

    toast.addEventListener('click', function() {
        toast.classList.add('sync-toast-pinned');
        clearTimeout(fadeTimer);
        toast.style.display = 'none';
        polling = false;
        var modal = document.getElementById('syncModal');
        if (modal) {
            modal.show();
            if (typeof updateSyncModal === 'function') updateSyncModal();
        }
    });

    function updateSyncToast() {
        if (!polling) return;
        fetch('/api-proxy/sync/delivery-status')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var circles = document.getElementById('syncToastCircles');
                if (!circles || !data.nodes) return;
                circles.innerHTML = data.nodes.map(function(n) {
                    var color = n.isSynced ? 'var(--sl-color-success-600)' : 'var(--sl-color-warning-500)';
                    var title = escHtml(n.displayName) + (n.isSynced ? ' ✓' : ' pending');
                    return '<span class="sync-circle" style="background:' + color + ';" title="' + title + '"></span>';
                }).join('');
                if (polling) setTimeout(updateSyncToast, 3000);
            })
            .catch(function() { if (polling) setTimeout(updateSyncToast, 5000); });
    }
    updateSyncToast();
})();

(function() {
    var articleId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Article?.Id.ToString() ?? ""));
    if (!articleId) return;

    var chipsEl = document.getElementById('concept-tags-chips');
    var btnAdd = document.getElementById('btn-add-concept');
    var inputWrap = document.getElementById('concept-tag-input-wrap');
    var searchInput = document.getElementById('concept-tag-search');
    var dropdown = document.getElementById('concept-tag-dropdown');
    if (!chipsEl || !btnAdd || !searchInput || !dropdown) return;

    var currentTags = Array.from(chipsEl.querySelectorAll('sl-tag[data-concept]'))
        .map(function(el) { return el.getAttribute('data-concept'); });

    var searchTimer = null;

    function putTags(tags) {
        return fetch('/api-proxy/article/' + articleId + '/concept-tags', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ conceptTags: tags })
        });
    }

    function escConceptHtml(s) {
        var d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
    }

    function renderChips() {
        chipsEl.innerHTML = currentTags.map(function(t) {
            return '<sl-tag size="small" variant="warning" pill removable data-concept="'+escConceptHtml(t)+'" style="margin-right:4px;">'+escConceptHtml(t)+'</sl-tag>';
        }).join('');
        attachRemoveHandlers();
    }

    function attachRemoveHandlers() {
        chipsEl.querySelectorAll('sl-tag[data-concept]').forEach(function(el) {
            el.addEventListener('sl-remove', function() {
                var name = el.getAttribute('data-concept');
                var idx = currentTags.indexOf(name);
                if (idx === -1) return;
                var prev = currentTags.slice();
                currentTags.splice(idx, 1);
                renderChips();
                putTags(currentTags).then(function(r) {
                    if (!r.ok) { currentTags = prev; renderChips(); alert('Failed to remove tag'); }
                });
            });
        });
    }

    attachRemoveHandlers();

    function addTag(name) {
        name = (name || '').trim();
        if (!name) return;
        if (currentTags.some(function(t) { return t.toLowerCase() === name.toLowerCase(); })) {
            searchInput.value = '';
            dropdown.style.display = 'none';
            return;
        }
        var prev = currentTags.slice();
        currentTags.push(name);
        renderChips();
        putTags(currentTags).then(function(r) {
            if (!r.ok) { currentTags = prev; renderChips(); alert('Failed to add tag'); }
        });
        searchInput.value = '';
        dropdown.style.display = 'none';
    }

    btnAdd.addEventListener('click', function() {
        inputWrap.style.display = 'block';
        btnAdd.style.display = 'none';
        setTimeout(function() { searchInput.focus(); }, 50);
    });

    searchInput.addEventListener('sl-input', function() {
        clearTimeout(searchTimer);
        var q = searchInput.value.trim();
        if (q.length < 1) { dropdown.style.display = 'none'; return; }
        searchTimer = setTimeout(function() {
            fetch('/api-proxy/concept-tags?q=' + encodeURIComponent(q) + '&limit=20')
                .then(function(r) { return r.ok ? r.json() : []; })
                .then(function(data) {
                    var tags = (data || []).filter(function(t) {
                        return !currentTags.some(function(c) { return c.toLowerCase() === t.name.toLowerCase(); });
                    });
                    var items = tags.map(function(t) {
                        return '<div class="concept-tag-item" data-name="' + escConceptHtml(t.name) + '" style="padding:8px 12px;cursor:pointer;border-bottom:1px solid var(--sl-color-neutral-100);">' +
                            '<sl-icon name="diagram-3" style="margin-right:6px;"></sl-icon>' +
                            escConceptHtml(t.name) +
                            '<span style="float:right;color:var(--sl-color-neutral-500);font-size:0.8rem;">' + t.articleCount + '</span>' +
                            '</div>';
                    });
                    var exactMatch = tags.some(function(t) { return t.name.toLowerCase() === q.toLowerCase(); });
                    var alreadyOnArticle = currentTags.some(function(c) { return c.toLowerCase() === q.toLowerCase(); });
                    if (!exactMatch && !alreadyOnArticle) {
                        items.unshift('<div class="concept-tag-item concept-tag-new" data-name="' + escConceptHtml(q) + '" style="padding:8px 12px;cursor:pointer;border-bottom:1px solid var(--sl-color-neutral-100);background:var(--sl-color-primary-50);">' +
                            '<sl-icon name="plus-lg" style="margin-right:6px;"></sl-icon>Create <strong>' + escConceptHtml(q) + '</strong>' +
                            '</div>');
                    }
                    dropdown.innerHTML = items.length === 0
                        ? '<div style="padding:8px 12px;color:var(--sl-color-neutral-500);font-size:0.9rem;">No matches.</div>'
                        : items.join('');
                    dropdown.style.display = 'block';
                });
        }, 200);
    });

    searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            var q = searchInput.value.trim();
            if (q) addTag(q);
        } else if (e.key === 'Escape') {
            dropdown.style.display = 'none';
            inputWrap.style.display = 'none';
            btnAdd.style.display = '';
            searchInput.value = '';
        }
    });

    var suppressBlurHide = false;
    dropdown.addEventListener('mousedown', function(e) {
        if (e.target.closest('.concept-tag-item')) suppressBlurHide = true;
    });

    dropdown.addEventListener('click', function(e) {
        var item = e.target.closest('.concept-tag-item');
        if (!item) return;
        addTag(item.getAttribute('data-name'));
        setTimeout(function() { searchInput.focus(); }, 0);
    });

    dropdown.addEventListener('mouseover', function(e) {
        var item = e.target.closest('.concept-tag-item');
        if (item) item.style.background = 'var(--sl-color-primary-50)';
    });
    dropdown.addEventListener('mouseout', function(e) {
        var item = e.target.closest('.concept-tag-item');
        if (item) item.style.background = item.classList.contains('concept-tag-new') ? 'var(--sl-color-primary-50)' : '';
    });

    document.addEventListener('click', function(e) {
        if (!e.target.closest('#concept-tag-input-wrap')) {
            dropdown.style.display = 'none';
        }
    });

    searchInput.addEventListener('sl-blur', function() {
        setTimeout(function() {
            if (suppressBlurHide) {
                suppressBlurHide = false;
                return;
            }
            if (searchInput.value.trim() === '' && inputWrap.style.display !== 'none') {
                dropdown.style.display = 'none';
                inputWrap.style.display = 'none';
                btnAdd.style.display = '';
            }
        }, 150);
    });
})();

(function() {
    var prev = document.getElementById('related-prev');
    var next = document.getElementById('related-next');
    if (!prev || !next) return;
    var list = document.getElementById('related-list');
    var info = document.getElementById('related-pager-info');
    var articleIdLocal = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Article?.Id.ToString() ?? ""));
    if (!articleIdLocal) return;
    var page = 1, pageSize = 10, totalPages = 1;
    function escRel(s){var d=document.createElement('div');d.textContent=s||'';return d.innerHTML;}
    function load(p) {
        prev.loading = next.loading = true;
        fetch('/api-proxy/article/' + articleIdLocal + '/related?page=' + p + '&pageSize=' + pageSize)
            .then(function(r){ return r.json(); })
            .then(function(d){
                page = d.page; totalPages = d.totalPages;
                list.innerHTML = (d.items || []).map(function(r) {
                    return '<div class="related-item" style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--sl-color-neutral-200);">'
                        + '<div><a href="/Article/View?id=' + r.id + '" style="font-weight:500;">' + escRel(r.title) + '</a>'
                        + '<div style="font-size:0.78rem;color:var(--sl-color-neutral-500);">' + escRel((r.sharedConcepts||[]).join(', ')) + '</div></div>'
                        + '<sl-badge variant="neutral" pill>' + r.strength + '</sl-badge>'
                        + '</div>';
                }).join('');
                info.textContent = 'Page ' + page + ' of ' + totalPages + ' \u00B7 ' + d.total + ' items';
                prev.disabled = page <= 1;
                next.disabled = page >= totalPages;
            })
            .finally(function() { prev.loading = next.loading = false; });
    }
    prev.addEventListener('click', function() { if (page > 1) load(page - 1); });
    next.addEventListener('click', function() { load(page + 1); });
})();
</script>

<!-- Copy article dialog -->
<sl-dialog id="dlg-copy-article" label="Copy Article To">
    @if (Model.Article != null)
    {
        <p class="text-muted text-sm">Copying: <strong>@Model.Article.Title</strong> from <code>@Model.Article.TreePath</code></p>
    }
    <sl-alert id="copy-article-error" variant="danger" closable style="margin-bottom:12px;display:none;">
        <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
        <span id="copy-article-error-msg"></span>
    </sl-alert>
    <sl-input id="copy-article-target" label="Target folder path" placeholder="/" autocomplete="off" autofocus></sl-input>
    <small class="text-muted">If the target already contains an article with the same title, the copy is renamed with a " (N)" suffix.</small>
    <sl-button slot="footer" variant="default" onclick="document.getElementById('dlg-copy-article').hide()">Cancel</sl-button>
    <sl-button id="btn-copy-article" slot="footer" variant="primary">Copy</sl-button>
</sl-dialog>
<script>
(function() {
    var btn = document.getElementById('btn-copy-article');
    if (!btn) return;
    var dlg = document.getElementById('dlg-copy-article');
    var input = document.getElementById('copy-article-target');
    var articleId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Article?.Id.ToString() ?? ""));
    btn.addEventListener('click', async function() {
        var target = (input.value || '').trim() || '/';
        try {
            var resp = await fetch('/api-proxy/article/' + articleId + '/copy', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ targetFolderPath: target })
            });
            if (resp.ok) {
                dlg.hide();
                window.location.href = '/Folder?path=' + encodeURIComponent(target);
            } else {
                var data = {}; try { data = await resp.json(); } catch {}
                var box = document.getElementById('copy-article-error');
                document.getElementById('copy-article-error-msg').textContent = data.error || ('Copy failed (HTTP ' + resp.status + ')');
                box.style.display = '';
                box.open = true;
            }
        } catch (e) {
            var box = document.getElementById('copy-article-error');
            document.getElementById('copy-article-error-msg').textContent = String(e);
            box.style.display = '';
            box.open = true;
        }
    });
})();
</script>
</div>
</div>
