@page
@model BeeMemoryBank.Web.Pages.Article.ViewModel
@{
    ViewData["Title"] = Model.Article?.Title ?? "Article";
}
<partial name="_Sidebar" />
<div id="page-content">
<div class="main-content">
@if (Model.Article != null)
{
    <div style="margin-bottom:12px;">
        <h1 class="article-title">@if (Model.Article.Protected)
            {<sl-icon name="shield-lock" title="Password-protected" style="color:var(--sl-color-warning-600);margin-right:6px;vertical-align:-2px;"></sl-icon>}@Model.Article.Title</h1>
        <div class="article-meta">
            <span class="article-id-badge" title="Click to copy" data-bmb-copy="@Model.Article.Id">
                id: @Model.Article.Id
            </span>
            <span><sl-icon name="folder2"></sl-icon> @Model.Article.TreePath</span>
        </div>
    </div>

    <div class="article-actions-bar" id="concept-tags-block">
        <div class="tags-area">
            <span class="tags-label">
                <sl-icon name="diagram-3"></sl-icon> tags:
            </span>
            <span id="concept-tags-chips">
                @foreach (var ct in Model.ConceptTags)
                {
                    <sl-tag size="small" variant="warning" pill removable data-concept="@ct">@ct</sl-tag>
                }
            </span>
            <sl-button id="btn-add-concept" size="small" variant="text" circle title="Add tag">
                <sl-icon name="plus-lg"></sl-icon>
            </sl-button>
            <div id="concept-tag-input-wrap" style="display:none;position:relative;margin-top:8px;max-width:480px;">
                <sl-input id="concept-tag-search" placeholder="Type to search or create tag..." clearable autocomplete="off" size="small"></sl-input>
                <div id="concept-tag-dropdown" style="display:none;position:absolute;z-index:1000;left:0;right:0;max-height:240px;overflow-y:auto;background:var(--sl-color-neutral-0);border:1px solid var(--sl-color-neutral-300);border-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,0.15);margin-top:2px;"></div>
            </div>
        </div>
        <div class="toolbar compact">
            @* Favoriting is a personal bookmark, not an edit — deliberately outside the
               IsReadOnly gate so read-only members can star articles too. State is filled in
               by site.js from the same /api-proxy/favorites call the sidebar already makes. *@
            <sl-button size="small" variant="default" id="btn-favorite-star"
                       data-article-id="@Model.Article.Id" title="Add to favorites">
                <sl-icon slot="prefix" name="star"></sl-icon> <span data-fav-label>Favorite</span>
            </sl-button>
            @if (!Model.IsReadOnly)
            {
                <sl-button size="small" variant="primary" href="/Article/Edit?id=@Model.Article.Id">
                    <sl-icon slot="prefix" name="pencil"></sl-icon> Edit
                </sl-button>
                @if (!Model.Article.Protected)
                {
                    <sl-button size="small" variant="default" id="btn-open-protect" title="Encrypt this article with a separate password">
                        <sl-icon slot="prefix" name="shield-lock"></sl-icon> Protect
                    </sl-button>
                }
                @* For protected articles, Change-password / Unprotect live on the lock card (under Unlock),
                   not in this toolbar — see the lock card below. *@
            }
            <sl-button size="small" variant="default" href="/Article/History?id=@Model.Article.Id">
                <sl-icon slot="prefix" name="clock-history"></sl-icon> History
            </sl-button>
            <sl-button size="small" variant="default" id="btn-open-copy-article">
                <sl-icon slot="prefix" name="copy"></sl-icon> Copy To
            </sl-button>
            <sl-button size="small" variant="default" id="btn-export-article">
                <sl-icon slot="prefix" name="upload"></sl-icon> Export
            </sl-button>
            <sl-button size="small" variant="default" id="btn-print-article">
                <sl-icon slot="prefix" name="printer"></sl-icon> Print
            </sl-button>
            <sl-button size="small" variant="default" href="/Folder?path=@Uri.EscapeDataString(Model.Article.TreePath)">
                <sl-icon slot="prefix" name="arrow-left"></sl-icon> Folder
            </sl-button>
            @if (!Model.IsReadOnly)
            {
                <sl-button size="small" variant="default" id="btn-open-move-article">
                    <sl-icon slot="prefix" name="arrows-move"></sl-icon> Move
                </sl-button>
                <sl-button size="small" variant="danger" id="btn-open-delete-article">
                    <sl-icon slot="prefix" name="trash"></sl-icon> Delete
                </sl-button>
            }
            else
            {
                <sl-badge variant="warning" pill title="Read-only ACL — write operations are disabled.">
                    <sl-icon slot="prefix" name="lock-fill"></sl-icon> Read-only
                </sl-badge>
            }
        </div>
    </div>

    @if (Model.Article.Protected)
    {
        <div class="card" id="lock-card" style="text-align:center;padding:40px 20px;@(Model.IsUnlockedFromCache ? "display:none;" : "")">
            <sl-icon name="shield-lock" style="font-size:3rem;color:var(--sl-color-warning-600);"></sl-icon>
            <h3 style="margin:14px 0 4px;">This article is password-protected</h3>
            <p style="color:var(--sl-color-neutral-500);margin:0;font-size:0.9rem;">Enter its password to view the content.</p>
            @if (!string.IsNullOrWhiteSpace(Model.Article.ProtectionHint))
            {
                <p style="color:var(--sl-color-neutral-500);margin:10px 0 0;font-size:0.9rem;">
                    <sl-icon name="lightbulb"></sl-icon> Hint: @Model.Article.ProtectionHint
                </p>
            }
            <div style="max-width:340px;margin:18px auto 0;display:flex;flex-direction:column;gap:10px;">
                <sl-input id="unlock-pass" type="text" inputmode="text" autocomplete="off" class="bmb-secret" data-1p-ignore data-lpignore="true" placeholder="Password"></sl-input>
                <div id="unlock-error" style="display:none;color:var(--sl-color-danger-600);font-size:0.9rem;"></div>
                <sl-button id="btn-unlock" variant="primary">
                    <sl-icon slot="prefix" name="unlock"></sl-icon> Unlock
                </sl-button>
                @if (!Model.IsReadOnly)
                {
                    <div style="display:flex;gap:8px;justify-content:center;margin-top:4px;">
                        <sl-button size="small" variant="text" class="btn-open-change-pass" title="Change the password">
                            <sl-icon slot="prefix" name="key"></sl-icon> Change password
                        </sl-button>
                        <sl-button size="small" variant="text" class="btn-open-unprotect" title="Remove password protection">
                            <sl-icon slot="prefix" name="unlock"></sl-icon> Unprotect
                        </sl-button>
                    </div>
                }
            </div>
        </div>
        <div class="card" id="unlocked-card" style="@(Model.IsUnlockedFromCache ? "" : "display:none;")">
            <div class="unlock-banner" id="unlock-banner" style="display:none;">
                <sl-icon name="unlock"></sl-icon>
                <span>Temporarily unlocked &middot; locks automatically in <strong id="unlock-remaining"></strong></span>
                <a href="#" id="lnk-lock-now">Lock now</a>
            </div>
            <div style="display:flex;justify-content:flex-end;gap:8px;margin-bottom:8px;">
                @if (!Model.IsReadOnly)
                {
                    <sl-button size="small" variant="text" class="btn-open-change-pass" title="Change the password">
                        <sl-icon slot="prefix" name="key"></sl-icon> Change password
                    </sl-button>
                    <sl-button size="small" variant="text" class="btn-open-unprotect" title="Remove password protection">
                        <sl-icon slot="prefix" name="unlock"></sl-icon> Unprotect
                    </sl-button>
                }
                <sl-button size="small" variant="warning" id="btn-relock" title="Hide content again">
                    <sl-icon slot="prefix" name="lock"></sl-icon> Re-lock
                </sl-button>
            </div>
            <div class="article-content" id="article-body"></div>
        </div>
    }
    else
    {
        <div class="card">
            @if (Model.Content == null)
            {
                <sl-alert variant="warning" open>
                    <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                    Content cannot be decrypted. This article was created on a node with a different encryption key.
                </sl-alert>
            }
            <div class="article-content" id="article-body"></div>
        </div>
    }

    @if (Model.RelatedArticles.Count > 0)
    {
        var totalRelated = Model.RelatedArticles.Count;
        var relatedPageSize = 5;
        var totalRelatedPages = (int)Math.Ceiling(totalRelated / (double)relatedPageSize);
        <div class="card mt-md">
            <h4 style="font-size:0.95rem;margin-bottom:14px;">
                <sl-icon name="diagram-3"></sl-icon> Related Articles (<span id="related-total">@totalRelated</span>)
            </h4>
            <div id="related-list">
                @foreach (var rel in Model.RelatedArticles.OrderByDescending(r => r.Strength).Take(relatedPageSize))
                {
                    <div class="related-item" style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--sl-color-neutral-200);">
                        <div>
                            <a href="/Article/View?id=@rel.Id" style="font-weight:500;">@rel.Title</a>
                            <div style="font-size:0.78rem;color:var(--sl-color-neutral-500);">@string.Join(", ", rel.SharedConcepts)</div>
                        </div>
                        <sl-badge variant="neutral" pill>@rel.Strength</sl-badge>
                    </div>
                }
            </div>
            @if (totalRelatedPages > 1)
            {
                <div id="related-pager" style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;">
                    <span id="related-pager-info" style="font-size:0.85rem;color:var(--sl-color-neutral-500);">Page 1 of @totalRelatedPages · @totalRelated items</span>
                    <div style="display:flex;gap:8px;">
                        <sl-button id="related-prev" size="small" variant="default" disabled>Prev</sl-button>
                        <sl-button id="related-next" size="small" variant="default">Next</sl-button>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Attachments -->
    @if (!Model.Article.Protected)
    {
        <div class="card mt-md">
            <h4 style="font-size:0.95rem;margin-bottom:14px;">
                <sl-icon name="paperclip"></sl-icon> Attachments (<span id="attachments-count">@Model.Attachments.Count</span>)
            </h4>

            <div id="attachments-list">
                @foreach (var att in Model.Attachments)
                {
                    <div class="attachment-item" id="attachment-@att.Id" style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--sl-color-neutral-200);">
                        <a href="/api-proxy/media/@att.Id" download="@att.FileName" style="display:flex;align-items:center;gap:8px;flex:1;min-width:0;">
                            <sl-icon name="file-earmark"></sl-icon>
                            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@att.FileName</span>
                            <span style="font-size:0.78rem;color:var(--sl-color-neutral-500);flex-shrink:0;">(@ViewModel.FormatFileSize(att.FileSize))</span>
                        </a>
                        @if (!Model.IsReadOnly)
                        {
                            <sl-icon-button name="trash" label="Delete" style="font-size:0.9rem;flex-shrink:0;"
                                class="btn-delete-attachment" data-attachment-id="@att.Id"></sl-icon-button>
                        }
                    </div>
                }
            </div>

            @if (!Model.IsReadOnly)
            {
                <input type="file" id="attachment-file-input" multiple style="display:none;" />
                <div class="attach-dropzone" id="attachment-dropzone" role="button" tabindex="0" aria-label="Add files">
                    <sl-icon name="cloud-arrow-up"></sl-icon>
                    <span id="attachment-dropzone-text">Drop files here or click to choose</span>
                </div>
            }
        </div>
    }

    <!-- Comments -->
    <div class="card mt-md">
        <h4 style="font-size:0.95rem;margin-bottom:14px;">
            <sl-icon name="chat-dots"></sl-icon> Comments (@Model.Comments.Count)
        </h4>

        <div id="comments-list">
        @foreach (var comment in Model.Comments)
        {
            <div class="comment-item" id="comment-@comment.Id">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <span class="comment-author">owner</span>
                        <span class="comment-date">@comment.CreatedAt.ToString("g")</span>
                    </div>
                    <sl-icon-button name="trash" label="Delete" style="font-size:0.9rem;"
                        class="btn-delete-comment" data-comment-id="@comment.Id"></sl-icon-button>
                </div>
                <p class="comment-text">@comment.Text</p>
            </div>
        }
        </div>

        <div style="margin-top:14px;">
            <sl-textarea id="new-comment-text" rows="2" placeholder="Add a comment..." style="margin-bottom:8px;"></sl-textarea>
            <sl-button id="btn-add-comment" size="small" variant="primary">
                <sl-icon slot="prefix" name="send"></sl-icon> Add Comment
            </sl-button>
        </div>
    </div>
}
else
{
    <p>Article not found.</p>
}

<!-- Print preview dialog -->
<sl-dialog id="dlg-print-article" label="Print Preview" class="print-dialog">
    <style>
        /* Always full-viewport — preview makes no sense at any smaller size. */
        #dlg-print-article { --width: 100vw; }
        #dlg-print-article::part(panel) { max-width: 100vw; max-height: 100vh; height: 100vh; border-radius: 0; }
        #dlg-print-article::part(body) { padding: 0; background: var(--sl-color-neutral-100); overflow: hidden; display: flex; flex-direction: column; }

        .print-preview-toolbar {
            display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px;
            padding: 8px 14px; background: var(--sl-color-neutral-50);
            border-bottom: 1px solid var(--sl-color-neutral-200);
            font-size: 0.85rem; flex-shrink: 0;
        }
        .print-preview-toolbar .group { display: flex; align-items: center; gap: 4px; }
        .print-preview-toolbar .sep { width: 1px; height: 20px; background: var(--sl-color-neutral-300); margin: 0 4px; }
        .print-preview-toolbar .spacer { flex: 1; }
        .print-preview-toolbar sl-select { min-width: 140px; }
        .print-preview-toolbar sl-select::part(form-control-label) { display: none; }

        /* Compact pill-buttons around the font-size %, tight against the label. */
        .print-preview-toolbar .size-group { display: flex; align-items: center; gap: 4px; }
        .print-preview-toolbar .size-btn {
            display: inline-flex; align-items: center; justify-content: center;
            width: 24px; height: 24px;
            background: var(--sl-color-primary-600); color: white;
            border: 0; border-radius: 5px; cursor: pointer;
            font-size: 16px; line-height: 1; padding: 0;
        }
        .print-preview-toolbar .size-btn:hover { background: var(--sl-color-primary-500); }
        .print-preview-toolbar .size-btn:active { background: var(--sl-color-primary-700); }
        .print-preview-toolbar .size-label { min-width: 36px; text-align: center; font-variant-numeric: tabular-nums; }

        .print-preview-frame-wrap {
            flex: 1; min-height: 0; overflow: auto;
            background: var(--sl-color-neutral-100);
        }
        #print-iframe { width: 100%; height: 100%; border: 0; background: transparent; display: block; }
    </style>
    <div class="print-preview-toolbar">
        <div class="group">
            <sl-icon-button id="print-zoom-out" name="zoom-out" label="Zoom out"></sl-icon-button>
            <span id="print-zoom-label" style="min-width:42px;text-align:center;">100%</span>
            <sl-icon-button id="print-zoom-in" name="zoom-in" label="Zoom in"></sl-icon-button>
        </div>
        <span class="sep"></span>
        <div class="group">
            <sl-select id="print-font" size="small" value="serif" hoist>
                <sl-option value="serif">Serif (Georgia)</sl-option>
                <sl-option value="sans">Sans (Helvetica)</sl-option>
                <sl-option value="times">Times New Roman</sl-option>
                <sl-option value="verdana">Verdana</sl-option>
                <sl-option value="mono">Monospace</sl-option>
            </sl-select>
        </div>
        <div class="size-group">
            <button type="button" class="size-btn" id="print-size-down" aria-label="Smaller font">−</button>
            <span id="print-size-label" class="size-label">100%</span>
            <button type="button" class="size-btn" id="print-size-up" aria-label="Larger font">+</button>
        </div>
        <div class="group">
            <sl-select id="print-margins" size="small" value="normal" hoist>
                <sl-option value="narrow">Narrow margins</sl-option>
                <sl-option value="normal">Normal margins</sl-option>
                <sl-option value="wide">Wide margins</sl-option>
            </sl-select>
        </div>
        <sl-switch id="print-page-numbers" size="small">Page numbers</sl-switch>
        <span class="spacer"></span>
        <span id="print-page-status" style="color:var(--sl-color-neutral-600);">Rendering…</span>
        <sl-button size="small" variant="default" data-dlg-cancel="dlg-print-article">Close</sl-button>
        <sl-button size="small" variant="primary" id="btn-do-print">
            <sl-icon slot="prefix" name="printer"></sl-icon> Print
        </sl-button>
    </div>
    <div class="print-preview-frame-wrap">
        <iframe id="print-iframe" title="Print preview"></iframe>
    </div>
</sl-dialog>

<!-- Move dialog -->
<sl-dialog id="dlg-move-article" label="Move Article" style="--width:560px;">
    <style>
        #dlg-move-article::part(panel) { overflow: visible; }
        #dlg-move-article::part(body) { overflow: visible; }
    </style>
    <p class="text-muted text-sm">Moving: <code>@Model.Article?.Title</code></p>
    <div style="position:relative;">
        <sl-input id="move-article-search" label="Destination folder" placeholder="Type to search or leave empty for root (/)" autocomplete="off"></sl-input>
        <div id="move-article-dropdown" style="display:none;position:absolute;z-index:1000;left:0;right:0;max-height:240px;overflow-y:auto;background:var(--sl-color-neutral-0);border:1px solid var(--sl-color-neutral-300);border-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,0.15);margin-top:2px;"></div>
    </div>
    <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-move-article">Cancel</sl-button>
    <sl-button id="btn-move-article" slot="footer" variant="primary">Move</sl-button>
</sl-dialog>

<!-- Delete dialog -->
<sl-dialog id="dlg-delete-article" label="Delete Article">
    <sl-alert variant="danger" open>
        <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
        Delete «@Model.Article?.Title»?
    </sl-alert>
    <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-delete-article">Cancel</sl-button>
    <sl-button id="btn-confirm-delete-article" slot="footer" variant="danger">Delete</sl-button>
</sl-dialog>

@if (!Model.IsReadOnly)
{
    <!-- Protect dialog (add a separate password) -->
    <sl-dialog id="dlg-protect" label="Protect with a password">
        <sl-alert variant="warning" open style="margin-bottom:14px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            This password is <strong>separate</strong> from your account and <strong>cannot be recovered</strong>.
            If you forget it, this article is lost forever.
        </sl-alert>
        <div style="display:flex;flex-direction:column;gap:12px;">
            <sl-input id="protect-pass" type="text" inputmode="text" autocomplete="off" class="bmb-secret" data-1p-ignore data-lpignore="true" label="Password"></sl-input>
            <sl-input id="protect-pass2" type="text" inputmode="text" autocomplete="off" class="bmb-secret" data-1p-ignore data-lpignore="true" label="Confirm password"></sl-input>
            <sl-input id="protect-hint" label="Hint (optional)" placeholder="A reminder shown before unlocking — do NOT put the password here"></sl-input>
            <div id="protect-error" style="display:none;color:var(--sl-color-danger-600);font-size:0.9rem;"></div>
        </div>
        <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-protect">Cancel</sl-button>
        <sl-button id="btn-protect" slot="footer" variant="primary">Protect</sl-button>
    </sl-dialog>

    <!-- Change passphrase dialog -->
    <sl-dialog id="dlg-change-pass" label="Change article password">
        <div style="display:flex;flex-direction:column;gap:12px;">
            <sl-input id="cp-old" type="text" inputmode="text" autocomplete="off" class="bmb-secret" data-1p-ignore data-lpignore="true" label="Current password"></sl-input>
            <sl-input id="cp-new" type="text" inputmode="text" autocomplete="off" class="bmb-secret" data-1p-ignore data-lpignore="true" label="New password"></sl-input>
            <sl-input id="cp-new2" type="text" inputmode="text" autocomplete="off" class="bmb-secret" data-1p-ignore data-lpignore="true" label="Confirm new password"></sl-input>
            <sl-input id="cp-hint" label="Hint (optional)" placeholder="A reminder shown before unlocking"></sl-input>
            <div id="cp-error" style="display:none;color:var(--sl-color-danger-600);font-size:0.9rem;"></div>
        </div>
        <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-change-pass">Cancel</sl-button>
        <sl-button id="btn-change-pass" slot="footer" variant="primary">Change password</sl-button>
    </sl-dialog>

    <!-- Remove protection dialog -->
    <sl-dialog id="dlg-unprotect" label="Remove password protection">
        <p class="text-muted text-sm">The article body will be readable again without a password.</p>
        <div style="display:flex;flex-direction:column;gap:12px;">
            <sl-input id="up-pass" type="text" inputmode="text" autocomplete="off" class="bmb-secret" data-1p-ignore data-lpignore="true" label="Current password"></sl-input>
            <div id="up-error" style="display:none;color:var(--sl-color-danger-600);font-size:0.9rem;"></div>
        </div>
        <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-unprotect">Cancel</sl-button>
        <sl-button id="btn-unprotect" slot="footer" variant="danger">Remove protection</sl-button>
    </sl-dialog>
}

<!-- Copy article dialog -->
<sl-dialog id="dlg-copy-article" label="Copy Article To">
    @if (Model.Article != null)
    {
        <p class="text-muted text-sm">Copying: <strong>@Model.Article.Title</strong> from <code>@Model.Article.TreePath</code></p>
    }
    <sl-alert id="copy-article-error" variant="danger" closable style="margin-bottom:12px;display:none;">
        <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
        <span id="copy-article-error-msg"></span>
    </sl-alert>
    <sl-input id="copy-article-target" label="Target folder path" placeholder="/" autocomplete="off" autofocus></sl-input>
    <small class="text-muted">If the target already contains an article with the same title, the copy is renamed with a " (N)" suffix.</small>
    <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-copy-article">Cancel</sl-button>
    <sl-button id="btn-copy-article" slot="footer" variant="primary">Copy</sl-button>
</sl-dialog>

@* Sync delivery status is superadmin-only at the API (/api/sync/delivery-status names every
   peer and its address), and the proxy route enforces the same role. Rendering the toast for
   everyone meant a regular user who saved an article got a widget that could only ever fail —
   its retry loop polled a 403 every five seconds until they navigated away. Same claim check the
   layout's sync widget uses. *@
@if (User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Role && c.Value == "superadmin"))
{
<div id="syncToast" class="sync-toast" style="display:none;">
    <div class="sync-toast-content">
        <span class="sync-toast-label">Syncing</span>
        <div class="sync-toast-circles" id="syncToastCircles"></div>
    </div>
</div>

<sl-dialog label="Sync Delivery Status" id="syncModal" class="sync-modal">
    <div id="syncModalContent" class="sync-modal-content">Loading...</div>
    <sl-button slot="footer" variant="primary" data-dlg-cancel="syncModal">Close</sl-button>
</sl-dialog>
}

<script type="application/json" id="article-view-data">
{
    "articleId": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Article?.Id.ToString() ?? "")),
    "content": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Content ?? "")),
    "treePath": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Article?.TreePath ?? "/")),
    "isProtected": @(Model.Article?.Protected == true ? "true" : "false"),
    "isUnlockedFromCache": @(Model.IsUnlockedFromCache ? "true" : "false"),
    "unlockExpiresInSeconds": @(Model.UnlockExpiresInSeconds?.ToString() ?? "null"),
    "articleTitle": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Article?.Title ?? "")),
    "articleTreePath": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Article?.TreePath ?? "/"))
}
</script>
<script src="/js/pages/article-view.js"></script>

</div>
</div>
