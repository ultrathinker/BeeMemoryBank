@page
@model BeeMemoryBank.Web.Pages.GraphModel
@{
    ViewData["Title"] = "Knowledge Graph";
}

@section HeadStyles {
    <style>
        #graph-container {
            position: relative;
            background: var(--sl-panel-background-color);
            border: 1px solid var(--sl-color-neutral-200);
            border-radius: var(--sl-border-radius-medium);
            overflow: hidden;
        }
        #graph-svg {
            cursor: grab;
            width: 100%;
            height: 100%;
        }
        #graph-cy {
            width: 100%;
            height: 100%;
            display: none;
            position: relative;
            overflow: hidden;
        }
        /* Cytoscape inserts transformed canvases that can briefly escape the box
           during layout animation; make sure nothing outside #graph-cy becomes
           horizontally scrollable on the page. */
        html, body.graph-page { overflow-x: hidden; max-width: 100vw; }
        /* The shared .main-content has overflow-y:auto for scrolling long pages,
           which reserves ~17px for the vertical scrollbar. On wide content this
           bleeds as horizontal scroll on the graph page specifically. Clip it. */
        body.graph-page .main-content { overflow-x: hidden; }
        #graph-svg:active {
            cursor: grabbing;
        }
        .node circle {
            stroke: #fff;
            stroke-width: 1.5px;
            transition: stroke-width 0.2s, r 0.2s;
        }
        .node.truncated circle {
            stroke: var(--sl-color-warning-500);
            stroke-width: 2.5px;
            stroke-dasharray: 3 3;
        }
        .node:hover circle {
            stroke-width: 3px;
            stroke: var(--sl-color-primary-500);
            stroke-dasharray: none;
        }
        .node text {
            pointer-events: none;
            font-family: var(--sl-font-sans);
            font-weight: 500;
            fill: var(--text-primary);
            text-shadow: 0 1px 2px var(--bg-primary), 0 -1px 2px var(--bg-primary), 1px 0 2px var(--bg-primary), -1px 0 2px var(--bg-primary);
        }
        .link {
            stroke: var(--sl-color-neutral-300);
            stroke-opacity: 0.6;
            transition: stroke-opacity 0.2s;
        }
        .link.highlight {
            stroke: var(--sl-color-primary-400);
            stroke-opacity: 1;
        }
        #graph-controls {
            position: absolute;
            top: 10px;
            left: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            z-index: 5;
        }
        #btn-fullscreen {
            display: inline-flex;
        }
        /* Make the page's own content column fill the available viewport height
           instead of sizing the graph area off a fragile magic-number
           calc(100vh - Npx). Rows above the graph (header, legend, folder-scope
           bar, filter bar, tags table) keep their natural content height
           (flex-shrink:0 below); the graph area is the only flexible row and
           consumes whatever space is left via flex:1. That way, adding, removing,
           or resizing any row above automatically resizes the graph instead of
           pushing it below the viewport.
           .main-content's own height is already fully determined by the outer
           flex chain (body -> .app-body -> .main-content), so height:100% here
           resolves to a real pixel value, not an intrinsic/auto one. */
        body.graph-page .main-content {
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 0;
        }
        body.graph-page .main-content > * {
            flex-shrink: 0;
        }
        #graph-fullscreen-wrap {
            position: relative;
            flex: 1 1 auto;
            min-height: 320px;
            max-width: 100%;
        }
        /* The graph page has its own floating sidebars (bee-panel-left/right) whose
           transforms or widths can briefly overflow on narrow viewports; clip at
           the page level so the main scrollbars never appear. */
        body.graph-page, body.graph-page #page-content {
            overflow-x: hidden;
        }
        #graph-fullscreen-wrap #graph-container {
            height: 100%;
            min-height: 0;
            margin-bottom: 0;
        }
        #graph-fullscreen-wrap:fullscreen,
        #graph-fullscreen-wrap:-webkit-full-screen { height: 100vh; background: var(--bg-primary); }
        #graph-fullscreen-wrap:fullscreen #graph-container,
        #graph-fullscreen-wrap:-webkit-full-screen #graph-container { height: 100%; }
        .bee-panel {
            position: absolute;
            top: 0; bottom: 0;
            background: var(--sl-panel-background-color);
            border: 1px solid var(--sl-color-neutral-300);
            box-shadow: 0 0 12px rgba(0,0,0,0.15);
            z-index: 10;
            display: flex;
            flex-direction: column;
            padding: 16px;
            overflow-y: auto;
            visibility: hidden;
            transition: transform 0.25s ease, visibility 0s linear 0.25s;
        }
        .bee-panel:not([hidden]) {
            visibility: visible;
            transition: transform 0.25s ease, visibility 0s linear 0s;
        }
        .bee-panel-right { right: 0; width: 450px; max-width: 50%; transform: translateX(calc(100% + 24px)); }
        .bee-panel-right:not([hidden]) { transform: translateX(0); }
        .bee-panel-left { left: 0; right: 450px; transform: translateX(calc(-100% - 24px)); overflow: hidden; }
        .bee-panel-left:not([hidden]) { transform: translateX(0); }
        #article-preview-frame { flex: 1 1 auto; min-height: 0; }
        @@media (max-width: 900px) { .bee-panel-left { right: 0; } }
        .bee-panel[hidden] { display: flex !important; pointer-events: none; }
        .bee-panel-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; gap: 8px; flex-shrink: 0; }
    </style>
}

<partial name="_Sidebar" />
<div id="page-content">
<div class="main-content">

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
    <h1 style="margin:0;">
        <sl-icon name="diagram-3"></sl-icon> Knowledge Graph
    </h1>
    <div style="display:flex; gap: 8px; align-items:center;">
        <sl-button-group>
            <sl-button id="btn-mode-home" variant="primary" size="small">
                <sl-icon slot="prefix" name="house"></sl-icon> Simple
            </sl-button>
            <sl-button id="btn-mode-full" variant="default" size="small">
                <sl-icon slot="prefix" name="globe"></sl-icon> Full Graph
            </sl-button>
        </sl-button-group>
        <sl-button id="btn-fullscreen" variant="default" size="small">
            <sl-icon slot="prefix" name="fullscreen"></sl-icon> Fullscreen
        </sl-button>
        <sl-button-group>
            <sl-button id="btn-graph-view" variant="primary" size="small">
                <sl-icon slot="prefix" name="diagram-3"></sl-icon> Graph
            </sl-button>
            <sl-button id="btn-table-view" variant="default" size="small">
                <sl-icon slot="prefix" name="table"></sl-icon> Tags
            </sl-button>
        </sl-button-group>
    </div>
</div>

<!-- Legend: explains what node colors mean in the current mode -->
<div id="graph-legend" style="margin-bottom:8px; display:flex; flex-wrap:wrap; gap:16px; font-size:0.85rem; color:var(--sl-color-neutral-500);"></div>

<!-- Folder-scope picker: restricts graph search to a folder subtree -->
<div id="folder-scope-bar" style="margin-bottom:6px; display:flex; align-items:center; gap:6px;">
    <a id="folder-scope-link" href="#" role="button" title="Restrict the graph search to a specific folder" style="font-size:0.8rem; color:var(--sl-color-neutral-500); text-decoration:none; display:inline-flex; align-items:center; gap:3px;">
        <sl-icon name="folder2" style="font-size:0.85rem;"></sl-icon> Select folder
    </a>
    <div id="folder-scope-picker" class="bmb-folder-picker" hidden style="flex:1 1 auto; max-width:380px;">
        <sl-input class="bmb-fp-input" placeholder="Type to search folders, or pick / for root" autocomplete="off" size="small"></sl-input>
        <div class="bmb-fp-dropdown" hidden></div>
    </div>
    <sl-tooltip content="Apply folder + re-run search" id="folder-scope-apply-tip" style="display:none;">
        <sl-icon-button id="folder-scope-apply" name="check-lg" label="Apply folder scope" size="small"></sl-icon-button>
    </sl-tooltip>
    <sl-icon-button id="folder-scope-clear" name="x-lg" label="Clear folder scope" size="small" style="display:none;"></sl-icon-button>
</div>

<!-- Filter bar -->
<div style="margin-bottom:16px; display: flex; gap: 8px;">
    <sl-input id="concept-filter" placeholder="Filter tags locally, press Enter to search across the whole graph..." clearable size="small" style="flex-grow: 1; min-width: 0;">
        <sl-icon slot="prefix" name="search" style="margin-left:8px;"></sl-icon>
    </sl-input>
    <sl-tooltip content="Refresh data">
        <sl-icon-button id="btn-graph-refresh" name="arrow-clockwise" label="Refresh"></sl-icon-button>
    </sl-tooltip>
</div>

<!-- Tags table view (hidden by default) -->
<div id="table-container" style="display:none;">
    <div class="card">
        <div id="concept-table-rows"></div>
        <div id="concept-table-pager" style="display:none;margin-top:12px;align-items:center;justify-content:space-between;gap:12px;">
            <span id="concept-table-pager-info" style="font-size:0.85rem;color:var(--sl-color-neutral-500);"></span>
            <div style="display:flex;gap:8px;">
                <sl-button id="concept-table-pager-prev" size="small" variant="default">Prev</sl-button>
                <sl-button id="concept-table-pager-next" size="small" variant="default">Next</sl-button>
            </div>
        </div>
    </div>
</div>

<!-- Graph + floating panels wrapper (needed for fullscreen) -->
<div id="graph-fullscreen-wrap">
    <div id="graph-container">
        <div id="graph-controls">
            <sl-tooltip content="Zoom In" placement="left">
                <sl-icon-button name="plus-lg" circle variant="default" id="btn-zoom-in"></sl-icon-button>
            </sl-tooltip>
            <sl-tooltip content="Zoom Out" placement="left">
                <sl-icon-button name="dash-lg" circle variant="default" id="btn-zoom-out"></sl-icon-button>
            </sl-tooltip>
            <sl-tooltip content="Reset View" placement="left">
                <sl-icon-button name="fullscreen-exit" circle variant="default" id="btn-zoom-reset"></sl-icon-button>
            </sl-tooltip>
        </div>

        <svg id="graph-svg"></svg>
        <div id="graph-cy"></div>
        
        <div id="graph-placeholder" style="display:none;align-items:center;justify-content:center;height:100%;color:var(--sl-color-neutral-400);position:absolute;top:0;left:0;right:0;">
            <div style="text-align:center;">
                <sl-icon name="diagram-3" style="font-size:3rem;display:block;margin-bottom:8px;"></sl-icon>
                <p>No connections found.</p>
                <p style="font-size:0.85rem;">Add tags to multiple articles to see links.</p>
            </div>
        </div>
    </div>
    <!-- Right panel: tag details -->
    <div id="concept-panel" class="bee-panel bee-panel-right" hidden>
        <div class="bee-panel-header">
            <h3 id="panel-concept-name" style="margin:0;"></h3>
            <sl-icon-button name="x-lg" label="Close" class="bee-panel-close" data-target="concept-panel"></sl-icon-button>
        </div>
        <p id="panel-concept-meta" class="text-muted text-sm"></p>
        <div id="panel-articles-list" style="margin-top:20px;"></div>
    </div>
    <!-- Left panel: read-only article preview -->
    <div id="article-preview-panel" class="bee-panel bee-panel-left" hidden>
        <div class="bee-panel-header">
            <span style="font-size:0.85rem;color:var(--sl-color-neutral-500);">Article preview</span>
            <sl-icon-button name="x-lg" label="Close" class="bee-panel-close" data-target="article-preview-panel"></sl-icon-button>
        </div>
        <iframe id="article-preview-frame" style="flex:1;width:100%;border:0;background:var(--bg-primary);"></iframe>
    </div>
</div>

</div>
</div>

<sl-dialog id="dlg-full-confirm" label="Load the full graph?">
    <p>The full graph renders <strong>every</strong> tag at once. If you have a lot of tags this can be slow and heavy to explore. Continue?</p>
    <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-full-confirm">Cancel</sl-button>
    <sl-button id="btn-full-confirm" slot="footer" variant="primary">Load full graph</sl-button>
</sl-dialog>

@section Scripts {
    <script src="~/lib/d3/d3.v7.min.js" asp-append-version="true"></script>
    <script src="~/lib/cytoscape/cytoscape.min.js"></script>
    <script src="~/lib/cytoscape/layout-base.js"></script>
    <script src="~/lib/cytoscape/cose-base.js"></script>
    <script src="~/lib/cytoscape/cytoscape-fcose.js"></script>
    <script type="application/json" id="graph-data">
    {
        "focusConcept": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FocusConcept))
    }
    </script>
    <script src="/js/pages/graph.js"></script>
}
