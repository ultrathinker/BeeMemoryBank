@page
@model BeeMemoryBank.Web.Pages.TagsModel
@{
    ViewData["Title"] = "Tags";
}
<partial name="_Sidebar" />
<div id="page-content">
<div class="main-content">
    <div style="display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;justify-content:space-between;margin-bottom:16px;">
        <h1 style="font-size:1.5rem;margin:0;">
            <sl-icon name="tags"></sl-icon> Tags
        </h1>
        <sl-input id="tag-search" placeholder="Filter..." clearable size="small" style="flex:1 1 180px;max-width:260px;min-width:0;">
            <sl-icon slot="prefix" name="search" style="margin-left:8px;"></sl-icon>
        </sl-input>
    </div>

    <div id="concept-loading" style="text-align:center;padding:24px;"><sl-spinner></sl-spinner></div>
    <div class="table-scroll">
    <table id="concept-table" style="display:none;width:100%;min-width:480px;border-collapse:collapse;">
        <thead>
            <tr style="border-bottom:1px solid var(--sl-color-neutral-300);">
                <th style="text-align:left;padding:8px;">Name</th>
                <th style="text-align:right;padding:8px;width:120px;">Articles</th>
                <th style="text-align:right;padding:8px;width:260px;">Actions</th>
            </tr>
        </thead>
        <tbody id="concept-tbody"></tbody>
    </table>
    </div>
    <div id="concept-pager" style="display:none;margin-top:12px;align-items:center;justify-content:space-between;gap:12px;">
        <span id="concept-pager-info" style="font-size:0.85rem;color:var(--sl-color-neutral-500);"></span>
        <div style="display:flex;gap:8px;">
            <sl-button id="concept-pager-prev" size="small" variant="default">Prev</sl-button>
            <sl-button id="concept-pager-next" size="small" variant="default">Next</sl-button>
        </div>
    </div>
    <div id="concept-empty" style="display:none;text-align:center;padding:24px;color:var(--sl-color-neutral-500);">No tags found.</div>
</div>
</div>

<sl-dialog id="dlg-rename" label="Rename tag">
    <sl-input id="rename-new-name" label="New name" autofocus></sl-input>
    <p class="text-muted text-sm" style="margin-top:8px;">Current: <code id="rename-current"></code></p>
    <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-rename">Cancel</sl-button>
    <sl-button id="btn-rename-confirm" slot="footer" variant="primary">Rename</sl-button>
</sl-dialog>

<sl-dialog id="dlg-merge" label="Merge tag">
    <p class="text-muted text-sm">All articles using <code id="merge-source"></code> will be moved to the target tag, then the source is deleted.</p>
    <sl-input id="merge-target" label="Target tag" autofocus></sl-input>
    <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-merge">Cancel</sl-button>
    <sl-button id="btn-merge-confirm" slot="footer" variant="primary">Merge</sl-button>
</sl-dialog>

<sl-dialog id="dlg-delete" label="Delete tag">
    <sl-alert variant="danger" open>
        <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
        Delete <code id="delete-name"></code>? Removes it from all articles.
    </sl-alert>
    <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-delete">Cancel</sl-button>
    <sl-button id="btn-delete-confirm" slot="footer" variant="danger">Delete</sl-button>
</sl-dialog>

<script type="application/json" id="page-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { isSuperadmin = Model.IsSuperadmin }))</script>
<script src="~/js/pages/tags.js" asp-append-version="true"></script>
