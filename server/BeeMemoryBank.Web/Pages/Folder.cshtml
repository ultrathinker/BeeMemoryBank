@page
@model FolderModel
@{
    ViewData["Title"] = Model.FolderName;
}
<partial name="_Sidebar" />
<div id="page-content">
<div class="main-content">
    <h2 style="font-size:1.4rem;font-weight:700;margin:0 0 6px 0;">
        <sl-icon name="folder2-open" style="margin-right:6px;"></sl-icon>@Model.FolderName
    </h2>
    @{
        var isReadOnly = Model.Children?.IsReadOnly == true;
        var isSystemFolder = Model.Children?.IsSystem == true;
    }
    <div class="folder-header-bar">
        <div class="folder-path">
            <span class="bmb-path-copy text-muted text-sm" title="Click to copy path" data-bmb-copy="@Model.CurrentPath">
                <sl-icon name="folder2"></sl-icon> @Model.CurrentPath
            </span>
            @if (isReadOnly)
            {
                <sl-badge variant="warning" pill style="margin-left:8px;" title="You have read-only access to this folder.">
                    <sl-icon slot="prefix" name="lock-fill"></sl-icon> Read-only
                </sl-badge>
            }
            @if (isSystemFolder)
            {
                <sl-badge variant="primary" pill style="margin-left:8px;" title="System folder — write content allowed, structural ops disabled.">
                    <sl-icon slot="prefix" name="gear-fill"></sl-icon> System
                </sl-badge>
            }
        </div>
        <div class="toolbar compact">
            @if (!isReadOnly)
            {
                <sl-button id="btn-open-new-article-folder" size="small" variant="success">
                    <sl-icon slot="prefix" name="file-earmark-plus"></sl-icon> New Article
                </sl-button>
                <sl-button id="btn-open-add-subfolder" size="small" variant="success">
                    <sl-icon slot="prefix" name="folder-plus"></sl-icon> Add Folder
                </sl-button>
                @if (!isSystemFolder)
                {
                    <sl-button id="btn-open-rename-folder" size="small" variant="default">
                        <sl-icon slot="prefix" name="pencil"></sl-icon> Rename
                    </sl-button>
                    <sl-button id="btn-open-move-folder" size="small" variant="default">
                        <sl-icon slot="prefix" name="folder-symlink"></sl-icon> Move
                    </sl-button>
                }
            }
            <sl-button id="btn-open-copy-folder" size="small" variant="default">
                <sl-icon slot="prefix" name="copy"></sl-icon> Copy To
            </sl-button>
            <sl-button id="btn-export-folder" size="small" variant="default">
                <sl-icon slot="prefix" name="upload"></sl-icon> Export
            </sl-button>
            @if (!isReadOnly && !isSystemFolder)
            {
                <sl-button id="btn-open-delete-folder" size="small" variant="danger">
                    <sl-icon slot="prefix" name="trash"></sl-icon> Delete
                </sl-button>
            }
        </div>
    </div>

    @if (Model.Children != null && Model.Children.Folders.Count > 0)
    {
        <div class="card">
            <h4 style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.8px;color:var(--text-secondary);margin-bottom:12px;">
                <sl-icon name="diagram-3"></sl-icon> Subfolders
            </h4>
            <table class="bmb-sort-table" id="folders-table" style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr>
                        <th class="bmb-sort-th" data-sort="name" data-default="asc" style="text-align:left;padding:6px 10px;border-bottom:2px solid var(--sl-color-neutral-200);cursor:pointer;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.6px;color:var(--text-secondary);">Name <span class="bmb-sort-arrow"></span></th>
                        <th class="bmb-sort-th" data-sort="count" style="text-align:center;padding:6px 10px;border-bottom:2px solid var(--sl-color-neutral-200);cursor:pointer;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.6px;color:var(--text-secondary);width:80px;">Articles <span class="bmb-sort-arrow"></span></th>
                        <th class="bmb-sort-th" data-sort="updated" data-default="desc" style="text-align:right;padding:6px 10px;border-bottom:2px solid var(--sl-color-neutral-200);cursor:pointer;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.6px;color:var(--text-secondary);width:120px;">Updated <span class="bmb-sort-arrow"></span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var folder in Model.Children.Folders)
                    {
                        <tr class="bmb-sort-row" data-name="@folder.Name" data-count="@folder.ArticleCount" data-updated-ts="@folder.UpdatedAt.ToString("o")">
                            <td style="padding:8px 10px;border-bottom:1px solid var(--sl-color-neutral-100);">
                                <a href="/Folder?path=@Uri.EscapeDataString(folder.Path)" style="display:inline-flex;align-items:center;gap:6px;text-decoration:none;color:var(--text-primary);">
                                    <sl-icon name="folder2" style="font-size:1rem;"></sl-icon> @folder.Name
                                </a>
                            </td>
                            <td style="text-align:center;padding:8px 10px;border-bottom:1px solid var(--sl-color-neutral-100);">
                                <sl-badge variant="neutral" pill>@folder.ArticleCount</sl-badge>
                            </td>
                            <td style="text-align:right;padding:8px 10px;border-bottom:1px solid var(--sl-color-neutral-100);font-size:0.85rem;color:var(--text-secondary);" class="text-muted text-sm">@folder.UpdatedAt.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.Children != null && Model.Children.Articles.Count > 0)
    {
        <div class="card">
            <h4 style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.8px;color:var(--text-secondary);margin-bottom:12px;">
                <sl-icon name="file-earmark-text"></sl-icon> Articles
            </h4>
            <table class="bmb-sort-table" id="articles-table" style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr>
                        <th class="bmb-sort-th" data-sort="title" data-default="asc" style="text-align:left;padding:6px 10px;border-bottom:2px solid var(--sl-color-neutral-200);cursor:pointer;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.6px;color:var(--text-secondary);">Title <span class="bmb-sort-arrow"></span></th>
                        <th class="bmb-sort-th" data-sort="created" data-default="desc" style="text-align:right;padding:6px 10px;border-bottom:2px solid var(--sl-color-neutral-200);cursor:pointer;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.6px;color:var(--text-secondary);width:120px;">Created <span class="bmb-sort-arrow"></span></th>
                        <th class="bmb-sort-th" data-sort="updated" data-default="desc" style="text-align:right;padding:6px 10px;border-bottom:2px solid var(--sl-color-neutral-200);cursor:pointer;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.6px;color:var(--text-secondary);width:120px;">Updated <span class="bmb-sort-arrow"></span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var article in Model.Children.Articles)
                    {
                        <tr class="bmb-sort-row" data-title="@article.Title" data-created-ts="@article.CreatedAt.ToString("o")" data-updated-ts="@article.UpdatedAt.ToString("o")">
                            <td style="padding:8px 10px;border-bottom:1px solid var(--sl-color-neutral-100);">
                                <a href="/Article/View?id=@article.Id" style="text-decoration:none;color:var(--text-primary);">@article.Title</a>
                                @if (article.Protected)
                                {
                                    <sl-icon name="shield-lock" title="Password-protected" style="color:var(--sl-color-warning-600);font-size:0.85em;vertical-align:-1px;margin-left:4px;"></sl-icon>
                                }
                            </td>
                            <td style="text-align:right;padding:8px 10px;border-bottom:1px solid var(--sl-color-neutral-100);font-size:0.85rem;color:var(--text-secondary);" class="text-muted text-sm">@article.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td style="text-align:right;padding:8px 10px;border-bottom:1px solid var(--sl-color-neutral-100);font-size:0.85rem;color:var(--text-secondary);" class="text-muted text-sm">@article.UpdatedAt.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.Children == null || (Model.Children.Folders.Count == 0 && Model.Children.Articles.Count == 0))
    {
        <div class="card" style="text-align:center;padding:40px;">
            <sl-icon name="folder2" style="font-size:3rem;color:var(--text-secondary);"></sl-icon>
            <p style="margin-top:12px;color:var(--text-secondary);">This folder is empty</p>
            @if (!isReadOnly)
            {
                <sl-button size="small" variant="primary" href="/Article/Edit?treePath=@Uri.EscapeDataString(Model.CurrentPath)" style="margin-top:12px;">
                    <sl-icon slot="prefix" name="plus-lg"></sl-icon> Create Article
                </sl-button>
            }
        </div>
    }

<!-- Move folder dialog -->
<sl-dialog id="dlg-move-folder" label="Move Folder" class="bmb-fp-host" style="--width:560px;">
    <p class="text-muted text-sm">Moving: <code>@Model.CurrentPath</code></p>
    <label style="display:block;font-size:0.88rem;color:var(--text-secondary);margin-bottom:6px;">Destination parent folder</label>
    <div class="bmb-folder-picker" id="move-folder-picker">
        <sl-input class="bmb-fp-input" placeholder="Type to search folders, or pick / for root" autocomplete="off"></sl-input>
        <div class="bmb-fp-dropdown" hidden></div>
    </div>
    <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-move-folder">Cancel</sl-button>
    <sl-button id="btn-move-folder" slot="footer" variant="primary">Move</sl-button>
</sl-dialog>

<!-- Rename folder dialog -->
<sl-dialog id="dlg-rename-folder" label="Rename Folder">
    <sl-input id="rename-folder-name" label="Folder name" value="@System.IO.Path.GetFileName(Model.CurrentPath.TrimEnd('/'))" required autofocus></sl-input>
    <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-rename-folder">Cancel</sl-button>
    <sl-button id="btn-rename-folder" slot="footer" variant="primary">Rename</sl-button>
</sl-dialog>

<!-- Add subfolder dialog -->
<sl-dialog id="dlg-add-subfolder" label="Add Subfolder" class="bmb-fp-host">
    <div id="folder-add-subfolder-path-selector" class="bmb-path-selector">
        <div class="bmb-path-display">
            <sl-icon class="bmb-path-icon" name="folder2"></sl-icon>
            <span class="bmb-path-text">/</span>
            <sl-icon-button class="bmb-path-edit-btn" name="pencil-square" label="Change location"></sl-icon-button>
        </div>
        <div class="bmb-path-picker bmb-folder-picker" hidden>
            <sl-input class="bmb-fp-input" placeholder="Type to search folders, or pick / for root" autocomplete="off" size="small"></sl-input>
            <div class="bmb-fp-dropdown" hidden></div>
        </div>
    </div>
    <sl-alert id="add-subfolder-error" variant="danger" closable style="margin-bottom:12px;display:none;">
        <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
        <span id="add-subfolder-error-msg"></span>
    </sl-alert>
    <sl-input id="add-subfolder-name" label="Folder name" placeholder="New Folder" required autofocus></sl-input>
    <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-add-subfolder">Cancel</sl-button>
    <sl-button id="btn-add-subfolder" slot="footer" variant="primary">Create</sl-button>
</sl-dialog>

<!-- Delete folder dialog -->
<sl-dialog id="dlg-delete-folder" label="Delete Folder">
    <sl-alert variant="danger" open>
        <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
        All articles in <strong>@Model.CurrentPath</strong> and subfolders will be deleted!
    </sl-alert>
    <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-delete-folder">Cancel</sl-button>
    <sl-button id="btn-confirm-delete-folder" slot="footer" variant="danger">Delete All</sl-button>
</sl-dialog>

<!-- Copy folder dialog -->
<sl-dialog id="dlg-copy-folder" label="Copy Folder To">
    <p class="text-muted text-sm">Copying: <code>@Model.CurrentPath</code></p>
    <sl-alert id="copy-folder-error" variant="danger" closable style="margin-bottom:12px;display:none;">
        <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
        <span id="copy-folder-error-msg"></span>
    </sl-alert>
    <sl-input id="copy-folder-target" label="Target parent path" placeholder="/" autocomplete="off" autofocus></sl-input>
    <small class="text-muted">A deep copy is created at <code>&lt;target&gt;/@System.IO.Path.GetFileName(Model.CurrentPath.TrimEnd('/'))</code>. Name collisions get a " (N)" suffix.</small>
    <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-copy-folder">Cancel</sl-button>
    <sl-button id="btn-copy-folder" slot="footer" variant="primary">Copy</sl-button>
</sl-dialog>
<script type="application/json" id="folder-page-data">
    {"currentPath":@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CurrentPath))}
</script>
<script src="/js/pages/folder.js"></script>
</div>
</div>
