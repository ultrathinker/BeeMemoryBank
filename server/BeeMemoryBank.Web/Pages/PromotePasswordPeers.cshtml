@page
@model PromotePasswordPeersModel
@{
    ViewData["Title"] = "Grant superadmin to password-joined devices";
}

<div class="main-content">
    <h2 style="margin-bottom:12px;"><sl-icon name="shield-check" style="margin-right:8px;vertical-align:middle;"></sl-icon>Grant superadmin to devices joined with the password</h2>

    <div class="card" style="max-width:720px;">
        <p style="margin-bottom:12px;">
            Whoever knows the master password is a superadmin. These devices joined before that
            rule, so the network still treats them as ordinary peers: a hard delete or a password
            change made on them is applied there but refused everywhere else, and the copies drift
            apart. Granting them superadmin tells every node, one device at a time.
        </p>
        <p class="text-muted text-sm" style="margin-bottom:16px;">
            If you demoted one of these devices on purpose, untick it. Blind nodes never appear here.
        </p>

        @if (Model.Candidates.Count == 0)
        {
            <p>Every device joined with the password is already a superadmin.</p>
            <sl-button href="/Admin" variant="default">Back to Admin</sl-button>
        }
        else
        {
            <form method="post">
                @foreach (var c in Model.Candidates)
                {
                    <div style="margin-bottom:8px;">
                        <label>
                            <input type="checkbox" name="nodeIds" value="@c.NodeId" checked />
                            <strong>@c.DisplayName</strong>
                            <code class="text-sm">@c.NodeId.ToString()[..8]&hellip;</code>
                            <span class="text-muted text-sm">@(c.ApiAddress ?? "")</span>
                        </label>
                    </div>
                }
                <div style="margin-top:16px;display:flex;gap:8px;">
                    <sl-button type="submit" variant="warning">Grant superadmin to the ticked devices</sl-button>
                    <sl-button href="/Admin" variant="default">Cancel</sl-button>
                </div>
            </form>
        }
    </div>
</div>
