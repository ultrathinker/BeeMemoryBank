@page
@model BeeMemoryBank.Web.Pages.UsersModel
@{
    ViewData["Title"] = "Users";
}

<partial name="_Sidebar" />

<div id="page-content">
<div class="main-content">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
        <h2 style="margin:0;"><sl-icon name="people"></sl-icon> Users</h2>
        <div style="display:flex;gap:8px;">
            <sl-button size="small" variant="default" href="/Roles">
                <sl-icon slot="prefix" name="shield-lock"></sl-icon> Roles
            </sl-button>
            <sl-button size="small" variant="success" id="btn-open-add-user">
                <sl-icon slot="prefix" name="plus-lg"></sl-icon> Add User
            </sl-button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <sl-alert variant="success" open closable style="margin-bottom:20px;">
            <sl-icon slot="icon" name="check-circle"></sl-icon>
            @Model.SuccessMessage
        </sl-alert>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <sl-alert variant="danger" open closable style="margin-bottom:20px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            @Model.ErrorMessage
        </sl-alert>
    }

    @if (Model.Users != null && Model.Users.Count > 0)
    {
        <div class="card" style="padding:0;overflow:hidden;">
            <table class="version-table">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Display Name</th>
                        <th>Role</th>
                        <th>Chat</th>
                        <th>Created</th>
                        <th>Last Login</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td><strong>@user.Username</strong></td>
                            <td>@user.DisplayName</td>
                            <td>
                                <sl-badge variant="@(user.Role == "superadmin" ? "warning" : user.Role == "user" ? "neutral" : "primary")" pill>
                                    @user.Role
                                </sl-badge>
                            </td>
                            <td>
                                <sl-icon name="@(user.ChatAccess ? "check-circle" : "dash-circle")"
                                    style="color:@(user.ChatAccess ? "var(--sl-color-success-600)" : "var(--sl-color-neutral-400)");font-size:1.1rem;"
                                    title="@(user.ChatAccess ? "Can use AI chat" : "AI chat access denied")"></sl-icon>
                            </td>
                            <td class="text-muted text-sm">@user.CreatedAt.ToString("g")</td>
                            <td class="text-muted text-sm">@(user.LastLoginAt?.ToString("g") ?? "—")</td>
                            <td style="text-align:right;">
                                @if (user.Role != "superadmin")
                                {
                                    <sl-icon-button name="shield-lock" label="Folder access"
                                        data-uid="@user.Id" data-name="@user.Username" data-role="@user.Role"
                                        class="btn-user-folder-access">
                                    </sl-icon-button>
                                }
                                <sl-icon-button name="key" label="Change Password"
                                    data-uid="@user.Id" data-name="@user.Username"
                                    class="btn-user-change-pw">
                                </sl-icon-button>
                                <sl-icon-button name="pencil" label="Edit"
                                    data-uid="@user.Id" data-display="@user.DisplayName" data-role="@user.Role" data-chat-access="@user.ChatAccess.ToString().ToLower()"
                                    class="btn-user-edit">
                                </sl-icon-button>
                                <sl-icon-button name="trash" label="Delete"
                                    data-name="@user.Username" data-form-id="form-del-@user.Id"
                                    class="btn-user-delete">
                                </sl-icon-button>
                                <form id="form-del-@user.Id" method="post" asp-page-handler="Delete" style="display:none;">
                                    <input type="hidden" name="id" value="@user.Id" />
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card" style="text-align:center;padding:40px;">
            <sl-icon name="people" style="font-size:2rem;color:var(--text-secondary);display:block;margin-bottom:12px;"></sl-icon>
            <p class="text-muted">No users found</p>
        </div>
    }

    <sl-dialog id="dlg-add-user" label="Add User">
        <sl-alert id="add-user-error" variant="danger" closable style="display:none;margin-bottom:16px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            <span class="msg"></span>
        </sl-alert>
        <sl-alert variant="primary" open style="margin-bottom:16px;">
            <sl-icon slot="icon" name="info-circle"></sl-icon>
            This user's password is local to this node only. To allow this user to log in on other nodes,
            add them on each node separately.
        </sl-alert>
        <form id="form-add-user" onsubmit="return false;">
            <div style="margin-bottom:16px;">
                <sl-input id="add-username" name="username" label="Username" required autocomplete="off"></sl-input>
            </div>
            <div style="margin-bottom:16px;">
                <sl-input id="add-display-name" name="displayName" label="Display Name" required autocomplete="off" help-text="Leave blank to use Username"></sl-input>
            </div>
            <div style="margin-bottom:16px;">
                <sl-input id="add-password" name="password" label="Password" type="password" password-toggle required autocomplete="new-password"
                    help-text="At least 8 characters, with an uppercase letter, a lowercase letter, and a digit."></sl-input>
            </div>
            <div style="margin-bottom:16px;">
                <sl-select id="add-role" name="role" label="Role" value="user"
                    help-text="Custom roles carry their own folder rules — manage them on the Roles page.">
                    <sl-option value="superadmin">Superadmin</sl-option>
                    <sl-option value="user">User</sl-option>
                </sl-select>
            </div>
        </form>
        <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-add-user">Cancel</sl-button>
        <sl-button id="btn-add-user-submit" slot="footer" variant="primary">Create User</sl-button>
    </sl-dialog>

    <sl-dialog id="dlg-change-password" label="Change Password">
        <sl-alert id="change-password-error" variant="danger" closable style="display:none;margin-bottom:16px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            <span class="msg"></span>
        </sl-alert>
        <form id="form-change-password" onsubmit="return false;">
            <input type="hidden" id="cp-user-id" name="id" />
            <p id="cp-user-name" style="margin:0 0 16px;color:var(--text-secondary);"></p>
            <div style="margin-bottom:16px;">
                <sl-input id="cp-new-password" name="newPassword" label="New Password" type="password" password-toggle required autocomplete="new-password"
                    help-text="At least 8 characters, with an uppercase letter, a lowercase letter, and a digit."></sl-input>
            </div>
        </form>
        <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-change-password">Cancel</sl-button>
        <sl-button id="btn-change-password-submit" slot="footer" variant="primary">Change Password</sl-button>
    </sl-dialog>

    <sl-dialog id="dlg-edit-user" label="Edit User">
        <sl-alert id="edit-user-error" variant="danger" closable style="display:none;margin-bottom:16px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            <span class="msg"></span>
        </sl-alert>
        <form id="form-edit-user" onsubmit="return false;">
            <input type="hidden" id="edit-user-id" name="id" />
            <div style="margin-bottom:16px;">
                <sl-input id="edit-display-name" name="displayName" label="Display Name" required></sl-input>
            </div>
            <div style="margin-bottom:16px;">
                <sl-select id="edit-role" name="role" label="Role">
                    <sl-option value="superadmin">Superadmin</sl-option>
                    <sl-option value="user">User</sl-option>
                </sl-select>
                <p id="edit-role-hint" class="text-muted text-sm" style="margin:6px 0 0 0;display:none;"></p>
                <p id="edit-promote-hint" class="text-muted text-sm" style="margin:6px 0 0 0;display:none;">
                    They keep their current password. The key that lets them unlock this server is
                    created the next time they log in — until then they can work as usual, but
                    can't unlock the server if it's locked.
                </p>
            </div>
            <div style="margin-bottom:8px;">
                <sl-checkbox id="edit-chat-access">Can use AI chat</sl-checkbox>
                <p id="edit-chat-access-hint" class="text-muted text-sm" style="margin:4px 0 0 0;display:none;">
                    AI chat is currently disabled for everyone (see Admin page) — this setting has no effect until it's re-enabled globally.
                </p>
            </div>
        </form>
        <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-edit-user">Cancel</sl-button>
        <sl-button id="btn-edit-user-submit" slot="footer" variant="primary">Save</sl-button>
    </sl-dialog>

    <partial name="_FolderAccessDialog" />

</div>
</div>

<script src="/js/pages/users.js"></script>
