@page
@model BeeMemoryBank.Web.Pages.ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<partial name="_Sidebar" />

<div id="page-content">
<div class="main-content">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
        <h2 style="margin:0;"><sl-icon name="person-circle"></sl-icon> Profile</h2>
    </div>

    <div class="card" style="max-width:500px;margin-bottom:32px;">
        <div style="margin-bottom:20px;">
            <div style="margin-bottom:12px;">
                <sl-input label="Username" value="@Model.Username" readonly autocomplete="username"></sl-input>
            </div>
            <div style="margin-bottom:12px;">
                <sl-input label="Display Name" value="@Model.DisplayName" readonly></sl-input>
            </div>
            <div><strong>Role:</strong>
                <sl-badge variant="@(Model.Role == "superadmin" ? "warning" : "neutral")" pill style="margin-left:6px;">
                    @Model.Role
                </sl-badge>
            </div>
        </div>

        <sl-divider></sl-divider>

        <h3 style="margin:16px 0 12px;"><sl-icon name="key"></sl-icon> Change Password</h3>

        <sl-alert variant="warning" open style="margin-bottom:12px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            Changing your password updates the local key wrapping on <strong>this node only</strong>.
            Other nodes in the network keep their own passwords independently — there is no way to push a
            password change across the network. To prevent access from another node, sign in there and
            change the password directly. To rotate the network's encryption key, use
            <strong>Admin &rarr; Network &rarr; Rotate DEK</strong>.
        </sl-alert>

        <div id="cp-alert" style="display:none;margin-bottom:16px;"></div>

        <div style="margin-bottom:16px;">
            <sl-input id="cp-old" label="Current Password" type="password" password-toggle required autocomplete="current-password"></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="cp-new" label="New Password" type="password" password-toggle required autocomplete="new-password"></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="cp-confirm" label="Confirm New Password" type="password" password-toggle required autocomplete="new-password"></sl-input>
        </div>
        <sl-button id="btn-change-password" variant="primary">
            <sl-icon slot="prefix" name="check-lg"></sl-icon> Change Password
        </sl-button>
    </div>

    <!-- Auto-approve writes: opt-in, skips the human-in-the-loop Allow/Deny gate for write tools.
         Lives here rather than on the Admin page because it is a PER-USER preference (finding M1):
         on Admin it both read as a node-wide switch and was unreachable for everyone except
         superadmins, even though the setting it writes has always been the caller's own. ACL, the
         destructive-op cap and audit tagging still apply in full — only the pause is skipped. -->
    <h3 style="margin:16px 0 12px;"><sl-icon name="robot"></sl-icon> AI Chat</h3>
    <div class="card" style="margin-bottom:24px;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:16px;">
        <div>
            <strong>Auto-approve writes</strong>
            <p class="text-muted text-sm" style="margin:4px 0 0 0;">
                When on, the AI creates/edits/deletes your notes immediately without asking for Allow/Deny.
                Applies to your account only. Folder access rules and the destructive-action limit still
                apply, and every change stays visible in article history / restorable.
            </p>
        </div>
        <sl-switch id="chat-auto-approve-toggle" style="flex-shrink:0;"></sl-switch>
    </div>

    <!-- AI Agents Section -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <h3 style="margin:0;"><sl-icon name="robot"></sl-icon> My AI Agents</h3>
        <sl-button size="small" variant="success" id="btn-open-create-agent">
            <sl-icon slot="prefix" name="plus-lg"></sl-icon> Create Agent
        </sl-button>
    </div>

    <div class="card" style="padding:0;overflow:hidden;">
        <div id="agents-loading" style="padding:20px;text-align:center;">
            <sl-spinner style="font-size:1.5rem;"></sl-spinner>
        </div>
        <div id="agents-empty" style="padding:40px;text-align:center;display:none;">
            <sl-icon name="robot" style="font-size:2rem;color:var(--text-secondary);display:block;margin-bottom:12px;"></sl-icon>
            <p class="text-muted">You have no agents</p>
        </div>
        <div id="agents-table-container" style="display:none;">
            <table class="version-table" style="margin:0;">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>API Key Prefix</th>
                        <th>
                            Auto-unlock
                            <sl-tooltip content="Whether this key can wake a locked node by itself. Only a superadmin's agent can — an ordinary account's agent only works while the vault is already unlocked by someone else.">
                                <sl-icon name="info-circle"></sl-icon>
                            </sl-tooltip>
                        </th>
                        <th>Created</th>
                        <th>Last Access</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="agents-tbody"></tbody>
            </table>
        </div>
        <div style="padding:12px 16px;border-top:1px solid var(--border);background:var(--bg-app);font-size:0.85rem;color:var(--text-secondary);">
            <sl-icon name="info-circle"></sl-icon> <span id="agents-count">Used 0 of 20 agents</span>
        </div>
    </div>
</div>
</div>

<!-- Create Agent Dialog -->
<sl-dialog id="dlg-create-agent" label="Create New AI Agent">
    <div style="margin-bottom:16px;">
        <sl-input id="agent-name" label="Name" placeholder="e.g. VS Code Plugin" required></sl-input>
    </div>
    <div style="margin-bottom:16px;">
        <sl-input id="agent-desc" label="Description" placeholder="Optional"></sl-input>
    </div>
    <sl-button slot="footer" variant="default" id="btn-cancel-create-agent">Cancel</sl-button>
    <sl-button slot="footer" variant="primary" id="btn-do-create-agent">Create</sl-button>
</sl-dialog>

<!-- One-time Secret Dialog -->
<sl-dialog id="dlg-show-secret" label="Agent API Key Created" no-header-close>
    <sl-alert variant="warning" open style="margin-bottom:16px;">
        <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
        Copy this key now. For your security, it will <strong>never be shown again</strong>.
    </sl-alert>
    <div style="background:var(--bg-app);padding:16px;border-radius:8px;border:1px solid var(--border);position:relative;margin-bottom:16px;">
        <code id="secret-key-code" style="word-break:break-all;font-family:var(--font-mono);font-size:0.9rem;display:block;padding-right:40px;"></code>
        <sl-icon-button name="clipboard" label="Copy" id="btn-copy-secret"
            style="position:absolute;top:10px;right:10px;font-size:1.2rem;">
        </sl-icon-button>
    </div>

    <!-- Filled in by JS from the create response's canAutoUnlock flag: whether this
         particular key can wake a locked node by itself (superadmin owner) or only works
         while the vault is already unlocked (every other owner). -->
    <sl-alert id="secret-autounlock-note" variant="neutral" open style="margin-bottom:16px;">
        <sl-icon slot="icon" name="info-circle"></sl-icon>
        <span id="secret-autounlock-text"></span>
    </sl-alert>

    <sl-divider></sl-divider>

    <p class="text-muted" style="font-size:0.85rem;margin:16px 0 12px;">
        <sl-icon name="plug"></sl-icon> These snippets already contain your key and server URL — paste them into your AI client now, while the key is visible.
    </p>

    <div style="margin-bottom:16px;">
        <div style="margin-bottom:6px;font-size:0.85rem;font-weight:600;"><sl-icon name="terminal"></sl-icon> Claude Code (CLI)</div>
        <div style="background:var(--bg-app);padding:16px;border-radius:8px;border:1px solid var(--border);position:relative;">
            <code id="mcp-cli-code" style="word-break:break-all;white-space:pre-wrap;font-family:var(--font-mono);font-size:0.85rem;display:block;padding-right:40px;"></code>
            <sl-icon-button name="clipboard" label="Copy"
                style="position:absolute;top:10px;right:10px;font-size:1.2rem;"
                data-copy-target="mcp-cli-code" data-copy-msg="Claude Code command copied">
            </sl-icon-button>
        </div>
    </div>

    <div>
        <div style="margin-bottom:6px;font-size:0.85rem;font-weight:600;"><sl-icon name="braces"></sl-icon> Cursor / Windsurf (<code>.cursor/mcp.json</code>)</div>
        <div style="background:var(--bg-app);padding:16px;border-radius:8px;border:1px solid var(--border);position:relative;">
            <code id="mcp-cursor-code" style="white-space:pre;font-family:var(--font-mono);font-size:0.85rem;display:block;padding-right:40px;overflow-x:auto;"></code>
            <sl-icon-button name="clipboard" label="Copy"
                style="position:absolute;top:10px;right:10px;font-size:1.2rem;"
                data-copy-target="mcp-cursor-code" data-copy-msg="Cursor config copied">
            </sl-icon-button>
        </div>
    </div>

    <sl-button slot="footer" variant="primary" id="btn-close-secret-dlg">I have copied it</sl-button>
</sl-dialog>

<script type="application/json" id="profile-page-data">
    {"mcpBaseUrl":@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.McpBaseUrl))}
</script>
<script src="/js/pages/profile.js"></script>
