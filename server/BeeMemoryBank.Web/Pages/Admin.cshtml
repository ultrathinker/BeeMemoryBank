        </sl-button>
    </div>
    <div class="card" style="padding:0;overflow:hidden;margin-bottom:24px;">
        <table class="version-table">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Prefix</th>
                    <th>Priority</th>
                    <th>Enabled</th>
                    <th>Status</th>
                    <th>Last used</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody id="chat-keys-body">
                <tr><td colspan="7" class="text-muted text-sm" style="text-align:center;padding:16px;">Loading…</td></tr>
            </tbody>
