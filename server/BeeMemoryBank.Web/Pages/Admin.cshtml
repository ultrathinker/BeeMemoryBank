    <!-- Models -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:8px;flex-wrap:wrap;">
        <strong>Model catalogue</strong>
        <sl-button size="small" variant="primary" id="btn-add-chat-model">
            <sl-icon slot="prefix" name="plus-lg"></sl-icon> Add model
        </sl-button>
    </div>
    <div class="card" style="padding:0;overflow:hidden;margin-bottom:24px;">
        <table class="version-table">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Model ID</th>
                    <th style="text-align:center;">Text</th>
                    <th style="text-align:center;">Vision</th>
                    <th style="text-align:center;">Image gen</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody id="chat-models-body">
                <tr><td colspan="6" class="text-muted text-sm" style="text-align:center;padding:16px;">Loading…</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Default models: three pinned-default dropdowns. "Default" = oldest model with the matching
         property; picking a specific model pins it. -->
    <div style="margin-bottom:8px;">
        <strong>Default models</strong>
        <p class="text-muted text-sm" style="margin:4px 0 0 0;">
            Pin a specific model for each role, or leave on "Default" to use the oldest model with
            that capability. The text model is the entry point for every chat turn.
        </p>
    </div>
    <div class="card" style="padding:16px;margin-bottom:32px;">
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
            <div>
                <label style="font-size:0.85rem;color:var(--text-secondary);display:block;margin-bottom:4px;">Default text model</label>
                <sl-select id="default-text-model" size="small" placeholder="Default">
                    <sl-option value="">Default</sl-option>
                </sl-select>
            </div>
            <div>
                <label style="font-size:0.85rem;color:var(--text-secondary);display:block;margin-bottom:4px;">Default vision model</label>
                <sl-select id="default-vision-model" size="small" placeholder="Default">
                    <sl-option value="">Default</sl-option>
                </sl-select>
            </div>
            <div>
                <label style="font-size:0.85rem;color:var(--text-secondary);display:block;margin-bottom:4px;">Default image-gen model</label>
                <sl-select id="default-imagegen-model" size="small" placeholder="Default">
                    <sl-option value="">Default</sl-option>
                </sl-select>
            </div>
        </div>
        <p id="chat-defaults-hint" class="text-muted" style="font-size:0.74rem;margin:8px 0 0 0;"></p>
    </div>

    <sl-dialog id="dlg-add-chat-key" label="Add OpenRouter key" style="--width:480px;">
        <div style="margin-bottom:16px;">
            <sl-input id="chat-key-label" label="Label" placeholder="e.g. personal" required></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="chat-key-value" label="API key" type="password" password-toggle placeholder="sk-or-…" required autocomplete="off"></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="chat-key-priority" label="Priority (lower = used first)" type="number" value="0"></sl-input>
        </div>
        <p class="text-muted text-sm">The key needs an unlocked vault to be encrypted. Copy the full key now — it won't be shown again.</p>
        <sl-button slot="footer" type="button" variant="default" onclick="document.getElementById('dlg-add-chat-key').hide()">Cancel</sl-button>
        <sl-button slot="footer" type="button" variant="primary" id="btn-save-chat-key">
            <sl-icon slot="prefix" name="save"></sl-icon> Save key
        </sl-button>
    </sl-dialog>

    <sl-dialog id="dlg-add-chat-model" label="Add model" style="--width:480px;">
        <div style="margin-bottom:16px;">
            <sl-input id="chat-model-id" label="Model ID" placeholder="e.g. openai/gpt-4o-mini" required></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="chat-model-label" label="Label" placeholder="e.g. GPT-4o mini" required></sl-input>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px;">
            <sl-checkbox id="chat-model-text" checked>Text</sl-checkbox>
            <sl-checkbox id="chat-model-vision">Vision (accepts images)</sl-checkbox>
            <sl-checkbox id="chat-model-imagegen">Image generation</sl-checkbox>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="chat-model-context" label="Context window (tokens)" type="number" min="1"
                      placeholder="e.g. 128000 (optional)"></sl-input>
        </div>
        <p class="text-muted text-sm">A model can have multiple capabilities (e.g. both text AND vision).</p>
        <sl-button slot="footer" type="button" variant="default" onclick="document.getElementById('dlg-add-chat-model').hide()">Cancel</sl-button>
        <sl-button slot="footer" type="button" variant="primary" id="btn-save-chat-model">
            <sl-icon slot="prefix" name="save"></sl-icon> Save model
        </sl-button>
    </sl-dialog>

    <sl-dialog id="dlg-edit-chat-model" label="Edit model" style="--width:480px;">
        <div style="margin-bottom:16px;">
            <sl-input id="edit-chat-model-id" label="Model ID" disabled></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="edit-chat-model-label" label="Label" disabled></sl-input>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px;">
            <sl-checkbox id="edit-chat-model-text">Text</sl-checkbox>
            <sl-checkbox id="edit-chat-model-vision">Vision (accepts images)</sl-checkbox>
            <sl-checkbox id="edit-chat-model-imagegen">Image generation</sl-checkbox>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="edit-chat-model-context" label="Context window (tokens)" type="number" min="1"
                      placeholder="e.g. 128000 (optional)"></sl-input>
        </div>
        <p class="text-muted text-sm">Toggle which capabilities this model provides.</p>
        <sl-button slot="footer" type="button" variant="default" onclick="document.getElementById('dlg-edit-chat-model').hide()">Cancel</sl-button>
        <sl-button slot="footer" type="button" variant="primary" id="btn-save-edit-chat-model">
            <sl-icon slot="prefix" name="save"></sl-icon> Save
        </sl-button>
    </sl-dialog>

    <script>
    (function () {
        var keysBody = document.getElementById('chat-keys-body');
        var modelsBody = document.getElementById('chat-models-body');

        // Quotes included: esc() feeds a title="..." attribute a few lines down, where an
        // unescaped " would end the attribute early.
        function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }
        function rel(t) {
            if (!t) return '—';
            var d = new Date(t); if (isNaN(d)) return esc(t);
            var s = (Date.now() - d.getTime()) / 1000;
            if (s < 60) return Math.floor(s) + 's ago';
            if (s < 3600) return Math.floor(s / 60) + 'm ago';
            if (s < 86400) return Math.floor(s / 3600) + 'h ago';
            return Math.floor(s / 86400) + 'd ago';
        }

        // Phase 4: derives the per-key circuit-breaker status shown in the Status column. A disabled
        // key (HTTP 401 → enabled=0) shows red; a cooling-down key (402/429 → future disabled_until)
        // shows amber with its retry time; otherwise Active (green), with any last_error as a tooltip.
        function keyStatus(k) {
            if (!k.enabled) return { label: 'Disabled', color: 'var(--sl-color-danger-600)' };
            if (k.disabledUntil) {
                var d = new Date(k.disabledUntil);
                if (!isNaN(d) && d.getTime() > Date.now()) {
                    return { label: 'Cooling down', color: 'var(--sl-color-warning-600)', title: 'auto-retries after ' + rel(k.disabledUntil) };
                }
            }
            if (k.lastError) return { label: 'Active', color: 'var(--sl-color-success-600)', title: 'last error: ' + k.lastError };
            return { label: 'Active', color: 'var(--sl-color-success-600)' };
        }

        function loadKeys() {
            fetch('/api-proxy/chat/keys').then(function (r) { return r.json(); }).then(function (keys) {
                if (!Array.isArray(keys) || keys.length === 0) {
                    keysBody.innerHTML = '<tr><td colspan="7" class="text-muted text-sm" style="text-align:center;padding:16px;">No keys. Add one to enable AI chat.</td></tr>';
                    return;
                }
                keysBody.innerHTML = keys.map(function (k) {
                    var st = keyStatus(k);
                    return '<tr>'
                        + '<td><strong>' + esc(k.label) + '</strong></td>'
                        + '<td><code class="text-sm">' + esc(k.keyPrefix) + '</code></td>'
                        + '<td class="text-muted text-sm">' + (k.priority || 0) + '</td>'
                        + '<td><sl-switch data-key-id="' + k.id + '" ' + (k.enabled ? 'checked' : '') + ' onsl-change="toggleChatKey"></sl-switch></td>'
                        + '<td class="text-sm" style="color:' + st.color + ';"' + (st.title ? ' title="' + esc(st.title) + '"' : '') + '>' + st.label + '</td>'
                        + '<td class="text-muted text-sm">' + rel(k.lastUsedAt) + '</td>'
                        + '<td style="text-align:right;"><sl-icon-button name="trash" label="Delete" data-key-id="' + k.id + '" onclick="deleteChatKey(this.dataset.keyId)"></sl-icon-button></td>'
                        + '</tr>';
                }).join('');
            }).catch(function () { keysBody.innerHTML = '<tr><td colspan="7" class="text-muted text-sm">Failed to load keys.</td></tr>'; });
        }

        var modelsCache = [];
        var editingModelId = null;

        function loadModels() {
            fetch('/api-proxy/chat/models/all').then(function (r) { return r.json(); }).then(function (models) {
                modelsCache = Array.isArray(models) ? models : [];
                if (modelsCache.length === 0) {
                    modelsBody.innerHTML = '<tr><td colspan="6" class="text-muted text-sm" style="text-align:center;padding:16px;">No models. Add one (with the Text capability) to enable AI chat.</td></tr>';
                    loadDefaults();
                    return;
                }
                modelsBody.innerHTML = modelsCache.map(function (m) {
                    return '<tr>'
                        + '<td><strong>' + esc(m.label) + '</strong></td>'
                        + '<td><code class="text-sm">' + esc(m.modelId) + '</code></td>'
                        + '<td style="text-align:center;"><sl-checkbox disabled ' + (m.isText ? 'checked' : '') + '></sl-checkbox></td>'
                        + '<td style="text-align:center;"><sl-checkbox disabled ' + (m.isVision ? 'checked' : '') + '></sl-checkbox></td>'
                        + '<td style="text-align:center;"><sl-checkbox disabled ' + (m.isImageGen ? 'checked' : '') + '></sl-checkbox></td>'
                        + '<td style="text-align:right;">'
                        + '<sl-icon-button name="pencil" label="Edit" data-edit-id="' + m.id + '" onclick="editChatModel(this.dataset.editId)"></sl-icon-button>'
                        + '<sl-icon-button name="trash" label="Delete" data-model-id="' + m.id + '" onclick="deleteChatModel(this.dataset.modelId)"></sl-icon-button>'
                        + '</td>'
                        + '</tr>';
                }).join('');
                loadDefaults();
            }).catch(function () { modelsBody.innerHTML = '<tr><td colspan="6" class="text-muted text-sm">Failed to load models.</td></tr>'; });
        }

        window.editChatModel = function (id) {
            var m = modelsCache.find(function (x) { return x.id === id; });
            if (!m) return;
            document.getElementById('edit-chat-model-id').value = m.modelId || '';
            document.getElementById('edit-chat-model-label').value = m.label || '';
            document.getElementById('edit-chat-model-text').checked = !!m.isText;
            document.getElementById('edit-chat-model-vision').checked = !!m.isVision;
            document.getElementById('edit-chat-model-imagegen').checked = !!m.isImageGen;
            document.getElementById('edit-chat-model-context').value = m.contextWindow || '';
            editingModelId = id;
            document.getElementById('dlg-edit-chat-model').show();
        };
        window.toggleChatKey = function (e) {
            var id = e.target.dataset.keyId; var enabled = e.target.checked;
            fetch('/api-proxy/chat/keys/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ enabled: enabled }) })
                .catch(function () { loadKeys(); });
        };
        window.deleteChatKey = function (id) {
            if (!confirm('Delete this API key?')) return;
            fetch('/api-proxy/chat/keys/' + id, { method: 'DELETE' }).then(function () { loadKeys(); });
        };
        window.deleteChatModel = function (id) {
            if (!confirm('Delete this model?')) return;
            fetch('/api-proxy/chat/models/' + id, { method: 'DELETE' }).then(function () { loadModels(); });
        };

        document.getElementById('btn-add-chat-key').addEventListener('click', function () {
            document.getElementById('dlg-add-chat-key').show();
        });
        document.getElementById('btn-save-chat-key').addEventListener('click', function () {
            var label = document.getElementById('chat-key-label').value.trim();
            var key = document.getElementById('chat-key-value').value.trim();
            var priority = parseInt(document.getElementById('chat-key-priority').value || '0', 10) || 0;
            if (!label || !key) return;
            fetch('/api-proxy/chat/keys', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ label: label, apiKey: key, priority: priority }) })
                .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
                .then(function (res) {
                    document.getElementById('dlg-add-chat-key').hide();
                    document.getElementById('chat-key-label').value = '';
                    document.getElementById('chat-key-value').value = '';
                    document.getElementById('chat-key-priority').value = '0';
                    loadKeys();
                    if (res.ok && res.body && res.body.apiKey) {
                        alert('Key created. Copy it now — it will not be shown again:\n\n' + res.body.apiKey);
                    } else if (!res.ok) {
                        alert((res.body && res.body.error) ? res.body.error : 'Failed to save key (is the vault unlocked?).');
                    }
                });
        });

        document.getElementById('btn-add-chat-model').addEventListener('click', function () {
            document.getElementById('dlg-add-chat-model').show();
        });
        document.getElementById('btn-save-chat-model').addEventListener('click', function () {
            var modelIdInput = document.getElementById('chat-model-id');
            var modelId = modelIdInput.value.trim();
            var label = document.getElementById('chat-model-label').value.trim();
            var isText = document.getElementById('chat-model-text').checked;
            var isVision = document.getElementById('chat-model-vision').checked;
            var isImageGen = document.getElementById('chat-model-imagegen').checked;
            var cw = parseInt(document.getElementById('chat-model-context').value, 10);
            // OpenRouter model slugs are always clean "provider/model-name" strings — they never
            // contain spaces or colons. Reject a Model ID that does (someone pasted a label by
            // mistake) with an inline error. Clear any prior custom validity so the field isn't
            // stuck invalid.
            modelIdInput.setCustomValidity('');
            if (/[\s:]/.test(modelId)) {
                modelIdInput.setCustomValidity('Model ID must not contain spaces — use the exact slug from OpenRouter, like provider/model-name');
                modelIdInput.reportValidity();
                return;
            }
            if (!modelId || !label) return;
            fetch('/api-proxy/chat/models', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ modelId: modelId, label: label, isText: isText, isVision: isVision, isImageGen: isImageGen, contextWindow: (isNaN(cw) || cw <= 0) ? null : cw }) })
                .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
                .then(function (res) {
                    document.getElementById('dlg-add-chat-model').hide();
                    document.getElementById('chat-model-id').value = '';
                    document.getElementById('chat-model-label').value = '';
                    document.getElementById('chat-model-text').checked = true;
                    document.getElementById('chat-model-vision').checked = false;
                    document.getElementById('chat-model-imagegen').checked = false;
                    document.getElementById('chat-model-context').value = '';
                    if (res.ok) { loadModels(); } else { alert((res.body && res.body.error) ? res.body.error : 'Failed to save model.'); }
                });
        });

        document.getElementById('btn-save-edit-chat-model').addEventListener('click', function () {
            if (!editingModelId) return;
            var isText = document.getElementById('edit-chat-model-text').checked;
            var isVision = document.getElementById('edit-chat-model-vision').checked;
            var isImageGen = document.getElementById('edit-chat-model-imagegen').checked;
            var editCw = parseInt(document.getElementById('edit-chat-model-context').value, 10);
            // ALWAYS include contextWindow (null when blank) — unconditional set lets blank CLEAR it.
            fetch('/api-proxy/chat/models/' + editingModelId, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isText: isText, isVision: isVision, isImageGen: isImageGen, contextWindow: (isNaN(editCw) || editCw <= 0) ? null : editCw })
            }).then(function (r) {
                document.getElementById('dlg-edit-chat-model').hide();
                editingModelId = null;
                if (r.ok) loadModels();
            });
        });

        // Default-model dropdowns: each lists only models with the matching capability, sorted
        // oldest-first (matching the grid), with "Default" as the first option (= oldest-with-property).
        // Guard against saveDefaults() firing from PROGRAMMATIC value assignment during
        // loadDefaults()'s initial population (Shoelace's <sl-select> can emit its own
        // 'sl-change' as a side effect of setting .value right after dynamically appending
        // <sl-option> children — the exact same class of bug already fixed once in the /AI
        // chat model picker). Without this guard, loading the page could immediately re-PATCH
        // whatever partial/empty values the three selects happen to hold mid-population,
        // clobbering an already-saved pin with null — which is what "my selection doesn't
        // stick" looks like from the user's side.
        var suppressSaveDefaults = false;

        function loadDefaults() {
            fetch('/api-proxy/chat/settings/defaults').then(function (r) { return r.ok ? r.json() : { defaultTextModelId: null, defaultVisionModelId: null, defaultImageGenModelId: null }; }).then(function (defaults) {
                suppressSaveDefaults = true;
                populateDefaultSelect('default-text-model', function (m) { return m.isText; }, defaults.defaultTextModelId);
                populateDefaultSelect('default-vision-model', function (m) { return m.isVision; }, defaults.defaultVisionModelId);
                populateDefaultSelect('default-imagegen-model', function (m) { return m.isImageGen; }, defaults.defaultImageGenModelId);
                // Re-enable saving on the NEXT tick, after Shoelace's own internal reconciliation
                // (and any 'sl-change' it dispatches as a side effect of the .value assignments
                // above) has had a chance to run and settle.
                setTimeout(function () { suppressSaveDefaults = false; }, 0);
            }).catch(function () {});
        }
        function populateDefaultSelect(selectId, filterFn, selectedId) {
            var sel = document.getElementById(selectId);
            if (!sel) return;
            sel.innerHTML = '';
            var defOpt = document.createElement('sl-option');
            defOpt.value = '';
            defOpt.textContent = 'Default (oldest)';
            sel.appendChild(defOpt);
            modelsCache.filter(filterFn).forEach(function (m) {
                var opt = document.createElement('sl-option');
                opt.value = m.id;
                opt.textContent = m.label || m.modelId;
                sel.appendChild(opt);
            });
            // Defer setting .value to the next tick — right after appendChild, Shoelace's
            // <sl-option> custom elements may not be upgraded/registered yet, so an immediate
            // .value assignment can silently fail to select anything (reverting to the first
            // option, "Default"). This is the same timing gotcha already worked around
            // elsewhere in this app for dynamically populated <sl-select> lists.
            setTimeout(function () { sel.value = selectedId || ''; }, 0);
        }
        function saveDefaults() {
            if (suppressSaveDefaults) return;
            fetch('/api-proxy/chat/settings/defaults', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    defaultTextModelId: (document.getElementById('default-text-model').value || '') || null,
                    defaultVisionModelId: (document.getElementById('default-vision-model').value || '') || null,
                    defaultImageGenModelId: (document.getElementById('default-imagegen-model').value || '') || null
                })
            }).catch(function () {});
        }
        ['default-text-model', 'default-vision-model', 'default-imagegen-model'].forEach(function (id) {
            var sel = document.getElementById(id);
            if (sel) sel.addEventListener('sl-change', saveDefaults);
        });

        // "Allow AI chat for users" node-wide kill switch toggle.
        var chatEnabledToggle = document.getElementById('chat-globally-enabled-toggle');
        function loadChatEnabled() {
            if (!chatEnabledToggle) return;
            fetch('/api-proxy/chat/settings/chat-enabled', { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : { chatGloballyEnabled: true }; })
                .then(function (data) { chatEnabledToggle.checked = !!data.chatGloballyEnabled; })
                .catch(function () {});
        }
        if (chatEnabledToggle) {
            chatEnabledToggle.addEventListener('sl-change', function () {
                var enabled = chatEnabledToggle.checked;
                fetch('/api-proxy/chat/settings/chat-enabled', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: enabled })
                }).catch(function () { chatEnabledToggle.checked = !enabled; });
            });
        }
        loadChatEnabled();

        // Issue a new recovery key. The key comes back exactly once — nothing stores it in
        // recoverable form — so it goes straight into a dialog the admin must copy from, never
        // into a log line or a page the browser might restore later.
        var issueRecoveryBtn = document.getElementById('issue-recovery-key-btn');
        if (issueRecoveryBtn) {
            issueRecoveryBtn.addEventListener('click', function () {
                if (!confirm('Issue a new recovery key?\n\nIt will be shown once and cannot be retrieved afterwards. Existing passwords keep working.')) return;
                issueRecoveryBtn.loading = true;
                fetch('/api-proxy/keys/add-recovery', { method: 'POST', headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
                    .then(function (res) {
                        if (res.ok && res.body && res.body.recoveryKey) {
                            document.getElementById('recovery-key-value').value = res.body.recoveryKey;
                            document.getElementById('recovery-key-dialog').show();
                        } else {
                            alert((res.body && res.body.error) ? res.body.error : 'Failed to issue a recovery key (is the vault unlocked?).');
                        }
                    })
                    .catch(function () { alert('Failed to issue a recovery key.'); })
                    .finally(function () { issueRecoveryBtn.loading = false; });
            });

            document.getElementById('recovery-key-copy').addEventListener('click', function () {
                var input = document.getElementById('recovery-key-value');
                navigator.clipboard.writeText(input.value).catch(function () {});
            });
            document.getElementById('recovery-key-close').addEventListener('click', function () {
                // Clear the field on close so the key doesn't linger in the DOM.
                document.getElementById('recovery-key-value').value = '';
                document.getElementById('recovery-key-dialog').hide();
            });
        }

        // "Generate embeddings on this node" toggle (tbl_node_identity.can_generate_embeddings).
        var embeddingsToggle = document.getElementById('embeddings-enabled-toggle');
        function loadEmbeddingsEnabled() {
            if (!embeddingsToggle) return;
            fetch('/api-proxy/admin/search/embeddings-enabled', { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : { enabled: false }; })
                .then(function (data) { embeddingsToggle.checked = !!data.enabled; })
                .catch(function () {});
        }
        if (embeddingsToggle) {
            embeddingsToggle.addEventListener('sl-change', function () {
                var enabled = embeddingsToggle.checked;
                fetch('/api-proxy/admin/search/embeddings-enabled', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: enabled })
                }).then(function (r) {
                    if (!r.ok) embeddingsToggle.checked = !enabled;
                }).catch(function () { embeddingsToggle.checked = !enabled; });
            });
        }
        loadEmbeddingsEnabled();

        // "Backfill pending now" button — triggers a one-shot background drain instead of
        // waiting out the default 5-minute-tick / 50-item-batch schedule.
        var embeddingsBackfillBtn = document.getElementById('embeddings-backfill-btn');
        var embeddingsBackfillStatus = document.getElementById('embeddings-backfill-status');
        if (embeddingsBackfillBtn) {
            embeddingsBackfillBtn.addEventListener('click', function () {
                embeddingsBackfillBtn.loading = true;
                if (embeddingsBackfillStatus) embeddingsBackfillStatus.textContent = '';
                fetch('/api-proxy/admin/search/embeddings/backfill', { method: 'POST' })
                    .then(function (r) {
                        if (embeddingsBackfillStatus) {
                            embeddingsBackfillStatus.textContent = r.ok
                                ? 'Started — check server logs or the metrics below in a bit.'
                                : 'Failed to start backfill.';
                        }
                    })
                    .catch(function () {
                        if (embeddingsBackfillStatus) embeddingsBackfillStatus.textContent = 'Failed to start backfill.';
                    })
                    .finally(function () { embeddingsBackfillBtn.loading = false; });
            });
        }

        // Web session (cookie) settings: duration + sliding-expiration toggle.
        var sessionHoursInput = document.getElementById('session-expire-hours');
        var sessionSlidingToggle = document.getElementById('session-sliding-toggle');
        var sessionSaveBtn = document.getElementById('btn-save-session-settings');
        var sessionSavedMsg = document.getElementById('session-settings-saved-msg');
        function loadSessionSettings() {
            if (!sessionHoursInput || !sessionSlidingToggle) return;
            fetch('/api-proxy/session/settings', { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : { expireHours: 48, slidingExpiration: true }; })
                .then(function (data) {
                    sessionHoursInput.value = data.expireHours;
                    sessionSlidingToggle.checked = !!data.slidingExpiration;
                })
                .catch(function () {});
        }
        if (sessionSaveBtn) {
            sessionSaveBtn.addEventListener('click', function () {
                if (sessionSavedMsg) sessionSavedMsg.style.display = 'none';
                var hours = parseInt(sessionHoursInput.value, 10);
                if (!hours || hours < 1 || hours > 720) {
                    alert('Session duration must be between 1 and 720 hours.');
                    return;
                }
                sessionSaveBtn.loading = true;
                fetch('/api-proxy/session/settings', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ expireHours: hours, slidingExpiration: sessionSlidingToggle.checked })
                })
                    .then(function (r) {
                        sessionSaveBtn.loading = false;
                        if (r.ok && sessionSavedMsg) {
                            sessionSavedMsg.style.display = 'inline';
                            setTimeout(function () { sessionSavedMsg.style.display = 'none'; }, 3000);
                        } else if (!r.ok) {
                            alert('Failed to save session settings.');
                        }
                    })
                    .catch(function () {
                        sessionSaveBtn.loading = false;
                        alert('Failed to save session settings.');
                    });
            });
        }
        loadSessionSettings();

        // Branding: the product name in the header / tab title.
        var brandInput = document.getElementById('brand-name-input');
        var brandPreview = document.getElementById('brand-preview');
        var brandSaveBtn = document.getElementById('btn-save-branding');
        var brandResetBtn = document.getElementById('btn-reset-branding');
        var brandSavedMsg = document.getElementById('branding-saved-msg');
        var brandDefault = 'Bee Memory Bank';

        function renderBrandPreview() {
            if (!brandPreview) return;
            var typed = (brandInput && brandInput.value || '').trim();
            brandPreview.textContent = typed || brandDefault;
        }
        function loadBranding() {
            if (!brandInput) return;
            fetch('/api-proxy/branding', { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (data) {
                    if (!data) return;
                    brandDefault = data.defaultName || brandDefault;
                    brandInput.placeholder = brandDefault;
                    // Only a real override goes into the box; the default stays a placeholder so
                    // "empty means default" reads the same way it behaves.
                    brandInput.value = data.isCustom ? data.name : '';
                    renderBrandPreview();
                })
                .catch(function () {});
        }
        function saveBranding(name) {
            if (brandSavedMsg) brandSavedMsg.style.display = 'none';
            brandSaveBtn.loading = true;
            fetch('/api-proxy/branding', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: name })
            })
                .then(function (r) {
                    brandSaveBtn.loading = false;
                    if (!r.ok) {
                        return r.json().catch(function () { return {}; }).then(function (e) {
                            alert(e.error || 'Failed to save the product name.');
                        });
                    }
                    return r.json().then(function (data) {
                        brandInput.value = data.isCustom ? data.name : '';
                        renderBrandPreview();
                        // Update the header live so the change is visible without a reload.
                        var headerSpan = document.querySelector('.app-logo span');
                        if (headerSpan) headerSpan.textContent = data.name;
                        if (brandSavedMsg) {
                            brandSavedMsg.style.display = 'inline';
                            setTimeout(function () { brandSavedMsg.style.display = 'none'; }, 3000);
                        }
                    });
                })
                .catch(function () {
                    brandSaveBtn.loading = false;
                    alert('Failed to save the product name.');
                });
        }
        if (brandInput) brandInput.addEventListener('sl-input', renderBrandPreview);
        if (brandSaveBtn) brandSaveBtn.addEventListener('click', function () { saveBranding((brandInput.value || '').trim()); });
        if (brandResetBtn) brandResetBtn.addEventListener('click', function () { brandInput.value = ''; saveBranding(''); });
        loadBranding();

        loadKeys();
        loadModels();
    })();
    </script>

    <!-- Change Node URL Dialog -->
    <sl-dialog id="dlg-change-url" label="Change Node URL">
        <form method="post" asp-page-handler="ChangeNodeAddress" class="sl-form">
            <input type="hidden" id="change-url-node-id" name="nodeId" />
            <p id="change-url-node-name" style="margin:0 0 16px;color:var(--text-secondary);"></p>
            <div style="margin-bottom:16px;">
                <sl-input id="change-url-input" name="newApiAddress" label="New API Address" placeholder="https://example.com" required></sl-input>
            </div>
            <div style="margin-bottom:16px;">
                <sl-input name="password" label="Master Password" type="password" password-toggle required autocomplete="off"></sl-input>
            </div>
            <sl-button type="button" slot="footer" variant="default" onclick="document.getElementById('dlg-change-url').hide()">Cancel</sl-button>
            <sl-button type="submit" slot="footer" variant="primary">
                <sl-icon slot="prefix" name="link-45deg"></sl-icon> Change URL
            </sl-button>
        </form>
    </sl-dialog>

    <!-- Lock Server -->
    <h3 style="margin-bottom:12px;"><sl-icon name="lock"></sl-icon> Lock Server</h3>
    <div class="card mt-md" style="margin-bottom:32px;max-width:480px;">
        <p class="text-muted text-sm" style="margin-bottom:12px;">
            Locking erases the master encryption key from memory. Everyone is immediately logged out —
            you, other users, MCP agents, and mobile apps. No one can read or edit articles until any
            superadmin logs back in — after that the server is open for everyone again.
            Use this when you're leaving the server unattended and want to make sure nobody — not even
            an already-connected agent — can access your data while you're away.
            Think of it as pulling the key out of the lock and taking it with you.
        </p>
        <sl-button variant="warning" size="small" href="/Lock"
            onclick="return confirm('Lock the server? The decryption key will be cleared from memory. All users will need to re-authenticate to access encrypted content.')">
            <sl-icon slot="prefix" name="lock"></sl-icon> Lock Server
        </sl-button>
    </div>

    <!-- Branding -->
    <h3 style="margin-bottom:12px;"><sl-icon name="type"></sl-icon> Branding</h3>
    <div class="card mt-md" style="margin-bottom:32px;max-width:480px;">
        <p class="text-muted text-sm" style="margin-bottom:12px;">
            The name shown in the header next to the logo and in the browser tab title. Leave it
            empty to keep the built-in name. This is a setting of THIS node only — it is never
            synced, so every installation can carry its own company name.
        </p>
        <sl-input id="brand-name-input" size="small" maxlength="40" clearable
                  label="Product name" style="max-width:320px;"></sl-input>
        <p class="text-muted text-sm" style="margin:10px 0 16px;">
            Header preview: <strong id="brand-preview" style="color:var(--text-primary);"></strong>
        </p>
        <sl-button id="btn-save-branding" variant="primary" size="small">
            <sl-icon slot="prefix" name="check-lg"></sl-icon> Save
        </sl-button>
        <sl-button id="btn-reset-branding" variant="text" size="small">Reset to default</sl-button>
        <span id="branding-saved-msg" style="display:none;margin-left:8px;color:var(--sl-color-success-600);font-size:0.85rem;">Saved.</span>
    </div>

    <!-- Web Session -->
    <h3 style="margin-bottom:12px;"><sl-icon name="clock-history"></sl-icon> Web Session</h3>
    <div class="card mt-md" style="margin-bottom:32px;max-width:480px;">
        <p class="text-muted text-sm" style="margin-bottom:12px;">
            Controls how long a browser login (the "bee_session" cookie) stays valid before
            requiring a fresh sign-in on the <a href="/Login">Login</a> page. This has no effect
            on AI/MCP agents connected via a bearer token — those never use or extend this cookie.
        </p>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
            <sl-input id="session-expire-hours" type="number" min="1" max="720" size="small"
                label="Session duration (hours)" style="max-width:160px;"></sl-input>
        </div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
            <sl-switch id="session-sliding-toggle" size="small">Extend on activity (sliding)</sl-switch>
        </div>
        <p class="text-muted text-sm" style="margin-bottom:12px;">
            When sliding is on, each web visit resets the countdown — someone active every day
            never gets logged out. When off, the session expires exactly N hours after login no
            matter how often they visit.
        </p>
        <p class="text-muted text-sm" style="margin-bottom:12px;">
            Changes apply only to new logins going forward — sessions already signed in keep the
            expiry they were given at sign-in and are not shortened or revoked.
        </p>
        <sl-button id="btn-save-session-settings" variant="primary" size="small">
            <sl-icon slot="prefix" name="check-lg"></sl-icon> Save
        </sl-button>
        <span id="session-settings-saved-msg" style="display:none;margin-left:8px;color:var(--sl-color-success-600);font-size:0.85rem;">Saved.</span>
    </div>

    <!-- Hard Delete -->
    <h3 style="margin-bottom:12px;"><sl-icon name="trash"></sl-icon> Hard Delete</h3>
    <div class="card mt-md" style="margin-bottom:32px;max-width:480px;">
        <p class="text-muted text-sm" style="margin-bottom:12px;">
            Physically remove folders, articles, and their media from this node and propagate
            the deletion to every synced node. Unlike regular delete (which keeps items in the
            trash), this is permanent and cannot be undone. Use for cleaning up junk imports
            or data that must not persist anywhere.
        </p>
        <sl-button variant="danger" size="small" href="/HardDelete">
            <sl-icon slot="prefix" name="trash"></sl-icon> Open Hard Delete
        </sl-button>
    </div>

    <!-- Reset node -->
    <h3 style="margin-bottom:12px;"><sl-icon name="exclamation-octagon"></sl-icon> Reset This Node</h3>
    <div class="card mt-md" style="margin-bottom:32px;max-width:640px;">
        <p class="text-muted text-sm" style="margin-bottom:12px;">
            Wipes every article, folder, user, key and sync-state row on this node and returns it to
            the first-run Setup screen, ready to initialize a new vault or join a different network.
            Other nodes are not affected — but this node loses its identity, so it rejoins as a new
            one. Use it when the sync status says "Snapshot required", or when repurposing the node.
        </p>
        <sl-alert variant="danger" open style="margin-bottom:16px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            <strong>This cannot be undone.</strong> If this node holds the only copy of anything,
            take a snapshot first.
        </sl-alert>
        <form method="post" asp-page-handler="ResetNode"
              onsubmit="return confirm('This will DELETE all local articles, folders, users, keys, and sync state on this node. Proceed?');">
            @Html.AntiForgeryToken()
            <sl-input name="masterPassword" type="password" required password-toggle
                      label="Master password (confirmation)" placeholder="required to confirm"
                      style="margin-bottom:12px;"></sl-input>
            <sl-button type="submit" variant="danger" size="small">
                <sl-icon slot="prefix" name="trash"></sl-icon> Wipe this node
            </sl-button>
        </form>
        <p class="text-muted text-sm" style="margin-top:12px;">
            Locked out and unable to sign in at all? Run <code>bmb init reset</code> on the host
            instead — see <em>docs/deployment.md</em>.
        </p>
    </div>

    @if (Model.OsAutoUnlockSupported)
    {
        <h3 style="margin-bottom:12px;"><sl-icon name="key"></sl-icon> OS Auto-Unlock</h3>
        <div class="card mt-md" style="margin-bottom:32px;max-width:640px;">
            <p class="text-muted text-sm" style="margin-bottom:12px;">
                Lets this node unlock itself automatically on startup — no password prompt — using a
                secret protected by Windows DPAPI under this Windows user account. Useful for a
                server node that runs unattended.
            </p>
            <sl-alert variant="warning" open style="margin-bottom:16px;">
                <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                <strong>Anyone with access to this Windows user account will be able to open the
                vault without a password</strong> once this is enabled. Only enable it on a machine
                you trust and control physically.
            </sl-alert>

            @if (Model.OsAutoUnlockEnabled)
            {
                <sl-badge variant="success" pill style="margin-bottom:12px;">enabled</sl-badge>
                <form method="post" asp-page-handler="DisableAutoUnlock">
                    <sl-button type="submit" variant="danger" size="small"
                               onclick="return confirm('Disable OS auto-unlock? The vault will require a password on next unlock.')">
                        <sl-icon slot="prefix" name="key"></sl-icon> Disable auto-unlock
                    </sl-button>
                </form>
            }
            else
            {
                <sl-badge variant="neutral" pill style="margin-bottom:12px;">not configured</sl-badge>
                <form method="post" asp-page-handler="EnableAutoUnlock">
                    <sl-button type="submit" variant="primary" size="small"
                               onclick="return confirm('Enable OS auto-unlock? Anyone with access to this Windows account will be able to open the vault without a password.')">
                        <sl-icon slot="prefix" name="key"></sl-icon> Enable auto-unlock
                    </sl-button>
                </form>
            }
        </div>
    }

    <!-- DEK Rotation -->
    @{
        var dekActive = Model.DekRotationProgress != null
            && Model.DekRotationProgress.CurrentStep != "Idle"
            && Model.DekRotationProgress.CurrentStep != "Completed"
            && Model.DekRotationProgress.CurrentStep != "Failed";
    }

    <h3 style="margin-bottom:12px;"><sl-icon name="shield-lock"></sl-icon> DEK Rotation</h3>
    <div class="card mt-md" style="margin-bottom:32px;max-width:640px;">
        <p class="text-muted text-sm" style="margin-bottom:12px;">
            Rotates the encryption key for all article bodies, versions, and media. Generates a new master DEK;
            old DEK is securely retired.
        </p>

        @if (Model.ShowRecoveryKeyReminder)
        {
            <sl-alert variant="warning" open style="margin-bottom:16px;">
                <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                <strong>Issue a new recovery key!</strong> All previous recovery keys were invalidated by the DEK rotation.
                Use the button below.
            </sl-alert>
        }

        <div style="margin-bottom:16px;">
            <sl-button id="issue-recovery-key-btn" variant="default" size="small">
                <sl-icon slot="prefix" name="key"></sl-icon>
                Issue new recovery key
            </sl-button>
            <div class="text-muted text-sm" style="margin-top:6px;">
                A recovery key unlocks the vault if the master password is lost. It is shown once and cannot be
                retrieved later — only a key derived from it is stored. Issuing a new one does not invalidate
                existing passwords.
            </div>
        </div>

        <sl-dialog id="recovery-key-dialog" label="Your new recovery key" style="--width:560px;">
            <sl-alert variant="warning" open style="margin-bottom:12px;">
                <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                Save this now. It is not stored anywhere in recoverable form and will never be shown again.
            </sl-alert>
            <sl-input id="recovery-key-value" readonly filled></sl-input>
            <sl-button slot="footer" id="recovery-key-copy" variant="primary">
                <sl-icon slot="prefix" name="clipboard"></sl-icon>
                Copy
            </sl-button>
            <sl-button slot="footer" id="recovery-key-close">Done</sl-button>
        </sl-dialog>

        @if (dekActive)
        {
            <sl-alert variant="warning" open style="margin-bottom:16px;">
                <sl-icon slot="icon" name="arrow-clockwise"></sl-icon>
                <strong>DEK Rotation in Progress</strong>
                <div style="margin-top:8px;">
                    <strong>Step:</strong> @Model.DekRotationProgress!.CurrentStep
                </div>
                <sl-progress-bar value="@Model.DekRotationProgress.PercentageComplete" style="margin-top:8px;"></sl-progress-bar>
                @if (!string.IsNullOrEmpty(Model.DekRotationProgress.StatusMessage))
                {
                    <p class="text-muted text-sm" style="margin-top:4px;">@Model.DekRotationProgress.StatusMessage</p>
                }
                @if (!string.IsNullOrEmpty(Model.DekRotationProgress.ErrorMessage))
                {
                    <p style="color:var(--sl-color-danger-600);margin-top:4px;">@Model.DekRotationProgress.ErrorMessage</p>
                }
                @if (Model.DekRotationProgress.EventId.HasValue)
                {
                    <form method="post" asp-page-handler="CancelDekRotation" style="margin-top:12px;">
                        <input type="hidden" name="eventId" value="@Model.DekRotationProgress.EventId" />
                        <sl-button type="submit" variant="danger" size="small">
                            <sl-icon slot="prefix" name="x-lg"></sl-icon> Cancel Rotation
                        </sl-button>
                    </form>
                }
                <p class="text-muted text-sm" style="margin-top:8px;">This page refreshes automatically every 3 seconds.</p>
            </sl-alert>
        }
        else if (!string.IsNullOrEmpty(Model.DekRotationCommitId))
        {
            <sl-alert variant="primary" open style="margin-bottom:16px;">
                <sl-icon slot="icon" name="info-circle"></sl-icon>
                <strong>DEK rotation proposed.</strong> Enter your master password to confirm and begin re-encryption.
            </sl-alert>
            <form method="post" asp-page-handler="AcceptDekRotation" style="margin-bottom:16px;">
                <input type="hidden" name="commitEventId" value="@Model.DekRotationCommitId" />
                <div style="margin-bottom:12px;">
                    <sl-input name="masterPassword" label="Master Password" type="password" password-toggle required autocomplete="off"></sl-input>
                </div>
                <div style="display:flex;gap:8px;">
                    <sl-button type="submit" variant="warning">
                        <sl-icon slot="prefix" name="shield-lock"></sl-icon> Confirm DEK Rotation
                    </sl-button>
                    <form method="post" asp-page-handler="CancelDekRotation" style="display:inline;">
                        <input type="hidden" name="eventId" value="@Model.DekRotationCommitId" />
                        <sl-button type="submit" variant="default">Cancel</sl-button>
                    </form>
                </div>
            </form>
        }
        else if (Model.DekRotationProgress?.CurrentStep == "Failed")
        {
            <sl-alert variant="danger" open style="margin-bottom:16px;">
                <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                <strong>DEK rotation failed.</strong>
                @if (!string.IsNullOrEmpty(Model.DekRotationProgress.ErrorMessage))
                {
                    <p style="margin-top:4px;">@Model.DekRotationProgress.ErrorMessage</p>
                }
            </sl-alert>
            <div style="display:flex;gap:8px;">
                <sl-button variant="warning" size="small" onclick="document.getElementById('dlg-dek-rotation').show()">
                    <sl-icon slot="prefix" name="shield-lock"></sl-icon> Retry Rotation
                </sl-button>
                @if (Model.DekRotationProgress?.EventId != null)
                {
                    <form method="post" asp-page-handler="CancelDekRotation" style="display:inline;">
                        <input type="hidden" name="eventId" value="@Model.DekRotationProgress.EventId" />
                        <sl-button type="submit" variant="default" size="small">Dismiss</sl-button>
                    </form>
                }
            </div>
        }
        else
        {
            <sl-button variant="warning" size="small" onclick="document.getElementById('dlg-dek-rotation').show()">
                <sl-icon slot="prefix" name="shield-lock"></sl-icon> Rotate DEK
            </sl-button>
        }
    </div>

    @if (dekActive)
    {
        <script>
            if (!window._dekRotationRefreshing) {
                window._dekRotationRefreshing = true;
                setTimeout(function() { location.reload(); }, 3000);
            }
        </script>
    }

    @* Backfill Orphan Media Links — hidden. Auto-link on save covers new uploads;
       if sync ever brings orphan rows, uncomment this block and the matching
       blocks in Web/Program.cs + Api/Endpoints/AdminEndpoints.cs + Api/Program.cs.
    <h3 style="margin-bottom:12px;"><sl-icon name="link-45deg"></sl-icon> Backfill Orphan Media Links</h3>
    <div class="card mt-md" style="margin-bottom:32px;max-width:480px;">
        <p class="text-muted text-sm" style="margin-bottom:12px;">
            Scan all articles for media references (images) and link any orphan media records to their
            parent article. This fixes media uploaded before the article was saved.
        </p>
        <sl-button variant="primary" size="small" id="btn-backfill-media">
            <sl-icon slot="prefix" name="link-45deg"></sl-icon> Backfill Media Links
        </sl-button>
    </div>
    *@

    <!-- Restore Snapshot Dialog -->
    <sl-dialog id="dlg-restore-snapshot" label="Restore Snapshot">
        <sl-alert variant="danger" open style="margin-bottom:16px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            <strong>Warning:</strong> This will replace ALL data with the snapshot. Current data will be lost.
            The server will be temporarily unavailable during restore.
        </sl-alert>
        <input type="hidden" name="fileName" id="restore-file-name" />
        <div style="margin-bottom:16px;">
            <sl-input name="masterPassword" id="restore-master-password" label="Master Password" type="password" password-toggle required autocomplete="off"></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-checkbox name="createBackupFirst" id="restore-backup-checkbox" checked>Create backup before restore</sl-checkbox>
        </div>
        <sl-button slot="footer" variant="default" onclick="document.getElementById('dlg-restore-snapshot').hide()">Cancel</sl-button>
        <sl-button type="button" slot="footer" variant="danger" id="btn-restore-confirm">
            <sl-icon slot="prefix" name="arrow-counterclockwise"></sl-icon> Restore
        </sl-button>
        <sl-button type="button" slot="footer" variant="default" onclick="document.getElementById('dlg-restore-snapshot').hide()">Cancel</sl-button>
    </sl-dialog>

    <!-- DEK Rotation Dialog -->
    <sl-dialog id="dlg-dek-rotation" label="Rotate DEK" style="--width:580px;">
        <sl-alert variant="danger" open style="margin-bottom:16px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            <strong>This is a destructive, network-wide operation.</strong>
        </sl-alert>
        <p style="margin-bottom:12px;">Before proceeding, understand the impact:</p>
        <ul style="margin:0 0 16px 20px;line-height:1.8;">
            <li>All article bodies, version history, conflict copies, and media files will be <strong>re-encrypted</strong> (one big transaction; node enters maintenance for the duration).</li>
            <li>All <strong>agents</strong> will be deleted — they must be regenerated after rotation completes (their API keys cannot be re-wrapped server-side).</li>
            <li>All <strong>other user key slots</strong> will be removed — other users will need to re-register their passwords against the new DEK.</li>
            <li>All <strong>recovery keys</strong> will be invalidated — issue a new recovery key immediately after rotation.</li>
            <li>A <strong>pre-rotation snapshot</strong> is created automatically before any destructive change.</li>
            <li><strong>Do not close the browser, restart the node, or interrupt the process</strong> until it completes.</li>
        </ul>
        <form method="post" asp-page-handler="ProposeDekRotation" class="sl-form">
            <div style="margin-bottom:16px;">
                <sl-input name="masterPassword" label="Master Password" type="password" password-toggle required autocomplete="off"></sl-input>
            </div>
            <sl-button type="button" slot="footer" variant="default" onclick="document.getElementById('dlg-dek-rotation').hide()">Cancel</sl-button>
            <sl-button type="submit" slot="footer" variant="danger">
                <sl-icon slot="prefix" name="shield-lock"></sl-icon> Propose DEK Rotation
            </sl-button>
            <sl-button type="button" slot="footer" variant="default" onclick="document.getElementById('dlg-dek-rotation').hide()">Cancel</sl-button>
        </form>
    </sl-dialog>

    <!-- Search diagnostics (WP-18) — latency / volume / index health.
         Numbers only: timings, request counts, coarse result-count buckets, and the already-public
         IndexBuilder / SearchIndexRuntimeState diagnostics. No query text or content is ever shown. -->
    <sl-details summary="Search diagnostics" style="margin-top:32px;margin-bottom:32px;">
        <div style="max-width:920px;">
            <p class="text-muted text-sm" style="margin-bottom:16px;">
                Latency (p50/p95) and request volume per search type over a rolling in-memory window,
                plus the encrypted search-index health signals. Counts and timings only — no query
                text, titles, or article content is ever recorded or shown here.
            </p>

            <div class="card" style="padding:12px 16px;margin-bottom:20px;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <sl-switch id="embeddings-enabled-toggle" size="small">Generate embeddings on this node</sl-switch>
                </div>
                <p class="text-muted text-sm" style="margin:8px 0 0;">
                    Controls whether this node computes its own semantic embeddings (needed for meaning-based
                    and hybrid search). Embeddings never sync between nodes — each node that wants semantic
                    search must generate its own. Turning this off saves CPU but semantic/hybrid search will
                    silently fall back to exact-match only on this node.
                </p>
                <div style="display:flex;align-items:center;gap:10px;margin-top:12px;">
                    <sl-button id="embeddings-backfill-btn" size="small">
                        <sl-icon slot="prefix" name="arrow-repeat"></sl-icon> Backfill pending now
                    </sl-button>
                    <span id="embeddings-backfill-status" class="text-muted text-sm"></span>
                </div>
                <p class="text-muted text-sm" style="margin:8px 0 0;">
                    Drains pending embeddings and search-index entries immediately in the background instead
                    of waiting out the normal drip-fed schedule (default: one batch every 5 minutes). Useful
                    right after turning the toggle above on, or after a large import. Safe to click more than
                    once — it's a no-op if nothing is pending.
                </p>
            </div>

            @if (Model.SearchMetrics is { } searchMetricsEl)
            {
                var latency = searchMetricsEl.TryGetProperty("latency", out var latEl) && latEl.ValueKind == JsonValueKind.Array ? latEl.EnumerateArray().ToArray() : Array.Empty<JsonElement>();

                <h4 style="margin:8px 0;"><sl-icon name="stopwatch"></sl-icon> Latency &amp; volume</h4>
                @if (latency.Length == 0)
                {
                    <p class="text-muted text-sm" style="margin-bottom:16px;">No searches recorded yet in this process's lifetime.</p>
                }
                else
                {
                    <div class="card" style="padding:0;overflow:hidden;margin-bottom:16px;">
                        <table class="version-table">
                            <thead>
                                <tr>
                                    <th>Search type</th>
                                    <th>Requests</th>
                                    <th>p50 (ms)</th>
                                    <th>p95 (ms)</th>
                                    <th colspan="4" style="text-align:center;">Result counts</th>
                                </tr>
                                <tr>
                                    <th></th><th></th><th></th><th></th>
                                    <th style="text-align:center;">0</th>
                                    <th style="text-align:center;">1–10</th>
                                    <th style="text-align:center;">11–100</th>
                                    <th style="text-align:center;">100+</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in latency)
                                {
                                    var label = row.TryGetProperty("searchType", out var stEl) && stEl.ValueKind == JsonValueKind.String ? stEl.GetString() : "?";
                                    <tr>
                                        <td><strong>@label</strong></td>
                                        <td>@(row.TryGetProperty("count", out var cEl) ? cEl.GetInt64().ToString("N0") : "0")</td>
                                        <td>@FmtMs(row, "p50Ms")</td>
                                        <td>@FmtMs(row, "p95Ms")</td>
                                        <td style="text-align:center;">@BucketVal(row, "bucketZero")</td>
                                        <td style="text-align:center;">@BucketVal(row, "bucketOneToTen")</td>
                                        <td style="text-align:center;">@BucketVal(row, "bucketElevenToHundred")</td>
                                        <td style="text-align:center;">@BucketVal(row, "bucketOverHundred")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (searchMetricsEl.TryGetProperty("indexHealth", out var ihEl) && ihEl.ValueKind == JsonValueKind.Object)
                {
                    var warm = ihEl.TryGetProperty("warmStartAttempted", out var wEl) && wEl.ValueKind == JsonValueKind.False;
                    <h4 style="margin:8px 0;"><sl-icon name="hdd-stack"></sl-icon> Encrypted search index</h4>
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px 24px;margin-bottom:8px;">
                        <div><span class="text-muted text-sm">Sealed segments</span><br><strong>@GetInt(ihEl, "sealedSegmentCount")</strong></div>
                        <div><span class="text-muted text-sm">Hot buffer docs</span><br><strong>@GetInt(ihEl, "hotBufferCount")</strong></div>
                        <div><span class="text-muted text-sm">Warm-start run</span><br>
                            @if (warm)
                            {
                                <sl-badge variant="warning" pill>not yet</sl-badge>
                            }
                            else
                            {
                                <sl-badge variant="success" pill>yes</sl-badge>
                            }
                        </div>
                        <div><span class="text-muted text-sm">Lifetime seals</span><br><strong>@GetInt(ihEl, "sealCount")</strong></div>
                        <div><span class="text-muted text-sm">Lifetime merges</span><br><strong>@GetInt(ihEl, "mergeCount")</strong></div>
                    </div>
                    <p class="text-muted text-sm" style="margin-top:8px;">
                        @if (warm)
                        {
                            <text>The index has not been warm-started from disk yet this session; it builds as pending articles are processed.</text>
                        }
                        else
                        {
                            <text>The index was warm-started from persisted segments (or a rebuild was triggered) this session.</text>
                        }
                    </p>
                }
            }
            else
            {
                <sl-alert variant="warning" open>
                    <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                    Search diagnostics are unavailable (the API returned no data — the session may be locked or the request lacked admin rights).
                </sl-alert>
            }
        </div>
    </sl-details>

    @{
        // Local helpers keep the table markup above readable. They read from a JsonElement row/column
        // defensively (any missing field renders as "—" rather than throwing).
        static string FmtMs(JsonElement row, string prop)
        {
            if (row.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number)
            {
                var ms = v.GetDouble();
                return ms <= 0 ? "—" : ms.ToString("0.###");
            }
            return "—";
        }
        static string BucketVal(JsonElement row, string prop)
        {
            if (row.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number)
            {
                var n = v.GetInt64();
                return n == 0 ? "—" : n.ToString("N0");
            }
            return "—";
        }
        static string GetInt(JsonElement el, string prop)
        {
            if (el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number)
                return v.GetInt32().ToString("N0");
            return "—";
        }
    }

    <!-- Advanced settings — diagnostic / repair tools an admin rarely needs -->
    <sl-details summary="Advanced settings" style="margin-top:32px;margin-bottom:32px;">
        <h4 style="margin-top:8px;margin-bottom:8px;"><sl-icon name="share"></sl-icon> Verify tag graph</h4>
        <div style="max-width:640px;">
            @if (Model.GraphEdgeStats != null)
            {
                var s = Model.GraphEdgeStats.Value;
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px 24px;margin-bottom:16px;">
                    <div><span class="text-muted text-sm">Tags total</span><br><strong>@s.GetProperty("totalTags").GetInt64()</strong></div>
                    <div><span class="text-muted text-sm">Tags with connections</span><br><strong>@s.GetProperty("nodesWithEdges").GetInt64()</strong></div>
                    <div><span class="text-muted text-sm">Connections</span><br><strong>@s.GetProperty("totalEdgeRows").GetInt64()</strong></div>
                </div>
            }

            <p class="text-muted text-sm" style="margin-bottom:8px;">
                The system keeps a fast lookup of which tags appear together in your articles.
                That lookup powers the Graph view, related-tags suggestions, and tag search.
                It is updated automatically whenever you tag or untag an article — including
                changes that arrive from another node via sync, and after restoring a snapshot.
            </p>
            <p class="text-muted text-sm" style="margin-bottom:8px;">
                <strong>Pressing this button is always safe.</strong> If everything is in sync (the normal case),
                it just verifies and returns in milliseconds. If something is off, it rebuilds the lookup
                from scratch.
            </p>
            <p class="text-muted text-sm" style="margin-bottom:12px;">
                You usually never need to press it. Reasons you might:
            </p>
            <ul class="text-muted text-sm" style="margin:0 0 16px 20px;line-height:1.7;">
                <li>The Graph view shows fewer connections than you expect</li>
                <li>You manually edited the database</li>
                <li>You just want to confirm everything is consistent</li>
            </ul>

            <form method="post" asp-page-handler="RebuildGraph">
                <sl-button type="submit" variant="primary" size="small">
                    <sl-icon slot="prefix" name="arrow-repeat"></sl-icon> Verify and rebuild if needed
                </sl-button>
            </form>
        </div>
    </sl-details>

</div>

<script>
function confirmAutoAcceptToggle(switchEl) {
    var nodeId = switchEl.dataset.nodeId;
    var nodeName = switchEl.dataset.nodeName;
    var newValue = switchEl.checked;

    var proceed;
    if (newValue) {
        proceed = confirm(
            "Enable AUTO-RESTORE for peer '" + nodeName + "'?\n\n" +
            "When this peer initiates a snapshot restore, it will apply on this node WITHOUT confirmation. " +
            "Your articles, folders, and tags from after the restore point will be replaced.\n\n" +
            "Only enable for peers you fully trust (your own devices, your team's nodes). " +
            "For peers belonging to other people, keep this OFF.\n\n" +
            "Continue?"
        );
    } else {
        proceed = true;
    }

    if (!proceed) {
        switchEl.checked = !newValue;
        return;
    }

    document.getElementById("autoaccept-value-" + nodeId).value = newValue ? "true" : "false";
    document.getElementById("autoaccept-form-" + nodeId).submit();
}

function confirmAutoAcceptDekToggle(switchEl) {
    var nodeId = switchEl.dataset.nodeId;
    var nodeName = switchEl.dataset.nodeName;
    var newValue = switchEl.checked;

    var proceed;
    if (newValue) {
        proceed = confirm(
            "Enable AUTO-ACCEPT DEK ROTATION for peer '" + nodeName + "'?\n\n" +
            "When this peer initiates a DEK rotation, it will apply on this node WITHOUT confirmation. " +
            "ALL article bodies, versions, and media will be re-encrypted with a new key. " +
            "This is more destructive than snapshot restore.\n\n" +
            "Only enable for peers you fully trust (your own devices).\n\n" +
            "Continue?"
        );
    } else {
        proceed = true;
    }

    if (!proceed) {
        switchEl.checked = !newValue;
        return;
    }

    document.getElementById("autoaccept-dek-value-" + nodeId).value = newValue ? "true" : "false";
    document.getElementById("autoaccept-dek-form-" + nodeId).submit();
}

function openChangeUrl(nodeId, nodeName, currentUrl) {
    document.getElementById('change-url-node-id').value = nodeId;
    document.getElementById('change-url-node-name').textContent = 'Node: ' + nodeName;
    var input = document.getElementById('change-url-input');
    input.value = currentUrl;
    setTimeout(function() { input.value = currentUrl; }, 50);
    document.getElementById('dlg-change-url').show();
}

function openRestoreDialog(fileName) {
    document.getElementById('restore-file-name').value = fileName;
    document.getElementById('restore-snapshot-name-display').textContent = fileName;
    
    var networkRadio = document.querySelector('sl-radio[value="network"]');
    if (networkRadio) {
        if (fileName.startsWith('imported-')) {
            // Optional: for foreign networks disable network mode. In phase 6 it's based on DEK sentinel, but for now we don't have it.
            // Let's not disable it yet or base it on "imported-" as instructions suggested "для imported-badge: ...".
            // Actually, we'll keep it simple: just show dialog.
        }
    }
    
    document.getElementById('dlg-restore-snapshot').show();
}

(function() {
    var dropZone = document.getElementById('snapshot-upload-zone');
    var fileInput = document.getElementById('snapshot-file-input');
    if (dropZone && fileInput) {
        var pickFileBtn = document.getElementById('btn-pick-file');
        if (pickFileBtn) pickFileBtn.addEventListener('click', function() { fileInput.click(); });

        dropZone.addEventListener('dragover', function(e) { e.preventDefault(); dropZone.style.background = 'rgba(0,0,0,0.05)'; });
        dropZone.addEventListener('dragleave', function(e) { dropZone.style.background = ''; });
        dropZone.addEventListener('drop', function(e) {
            e.preventDefault();
            dropZone.style.background = '';
            if (e.dataTransfer.files.length) uploadSnapshotFile(e.dataTransfer.files[0]);
        });
        fileInput.addEventListener('change', function(e) {
            if (e.target.files.length) uploadSnapshotFile(e.target.files[0]);
        });
    }

    function uploadSnapshotFile(file) {
        var fd = new FormData();
        fd.append('file', file);
        document.getElementById('upload-progress').style.display = 'block';
        document.getElementById('upload-status').textContent = 'Uploading ' + file.name + '...';

        var xhr = new XMLHttpRequest();
        xhr.upload.addEventListener('progress', function(e) {
            if (e.lengthComputable) {
                document.getElementById('upload-progress-bar').value = (e.loaded / e.total) * 100;
            }
        });
        xhr.onload = function() {
            if (xhr.status === 200) {
                document.getElementById('upload-status').textContent = 'Uploaded successfully';
                setTimeout(function() { location.reload(); }, 1500);
            } else {
                document.getElementById('upload-status').textContent = 'Upload failed: ' + xhr.statusText;
            }
        };
        xhr.open('POST', '/Admin?handler=UploadSnapshot');
        xhr.setRequestHeader('RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        xhr.send(fd);
    }
    // Delegated event handlers on document — one-time registration via a window-level guard
    // survives SPA page swaps. Plain addEventListener on #btn-create-snapshot turned out to be
    // unreliable under SPA nav (first click did nothing; second click worked). Delegation on
    // document removes the whole class of attachment-timing issues: the listener is set once
    // on the first execution and never needs to be re-wired.

    function showProgress(label, detail) {
        var lbl = document.getElementById('snapshot-progress-label');
        var det = document.getElementById('snapshot-progress-detail');
        var dlg = document.getElementById('dlg-snapshot-progress');
        if (lbl) lbl.textContent = label;
        if (det) det.textContent = detail || '';
        if (dlg) dlg.show();
    }
    function hideProgress() {
        var dlg = document.getElementById('dlg-snapshot-progress');
        if (dlg) dlg.hide();
    }

    // Register document-level delegated listeners ONCE for the lifetime of the tab.
    // Re-attaching them on every SPA navigation would accumulate duplicate fetches.
    // Other per-element handlers below (restoreBtn, etc.) still re-wire on each IIFE run
    // because those elements are fresh after each SPA page swap.
    if (!window._adminSnapshotDelegated) {
        window._adminSnapshotDelegated = true;

        // Block the snapshot-progress dialog from being closed mid-creation.
        document.addEventListener('sl-request-close', function(e) {
            if (e.target && e.target.id === 'dlg-snapshot-progress') e.preventDefault();
        }, true);

        // Toggle the snapshot upload drop-zone via the explicit "Upload" button next to "Create".
        // Document-level delegation (same reason as #btn-create-snapshot below) — survives SPA nav.
        document.addEventListener('click', function(e) {
            var uploadToggle = e.target.closest('#btn-show-upload');
            if (!uploadToggle) return;
            var zone = document.getElementById('snapshot-upload-zone');
            if (!zone) return;
            zone.style.display = (zone.style.display === 'none' || !zone.style.display) ? 'block' : 'none';
        });

        document.addEventListener('click', function(e) {
            var createBtn = e.target.closest('#btn-create-snapshot');
            if (!createBtn) return;
            if (createBtn.hasAttribute('data-busy')) return;
            createBtn.setAttribute('data-busy', '');
            createBtn.loading = true;
            showProgress('Creating snapshot\u2026', 'This may take a while for large databases.');
            fetch('/api-proxy/snapshots', { method: 'POST' })
                .then(function(r) {
                    if (r.ok) {
                        window.location.reload();
                    } else {
                        hideProgress();
                        alert('Failed to create snapshot');
                    }
                })
                .catch(function() {
                    hideProgress();
                    alert('Network error');
                })
                .finally(function() {
                    createBtn.loading = false;
                    createBtn.removeAttribute('data-busy');
                });
        });
    }

    // Backfill Orphan Media Links handler — hidden, see matching HTML comment above.
    // var backfillBtn = document.getElementById('btn-backfill-media');
    // if (backfillBtn) {
    //     backfillBtn.addEventListener('click', function() {
    //         if (!confirm('Scan all articles and link orphan media records?')) return;
    //         backfillBtn.loading = true;
    //         fetch('/api-proxy/admin/backfill-media-links', { method: 'POST' })
    //             .then(function(r) { return r.json(); })
    //             .then(function(data) {
    //                 backfillBtn.loading = false;
    //                 alert('Linked ' + (data.linked || 0) + ' media records.');
    //             })
    //             .catch(function() {
    //                 backfillBtn.loading = false;
    //                 alert('Backfill failed.');
    //             });
    //     });
    // }

    var restoreBtn = document.getElementById('btn-restore-confirm');
    if (restoreBtn) {
        restoreBtn.addEventListener('click', function() {
            var fileName = document.getElementById('restore-file-name').value;
            var passwordInput = document.getElementById('restore-master-password');
            var password = passwordInput ? passwordInput.value : '';
            var backupCheckbox = document.getElementById('restore-backup-checkbox');
            var createBackup = backupCheckbox ? backupCheckbox.checked : true;
            var mode = document.getElementById('restore-mode').value;

            if (mode === 'network') {
                if (!confirm('Distribute snapshot state to entire network? This will affect all peers.')) return;
                
                restoreBtn.loading = true;
                document.getElementById('dlg-restore-snapshot').hide();
                showProgress('Initiating network restore\u2026', 'Please wait.');
                
                var fd = new FormData();
                fd.append('fileName', fileName);
                fetch('/Admin?handler=InitiateNetworkRestore', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: fd
                })
                .then(function(r) {
                    if (r.ok) return r.json();
                    throw new Error('Failed to initiate network restore');
                })
                .then(function(j) {
                    if (j && j.eventId) {
                        window.location.href = '/Login?restore=true';
                    } else {
                        hideProgress();
                        alert('Restore failed.');
                    }
                })
                .catch(function(e) {
                    hideProgress();
                    alert(e);
                })
                .finally(function() { restoreBtn.loading = false; });
                return;
            }

            if (!password) {
                alert('Master Password is required for standalone restore.');
                return;
            }
            restoreBtn.loading = true;

            document.getElementById('dlg-restore-snapshot').hide();

            var label = createBackup
                ? 'Restoring snapshot\u2026'
                : 'Restoring snapshot\u2026';
            var detail = createBackup
                ? 'Creating safety backup first, then restoring\u2026'
                : 'Restoring snapshot without backup\u2026';
            showProgress(label, detail);

            fetch('/Admin?handler=RestoreSnapshot', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: 'fileName=' + encodeURIComponent(fileName) +
                      '&masterPassword=' + encodeURIComponent(password) +
                      '&createBackupFirst=' + (createBackup ? 'true' : 'false') +
                      '&standaloneMode=' + (mode === 'standalone' ? 'true' : 'false')
            })
            .then(function(r) {
                if (r.redirected) {
                    window.location.href = r.url;
                } else if (r.ok) {
                    window.location.href = '/Login?restore=true';
                } else {
                    hideProgress();
                    alert('Restore failed');
                }
            })
            .catch(function() {
                hideProgress();
                alert('Network error');
            })
            .finally(function() { restoreBtn.loading = false; });
        });
    }
})();
</script>

<!-- Snapshot progress dialog (non-closable) -->
<sl-dialog id="dlg-snapshot-progress" no-header>
    <div style="text-align:center;padding:24px 0;">
        <sl-spinner style="font-size:2rem;margin-bottom:16px;"></sl-spinner>
        <p id="snapshot-progress-label" style="margin:0;color:var(--text-primary);font-size:1.05rem;font-weight:600;">Creating snapshot\u2026</p>
        <p id="snapshot-progress-detail" class="text-muted text-sm" style="margin-top:8px;">This may take a while for large databases.</p>
    </div>
</sl-dialog>

<!-- Check for updates dialog -->
<sl-dialog id="dlg-check-update" label="Check for Updates">
    <form method="post" asp-page-handler="CheckUpdate">
        <p class="text-muted text-sm" style="margin-bottom:16px;">
            Checking for updates requires a signed manifest. Since no feed is configured, you can paste manifest JSON and its Base64 signature below, or leave them empty to perform a dummy check (which will fail and allow you to test the Reset action).
        </p>
        <div style="margin-bottom:16px;">
            <sl-textarea name="manifestJson" label="Manifest JSON" placeholder='e.g. {"schemaVersion": 1, ...}'></sl-textarea>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input name="manifestSignatureBase64" label="Manifest Signature (Base64)" placeholder="e.g. AAAA..."></sl-input>
        </div>
        <sl-button slot="footer" variant="default" onclick="document.getElementById('dlg-check-update').hide()">Cancel</sl-button>
        <sl-button type="submit" slot="footer" variant="primary">
            <sl-icon slot="prefix" name="arrow-repeat"></sl-icon> Check
        </sl-button>
    </form>
</sl-dialog>

</div>
