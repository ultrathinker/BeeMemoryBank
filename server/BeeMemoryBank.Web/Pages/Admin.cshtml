    @if (Model.Agents != null && Model.Agents.Count > 0)
    {
        <div class="card" style="padding:0;overflow:hidden;margin-bottom:32px;">
            <table class="version-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Owner</th>
                        <th>API Key</th>
                        <th>
                            Auto-unlock
                            <sl-tooltip content="Whether this key can wake a locked node by itself. Only a superadmin's agent can \u2014 an ordinary user's agent only works while the vault is already unlocked by someone else.">
                                <sl-icon name="info-circle"></sl-icon>
                            </sl-tooltip>
                        </th>
