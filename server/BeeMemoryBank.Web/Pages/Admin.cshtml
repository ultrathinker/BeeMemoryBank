@page "/Admin"
@using System.Text.Json
@model BeeMemoryBank.Web.Pages.AdminModel
@{
    ViewData["Title"] = "Admin";
}

<partial name="_Sidebar" />

<div id="page-content">
<div class="main-content">
    <h2 style="margin-bottom:20px;"><sl-icon name="gear"></sl-icon> Admin</h2>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <sl-alert variant="success" open closable style="margin-bottom:20px;">
            <sl-icon slot="icon" name="check-circle"></sl-icon>
            @Model.SuccessMessage
        </sl-alert>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <sl-alert variant="danger" open closable style="margin-bottom:20px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            @Model.ErrorMessage
        </sl-alert>
    }

    @if (!string.IsNullOrEmpty(Model.GraphRebuildReport))
    {
        var graphDoc = JsonDocument.Parse(Model.GraphRebuildReport);
        var graphR = graphDoc.RootElement;
        var graphBefore = graphR.GetProperty("beforeEdgeRows").GetInt64();
        var graphAfter = graphR.GetProperty("afterEdgeRows").GetInt64();
        var graphExpected = graphR.GetProperty("expectedEdgeRows").GetInt64();
        var graphConsistent = graphR.GetProperty("wasConsistent").GetBoolean();
        var graphMs = graphR.GetProperty("durationMs").GetInt64();
        <sl-alert variant="@(graphConsistent ? "success" : "primary")" open closable style="margin-bottom:20px;">
            <sl-icon slot="icon" name="@(graphConsistent ? "check-circle" : "arrow-repeat")"></sl-icon>
            @if (graphConsistent)
            {
                <text>Tag graph integrity verified — everything is in sync (@graphBefore connections, checked in @graphMs ms).</text>
            }
            else
            {
                <text>Tag graph rebuilt: @graphBefore → @graphAfter connections (expected @graphExpected). Took @graphMs ms.</text>
            }
        </sl-alert>
    }

    @if (Model.PeerPendingRotations != null && Model.PeerPendingRotations.Count > 0)
    {
        foreach (var pending in Model.PeerPendingRotations)
        {
            // Use full event id (CSS-safe) for dialog id — avoids 8-char prefix collision
            // and ArgumentOutOfRangeException on short ids. (R1 reviewers H-2 / LOW-4.)
            var dlgId = "reject-dialog-" + pending.EventId.Replace("-", "");
            // Format the rotation timestamp to local time + ISO short — raw "...T...Z" was
            // confusing for non-technical admins. (Kilo R1 H-4.)
            var rotationLocal = DateTime.TryParse(pending.RotationTs,
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal,
                out var rotUtc)
                ? rotUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                : pending.RotationTs;
            <sl-alert variant="warning" open style="margin-bottom:20px;" role="alert" aria-live="polite">
                <sl-icon slot="icon" name="shield-exclamation"></sl-icon>
                <div>
                    <strong style="word-break:break-word;">@pending.OriginatorDisplayName</strong>
                    rotated their DEK on @rotationLocal.
                    To stay in sync, apply the rotation on this node.
                </div>
                <div style="display:flex;gap:8px;margin-top:12px;">
                    <form method="post" asp-page-handler="PeerAcceptDekRotation" style="display:inline;">
                        <input type="hidden" name="eventId" value="@pending.EventId" />
                        <sl-button type="submit" variant="primary" size="small">Apply</sl-button>
                    </form>
                    <sl-button variant="danger" size="small" onclick="document.getElementById('@dlgId').show()">
                        Reject — leave network
                    </sl-button>
                </div>
            </sl-alert>
            <sl-dialog id="@dlgId" label="Reject DEK rotation?">
                <p>Rejecting will permanently disconnect this node from the rotated network. Continue?</p>
                <form method="post" asp-page-handler="PeerRejectDekRotation" slot="footer" style="display:flex;gap:8px;justify-content:flex-end;">
                    <input type="hidden" name="eventId" value="@pending.EventId" />
                    <sl-button type="button" variant="default" autofocus onclick="this.closest('sl-dialog').hide()">Cancel</sl-button>
                    <sl-button type="submit" variant="danger">Reject rotation</sl-button>
                </form>
            </sl-dialog>
        }
    }

    <!-- Node Identity -->
    <h3 style="margin-bottom:12px;"><sl-icon name="fingerprint"></sl-icon> Node Identity</h3>
    @if (Model.Identity != null)
    {
        <div class="card" style="margin-bottom:32px;">
            <div class="article-meta">
                <span><strong>ID:</strong>
                    <span class="article-id-badge" title="Click to copy" data-bmb-copy="@Model.Identity.NodeId">
                        @Model.Identity.NodeId
                    </span>
                </span>
                <span><strong>Name:</strong> @Model.Identity.DisplayName</span>
            </div>
            <div style="margin-top:12px;">
                <label style="font-size:0.85rem;color:var(--text-secondary);">Ed25519 Public Key</label>
                <div style="display:flex;align-items:center;gap:8px;margin-top:4px;">
                    <code style="font-size:0.78rem;word-break:break-all;flex:1;" id="pubkey-val">@Model.Identity.Ed25519PublicKeyB64</code>
                    <sl-icon-button name="clipboard" label="Copy"
                        onclick="navigator.clipboard.writeText(document.getElementById('pubkey-val').textContent)">
                    </sl-icon-button>
                </div>
            </div>
        </div>
    }
    else
    {
        <sl-alert variant="warning" open style="margin-bottom:32px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            Could not retrieve node identity. Check API connection.
        </sl-alert>
    }

    <!-- Software Updates -->
    <h3 style="margin-bottom:12px;"><sl-icon name="arrow-up-circle"></sl-icon> Software Updates</h3>
    <div class="card mt-md" style="margin-bottom:32px;max-width:640px;">
        <p style="margin:0 0 12px;">
            Current version: <strong>v@(Model.CurrentVersion ?? "unknown")</strong>
        </p>

        @if (Model.UpdateStatus is { } st)
        {
            if (st.TryGetProperty("inProgress", out var ip) && ip.ValueKind == JsonValueKind.True)
            {
                <sl-alert variant="primary" open style="margin-bottom:12px;">
                    <sl-icon slot="icon" name="hourglass-split"></sl-icon>
                    An update is being applied now. The server will restart shortly — refresh this page in a moment.
                </sl-alert>
            }
            else if (st.TryGetProperty("result", out var res) && res.ValueKind == JsonValueKind.Object)
            {
                var rstatus = res.TryGetProperty("status", out var rs) && rs.ValueKind == JsonValueKind.String ? rs.GetString() : null;
                var rmsg = res.TryGetProperty("message", out var rm) && rm.ValueKind == JsonValueKind.String ? rm.GetString() : null;
                if (rstatus == "success")
                {
                    <sl-alert variant="success" open style="margin-bottom:12px;">
                        <sl-icon slot="icon" name="check-circle"></sl-icon>
                        Last update: @rmsg
                    </sl-alert>
                }
                else if (rstatus != null)
                {
                    <sl-alert variant="danger" open style="margin-bottom:12px;">
                        <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
                        Last update failed: @rmsg
                    </sl-alert>
                }
            }
        }

        @if (Model.UpdateCheck is { } uc)
        {
            var latest = uc.TryGetProperty("latest", out var l) && l.ValueKind == JsonValueKind.String ? l.GetString() : null;
            var avail = uc.TryGetProperty("updateAvailable", out var a) && a.ValueKind == JsonValueKind.True;
            var error = uc.TryGetProperty("error", out var e) && e.ValueKind == JsonValueKind.String ? e.GetString() : null;
            var notes = uc.TryGetProperty("notes", out var n) && n.ValueKind == JsonValueKind.String ? n.GetString() : null;

            if (error != null)
            {
                <sl-alert variant="warning" open style="margin-bottom:12px;">
                    <sl-icon slot="icon" name="exclamation-triangle"></sl-icon> @error
                </sl-alert>
            }
            else if (avail)
            {
                <sl-alert variant="success" open style="margin-bottom:12px;">
                    <sl-icon slot="icon" name="arrow-up-circle"></sl-icon>
                    Update available: <strong>v@latest</strong>@(string.IsNullOrEmpty(notes) ? "" : $" — {notes}")
                </sl-alert>
                <form method="post" asp-page-handler="ApplyUpdate" style="margin-bottom:8px;"
                      onsubmit="return confirm('Apply update to v@(latest)?\n\nThe server will fetch the new version, rebuild, and restart. This page will be unavailable for about 30–60 seconds.\n\nContinue?');">
                    <sl-button type="submit" variant="primary" size="small">
                        <sl-icon slot="prefix" name="download"></sl-icon> Apply update &amp; restart
                    </sl-button>
                </form>
            }
            else
            {
                <sl-alert variant="neutral" open style="margin-bottom:12px;">
                    <sl-icon slot="icon" name="check-circle"></sl-icon>
                    You are running the latest version@(string.IsNullOrEmpty(latest) ? "" : $" (v{latest})").
                </sl-alert>
            }
        }

        <form method="post" asp-page-handler="CheckUpdate" style="margin-top:4px;">
            <sl-button type="submit" variant="default" size="small">
                <sl-icon slot="prefix" name="arrow-repeat"></sl-icon> Check for updates
            </sl-button>
        </form>
    </div>

    <!-- Trusted Nodes -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <h3 style="margin:0;"><sl-icon name="people"></sl-icon> Trusted Nodes</h3>
        <span id="local-events-counter" class="text-muted text-sm"></span>
    </div>
    <script>
    (function() {
        fetch('/api-proxy/sync/status')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var el = document.getElementById('local-events-counter');
                if (el) el.textContent = 'Local events: ' + data.totalLocalEvents;
            })
            .catch(function() {});
    })();
    </script>
    @if (Model.Whitelist != null && Model.Whitelist.Count > 0)
    {
        <div class="card" style="padding:0;overflow:hidden;margin-bottom:32px;">
            <table class="version-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Node ID</th>
                        <th>API Address</th>
                        <th>Status</th>
                        <th>
                            Auto-restore
                            <sl-tooltip content="When ON, snapshot restores initiated by this peer apply automatically without your confirmation. The peer can replace your articles, folders, and tags. Enable only for peers you fully trust (e.g. your own devices). For peers that belong to other people, leave OFF — you'll get a UI prompt before restore applies." placement="top">
                                <sl-icon name="info-circle" style="color:var(--text-secondary);font-size:0.85rem;cursor:help;"></sl-icon>
                            </sl-tooltip>
                        </th>
                        <th>
                            Auto-DEK rotation
                            <sl-tooltip content="When ON, DEK rotation events initiated by this peer apply automatically without your confirmation. DEK rotation is more destructive than snapshot restore — it re-encrypts ALL article bodies, versions, and media with a new key. Enable only for peers you fully trust." placement="top">
                                <sl-icon name="info-circle" style="color:var(--text-secondary);font-size:0.85rem;cursor:help;"></sl-icon>
                            </sl-tooltip>
                        </th>
                        <th>Added</th>
                        <th>Last Sync</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Whitelist)
                    {
                        var isSelf = Model.Identity != null && entry.NodeId == Model.Identity.NodeId;
                        DateTime lastSync = DateTime.MinValue;
                        if (!isSelf && Model.NodeSyncStatus != null)
                            Model.NodeSyncStatus.TryGetValue(entry.NodeId, out lastSync);
                        <tr>
                            <td><strong>@entry.DisplayName</strong></td>
                            <td><code class="text-sm">@entry.NodeId.ToString()[..8]&hellip;</code></td>
                            <td class="text-muted text-sm">@(entry.ApiAddress ?? "\u2014")</td>
                            <td>
                                <sl-badge variant="@(entry.Status == "active" ? "success" : "neutral")" pill>
                                    @entry.Status
                                </sl-badge>
                                @if (entry.CanGenerateEmbeddings)
                                {
                                    <sl-badge variant="primary" pill style="margin-left:4px;">embeddings</sl-badge>
                                }
                            </td>
                            <td>
                                @if (!isSelf)
                                {
                                    <form method="post" asp-page-handler="SetAutoAcceptRestore" style="display:inline;" id="autoaccept-form-@entry.NodeId">
                                        <input type="hidden" name="nodeId" value="@entry.NodeId" />
                                        <input type="hidden" name="autoAccept" value="@((!entry.AutoAcceptRestore).ToString().ToLower())" id="autoaccept-value-@entry.NodeId" />
                                        <sl-switch
                                            @(entry.AutoAcceptRestore ? "checked" : "")
                                            data-node-id="@entry.NodeId"
                                            data-node-name="@entry.DisplayName"
                                            onsl-change="confirmAutoAcceptToggle">
                                        </sl-switch>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted text-sm">—</span>
                                }
                            </td>
                            <td>
                                @if (!isSelf)
                                {
                                    <form method="post" asp-page-handler="SetAutoAcceptDekRotation" style="display:inline;" id="autoaccept-dek-form-@entry.NodeId">
                                        <input type="hidden" name="nodeId" value="@entry.NodeId" />
                                        <input type="hidden" name="autoAccept" value="@((!entry.AutoAcceptDekRotation).ToString().ToLower())" id="autoaccept-dek-value-@entry.NodeId" />
                                        <sl-switch
                                            @(entry.AutoAcceptDekRotation ? "checked" : "")
                                            data-node-id="@entry.NodeId"
                                            data-node-name="@entry.DisplayName"
                                            onsl-change="confirmAutoAcceptDekToggle">
                                        </sl-switch>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted text-sm">—</span>
                                }
                            </td>
                            <td class="text-muted text-sm">@entry.CreatedAt.ToString("d")</td>
                            <td class="text-muted text-sm">@(isSelf ? "\u2014" : AdminModel.RelativeTime(lastSync))</td>
                            <td style="text-align:right;">
                                @if (!isSelf)
                                {
                                    <sl-icon-button name="link-45deg" label="Change URL"
                                        data-node-id="@entry.NodeId" data-node-name="@entry.DisplayName" data-current-url="@entry.ApiAddress"
                                        onclick="openChangeUrl(this.dataset.nodeId, this.dataset.nodeName, this.dataset.currentUrl)">
                                    </sl-icon-button>
                                    <form method="post" asp-page-handler="RevokeNode" style="display:inline;">
                                        <input type="hidden" name="nodeId" value="@entry.NodeId" />
                                        <sl-icon-button name="trash" label="Revoke"
                                            data-name="@entry.DisplayName" onclick="if(confirm('Revoke node ' + this.dataset.name + '?')) { this.closest('form').submit(); }">
                                        </sl-icon-button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card" style="text-align:center;padding:40px;margin-bottom:32px;">
            <sl-icon name="people" style="font-size:2rem;color:var(--text-secondary);display:block;margin-bottom:12px;"></sl-icon>
            <p class="text-muted">No trusted nodes</p>
        </div>
    }

    <!-- Snapshots -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;gap:8px;flex-wrap:wrap;">
        <h3 style="margin:0;"><sl-icon name="archive"></sl-icon> Snapshots</h3>
        <div style="display:flex;gap:8px;">
            <sl-button size="small" variant="default" id="btn-show-upload">
                <sl-icon slot="prefix" name="cloud-upload"></sl-icon> Upload
            </sl-button>
            <sl-button size="small" variant="success" id="btn-create-snapshot">
                <sl-icon slot="prefix" name="plus-lg"></sl-icon> Create Snapshot
            </sl-button>
        </div>
    </div>

    <div id="snapshot-upload-zone"
         style="display:none;border:2px dashed var(--text-secondary);padding:20px;text-align:center;border-radius:8px;margin-bottom:16px;cursor:pointer;transition:background 0.15s;">
        <sl-icon name="cloud-upload" style="font-size:1.6rem;color:var(--text-secondary);"></sl-icon>
        <p style="margin:8px 0 4px 0;">
            Drag &amp; drop a snapshot file (<code>.tar.gz</code> / <code>.bin</code>)
            or <sl-button variant="text" id="btn-pick-file">browse</sl-button>
        </p>
        <p class="text-muted text-sm" style="margin:0;">Uploaded snapshots appear in the list below and can be restored.</p>
        <input type="file" id="snapshot-file-input" accept=".tar.gz,.bin" style="display:none;" />
        <div id="upload-progress" style="display:none;margin-top:12px;">
            <sl-progress-bar id="upload-progress-bar" value="0"></sl-progress-bar>
            <span id="upload-status" class="text-sm text-muted"></span>
        </div>
    </div>

    @if (Model.Snapshots != null && Model.Snapshots.Count > 0)
    {
        <div class="card" style="padding:0;overflow:hidden;margin-bottom:32px;">
            <table class="version-table">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Size</th>
                        <th>Date</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var snap in Model.Snapshots)
                    {
                        <tr>
                            <td><code class="text-sm">@snap.FileName</code></td>
                            <td class="text-muted text-sm">@(snap.SizeBytes / 1024) KB</td>
                            <td class="text-muted text-sm">@snap.CreatedAt.ToString("g")</td>
                            <td style="text-align:right;">
                                <a href="/Admin?handler=DownloadSnapshot&fileName=@Uri.EscapeDataString(snap.FileName)"
                                   title="Download snapshot">
                                    <sl-icon-button name="download" label="Download"></sl-icon-button>
                                </a>
                                <sl-icon-button name="arrow-counterclockwise" label="Restore"
                                    data-filename="@snap.FileName"
                                    onclick="openRestoreDialog(this.dataset.filename)">
                                </sl-icon-button>
                                <form method="post" asp-page-handler="DeleteSnapshot" style="display:inline;">
                                    <input type="hidden" name="fileName" value="@snap.FileName" />
                                    <sl-icon-button name="trash" label="Delete"
                                        data-name="@snap.FileName" onclick="if(confirm('Delete snapshot ' + this.dataset.name + '?')) { this.closest('form').submit(); }">
                                    </sl-icon-button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card" style="text-align:center;padding:40px;margin-bottom:32px;">
            <sl-icon name="archive" style="font-size:2rem;color:var(--text-secondary);display:block;margin-bottom:12px;"></sl-icon>
            <p class="text-muted">No snapshots</p>
        </div>
    }

    <!-- Event Log & Compaction -->
    <div style="display:flex;align-items:center;gap:6px;margin-bottom:12px;margin-top:32px;">
        <h3 style="margin:0;"><sl-icon name="archive"></sl-icon> Event Log &amp; Compaction</h3>
        <sl-icon-button name="question-circle" label="About compaction"
            id="compaction-info-btn"
            style="font-size:1.2rem;color:var(--text-secondary);"></sl-icon-button>
    </div>

    @if (Model.CompactionPreview != null)
    {
        var p = Model.CompactionPreview;
        <div class="card" style="margin-bottom:16px;">
            <div style="display:grid;grid-template-columns:repeat(2, 1fr);gap:16px;margin-bottom:16px;">
                <div>
                    <div class="text-muted text-sm">Events in log</div>
                    <div style="font-size:1.4rem;font-weight:600;">@p.TotalEvents</div>
                </div>
                <div>
                    <div class="text-muted text-sm">Peers online</div>
                    <div style="font-size:1.4rem;font-weight:600;">@p.ActivePeerCount</div>
                </div>
            </div>

            @if (p.PeerPositions != null && p.PeerPositions.Count > 0)
            {
                <div style="margin-bottom:16px;">
                    <div class="text-muted text-sm" style="margin-bottom:4px;">Peers status:</div>
                    @foreach (var peer in p.PeerPositions)
                    {
                        var behind = peer.LastSequenceNum < 0 ? -1 : p.HeadSeq - peer.LastSequenceNum;
                        <div style="font-size:0.85rem;">
                            <code>@peer.NodeId</code> —
                            @if (behind < 0)
                            {
                                <span>never synced</span>
                            }
                            else if (behind == 0)
                            {
                                <span>fully synced</span>
                                <span>, last contact @AdminModel.RelativeTime(peer.UpdatedAt)</span>
                            }
                            else
                            {
                                <span>@behind operation(s) behind</span>
                                <span>, last contact @AdminModel.RelativeTime(peer.UpdatedAt)</span>
                            }
                        </div>
                    }
                </div>
            }

            @if (p.Warnings != null && p.Warnings.Count > 0)
            {
                <sl-alert variant="warning" open style="margin-bottom:16px;">
                    <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                    <strong>Warnings:</strong>
                    <ul style="margin:8px 0 0 20px;">
                        @foreach (var w in p.Warnings) { <li>@w</li> }
                    </ul>
                </sl-alert>
            }

            @if (p.CanCompact)
            {
                <sl-alert variant="primary" open style="margin-bottom:16px;">
                    <sl-icon slot="icon" name="info-circle"></sl-icon>
                    <strong>Ready to compact.</strong>
                    <div style="margin-top:8px;font-size:0.9rem;">
                        <div>Will delete the oldest <strong>@p.EventsToDelete</strong> events and replace them with one signed snapshot.</div>
                        <div>Will keep <strong>@p.EventsRemaining</strong> of the most recent events as a tail for continued sync.</div>
                        <div class="text-muted" style="margin-top:6px;">@(p.ActivePeerCount > 0
                            ? "Safe: every active peer has already received all the events we're about to delete."
                            : "No active peers — safe to compact.")</div>
                    </div>
                </sl-alert>

                <form method="post" asp-page-handler="Compact" style="display:inline;" onsubmit="return confirm('Compact event log?\n\nWill delete the oldest @p.EventsToDelete events (kept as one signed snapshot).\nWill keep @p.EventsRemaining of the most recent events for continued sync.\n\nContinue?');">
                    <sl-button type="submit" variant="warning">
                        <sl-icon slot="prefix" name="archive"></sl-icon>
                        Compact now (delete @p.EventsToDelete events)
                    </sl-button>
                </form>
            }
            else
            {
                <sl-alert variant="neutral" open>
                    <sl-icon slot="icon" name="info-circle"></sl-icon>
                    @p.Reason
                </sl-alert>
            }
        </div>
    }
    else
    {
        <sl-alert variant="warning" open style="margin-bottom:16px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            Could not load compaction preview.
        </sl-alert>
    }

    <sl-dialog id="compaction-info-dialog" label="About event log compaction" style="--width: 560px;">
        <div style="line-height:1.55;">
            <p><strong>What is the event log?</strong></p>
            <p>Every operation on this node (create article, rename folder, add tag, delete, …) is written as a numbered event into a journal. Nodes synchronize with each other by exchanging events — if peer B is at operation #500 and we're at #1800, peer B pulls events 501–1800 to catch up.</p>

            <p style="margin-top:12px;"><strong>Why compact?</strong></p>
            <p>The journal grows forever — 25 000+ events per year for an active user. New nodes joining the network would have to replay all of it. Compaction truncates the old part of the journal and replaces it with a <em>signed snapshot</em>: the full state at that point, packaged into one file. Invariant preserved: <code>current state = snapshot + operations after it</code>. Nothing is lost semantically, only the journal becomes short again.</p>

            <p style="margin-top:12px;"><strong>How many events are kept?</strong></p>
            <p>Target: keep the <strong>1500</strong> most recent events. Older events get folded into a signed snapshot and removed from the log. If there are fewer than 1500 events total, nothing happens.</p>

            <p style="margin-top:12px;"><strong>When is compaction refused?</strong></p>
            <p>If any active peer is more than 1500 events behind the newest one, or if any peer is in the whitelist but has never synced, compaction is refused — those peers would be cut off. Resolve by waiting for them to sync, or by revoking them from the whitelist.</p>

            <p style="margin-top:12px;"><strong>What happens after?</strong></p>
            <ul style="margin:6px 0 0 20px;">
                <li>A <code>.tar.gz</code> snapshot file is created in the server's data dir (signed with this node's key).</li>
                <li>Operations 1…N are deleted from <code>tbl_event</code>. The most recent ones remain.</li>
                <li>A tamper-proof <code>snapshot_checkpoint</code> marker is appended to the journal. It records the snapshot hash and references the previous checkpoint (Merkle chain). These markers never get compacted away.</li>
                <li>Peers already at or past position <em>N</em> continue syncing normally.</li>
                <li>Peers that fall behind position <em>N</em> later (e.g. offline for weeks) will need a <strong>Wipe &amp; Rejoin</strong> — they'll pull the fresh snapshot instead of trying to catch up via the journal.</li>
            </ul>

            <p style="margin-top:12px;"><strong>How often?</strong></p>
            <p>Admin-triggered only — no automatic background compaction. For a personal knowledge base, running it once a month or when the event log passes 5–10k is fine. Always check the peer list above first: if any peer is close to being cut off, wait for it to sync or revoke it.</p>
        </div>
        <sl-button slot="footer" variant="default" onclick="document.getElementById('compaction-info-dialog').hide()">Cancel</sl-button>
        <sl-button slot="footer" variant="primary" id="compaction-info-close">Got it</sl-button>
    </sl-dialog>

    <script>
        (function () {
            const btn = document.getElementById('compaction-info-btn');
            const dlg = document.getElementById('compaction-info-dialog');
            const close = document.getElementById('compaction-info-close');
            if (btn && dlg) btn.addEventListener('click', function () { dlg.show(); });
            if (close && dlg) close.addEventListener('click', function () { dlg.hide(); });
        })();
    </script>

    @if (Model.SnapshotCheckpoints != null && Model.SnapshotCheckpoints.Count > 0)
    {
        <details style="margin-bottom:32px;">
            <summary style="cursor:pointer;padding:8px;"><strong>Compaction history</strong> (@Model.SnapshotCheckpoints.Count checkpoints)</summary>
            <div class="card" style="padding:0;overflow:hidden;margin-top:8px;">
                <table class="version-table">
                    <thead>
                        <tr>
                            <th>Sequence</th>
                            <th>CP</th>
                            <th>Events removed</th>
                            <th>Snapshot</th>
                            <th>Created at</th>
                            <th>Chain</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var cp in Model.SnapshotCheckpoints)
                    {
                        var payload = cp.Payload;
                        var cpSeq = payload.TryGetProperty("cp_seq", out var cps) ? cps.GetInt64() : 0;
                        var evRemoved = payload.TryGetProperty("events_removed", out var er) ? er.GetInt32() : 0;
                        var snapFile = payload.TryGetProperty("snapshot_file_name", out var sf) ? sf.GetString() : null;
                        var prevHash = payload.TryGetProperty("prev_checkpoint_sha256", out var ph) ? ph.GetString() : null;
                        <tr>
                            <td>@cp.SequenceNum</td>
                            <td>@cpSeq</td>
                            <td>@evRemoved</td>
                            <td><code style="font-size:0.8rem;">@snapFile</code></td>
                            <td>@cp.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(prevHash != null ? $"→ {prevHash[..Math.Min(8, prevHash.Length)]}\u2026" : "(first)")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </details>
    }

    <!-- Agents -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;gap:12px;flex-wrap:wrap;">
        <h3 style="margin:0;"><sl-icon name="robot"></sl-icon> Agents</h3>
        <span class="text-muted text-sm" style="display:inline-flex;align-items:center;gap:6px;">
            <sl-icon name="info-circle"></sl-icon>
            To add a new agent, go to <a href="/Profile">Profile</a>.
        </span>
    </div>

    @if (Model.Agents != null && Model.Agents.Count > 0)
    {
        <div class="card" style="padding:0;overflow:hidden;margin-bottom:32px;">
            <table class="version-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Owner</th>
                        <th>API Key</th>
                        <th>Created</th>
                        <th>Last Access</th>
                        <th>Requests</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var agent in Model.Agents)
                    {
                        <tr>
                            <td><strong>@agent.Name</strong></td>
                            <td class="text-muted text-sm">@(agent.Description ?? "\u2014")</td>
                            <td class="text-muted text-sm">@(agent.OwnerName ?? (agent.OwnerUserId > 0 ? $"#{agent.OwnerUserId}" : "\u2014"))</td>
                            <td><code class="text-sm">@agent.KeyPrefix</code></td>
                            <td class="text-muted text-sm">@agent.CreatedAt.ToString("g")</td>
                            <td class="text-muted text-sm">@AdminModel.RelativeTime(agent.LastAccessedAt)</td>
                            <td class="text-muted text-sm">@(agent.RequestCount == 0 ? "\u2014" : agent.RequestCount.ToString("N0"))</td>
                            <td style="text-align:right;">
                                <form method="post" asp-page-handler="DeleteAgent" style="display:inline;">
                                    <input type="hidden" name="agentId" value="@agent.Id" />
                                    <sl-icon-button name="trash" label="Delete"
                                        data-name="@agent.Name" onclick="if(confirm('Delete agent ' + this.dataset.name + '?')) { this.closest('form').submit(); }">
                                    </sl-icon-button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card" style="text-align:center;padding:40px;margin-bottom:32px;">
            <sl-icon name="robot" style="font-size:2rem;color:var(--text-secondary);display:block;margin-bottom:12px;"></sl-icon>
            <p class="text-muted">No agents</p>
        </div>
    }

    <!-- AI / Chat (OpenRouter) — node-global keys + model catalogue. Superadmin-only (whole page is). -->
    <h3 style="margin-bottom:12px;"><sl-icon name="chat-left-text"></sl-icon> AI / Chat</h3>
    <sl-alert variant="neutral" open size="small" style="margin-bottom:16px;max-width:640px;">
        <sl-icon slot="icon" name="shield-exclamation"></sl-icon>
        Keys are encrypted at rest under the master DEK and only usable while the vault is unlocked.
        The full key is shown <strong>once</strong> at creation; afterwards only a short prefix.
        Everything the AI reads is sent to your configured OpenRouter model/provider.
    </sl-alert>

    <!-- Allow AI chat: node-wide kill switch. When off, no one except superadmins can use the
         AI chat feature (web UI), regardless of each user's individual "Can use AI chat" setting
         on the Users page. Per-user settings are preserved while this is off — turning it back on
         restores whatever each user had configured. -->
    <div class="card" style="max-width:640px;margin-bottom:24px;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:16px;">
        <div>
            <strong>Allow AI chat for users</strong>
            <p class="text-muted text-sm" style="margin:4px 0 0 0;">
                When off, only superadmins can use the AI chat — everyone else is blocked regardless
                of their individual chat-access setting (see <a href="/Users">Users</a>). Turning this
                back on restores each user's own setting, nothing is lost while it's off.
            </p>
        </div>
        <sl-switch id="chat-globally-enabled-toggle" style="flex-shrink:0;"></sl-switch>
    </div>

    <!-- Auto-approve writes: opt-in, skips the human-in-the-loop Allow/Deny gate for write tools.
         ACL, the destructive-op cap, and audit tagging still apply in full — only the pause is
         skipped. Article history/restore is the accepted safety net. -->
    <div class="card" style="max-width:640px;margin-bottom:24px;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:16px;">
        <div>
            <strong>Auto-approve writes</strong>
            <p class="text-muted text-sm" style="margin:4px 0 0 0;">
                When on, the AI creates/edits/deletes notes immediately without asking for Allow/Deny.
                Folder access rules and the destructive-action limit still apply, and every change is
                still visible in article history / restorable.
            </p>
        </div>
        <sl-switch id="chat-auto-approve-toggle" style="flex-shrink:0;"></sl-switch>
    </div>

    <!-- Keys -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:8px;flex-wrap:wrap;">
        <strong>OpenRouter API keys</strong>
        <sl-button size="small" variant="primary" id="btn-add-chat-key">
            <sl-icon slot="prefix" name="plus-lg"></sl-icon> Add key
        </sl-button>
    </div>
    <div class="card" style="padding:0;overflow:hidden;margin-bottom:24px;">
        <table class="version-table">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Prefix</th>
                    <th>Priority</th>
                    <th>Enabled</th>
                    <th>Status</th>
                    <th>Last used</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody id="chat-keys-body">
                <tr><td colspan="7" class="text-muted text-sm" style="text-align:center;padding:16px;">Loading…</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Models -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:8px;flex-wrap:wrap;">
        <strong>Model catalogue</strong>
        <sl-button size="small" variant="primary" id="btn-add-chat-model">
            <sl-icon slot="prefix" name="plus-lg"></sl-icon> Add model
        </sl-button>
    </div>
    <div class="card" style="padding:0;overflow:hidden;margin-bottom:24px;">
        <table class="version-table">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Model ID</th>
                    <th style="text-align:center;">Text</th>
                    <th style="text-align:center;">Vision</th>
                    <th style="text-align:center;">Image gen</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody id="chat-models-body">
                <tr><td colspan="6" class="text-muted text-sm" style="text-align:center;padding:16px;">Loading…</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Default models: three pinned-default dropdowns. "Default" = oldest model with the matching
         property; picking a specific model pins it. -->
    <div style="margin-bottom:8px;">
        <strong>Default models</strong>
        <p class="text-muted text-sm" style="margin:4px 0 0 0;">
            Pin a specific model for each role, or leave on "Default" to use the oldest model with
            that capability. The text model is the entry point for every chat turn.
        </p>
    </div>
    <div class="card" style="padding:16px;margin-bottom:32px;">
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
            <div>
                <label style="font-size:0.85rem;color:var(--text-secondary);display:block;margin-bottom:4px;">Default text model</label>
                <sl-select id="default-text-model" size="small" placeholder="Default">
                    <sl-option value="">Default</sl-option>
                </sl-select>
            </div>
            <div>
                <label style="font-size:0.85rem;color:var(--text-secondary);display:block;margin-bottom:4px;">Default vision model</label>
                <sl-select id="default-vision-model" size="small" placeholder="Default">
                    <sl-option value="">Default</sl-option>
                </sl-select>
            </div>
            <div>
                <label style="font-size:0.85rem;color:var(--text-secondary);display:block;margin-bottom:4px;">Default image-gen model</label>
                <sl-select id="default-imagegen-model" size="small" placeholder="Default">
                    <sl-option value="">Default</sl-option>
                </sl-select>
            </div>
        </div>
        <p id="chat-defaults-hint" class="text-muted" style="font-size:0.74rem;margin:8px 0 0 0;"></p>
    </div>

    <sl-dialog id="dlg-add-chat-key" label="Add OpenRouter key" style="--width:480px;">
        <div style="margin-bottom:16px;">
            <sl-input id="chat-key-label" label="Label" placeholder="e.g. personal" required></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="chat-key-value" label="API key" type="password" password-toggle placeholder="sk-or-…" required autocomplete="off"></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="chat-key-priority" label="Priority (lower = used first)" type="number" value="0"></sl-input>
        </div>
        <p class="text-muted text-sm">The key needs an unlocked vault to be encrypted. Copy the full key now — it won't be shown again.</p>
        <sl-button slot="footer" type="button" variant="default" onclick="document.getElementById('dlg-add-chat-key').hide()">Cancel</sl-button>
        <sl-button slot="footer" type="button" variant="primary" id="btn-save-chat-key">
            <sl-icon slot="prefix" name="save"></sl-icon> Save key
        </sl-button>
    </sl-dialog>

    <sl-dialog id="dlg-add-chat-model" label="Add model" style="--width:480px;">
        <div style="margin-bottom:16px;">
            <sl-input id="chat-model-id" label="Model ID" placeholder="e.g. openai/gpt-4o-mini" required></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="chat-model-label" label="Label" placeholder="e.g. GPT-4o mini" required></sl-input>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px;">
            <sl-checkbox id="chat-model-text" checked>Text</sl-checkbox>
            <sl-checkbox id="chat-model-vision">Vision (accepts images)</sl-checkbox>
            <sl-checkbox id="chat-model-imagegen">Image generation</sl-checkbox>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="chat-model-context" label="Context window (tokens)" type="number" min="1"
                      placeholder="e.g. 128000 (optional)"></sl-input>
        </div>
        <p class="text-muted text-sm">A model can have multiple capabilities (e.g. both text AND vision).</p>
        <sl-button slot="footer" type="button" variant="default" onclick="document.getElementById('dlg-add-chat-model').hide()">Cancel</sl-button>
        <sl-button slot="footer" type="button" variant="primary" id="btn-save-chat-model">
            <sl-icon slot="prefix" name="save"></sl-icon> Save model
        </sl-button>
    </sl-dialog>

    <sl-dialog id="dlg-edit-chat-model" label="Edit model" style="--width:480px;">
        <div style="margin-bottom:16px;">
            <sl-input id="edit-chat-model-id" label="Model ID" disabled></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="edit-chat-model-label" label="Label" disabled></sl-input>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px;">
            <sl-checkbox id="edit-chat-model-text">Text</sl-checkbox>
            <sl-checkbox id="edit-chat-model-vision">Vision (accepts images)</sl-checkbox>
            <sl-checkbox id="edit-chat-model-imagegen">Image generation</sl-checkbox>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input id="edit-chat-model-context" label="Context window (tokens)" type="number" min="1"
                      placeholder="e.g. 128000 (optional)"></sl-input>
        </div>
        <p class="text-muted text-sm">Toggle which capabilities this model provides.</p>
        <sl-button slot="footer" type="button" variant="default" onclick="document.getElementById('dlg-edit-chat-model').hide()">Cancel</sl-button>
        <sl-button slot="footer" type="button" variant="primary" id="btn-save-edit-chat-model">
            <sl-icon slot="prefix" name="save"></sl-icon> Save
        </sl-button>
    </sl-dialog>

    <script>
    (function () {
        var keysBody = document.getElementById('chat-keys-body');
        var modelsBody = document.getElementById('chat-models-body');

        function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
        function rel(t) {
            if (!t) return '—';
            var d = new Date(t); if (isNaN(d)) return esc(t);
            var s = (Date.now() - d.getTime()) / 1000;
            if (s < 60) return Math.floor(s) + 's ago';
            if (s < 3600) return Math.floor(s / 60) + 'm ago';
            if (s < 86400) return Math.floor(s / 3600) + 'h ago';
            return Math.floor(s / 86400) + 'd ago';
        }

        // Phase 4: derives the per-key circuit-breaker status shown in the Status column. A disabled
        // key (HTTP 401 → enabled=0) shows red; a cooling-down key (402/429 → future disabled_until)
        // shows amber with its retry time; otherwise Active (green), with any last_error as a tooltip.
        function keyStatus(k) {
            if (!k.enabled) return { label: 'Disabled', color: 'var(--sl-color-danger-600)' };
            if (k.disabledUntil) {
                var d = new Date(k.disabledUntil);
                if (!isNaN(d) && d.getTime() > Date.now()) {
                    return { label: 'Cooling down', color: 'var(--sl-color-warning-600)', title: 'auto-retries after ' + rel(k.disabledUntil) };
                }
            }
            if (k.lastError) return { label: 'Active', color: 'var(--sl-color-success-600)', title: 'last error: ' + k.lastError };
            return { label: 'Active', color: 'var(--sl-color-success-600)' };
        }

        function loadKeys() {
            fetch('/api-proxy/chat/keys').then(function (r) { return r.json(); }).then(function (keys) {
                if (!Array.isArray(keys) || keys.length === 0) {
                    keysBody.innerHTML = '<tr><td colspan="7" class="text-muted text-sm" style="text-align:center;padding:16px;">No keys. Add one to enable AI chat.</td></tr>';
                    return;
                }
                keysBody.innerHTML = keys.map(function (k) {
                    var st = keyStatus(k);
                    return '<tr>'
                        + '<td><strong>' + esc(k.label) + '</strong></td>'
                        + '<td><code class="text-sm">' + esc(k.keyPrefix) + '</code></td>'
                        + '<td class="text-muted text-sm">' + (k.priority || 0) + '</td>'
                        + '<td><sl-switch data-key-id="' + k.id + '" ' + (k.enabled ? 'checked' : '') + ' onsl-change="toggleChatKey"></sl-switch></td>'
                        + '<td class="text-sm" style="color:' + st.color + ';"' + (st.title ? ' title="' + esc(st.title) + '"' : '') + '>' + st.label + '</td>'
                        + '<td class="text-muted text-sm">' + rel(k.lastUsedAt) + '</td>'
                        + '<td style="text-align:right;"><sl-icon-button name="trash" label="Delete" data-key-id="' + k.id + '" onclick="deleteChatKey(this.dataset.keyId)"></sl-icon-button></td>'
                        + '</tr>';
                }).join('');
            }).catch(function () { keysBody.innerHTML = '<tr><td colspan="7" class="text-muted text-sm">Failed to load keys.</td></tr>'; });
        }

        var modelsCache = [];
        var editingModelId = null;

        function loadModels() {
            fetch('/api-proxy/chat/models/all').then(function (r) { return r.json(); }).then(function (models) {
                modelsCache = Array.isArray(models) ? models : [];
                if (modelsCache.length === 0) {
                    modelsBody.innerHTML = '<tr><td colspan="6" class="text-muted text-sm" style="text-align:center;padding:16px;">No models. Add one (with the Text capability) to enable AI chat.</td></tr>';
                    loadDefaults();
                    return;
                }
                modelsBody.innerHTML = modelsCache.map(function (m) {
                    return '<tr>'
                        + '<td><strong>' + esc(m.label) + '</strong></td>'
                        + '<td><code class="text-sm">' + esc(m.modelId) + '</code></td>'
                        + '<td style="text-align:center;"><sl-checkbox disabled ' + (m.isText ? 'checked' : '') + '></sl-checkbox></td>'
                        + '<td style="text-align:center;"><sl-checkbox disabled ' + (m.isVision ? 'checked' : '') + '></sl-checkbox></td>'
                        + '<td style="text-align:center;"><sl-checkbox disabled ' + (m.isImageGen ? 'checked' : '') + '></sl-checkbox></td>'
                        + '<td style="text-align:right;">'
                        + '<sl-icon-button name="pencil" label="Edit" data-edit-id="' + m.id + '" onclick="editChatModel(this.dataset.editId)"></sl-icon-button>'
                        + '<sl-icon-button name="trash" label="Delete" data-model-id="' + m.id + '" onclick="deleteChatModel(this.dataset.modelId)"></sl-icon-button>'
                        + '</td>'
                        + '</tr>';
                }).join('');
                loadDefaults();
            }).catch(function () { modelsBody.innerHTML = '<tr><td colspan="6" class="text-muted text-sm">Failed to load models.</td></tr>'; });
        }

        window.editChatModel = function (id) {
            var m = modelsCache.find(function (x) { return x.id === id; });
            if (!m) return;
            document.getElementById('edit-chat-model-id').value = m.modelId || '';
            document.getElementById('edit-chat-model-label').value = m.label || '';
            document.getElementById('edit-chat-model-text').checked = !!m.isText;
            document.getElementById('edit-chat-model-vision').checked = !!m.isVision;
            document.getElementById('edit-chat-model-imagegen').checked = !!m.isImageGen;
            document.getElementById('edit-chat-model-context').value = m.contextWindow || '';
            editingModelId = id;
            document.getElementById('dlg-edit-chat-model').show();
        };
        window.toggleChatKey = function (e) {
            var id = e.target.dataset.keyId; var enabled = e.target.checked;
            fetch('/api-proxy/chat/keys/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ enabled: enabled }) })
                .catch(function () { loadKeys(); });
        };
        window.deleteChatKey = function (id) {
            if (!confirm('Delete this API key?')) return;
            fetch('/api-proxy/chat/keys/' + id, { method: 'DELETE' }).then(function () { loadKeys(); });
        };
        window.deleteChatModel = function (id) {
            if (!confirm('Delete this model?')) return;
            fetch('/api-proxy/chat/models/' + id, { method: 'DELETE' }).then(function () { loadModels(); });
        };

        document.getElementById('btn-add-chat-key').addEventListener('click', function () {
            document.getElementById('dlg-add-chat-key').show();
        });
        document.getElementById('btn-save-chat-key').addEventListener('click', function () {
            var label = document.getElementById('chat-key-label').value.trim();
            var key = document.getElementById('chat-key-value').value.trim();
            var priority = parseInt(document.getElementById('chat-key-priority').value || '0', 10) || 0;
            if (!label || !key) return;
            fetch('/api-proxy/chat/keys', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ label: label, apiKey: key, priority: priority }) })
                .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
                .then(function (res) {
                    document.getElementById('dlg-add-chat-key').hide();
                    document.getElementById('chat-key-label').value = '';
                    document.getElementById('chat-key-value').value = '';
                    document.getElementById('chat-key-priority').value = '0';
                    loadKeys();
                    if (res.ok && res.body && res.body.apiKey) {
                        alert('Key created. Copy it now — it will not be shown again:\n\n' + res.body.apiKey);
                    } else if (!res.ok) {
                        alert((res.body && res.body.error) ? res.body.error : 'Failed to save key (is the vault unlocked?).');
                    }
                });
        });

        document.getElementById('btn-add-chat-model').addEventListener('click', function () {
            document.getElementById('dlg-add-chat-model').show();
        });
        document.getElementById('btn-save-chat-model').addEventListener('click', function () {
            var modelIdInput = document.getElementById('chat-model-id');
            var modelId = modelIdInput.value.trim();
            var label = document.getElementById('chat-model-label').value.trim();
            var isText = document.getElementById('chat-model-text').checked;
            var isVision = document.getElementById('chat-model-vision').checked;
            var isImageGen = document.getElementById('chat-model-imagegen').checked;
            var cw = parseInt(document.getElementById('chat-model-context').value, 10);
            // OpenRouter model slugs are always clean "provider/model-name" strings — they never
            // contain spaces or colons. Reject a Model ID that does (someone pasted a label by
            // mistake) with an inline error. Clear any prior custom validity so the field isn't
            // stuck invalid.
            modelIdInput.setCustomValidity('');
            if (/[\s:]/.test(modelId)) {
                modelIdInput.setCustomValidity('Model ID must not contain spaces — use the exact slug from OpenRouter, like provider/model-name');
                modelIdInput.reportValidity();
                return;
            }
            if (!modelId || !label) return;
            fetch('/api-proxy/chat/models', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ modelId: modelId, label: label, isText: isText, isVision: isVision, isImageGen: isImageGen, contextWindow: (isNaN(cw) || cw <= 0) ? null : cw }) })
                .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
                .then(function (res) {
                    document.getElementById('dlg-add-chat-model').hide();
                    document.getElementById('chat-model-id').value = '';
                    document.getElementById('chat-model-label').value = '';
                    document.getElementById('chat-model-text').checked = true;
                    document.getElementById('chat-model-vision').checked = false;
                    document.getElementById('chat-model-imagegen').checked = false;
                    document.getElementById('chat-model-context').value = '';
                    if (res.ok) { loadModels(); } else { alert((res.body && res.body.error) ? res.body.error : 'Failed to save model.'); }
                });
        });

        document.getElementById('btn-save-edit-chat-model').addEventListener('click', function () {
            if (!editingModelId) return;
            var isText = document.getElementById('edit-chat-model-text').checked;
            var isVision = document.getElementById('edit-chat-model-vision').checked;
            var isImageGen = document.getElementById('edit-chat-model-imagegen').checked;
            var editCw = parseInt(document.getElementById('edit-chat-model-context').value, 10);
            // ALWAYS include contextWindow (null when blank) — unconditional set lets blank CLEAR it.
            fetch('/api-proxy/chat/models/' + editingModelId, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isText: isText, isVision: isVision, isImageGen: isImageGen, contextWindow: (isNaN(editCw) || editCw <= 0) ? null : editCw })
            }).then(function (r) {
                document.getElementById('dlg-edit-chat-model').hide();
                editingModelId = null;
                if (r.ok) loadModels();
            });
        });

        // Default-model dropdowns: each lists only models with the matching capability, sorted
        // oldest-first (matching the grid), with "Default" as the first option (= oldest-with-property).
        // Guard against saveDefaults() firing from PROGRAMMATIC value assignment during
        // loadDefaults()'s initial population (Shoelace's <sl-select> can emit its own
        // 'sl-change' as a side effect of setting .value right after dynamically appending
        // <sl-option> children — the exact same class of bug already fixed once in the /AI
        // chat model picker). Without this guard, loading the page could immediately re-PATCH
        // whatever partial/empty values the three selects happen to hold mid-population,
        // clobbering an already-saved pin with null — which is what "my selection doesn't
        // stick" looks like from the user's side.
        var suppressSaveDefaults = false;

        function loadDefaults() {
            fetch('/api-proxy/chat/settings/defaults').then(function (r) { return r.ok ? r.json() : { defaultTextModelId: null, defaultVisionModelId: null, defaultImageGenModelId: null }; }).then(function (defaults) {
                suppressSaveDefaults = true;
                populateDefaultSelect('default-text-model', function (m) { return m.isText; }, defaults.defaultTextModelId);
                populateDefaultSelect('default-vision-model', function (m) { return m.isVision; }, defaults.defaultVisionModelId);
                populateDefaultSelect('default-imagegen-model', function (m) { return m.isImageGen; }, defaults.defaultImageGenModelId);
                // Re-enable saving on the NEXT tick, after Shoelace's own internal reconciliation
                // (and any 'sl-change' it dispatches as a side effect of the .value assignments
                // above) has had a chance to run and settle.
                setTimeout(function () { suppressSaveDefaults = false; }, 0);
            }).catch(function () {});
        }
        function populateDefaultSelect(selectId, filterFn, selectedId) {
            var sel = document.getElementById(selectId);
            if (!sel) return;
            sel.innerHTML = '';
            var defOpt = document.createElement('sl-option');
            defOpt.value = '';
            defOpt.textContent = 'Default (oldest)';
            sel.appendChild(defOpt);
            modelsCache.filter(filterFn).forEach(function (m) {
                var opt = document.createElement('sl-option');
                opt.value = m.id;
                opt.textContent = m.label || m.modelId;
                sel.appendChild(opt);
            });
            // Defer setting .value to the next tick — right after appendChild, Shoelace's
            // <sl-option> custom elements may not be upgraded/registered yet, so an immediate
            // .value assignment can silently fail to select anything (reverting to the first
            // option, "Default"). This is the same timing gotcha already worked around
            // elsewhere in this app for dynamically populated <sl-select> lists.
            setTimeout(function () { sel.value = selectedId || ''; }, 0);
        }
        function saveDefaults() {
            if (suppressSaveDefaults) return;
            fetch('/api-proxy/chat/settings/defaults', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    defaultTextModelId: (document.getElementById('default-text-model').value || '') || null,
                    defaultVisionModelId: (document.getElementById('default-vision-model').value || '') || null,
                    defaultImageGenModelId: (document.getElementById('default-imagegen-model').value || '') || null
                })
            }).catch(function () {});
        }
        ['default-text-model', 'default-vision-model', 'default-imagegen-model'].forEach(function (id) {
            var sel = document.getElementById(id);
            if (sel) sel.addEventListener('sl-change', saveDefaults);
        });

        // Auto-approve writes toggle.
        var autoApproveToggle = document.getElementById('chat-auto-approve-toggle');
        function loadAutoApprove() {
            if (!autoApproveToggle) return;
            fetch('/api-proxy/chat/settings/auto-approve', { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : { autoApproveWrites: false }; })
                .then(function (data) { autoApproveToggle.checked = !!data.autoApproveWrites; })
                .catch(function () {});
        }
        if (autoApproveToggle) {
            autoApproveToggle.addEventListener('sl-change', function () {
                var enabled = autoApproveToggle.checked;
                fetch('/api-proxy/chat/settings/auto-approve', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: enabled })
                }).catch(function () { autoApproveToggle.checked = !enabled; });
            });
        }
        loadAutoApprove();

        // "Allow AI chat for users" node-wide kill switch toggle.
        var chatEnabledToggle = document.getElementById('chat-globally-enabled-toggle');
        function loadChatEnabled() {
            if (!chatEnabledToggle) return;
            fetch('/api-proxy/chat/settings/chat-enabled', { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : { chatGloballyEnabled: true }; })
                .then(function (data) { chatEnabledToggle.checked = !!data.chatGloballyEnabled; })
                .catch(function () {});
        }
        if (chatEnabledToggle) {
            chatEnabledToggle.addEventListener('sl-change', function () {
                var enabled = chatEnabledToggle.checked;
                fetch('/api-proxy/chat/settings/chat-enabled', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: enabled })
                }).catch(function () { chatEnabledToggle.checked = !enabled; });
            });
        }
        loadChatEnabled();

        // Web session (cookie) settings: duration + sliding-expiration toggle.
        var sessionHoursInput = document.getElementById('session-expire-hours');
        var sessionSlidingToggle = document.getElementById('session-sliding-toggle');
        var sessionSaveBtn = document.getElementById('btn-save-session-settings');
        var sessionSavedMsg = document.getElementById('session-settings-saved-msg');
        function loadSessionSettings() {
            if (!sessionHoursInput || !sessionSlidingToggle) return;
            fetch('/api-proxy/session/settings', { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : { expireHours: 48, slidingExpiration: true }; })
                .then(function (data) {
                    sessionHoursInput.value = data.expireHours;
                    sessionSlidingToggle.checked = !!data.slidingExpiration;
                })
                .catch(function () {});
        }
        if (sessionSaveBtn) {
            sessionSaveBtn.addEventListener('click', function () {
                if (sessionSavedMsg) sessionSavedMsg.style.display = 'none';
                var hours = parseInt(sessionHoursInput.value, 10);
                if (!hours || hours < 1 || hours > 720) {
                    alert('Session duration must be between 1 and 720 hours.');
                    return;
                }
                sessionSaveBtn.loading = true;
                fetch('/api-proxy/session/settings', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ expireHours: hours, slidingExpiration: sessionSlidingToggle.checked })
                })
                    .then(function (r) {
                        sessionSaveBtn.loading = false;
                        if (r.ok && sessionSavedMsg) {
                            sessionSavedMsg.style.display = 'inline';
                            setTimeout(function () { sessionSavedMsg.style.display = 'none'; }, 3000);
                        } else if (!r.ok) {
                            alert('Failed to save session settings.');
                        }
                    })
                    .catch(function () {
                        sessionSaveBtn.loading = false;
                        alert('Failed to save session settings.');
                    });
            });
        }
        loadSessionSettings();

        loadKeys();
        loadModels();
    })();
    </script>

    <!-- Change Node URL Dialog -->
