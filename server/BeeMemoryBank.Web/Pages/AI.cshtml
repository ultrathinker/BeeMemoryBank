@page "/AI"
@model BeeMemoryBank.Web.Pages.AIModel
@{
    ViewData["Title"] = "AI";
}

@section HeadStyles {
    <style>
        /* The AI page uses its own conversation-history sidebar (#chat-sidebar) instead of the
           folder tree (#app-sidebar). We still RENDER <partial name="_Sidebar" /> below (just
           hidden) so the persistent DOM shell matches every other page: site.js's SPA navigation
           (see wwwroot/js/site.js spaNavigate) only swaps the innerHTML of #page-content and
           assumes the sidebar element outside it already exists from the initial full page load.
           Without it, leaving /AI via a SPA-eligible link (e.g. the header logo -> /Tree) left the
           destination page with no sidebar at all, since nothing outside #page-content ever gets
           re-inserted by the swap. */
        body.ai-chat-page #app-sidebar { display: none; }
        /* .main-content's global padding (site.css) is 24px top+bottom. Combined with this page's
           own full-height flex column, that padding eats into the box, leaving a visible empty
           strip below the composer. Shrink it to a small margin on this page only. */
        body.ai-chat-page .main-content { padding-bottom: 8px; }

        /* ── Claude-style redesign (scoped to this page only) ─────────────────── */

        /* Serif display face for the heading only; UI chrome stays on the app's default
           sans. Georgia/'Times New Roman' are universal system fonts — zero network
           requests, so no CSP/CDN concerns. */
        body.ai-chat-page .chat-heading {
            font-family: Georgia, 'Times New Roman', 'Noto Serif', serif;
            font-weight: 500;
            letter-spacing: 0.01em;
            margin: 0;
        }
        body.ai-chat-page #chat-empty-text {
            font-family: Georgia, 'Times New Roman', 'Noto Serif', serif;
            font-size: 1.05rem;
        }

        body.ai-chat-page .chat-header-row {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 8px;
        }
        /* ── Chat history sidebar: a faithful clone of the app's global folder-tree
           sidebar (.sidebar in site.css, rendered by _Sidebar.cshtml) — same default
           width, border, transition, resizable .splitter handle, and collapse mechanism
           — but with its own ids/classes so it never collides with #app-sidebar (which
           is still in the DOM on this page, just display:none). See wwwroot/js/site.js
           "Draggable splitter" + "Sidebar collapse / expand" for the canonical pattern
           this mirrors. #chat-sidebar is a plain flex column with a real defined height
           (it's a flex child of .app-body (via #page-content's display:contents), same as
           #app-sidebar on other pages), so its own border-right spans the full height with
           no special-casing — fixing the old "border stops partway down" bug that was a
           side-effect of the now-removed rail architecture. */
        body.ai-chat-page #chat-sidebar {
            position: relative;
            width: 280px;
            min-width: 280px;
            background: var(--bg-secondary);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            transition: width 0.22s ease, min-width 0.22s ease, border-color 0.22s ease;
            overflow: hidden;
        }
        /* Disable the width transition during an active splitter drag so resizing
           doesn't lag behind the mouse (mirrors .sidebar.no-transition in site.css). */
        body.ai-chat-page #chat-sidebar.no-transition {
            transition: none;
        }
        /* width:0 (NOT display:none) so the collapse animates and the JS collapse/expand
           helper's inline-style overrides + this class cooperate correctly. */
        body.ai-chat-page #chat-sidebar.chat-sidebar-collapsed {
            width: 0;
            min-width: 0;
            border-right-color: transparent;
        }
        /* Anchored to the panel's own top-right corner (position:relative on #chat-sidebar
           above) — independent of "New chat", not sharing its flex row. This is what lets the
           button below span the grid's own 30px inset exactly, instead of losing width to a
           reserved chevron slot. Shrunk via ::part(base) (Shoelace's default icon-button hit
           area is wider than the visible glyph) so it fits in the ~30px strip to the right of
           the button WITHOUT touching it — the button's own right edge sits at 30px from the
           panel's border, so this button's rendered width plus its "right" offset must together
           stay under that 30px, leaving a small visible gap. top:14px (nudged down from the
           button's own 8px top padding) roughly centers it against the button's ~36px height. */
        body.ai-chat-page #btn-chat-sidebar-collapse {
            position: absolute;
            top: 17px;
            right: 4px;
            z-index: 2;
        }
        body.ai-chat-page #btn-chat-sidebar-collapse::part(base) {
            padding: 2px;
            font-size: 1rem;
        }

        /* New-chat flash: when a brand-new conversation appears at the top of the list (right
           after sending the first message), pulse its box-shadow 3 times over ~0.8s so it's
           obvious a new entry showed up — box-shadow (not background) so it never fights the
           row's own persistent "active" background, which is what stays highlighted afterward. */
        @@keyframes chat-history-flash {
            0%, 100% { box-shadow: none; }
            50% { box-shadow: 0 0 0 2px var(--sl-color-primary-500); }
        }
        body.ai-chat-page .chat-history-item-flash {
            animation: chat-history-flash 0.267s ease-in-out 3;
        }

        /* Expand tab — fixed at the page's left edge, shown only while the chat sidebar
           is collapsed, so the user can re-open it without reaching the now-width:0
           collapse button inside the sidebar itself. Same visual shape as
           #sidebar-expand-tab in site.css, but scoped to this page. .visible is present
           in the markup from the very first render since this page always starts
           collapsed. */
        body.ai-chat-page #chat-sidebar-expand-tab {
            display: none;
            position: fixed;
            top: 56px;
            left: 0;
            z-index: 200;
            width: 18px;
            height: 52px;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-left: none;
            border-radius: 0 6px 6px 0;
            cursor: pointer;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            padding: 0;
            transition: background 0.15s, color 0.15s;
            box-shadow: 2px 0 6px rgba(0, 0, 0, 0.18);
        }
        body.ai-chat-page #chat-sidebar-expand-tab:hover {
            background: var(--bg-hover, var(--border));
            color: var(--accent);
        }
        body.ai-chat-page #chat-sidebar-expand-tab sl-icon {
            font-size: 0.75rem;
        }
        body.ai-chat-page #chat-sidebar-expand-tab.visible {
            display: flex;
        }

        /* #app-sidebar (the real folder tree) is hidden on this page via display:none, but
           its sibling expand tab (#sidebar-expand-tab) is NOT covered by that rule. site.js
           would show it on load if the user ever collapsed the global sidebar on another
           page (persisted in localStorage under 'bee-sidebar-collapsed'), so a stray "tree
           sidebar" arrow could appear stacked with our chat expand tab. Suppress it here. */
        body.ai-chat-page #sidebar-expand-tab {
            display: none !important;
        }

        /* Centered max-width column for messages + composer (Claude-style). Side padding keeps
           bubbles (especially the right-aligned "You" ones) off the scrollbar edge. */
        body.ai-chat-page #chat-messages {
            width: 100%;
            max-width: 820px;
            margin: 0 auto;
            padding-left: 12px;
            padding-right: 12px;
            box-sizing: border-box;
        }

        /* Markdown content inside a bubble must never overflow the bubble's own edge — lists in
           particular default to a wide 40px left indent that can push long lines past the
           bubble's max-width. Tighten the indent and force-wrap anything that could overflow
           (long words, code, tables, images). */
        body.ai-chat-page .chat-bubble-body ul,
        body.ai-chat-page .chat-bubble-body ol {
            padding-left: 20px;
            margin: 6px 0;
            max-width: 100%;
        }
        body.ai-chat-page .chat-bubble-body li {
            overflow-wrap: anywhere;
        }
        body.ai-chat-page .chat-bubble-body pre {
            overflow-x: auto;
            max-width: 100%;
        }
        body.ai-chat-page .chat-bubble-body img {
            max-width: 100%;
            height: auto;
        }
        body.ai-chat-page .chat-bubble-body table {
            display: block;
            overflow-x: auto;
            max-width: 100%;
        }
        body.ai-chat-page .chat-composer-outer {
            width: 100%;
            max-width: 820px;
            margin: 0 auto;
            padding-top: 4px;
        }

        /* The pill card. */
        body.ai-chat-page .chat-composer {
            border: 1px solid var(--sl-panel-border-color);
            border-radius: 26px;
            background: var(--sl-panel-background-color, var(--sl-color-neutral-0));
            padding: 12px 16px 10px 16px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        body.ai-chat-page .chat-composer:focus-within {
            border-color: var(--sl-color-primary-400);
        }
        /* Drag-and-drop feedback (class toggled by chat.js). */
        body.ai-chat-page .chat-composer.drag-over {
            border: 1px dashed var(--sl-color-primary-500);
            box-shadow: 0 0 0 3px var(--sl-color-primary-100);
        }

        /* Strip the textarea's own chrome so it melts into the pill. */
        body.ai-chat-page #chat-input::part(base) {
            border: none;
            box-shadow: none;
            background: transparent;
        }
        body.ai-chat-page #chat-input::part(textarea) {
            padding: 2px 4px 6px 4px;
        }

        /* Bottom row inside the pill: "+" left, model label + stop right. */
        body.ai-chat-page .chat-composer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-top: 2px;
        }
        body.ai-chat-page #chat-plus-btn::part(base) {
            border: 1px solid var(--sl-panel-border-color);
            border-radius: 50%;
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }
        body.ai-chat-page #chat-plus-btn::part(base):hover {
            background: var(--sl-color-neutral-100);
        }
        body.ai-chat-page .chat-composer-right {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        body.ai-chat-page #chat-model-label {
            font-size: 0.78rem;
            color: var(--text-secondary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 260px;
            user-select: none;
        }
        body.ai-chat-page #chat-stop {
            font-size: 1.3rem;
            color: var(--sl-color-danger-600);
        }

        /* Save-to-Bee dialog: the search input's prefix (magnifying glass) icon sits flush
           against the field's left edge by default — give it some breathing room. */
        body.ai-chat-page #chat-save-search::part(prefix) {
            margin-left: 6px;
        }

        /* Full-size image lightbox: shrink the dialog's own padding/panel so the image reads as
           the star of the popup, and cap the image to the viewport so a huge image never
           overflows the screen. object-fit:contain preserves aspect ratio at any size. */
        body.ai-chat-page #chat-image-lightbox::part(panel) {
            max-width: 92vw;
        }
        body.ai-chat-page #chat-image-lightbox::part(body) {
            padding: 8px;
            display: flex;
            justify-content: center;
        }
        body.ai-chat-page #chat-lightbox-img {
            display: block;
            max-width: 88vw;
            max-height: 85vh;
            object-fit: contain;
            border-radius: 6px;
        }

        /* Chat images (thumbnails) are clickable — hint it with a pointer cursor. */
        body.ai-chat-page .chat-image-thumb {
            cursor: zoom-in;
        }
    </style>
}
<script>document.body.classList.add('ai-chat-page');</script>
<partial name="_Sidebar" />
<div id="page-content">
<!-- Chat history sidebar: a direct child of #page-content (display:contents in site.css),
     i.e. structurally a flex child of .app-body — the SAME position the global folder-tree
     sidebar (#app-sidebar) occupies on every other page — so it stretches edge-to-edge with
     no gap, unaffected by .main-content's padding. Resizable via a .splitter handle that
     chat.js inserts right after it, and collapsible to width:0. The collapse button lives
     INSIDE this sidebar's own header (next to "New chat"), so it disappears with the rest
     of the content when collapsed — the fixed #chat-sidebar-expand-tab below is what stays
     reachable at the page's edge. Starts with .chat-sidebar-collapsed in markup: this page
     ALWAYS loads collapsed (an earlier deliberate product decision — only the dragged WIDTH
     is persisted across sessions, never the open/closed state). -->
<div id="chat-sidebar" class="chat-sidebar-collapsed">
    <!-- The collapse chevron is independent of "New chat" — anchored to the panel's own
         top-right corner (position:absolute, see the scoped <style> rule) rather than sharing
         a flex row with the button. This lets the button be sized purely by the grid's own
         30px left/right inset (matching #chat-history's rows below it exactly) with no need to
         reserve extra width for the chevron. -->
    <sl-icon-button id="btn-chat-sidebar-collapse" name="chevron-left"
        label="Collapse panel" title="Collapse panel"></sl-icon-button>
    <div style="padding:8px 30px;">
        <sl-button id="chat-new" variant="primary" outline style="width:100%;">
            <sl-icon slot="prefix" name="plus-lg"></sl-icon> New chat
        </sl-button>
    </div>
    <div id="chat-history" style="flex:1;overflow-y:auto;padding:0 10px 8px 10px;"></div>
</div>

<!-- Expand tab: visible from the very first render (the sidebar starts collapsed).
     chat.js toggles its .visible class as the sidebar collapses/expands. -->
<button id="chat-sidebar-expand-tab" class="visible" title="Show chat history"
    aria-label="Expand chat history">
    <sl-icon name="chevron-right"></sl-icon>
</button>

<div class="main-content" style="display:flex;flex-direction:column;min-width:0;">

    <div class="chat-header-row">
        <h2 class="chat-heading"><sl-icon name="chat-left-text"></sl-icon> AI Chat</h2>
    </div>

    <!-- Empty / not-configured states -->
    <div id="chat-empty-state" class="card" style="display:none;text-align:center;padding:32px;margin-bottom:8px;">
        <sl-icon id="chat-empty-icon" name="robot" style="font-size:2rem;color:var(--text-secondary);display:block;margin-bottom:12px;"></sl-icon>
        <p id="chat-empty-text" class="text-muted" style="margin:0;"></p>
    </div>

    <!-- Message list -->
    <div id="chat-messages" style="flex:1;overflow-y:auto;padding:4px 0 8px 0;"></div>

    <!-- Composer: pill card. "+" menu (image attach) bottom-left; effective text-model
         label + streaming Stop button bottom-right. No Send button — Enter sends
         (see chat.js keydown handler). Drag-and-drop an image anywhere on the pill. -->
    <div class="chat-composer-outer">
        <div id="chat-composer" class="chat-composer">
            <div id="chat-attach-preview" style="display:none;margin-bottom:6px;"></div>
            <sl-textarea id="chat-input" placeholder="Ask about your vault, or ask it to create/edit a note…"
                rows="2" resize="auto"></sl-textarea>
            <div class="chat-composer-bottom">
                <sl-dropdown id="chat-plus-dropdown" placement="top-start">
                    <sl-icon-button slot="trigger" id="chat-plus-btn" name="plus-lg"
                        label="Add to chat"></sl-icon-button>
                    <sl-menu id="chat-plus-menu">
                        <sl-menu-item value="add-image">
                            <sl-icon slot="prefix" name="image"></sl-icon> Add image
                        </sl-menu-item>
                    </sl-menu>
                </sl-dropdown>
                <input type="file" id="chat-attach-input"
                    accept="image/png,image/jpeg,image/webp,image/gif" style="display:none;" />
                <div class="chat-composer-right">
                    <span id="chat-model-label" title="Text model (set by admin)"></span>
                    <sl-icon-button id="chat-stop" name="stop-circle-fill"
                        label="Stop generating" style="display:none;"></sl-icon-button>
                </div>
            </div>
        </div>
        <div id="chat-attach-hint" class="text-muted" style="font-size:0.72rem;margin-top:4px;display:none;"></div>
    </div>
</div>
</div>

<!-- Phase 5: "Save to Bee" dialog — uploads a chat image to the vault media store (ACL-checked),
     attached to a user-picked note via the EXISTING /api-proxy/media/upload flow. The note is found
     through the existing /api-proxy/search (no new list endpoint added). -->
<sl-dialog id="chat-save-to-bee" label="Save image to Bee">
    <div style="display:flex;flex-direction:column;gap:10px;">
        <div id="chat-save-preview" style="text-align:center;"></div>
        <p class="text-muted" style="font-size:0.82rem;margin:0;">
            Adds this image to the end of a note you pick, as a new line at the bottom. Folder
            access is checked server-side — only folders you can write to are allowed.
        </p>
        <sl-input id="chat-save-search" placeholder="Search for a note…" clearable>
            <sl-icon slot="prefix" name="search"></sl-icon>
        </sl-input>
        <div id="chat-save-results" style="max-height:220px;overflow:auto;border:1px solid var(--sl-panel-border-color);border-radius:6px;"></div>
        <div id="chat-save-selected" class="text-muted" style="font-size:0.8rem;min-height:1.1rem;"></div>
    </div>
    <sl-button slot="footer" variant="default" data-save-close="1">Cancel</sl-button>
    <sl-button slot="footer" variant="primary" id="chat-save-confirm" disabled>Save</sl-button>
</sl-dialog>

<!-- Full-size image lightbox — click any chat image (uploaded or generated) to open it here.
     The <img> below always reuses the SAME src as the thumbnail (already the full-resolution
     bytes; the thumbnail is only CSS-scaled down), so right-click "Save image as…"/"Copy image"
     here gets the real full-resolution image, not a downscaled copy. no-header matches the
     existing no-header sl-dialog convention (see Admin.cshtml, Setup.cshtml). Closes via the X,
     Escape, or clicking the backdrop — all built into sl-dialog. -->
<sl-dialog id="chat-image-lightbox" no-header style="--width: auto;">
    <img id="chat-lightbox-img" src="" alt="Full-size image" />
</sl-dialog>

@section Scripts {
    <script src="/js/chat.js" asp-append-version="true"></script>
}
