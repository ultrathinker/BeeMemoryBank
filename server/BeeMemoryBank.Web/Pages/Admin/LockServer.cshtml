@page
@model BeeMemoryBank.Web.Pages.Admin.LockServerModel

@section About {
    <p>
        Locking <strong>erases the master encryption key from this node's memory</strong>. Everyone is logged out at once: you, the other users, MCP agents and the mobile apps. Nobody
        can read or edit articles until the vault is opened again. A superadmin who signs in opens it, and after that the server is open for everyone again. Nothing is deleted.
    </p>
    <p>
        Use it when you leave the server unattended and want nobody, not even an agent that is already connected, to get at your data while you are away. Think of it as taking
        the key out of the lock and putting it in your pocket.
    </p>
    <p>
        <strong>Two things can open the vault again without a superadmin signing in</strong>, and the page tells you which of them apply to this node: an <strong>agent key</strong> that
        is allowed to unlock the node by itself (it does so on its next request; revoke it on <a href="/Admin/Agents">Agents</a> if the lock has to hold), and <strong>OS auto-unlock</strong>,
        which reopens the vault when the node restarts (it does not undo a lock while the node keeps running).
    </p>
}

<div class="card mt-md" style="max-width:560px;">
    @if (Model.LockImpact != null)
    {
        var reopeners = Model.LockImpact.Agents;
        <p class="text-muted text-sm" style="margin-bottom:12px;">
            @if (reopeners.Count > 0)
            {
                <text>
                    @reopeners.Count agent @(reopeners.Count == 1 ? "key" : "keys") can unlock this node
                    again on @(reopeners.Count == 1 ? "its" : "their") next request:
                    @string.Join(", ", reopeners.Select(a => a.OwnerName != null ? $"{a.Name} ({a.OwnerName})" : a.Name)).
                    Revoke a key on the <a href="/Admin/Agents">Agents</a> page if the lock has to hold.
                </text>
            }
            else
            {
                <text>Nothing can auto-unlock this node &mdash; no agent key here carries the master key.</text>
            }
        </p>
        @if (Model.LockImpact.OsAutoUnlockEnabled)
        {
            <p class="text-muted text-sm" style="margin-bottom:12px;">
                OS auto-unlock is enabled, so restarting this node opens the vault again without a
                password. It does not undo a lock while the node keeps running.
            </p>
        }
    }
    @* A POST with the antiforgery token: a link or a prefetch of /Lock only shows its confirmation page, it never locks. *@
    <form method="post" asp-page="/Lock" data-busy-exempt="signs everyone out: the answer is the sign-in page">
        <sl-button type="submit" variant="warning" size="small" class="btn-confirm-click"
            data-confirm="Lock the server? The decryption key will be cleared from memory. All users will need to re-authenticate to access encrypted content.">
            <sl-icon slot="prefix" name="lock"></sl-icon> Lock Server
        </sl-button>
    </form>
</div>
