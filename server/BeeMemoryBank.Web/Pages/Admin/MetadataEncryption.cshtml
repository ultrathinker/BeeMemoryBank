@page
@using System.Text.Json
@model BeeMemoryBank.Web.Pages.Admin.MetadataEncryptionModel
@{
    // docs/design/step-a-spec.md 5.3, 5.4: the readiness report, the blockers in words and the one-way switch.
    // BMB-305: a finished switch is one status line, nothing else. BMB-303: what "Ask every device now" found sits next to its button, and a refused switch
    // leaves the form where it was.
    var report = Model.MetadataReadiness;
    var activated = report is { } r0 && r0.TryGetProperty("activated", out var a0) && a0.GetBoolean();
    var checkedAll = Model.MetadataReadinessCheckedAll;
    var ready = report is { } r1 && r1.TryGetProperty("ready", out var ready0) && ready0.GetBoolean();
    // The node refused the switch (the answer is kept with this mark): the form stays, with the list of what stands in the way, so that it can be pressed again.
    var refused = report is { } r2 && r2.TryGetProperty("refused", out var refused0) && refused0.ValueKind == JsonValueKind.True;
    static string StatusWords(string? status) => status switch
    {
        "ready" => "ready",
        "not_capable" => "runs an older version: update it to 2.6.0 or newer",
        "stale" => "not seen for more than 14 days",
        _ => "never seen by this node or the devices it asked",
    };
    static string BlockerWords(JsonElement b)
    {
        var code = b.GetProperty("code").GetString();
        var name = b.TryGetProperty("display_name", out var n) && n.ValueKind == JsonValueKind.String ? n.GetString() : null;
        return code switch
        {
            "peer_not_ready" => $"{name}: {StatusWords(b.TryGetProperty("status", out var s) ? s.GetString() : null)}",
            "vault_locked" => "This node is locked.",
            "not_superadmin" => "A device does not see this node as a superadmin.",
            "rotation_pending" => "A key rotation is in progress; finish or cancel it first.",
            "events_held" => "This node holds changes it has not applied yet. Unlock it and wait until they are applied.",
            "already_activated" => "Metadata encryption is already on.",
            _ => code ?? "",
        };
    }
    static string Since(JsonElement activation)
    {
        if (activation.ValueKind != JsonValueKind.Object || !activation.TryGetProperty("activated_at", out var at) || at.ValueKind != JsonValueKind.String) return "";
        var raw = at.GetString();
        return DateTimeOffset.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.AssumeUniversal, out var when)
            ? $" since {when.UtcDateTime:yyyy-MM-dd HH:mm} UTC"
            : $" since {raw}";
    }
}

@section About {
    @if (activated)
    {
        <p>
            Metadata encryption is <strong>on</strong> for this network. The titles of articles, the names of folders and tags, file names and the shape of the tree are encrypted when they
            travel between devices and in blind copies, so a blind copy or a relay no longer sees them (it still learns sizes, counts, timing and the names of the devices). A full node still
            keeps titles readable in its own database, because it shows and searches them. The switch was one way: there is no off switch.
        </p>
        <p>
            Copies made before the switch (old snapshots, earlier blind copies, a backup you took first) still hold titles in clear. Retire them yourself, or keep them as carefully as the
            backup.
        </p>
    }
    else
    {
        <p>
            Until it is switched on, the <strong>titles of your articles, the names of folders and tags, file names and the shape of the tree</strong> travel between your devices in clear,
            and blind copies (the blind node, phones, desktop blind copies) store them readable. Switching metadata encryption on encrypts all of that for the whole network, so a blind copy
            or a relay no longer sees it (it still learns sizes, counts, timing and the names of the devices). A full node still keeps titles readable in its own database, because it shows and searches them. It needs every device on version
            2.6.0 or newer; a device on an older version stops syncing until it is updated.
        </p>
        <p class="admin-warning">
            <strong>The switch is one way.</strong> There is no off switch, and going back is not possible from the node.
            Before you switch it on, take a fresh backup of this node and keep it offline.
            The backup holds your titles in clear, so it is yours to keep, and the node will not restore it.
        </p>
        <p>
            The page first asks every device whether it is ready. Only when every device is ready, and nothing else stands in the way (this node locked, a key rotation under way, changes held
            that were not applied), does it offer the switch, which asks for your master password. Every other device then switches as it syncs. A device you no longer use should be revoked
            (<a href="/Admin/TrustedNodes">Trusted Nodes</a>); it then no longer counts.
        </p>
    }
}

@if (Model.HeldEvents is { } held && held.TryGetProperty("count", out var heldCount) && heldCount.GetInt32() > 0)
{
    <p class="text-sm" style="margin-bottom:12px;">
        <sl-icon name="hourglass-split"></sl-icon>
        @heldCount.GetInt32() @(heldCount.GetInt32() == 1 ? "change waits" : "changes wait") for unlock: this node has received
        @(heldCount.GetInt32() == 1 ? "it" : "them") and passes @(heldCount.GetInt32() == 1 ? "it" : "them") on, and applies
        @(heldCount.GetInt32() == 1 ? "it" : "them") once it is unlocked.
    </p>
}

<div class="card mt-md" id="metadata-card" style="max-width:760px;">
    @if (report is null)
    {
        <p class="text-muted text-sm">The state of metadata encryption is unavailable right now.</p>
    }
    else if (activated)
    {
        <p class="text-sm" id="metadata-status" style="margin:0;">
            <sl-icon name="check-circle" style="color:var(--sl-color-success-600);vertical-align:-2px;"></sl-icon>
            <strong>On</strong>@Since(report.Value.GetProperty("activation")).
        </p>
    }
    else
    {
        @* The button, and next to it what it found: the answer is not at the other end of the page, and while the devices answer (up to ten
           seconds) the button says so. *@
        <form method="post" asp-page-handler="CheckMetadataReadiness" id="metadata-ask-form" data-busy="short"
              style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px;">
            <sl-button type="submit" size="small" variant="default">
                <sl-icon slot="prefix" name="arrow-repeat"></sl-icon> Ask every device now
            </sl-button>
            <span class="text-muted text-sm" data-busy-note hidden role="status">Asking every device. This can take up to 10 seconds.</span>
            @if (Model.MetadataAskSummary is { } summary)
            {
                <span class="text-sm" id="metadata-ask-result" role="status">@summary</span>
            }
        </form>

        var peers = report.Value.GetProperty("peers");
        if (peers.GetArrayLength() > 0)
        {
            <table class="table text-sm" style="margin-bottom:12px;">
                <thead><tr><th>Device</th><th>Kind</th><th>Status</th><th>Version</th><th>Last seen</th></tr></thead>
                <tbody>
                @foreach (var p in peers.EnumerateArray())
                {
                    var status = p.GetProperty("status").GetString();
                    <tr>
                        <td>@p.GetProperty("display_name").GetString()</td>
                        <td>@(p.GetProperty("kind").GetString() == "blind" ? "blind copy" : "full node")</td>
                        <td>@StatusWords(status)</td>
                        <td>@(p.GetProperty("app_version").ValueKind == JsonValueKind.String ? p.GetProperty("app_version").GetString() : "-")</td>
                        <td>@(p.GetProperty("seen_at").ValueKind == JsonValueKind.String ? p.GetProperty("seen_at").GetString() : "never")</td>
                    </tr>
                }
                </tbody>
            </table>
        }

        var blockers = report.Value.GetProperty("blockers");
        if (blockers.GetArrayLength() > 0)
        {
            <p class="text-sm" style="margin-bottom:4px;"><strong>Not yet:</strong></p>
            <ul class="text-sm" id="metadata-blockers" style="margin-bottom:12px;">
                @foreach (var b in blockers.EnumerateArray())
                {
                    <li>@BlockerWords(b)</li>
                }
            </ul>
        }

        if (checkedAll && (ready || refused))
        {
            <form method="post" asp-page-handler="ActivateMetadata" id="metadata-activate-form" data-busy="long" data-busy-title="Switching on metadata encryption" style="display:flex;flex-direction:column;gap:12px;">
                <sl-checkbox name="backupTaken" value="true" required>I took a fresh backup of this node and keep it offline</sl-checkbox>
                <sl-input name="masterPassword" type="password" password-toggle autocomplete="off"
                          data-1p-ignore data-lpignore="true" required
                          label="Master password"></sl-input>
                <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                    <sl-button type="submit" variant="danger" class="btn-confirm-click"
                        data-confirm="Switch metadata encryption on for the whole network? This cannot be undone, and going back is not possible from the node.">
                        <sl-icon slot="prefix" name="shield-lock"></sl-icon> Switch metadata encryption on
                    </sl-button>
                    <span class="text-muted text-sm" data-busy-note hidden role="status">Switching metadata encryption on...</span>
                </div>
            </form>
        }
    }
</div>
