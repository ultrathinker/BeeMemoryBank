@page
@model BeeMemoryBank.Web.Pages.Admin.AgentsModel

@section About {
    <p>
        An <strong>agent</strong> is a key that lets an AI assistant (or a script) reach this vault through the MCP interface. This page lists the agents of <em>every</em> user: its name, its owner, the
        start of its key, when it was last used and how many requests it has made. <strong>Revoking</strong> an agent (the bin) stops its key from working at once, and cannot be undone: it needs
        a new agent and a new key.
    </p>
    <p>
        An agent has <strong>no access rules of its own</strong>: it can do exactly what the user it belongs to can do. If that user may see only some folders, or may only read, so can the agent.
        An agent owned by a superadmin has no restrictions at all. To limit an agent, limit its owner on the <a href="/Users">Users</a> page. The <em>Auto-unlock</em> column marks agents that can
        wake a locked node by themselves, which only a superadmin's agent can; they are why a lock can be undone from outside (see <a href="/Admin/LockServer">Lock Server</a>).
    </p>
    <p>
        New agents are not created here: a person makes their own on their <a href="/Profile">Profile</a> page, where the full key is shown <strong>once</strong>.
    </p>
}

@if (Model.Agents != null && Model.Agents.Count > 0)
{
    <div class="card" style="padding:0;overflow:hidden;">
        @* Like Trusted Nodes (site.css, Admin): the columns follow the width of the card. Below 1060px the key prefix and the date created go (they are in the title of the
           name), below 860px a row stacks with the label of each cell, and the Delete button is never hidden. *@
        <table class="version-table admin-stack">
            <thead>
                <tr>
                    <th class="col-name">Name</th>
                    <th class="col-desc">Description</th>
                    <th class="col-owner">Owner</th>
                    <th class="hide-lt-1060">API Key</th>
                    <th class="col-unlock">
                        Auto-unlock
                        <sl-tooltip content="Whether this key can wake a locked node by itself. Only a superadmin's agent can — an ordinary user's agent only works while the vault is already unlocked by someone else.">
                            <sl-icon name="info-circle"></sl-icon>
                        </sl-tooltip>
                    </th>
                    <th class="hide-lt-1060">Created</th>
                    <th>Last Access</th>
                    <th>Requests</th>
                    <th class="col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var agent in Model.Agents)
                {
                    <tr>
                        <td class="col-name"><strong title="API key @agent.KeyPrefix, created @agent.CreatedAt.ToString("g")">@agent.Name</strong></td>
                        <td class="col-desc text-muted text-sm" data-label="Description">@(agent.Description ?? "—")</td>
                        <td class="col-owner text-muted text-sm" data-label="Owner">@(agent.OwnerName ?? (agent.OwnerUserId > 0 ? $"#{agent.OwnerUserId}" : "—"))</td>
                        <td class="hide-lt-1060"><code class="text-sm">@agent.KeyPrefix</code></td>
                        <td class="col-unlock" data-label="Auto-unlock">
                            @if (agent.CanAutoUnlock)
                            {
                                <sl-badge variant="warning" pill>Yes</sl-badge>
                            }
                            else
                            {
                                <span class="text-muted text-sm">No</span>
                            }
                        </td>
                        <td class="hide-lt-1060 text-muted text-sm">@agent.CreatedAt.ToString("g")</td>
                        <td class="text-muted text-sm" data-label="Last access">@AdminText.RelativeTime(agent.LastAccessedAt)</td>
                        <td class="text-muted text-sm" data-label="Requests">@(agent.RequestCount == 0 ? "—" : agent.RequestCount.ToString("N0"))</td>
                        <td class="col-actions">
                            <div class="row-actions">
                                <form data-busy="short" method="post" asp-page-handler="DeleteAgent" style="display:inline;">
                                    <input type="hidden" name="agentId" value="@agent.Id" />
                                    <sl-icon-button name="trash" label="Delete"
                                        class="btn-confirm-submit"
                                        data-confirm-pattern="Delete agent {name}?"
                                        data-name="@agent.Name">
                                    </sl-icon-button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card" style="text-align:center;padding:40px;">
        <sl-icon name="robot" style="font-size:2rem;color:var(--text-secondary);display:block;margin-bottom:12px;"></sl-icon>
        <p class="text-muted">No agents</p>
    </div>
}
