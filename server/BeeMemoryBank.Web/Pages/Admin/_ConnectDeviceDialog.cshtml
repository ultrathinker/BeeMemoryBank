@model BeeMemoryBank.Web.Pages.Admin.DevicesModel
@* "Connect a device": the content of the page of that name before the Devices section, as a dialog of Admin > Devices. Opening the page, or the dialog, opens nothing; only the
   button inside it does (a POST). The page answers the buttons of the dialog with the dialog open.
   one plain sentence per state for people who are not in IT; ports, firewall rules and the other computer's steps are folded under "More details". *@
<sl-dialog id="dlg-connect-device" label="Connect a device" class="connect-dialog" open="@Model.ConnectOpen">
    <div id="connect-device-body">
        @if (Model.Lan.Error != null)
        {
            <sl-alert variant="danger" open style="margin-bottom:16px;">
                <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
                @Model.Lan.Error
            </sl-alert>
        }

        @if (Model.Lan.Mode == "unavailable")
        {
            <sl-alert variant="warning" open style="margin-bottom:16px;">
                <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                <strong>This server cannot show a code to scan.</strong> Connect the other device by this server's web address instead.
                <details class="admin-more">
                    <summary>More details</summary>
                    <p>Connecting a device with a code works in the Bee Memory Bank apps for Windows and Mac and in the Windows service.
                       With Docker, the published ports in <code>docker-compose.yml</code> decide what other computers can reach
                       (see <code>docs/deployment.md</code>).</p>
                    <p>To join this server from a computer without a code: on that computer's first-run page choose
                       <strong>Connect to another device</strong>, leave the join code empty and type this server's web address
                       (the address of this page without <code>/Admin/Devices</code>) under <strong>Address of the other device</strong>.
                       Then enter this server's user name and password, a password hint and a name for the computer. The address has to be
                       reachable from that computer: the reverse proxy in front of this server must forward <code>/api/join</code>
                       (and allow that computer's address, if the proxy limits access).</p>
                </details>
            </sl-alert>
        }
        else
        {
            <p id="connect-wording" style="margin:0 0 12px;line-height:1.5;">
                Scan this code with the Bee Memory Bank app on your phone.
            </p>

            @if (Model.Lan.FirewallManaged && !Model.Lan.FirewallRule)
            {
                <div id="connect-firewall" style="border:1px solid var(--sl-color-warning-600);border-radius:10px;padding:16px;margin-bottom:16px;font-size:0.9rem;line-height:1.5;">
                    <p style="margin:0 0 10px;"><strong>Allow your phone to reach this computer.</strong> Windows asks for permission once.</p>
                    <form data-busy="short" method="post" asp-page-handler="Firewall">
                        <sl-button type="submit" variant="default">
                            <sl-icon slot="prefix" name="shield-check"></sl-icon>
                            Allow&hellip;
                        </sl-button>
                    </form>
                    <details class="admin-more">
                        <summary>More details</summary>
                        <p>Bee Memory Bank adds one rule to Windows Firewall so that devices on your home network can reach this computer
                           on port @Model.Lan.Port. Windows asks for administrator permission. This happens once, and Bee Memory Bank
                           never changes the firewall without asking.</p>
                    </details>
                </div>
            }

            @if (Model.Lan.Platform == "macos")
            {
                <p class="text-muted text-sm" style="margin:0 0 12px;">When your phone connects for the first time, your Mac asks whether Bee Memory Bank
                   may accept connections. Choose <strong>Allow</strong>.</p>
            }
            else if (!Model.Lan.FirewallManaged && Model.Lan.Platform == "windows")
            {
                <p class="text-muted text-sm" style="margin:0 0 4px;">If your phone cannot connect, Windows Firewall may be blocking it.</p>
                <details class="admin-more">
                    <summary>More details</summary>
                    <p>This is the Windows service: the firewall is not changed from here. The installer's
                       &ldquo;Configure Windows Firewall Exception&rdquo; option opens port @Model.Lan.Port. If you did not
                       choose it, add an inbound rule for TCP @Model.Lan.Port yourself.</p>
                </details>
            }

            @if (!Model.Lan.Active && Model.Lan.Setting == "on")
            {
                <sl-alert variant="danger" open style="margin-bottom:16px;">
                    <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
                    <strong>This computer cannot accept devices right now.</strong>
                    <details class="admin-more">
                        <summary>More details</summary>
                        <p>Bee Memory Bank could not open port @Model.Lan.Port: another program may be using it.
                           See <a href="@AdminRoutes.NetworkSettings">Network settings</a>.</p>
                    </details>
                </sl-alert>
            }
            else if (!Model.Lan.Active)
            {
                <p class="text-muted text-sm" style="margin:0 0 12px;">Show a code, then scan it with your phone.</p>
                <form data-busy="short" method="post" asp-page-handler="Enable">
                    <sl-button type="submit" variant="primary" size="small" id="btn-open-door">
                        <sl-icon slot="prefix" name="phone"></sl-icon>
                        Show a join code
                    </sl-button>
                </form>
                <details class="admin-more">
                    <summary>More details</summary>
                    <p>The code works for 15 minutes, for one device. It stops working by itself once the device has joined or the time
                       is up. Your vault stays unlocked meanwhile.</p>
                </details>
            }
            else if (Model.HasLanAddress)
            {
                @if (Model.Lan.ExpiresAt is { } expiresAt)
                {
                    <p class="text-muted text-sm" style="margin:0 0 12px;">Works until @expiresAt.ToLocalTime().ToString("HH:mm").</p>
                }
                else if (Model.Lan.Mode == "permanent")
                {
                    <p class="text-muted text-sm" style="margin:0 0 12px;">This code does not expire.</p>
                }
                @foreach (var ep in Model.Endpoints)
                {
                    <div class="connect-endpoint" style="display:flex;flex-direction:column;align-items:center;gap:12px;border:1px solid var(--border);border-radius:10px;padding:20px;margin-bottom:16px;background:var(--bg-app);">
                        <img src="@ep.QrDataUri" alt="Join code for @ep.Url" style="width:256px;height:256px;max-width:100%;image-rendering:pixelated;" />
                        <sl-copy-button value="@ep.Code" copy-label="Copy join code"></sl-copy-button>
                    </div>
                }
                <div class="admin-notes text-muted text-sm" style="line-height:1.5;">
                    <p>On your phone: open Bee Memory Bank, choose <strong>Connect</strong>, tap <strong>Scan QR code</strong>
                       and enter the master password of this computer.</p>
                    <details class="admin-more">
                        <summary>More details</summary>
                        @foreach (var ep in Model.Endpoints)
                        {
                            <p><span style="font-family:monospace;word-break:break-all;">@ep.Url</span><br />
                               <code style="font-size:0.72rem;overflow-wrap:anywhere;">@ep.Code</code></p>
                        }
                        <p>Instead of scanning, you can copy the code and paste it on the phone. The phone checks this computer's key from
                           the code before it sends the password anywhere.</p>
                        <p>On another computer running Bee Memory Bank: open its first-run page, choose <strong>Connect to another device</strong>,
                           paste this code and enter the master password. With <code>bmb join</code>, use <code>--code</code>.</p>
                        <p>Once connected, the devices keep in step by themselves: directly when both are on your home network, and through
                           your server or blind node when they are apart. Your web page stays private.</p>
                        @if (Model.Lan.Mode == "permanent")
                        {
                            <p>The code does not expire because this computer is shown on your network
                               (<a href="@AdminRoutes.NetworkSettings">Network settings</a>).</p>
                        }
                    </details>
                </div>
                @if (Model.Lan.Mode == "on-demand")
                {
                    <form data-busy="short" method="post" asp-page-handler="Disable" style="margin-top:12px;">
                        <sl-button type="submit" variant="default" size="small">Stop</sl-button>
                    </form>
                }
            }
            else
            {
                <p class="text-muted" style="text-align:center;padding:24px 0;">This computer is not connected to a network. Connect it to Wi-Fi and try again.</p>
            }
        }
    </div>
    <sl-button type="button" slot="footer" variant="default" data-dlg-cancel="dlg-connect-device">Close</sl-button>
</sl-dialog>
