@model BeeMemoryBank.Web.Pages.Admin.AdminPageModel
@{
    var isPasswordPage = string.Equals(ViewContext.RouteData.Values["page"] as string, BeeMemoryBank.Web.Pages.Admin.AdminRoutes.MasterPassword, StringComparison.OrdinalIgnoreCase);
}
@* Key slots are node-local, so a password change on one node leaves every other node accepting
   the OLD password - including at its own join endpoint, which is what grants mesh membership.
   The notice is set by the master_password_changed sync event and cleared by changing the
   password on the Master Password page; it carries no key material, which is why a human has to close the gap. *@
@if (Model.MasterPasswordNotice is { IsStale: true } notice)
{
    <sl-alert id="master-password-notice" variant="warning" open style="margin-bottom:16px;">
        <sl-icon slot="icon" name="key"></sl-icon>
        <strong>This node still uses the old master password.</strong><br />
        It was changed on <strong>@(notice.ChangedByNode ?? "another node")</strong>
        @(notice.ChangedAt.HasValue ? $"on {notice.ChangedAt.Value.ToLocalTime():g}" : "").
        Until you change it here too, this node keeps accepting the old password - including at its
        own join endpoint, which is how a new node becomes a full member of the network.
        @if (isPasswordPage)
        {
            <text>Change it below.</text>
        }
        else
        {
            <text>Change it on the <a href="/Admin/MasterPassword">Master Password</a> page.</text>
        }
        @* Dismissal is the honest answer to a question the event cannot answer. The peer announced
           a change; nothing in the announcement says whether it moved to the same password this
           node is already on. Without this the warning survived the operator doing exactly what it
           asked, on every node but the last one they touched. *@
        <form data-busy="short" method="post" asp-page-handler="DismissPasswordNotice" style="margin-top:10px;">
            <sl-button type="submit" size="small" variant="warning" outline>
                Already changed here &mdash; dismiss
            </sl-button>
        </form>
    </sl-alert>
}
