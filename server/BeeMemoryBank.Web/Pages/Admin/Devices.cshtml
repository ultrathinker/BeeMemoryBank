@page
@using BeeMemoryBank.Web.Services
@model BeeMemoryBank.Web.Pages.Admin.DevicesModel
@{
    var self = Model.Network?.Self;
    var lan = Model.LanSync;
}

@section About {
    <p>Your devices that keep in step with this one: computers, phones and blind nodes.</p>
    <details class="admin-more">
        <summary>More details</summary>
        <p>
            These are the devices that belong to this network: the computers, servers and phones this node syncs with, and the blind nodes that keep its encrypted
            backups. A device that is not on this list is not accepted, and a device that is revoked stops being accepted by every node that receives the revocation.
            Each row says in one sentence how this node reaches the device: directly on this network, directly over the internet, through another device, or not at all.
        </p>
        <p>
            <strong>Being away is not a fault.</strong> A laptop on a trip is &ldquo;Not on this network&rdquo; and, when another device has seen it, &ldquo;reachable through&rdquo;
            that device; it catches up when it is back. Only a device nobody has heard from for three days, or one this node calls and gets no answer from, is marked as an
            alarm. Open a device for its addresses, what it may do on its own, and how its certificate is trusted.
            To mirror selected folders read-only from a different Bee Memory Bank, use <a href="/RemoteAccounts">Remote Accounts</a>.
        </p>
    </details>
}

@if (Model.ShowLanNotice)
{
    @* D9: LAN sync is on by default after the update; said once. *@
    <sl-alert id="lan-notice" variant="primary" open style="margin-bottom:16px;">
        <sl-icon slot="icon" name="info-circle"></sl-icon>
        <strong>Direct sync with your devices on this network is on.</strong>
        <details class="admin-more">
            <summary>More details</summary>
            <p>Devices already paired with this one keep in step with it directly on a network you trust, without your server. Only the sync connection is opened,
               never the web page. You can change it under <a href="@AdminRoutes.NetworkSettings">Network settings</a>.</p>
        </details>
        <form data-busy="short" method="post" asp-page-handler="DismissLanNotice" style="margin-top:8px;">
            <sl-button type="submit" size="small">Got it</sl-button>
        </form>
    </sl-alert>
}

<div class="devices-actions">
    <sl-button variant="primary" size="small" class="btn-open-dialog" id="btn-connect-device" data-dialog-id="dlg-connect-device">
        <sl-icon slot="prefix" name="phone"></sl-icon> Connect a device
    </sl-button>
    <sl-button size="small" id="btn-add-blind-node" href="@AdminRoutes.BlindNodes">
        <sl-icon slot="prefix" name="shield-lock"></sl-icon> Add a blind node
    </sl-button>
</div>

<div class="card devices-self" id="this-device">
    <h3 class="devices-card-title"><sl-icon name="laptop"></sl-icon> This device</h3>
    @if (self is not null || Model.Identity is not null)
    {
        var name = self?.DisplayName ?? Model.Identity!.DisplayName;
        <p class="devices-self-line" id="this-device-line">
            <strong>@name</strong>
            @if (self is not null)
            {
                <span class="text-muted">&middot; @DeviceRows.KindOf(self)@(DeviceRows.PlatformOf(self) is { } platform ? " (" + platform + ")" : "") &middot; @DeviceRows.VersionOf(self)</span>
            }
            @if (Model.SharedDoors?.IsThisNodeShared == true)
            {
                <sl-badge variant="neutral" pill style="margin-left:6px;">shared</sl-badge>
            }
            @if (Model.SharedDoors?.IsThisNodeAccountsHome == true)
            {
                <sl-badge variant="primary" pill style="margin-left:4px;">accounts node</sl-badge>
            }
        </p>
    }
    @if (lan is not null)
    {
        <p class="devices-self-line" id="this-device-network">
            <span class="text-muted">On this network:</span> @LanNetworkWords.Networks(lan) &middot; @LanNetworkWords.Listening(lan).
            <a href="@AdminRoutes.NetworkSettings">Network settings</a>
        </p>
    }
    else if (!Model.Lan.IsAvailable)
    {
        <p class="devices-self-line text-muted text-sm" id="this-device-network">
            Devices reach this server through its web address. <a href="@AdminRoutes.NetworkSettings">Network settings</a>
        </p>
        <details class="admin-more">
            <summary>More details</summary>
            <p>This node is not the desktop app, so it has no LAN listener of its own: which computers can reach it is decided by how it was started.
               Network settings says what applies.</p>
        </details>
    }
    @if (Model.RestoredPeers.Count > 0)
    {
        <p class="devices-self-line" id="restored-devices-notice">
            <sl-icon name="shield-exclamation" style="color:var(--sl-color-warning-600);"></sl-icon>
            Restored devices waiting for confirmation: <strong>@Model.RestoredPeers.Count</strong> <a href="#restored-peers">Review</a>
        </p>
    }
    @if (Model.Identity is { } identity)
    {
        <details class="devices-identity" id="node-identity">
            <summary>Identity of this node</summary>
            <p class="text-muted text-sm" style="margin:8px 0;">
                Nothing here is secret. Use it to check that a device you are pairing is the one you think it is.
            </p>
            <details class="admin-more">
                <summary>More details</summary>
                <p>The ID names this node in the lists of the other nodes and in the log of changes; they check every change from this node against the public key.
                   Nothing here can be changed. A node that is wiped, or restored from a snapshot as a new node, gets a new identity.</p>
            </details>
            <div class="article-meta">
                <span><strong>ID:</strong>
                    <span class="article-id-badge" title="Click to copy" data-bmb-copy="@identity.NodeId">@identity.NodeId</span>
                </span>
            </div>
            <div style="margin-top:12px;">
                <label class="text-sm text-muted">Ed25519 Public Key</label>
                <div style="display:flex;align-items:center;gap:8px;margin-top:4px;">
                    <code style="font-size:0.78rem;word-break:break-all;flex:1;" id="pubkey-val">@identity.Ed25519PublicKeyB64</code>
                    <sl-icon-button id="btn-copy-pubkey" class="btn-copy-pubkey" data-target="pubkey-val" name="clipboard" label="Copy"></sl-icon-button>
                </div>
            </div>
        </details>
    }
</div>

@if (Model.PasswordPeersToPromote.Count > 0)
{
    <!-- BMB-42: devices joined before "whoever knows the master password is a superadmin"; the card is here only while there are any -->
    <div class="card" id="promote-password-peers" style="margin-bottom:16px;border-color:var(--sl-color-warning-600);">
        <h3 class="devices-card-title"><sl-icon name="shield-check"></sl-icon> Grant superadmin to devices joined with the password</h3>
        <sl-alert variant="warning" open style="margin-bottom:12px;">
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            <strong>@Model.PasswordPeersToPromote.Count device(s) need full rights so that all copies stay the same.</strong>
        </sl-alert>
        <details class="admin-more" style="margin-bottom:12px;">
            <summary>More details</summary>
            <p>These devices joined with the master password but are not superadmins yet. Whoever knows the master password is a superadmin. These devices joined
               before that rule, so the network still treats them as ordinary peers: a hard delete or a password change made on them is applied there but refused
               everywhere else, and the copies drift apart. Granting them superadmin tells every node, one device at a time.</p>
            <p>If you demoted one of these devices on purpose, untick it. Blind nodes never appear here.</p>
        </details>
        <form data-busy="short" method="post" asp-page-handler="PromotePasswordPeers">
            @foreach (var c in Model.PasswordPeersToPromote)
            {
                <div style="margin-bottom:8px;">
                    <label>
                        <input type="checkbox" name="nodeIds" value="@c.NodeId" checked />
                        <strong>@c.DisplayName</strong>
                        <code class="text-sm">@c.NodeId.ToString()[..8]&hellip;</code>
                        <span class="text-muted text-sm">@(c.ApiAddress ?? "")</span>
                    </label>
                </div>
            }
            <div style="margin-top:16px;">
                <sl-button type="submit" variant="warning" size="small">
                    <sl-icon slot="prefix" name="shield-check"></sl-icon> Grant superadmin to the ticked devices
                </sl-button>
            </div>
        </form>
    </div>
}

@if (Model.SharedDoors is { ShouldOfferAccountsHome: true } sd)
{
    <div class="card" id="accounts-home-card" style="margin-bottom:16px;">
        <h3 class="devices-card-title"><sl-icon name="people"></sl-icon> People are managed on this node</h3>
        <p class="text-muted text-sm" style="margin:0 0 10px;">
            Only one full node manages user accounts and issues superadmin doors for shared backup nodes. The accounts node is <strong>shared</strong> by definition.
        </p>
        @if (sd.AccountsHomeChanged)
        {
            <sl-alert id="accounts-home-changed" variant="warning" open style="margin-bottom:10px;">
                <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                The accounts node was changed from another node. If nobody you trust did that, check the audit log and the Devices list.
                <form data-busy="short" method="post" asp-page-handler="AcknowledgeAccountsHomeChange" style="display:inline;margin-left:8px;">
                    <sl-button type="submit" size="small">Acknowledge</sl-button>
                </form>
            </sl-alert>
        }
        @if (!string.IsNullOrWhiteSpace(sd.LastError))
        {
            <sl-alert id="shared-doors-apply-error" variant="danger" open style="margin-bottom:10px;">
                <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                @sd.LastError
            </sl-alert>
        }
        @if (sd.BlockedSharedNodes.Count > 0)
        {
            var blockerNames = string.Join(", ", sd.BlockedSharedNodes.Select(b => b.DisplayName));
            <sl-alert id="shared-doors-capability-warning" variant="warning" open style="margin-bottom:10px;">
                <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                Update shared node(s) before superadmin doors can be published: <strong>@blockerNames</strong>.
            </sl-alert>
        }
        @if ((sd.SkippedSharedNodes?.Count ?? 0) > 0)
        {
            var skippedNames = string.Join(", ", sd.SkippedSharedNodes!.Select(b => b.DisplayName));
            <sl-alert id="shared-doors-skipped-warning" variant="warning" open style="margin-bottom:10px;">
                <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                Skipped shared node(s) with an unusable public key during superadmin doors publish: <strong>@skippedNames</strong>.
            </sl-alert>
        }
        <form data-busy="short" method="post" asp-page-handler="SetAccountsHome" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <select name="nodeId" class="form-control" style="max-width:300px;">
                @if (Model.Identity is { } local && !BeeMemoryBank.Core.Models.BlindNodeId.IsBlind(local.NodeId))
                {
                    <option value="@local.NodeId" selected="@(sd.AccountsHomeNodeId == local.NodeId)">@local.DisplayName (this node)</option>
                }
                @foreach (var peer in Model.Whitelist.Where(e => e.Status == "A" && !BeeMemoryBank.Core.Models.BlindNodeId.IsBlind(e.NodeId) && e.NodeId != Model.Identity?.NodeId))
                {
                    <option value="@peer.NodeId" selected="@(sd.AccountsHomeNodeId == peer.NodeId)">@peer.DisplayName</option>
                }
            </select>
            <sl-button type="submit" size="small" variant="primary" id="btn-set-accounts-home">Save</sl-button>
        </form>
    </div>
}

@if (Model.ShowOwnershipReviewCard)
{
    <div class="card" id="ownership-review" style="margin-bottom:16px;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:8px;">
            <h3 class="devices-card-title" style="margin:0;"><sl-icon name="person-check"></sl-icon> Confirm who owns existing devices</h3>
            <form data-busy="short" method="post" asp-page-handler="ConfirmAllOwnership" style="display:inline;">
                <sl-button type="submit" size="small" variant="primary" id="btn-confirm-all-ownership">Confirm all suggested</sl-button>
            </form>
        </div>
        <p class="text-muted text-sm" style="margin:0 0 12px;">
            Confirm whether each upgraded device is shared infrastructure or belongs to a specific person.
        </p>
        @foreach (var entry in Model.OwnershipReviewEntries)
        {
            var selectedChoice = BeeMemoryBank.Web.Pages.Admin.DevicesModel.OwnershipChoiceValue(entry);
            <form data-busy="short" method="post" asp-page-handler="ConfirmOwnership" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px;">
                <input type="hidden" name="nodeId" value="@entry.NodeId" />
                <span style="min-width:160px;"><strong>@entry.DisplayName</strong></span>
                <select name="choice" class="form-control" style="max-width:260px;">
                    <option value="shared" selected="@(selectedChoice == "shared")">Shared infrastructure</option>
                    @foreach (var user in Model.Users)
                    {
                        var val = $"personal:{user.PersonId}";
                        var label = string.IsNullOrWhiteSpace(user.DisplayName) ? user.Username : user.DisplayName;
                        <option value="@val" selected="@(selectedChoice == val)">Personal: @label</option>
                    }
                </select>
                <sl-button type="submit" size="small">Confirm</sl-button>
            </form>
        }
    </div>
}

@if (Model.RestoredPeers.Count > 0)
{
    <div class="card" id="restored-peers" style="margin-bottom:16px;">
        <h3 class="devices-card-title"><sl-icon name="shield-exclamation"></sl-icon> Restored devices waiting for your confirmation</h3>
        <p class="text-muted text-sm" style="margin:0 0 8px;">
            These devices came back from a restore switched off. Confirm the ones you recognise.
        </p>
        <details class="admin-more">
            <summary>More details</summary>
            <p>A restore gave this node back the devices it trusted. A device with proof (an integrity anchor signed under your master key) came back switched on. These came back
               <strong>switched off</strong>: they cannot sign in with their key, sync or write anything here until you decide. A confirmed device does not get
               superadmin rights back by itself (open it to promote it). For a device you do not recognise, do nothing: it stays off, and it can join again by being paired from scratch.</p>
        </details>
        @foreach (var peer in Model.RestoredPeers)
        {
            <div style="display:flex;align-items:center;gap:12px;margin-top:8px;flex-wrap:wrap;">
                <span style="flex:1;min-width:200px;overflow-wrap:anywhere;"><strong>@peer.DisplayName</strong> <code style="font-size:0.78rem;">@peer.NodeId</code> @peer.ApiAddress</span>
                <form data-busy="short" method="post" asp-page-handler="ConfirmRestoredPeer" style="display:inline;">
                    <input type="hidden" name="nodeId" value="@peer.NodeId" />
                    <sl-button size="small" type="submit">Confirm</sl-button>
                </form>
            </div>
        }
    </div>
}

@if (Model.Network is null)
{
    <sl-alert variant="warning" open id="devices-unavailable">
        <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
        Could not load the devices. Check the API connection.
    </sl-alert>
}
else if (Model.Rows.Count == 0)
{
    <div class="card" id="devices-empty" style="text-align:center;padding:40px;">
        <sl-icon name="people" style="font-size:2rem;color:var(--text-secondary);display:block;margin-bottom:12px;"></sl-icon>
        <p class="text-muted" style="margin:0;">No other device yet. Press <strong>Connect a device</strong> to join a phone or another computer, or <strong>Add a blind node</strong> for an encrypted copy.</p>
    </div>
}
else
{
    <ul class="device-list" id="device-list">
        @foreach (var row in Model.Rows)
        {
            <li class="device-row tone-@row.Tone.ToString().ToLowerInvariant()" data-node-id="@row.NodeId" data-tone="@row.Tone.ToString().ToLowerInvariant()">
                <span class="device-mark" title="@row.ToneWords"><sl-icon name="@row.Icon"></sl-icon><span class="sr-only">@row.ToneWords</span></span>
                <div class="device-main">
                    <div class="device-head">
                        <a class="device-name" href="@AdminRoutes.DeviceOf(row.NodeId)">@row.Name</a>
                        <span class="device-kind text-muted text-sm">@row.Kind@(row.Platform is { } p ? " (" + p + ")" : "") &middot; @row.Version</span>
                        @if (Model.WhitelistEntryFor(row.NodeId) is { } wl)
                        {
                            if (wl.Ownership == "shared" || Model.SharedDoors?.AccountsHomeNodeId == row.NodeId)
                            {
                                <sl-badge variant="neutral" pill>shared</sl-badge>
                            }
                            else if (wl.Ownership == "personal")
                            {
                                <sl-badge variant="primary" pill>@(string.IsNullOrWhiteSpace(wl.OwnerLabel) ? "personal" : wl.OwnerLabel)</sl-badge>
                            }
                            else if (wl.NeedsReview && !Model.IsSingleSuperadminBank)
                            {
                                <sl-badge variant="warning" pill>review owner</sl-badge>
                            }
                        }
                    </div>
                    <div class="device-status">@row.Status@(row.Delivery is { } delivery ? " · " + delivery : "")</div>
                    @if (row.Contact is { } contact)
                    {
                        <div class="device-contact text-muted text-sm">@contact</div>
                    }
                </div>
                <sl-button size="small" href="@AdminRoutes.DeviceOf(row.NodeId)" class="device-open">Details</sl-button>
            </li>
        }
    </ul>
}

<p class="devices-links">
    <sl-button size="small" variant="text" href="/Network"><sl-icon slot="prefix" name="diagram-3"></sl-icon> Network map</sl-button>
    <sl-button size="small" variant="text" href="@AdminRoutes.NetworkSettings"><sl-icon slot="prefix" name="wifi"></sl-icon> Network settings</sl-button>
    <sl-button size="small" variant="text" href="@AdminRoutes.Compaction"><sl-icon slot="prefix" name="journal-text"></sl-icon> Event log &amp; compaction</sl-button>
</p>

<partial name="_ConnectDeviceDialog" model="Model" />
