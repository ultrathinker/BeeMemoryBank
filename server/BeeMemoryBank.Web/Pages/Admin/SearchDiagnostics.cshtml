@page
@using System.Text.Json
@model BeeMemoryBank.Web.Pages.Admin.SearchDiagnosticsModel

@* Search diagnostics (WP-18) - latency / volume / index health.
   Numbers only: timings, request counts, coarse result-count buckets, and the already-public
   IndexBuilder / SearchIndexRuntimeState diagnostics. No query text or content is ever shown. *@
@section About {
    <p>
        This page shows how the search of this node is doing, and holds the switch for <strong>semantic search</strong>. It has two parts. <strong>Latency and volume</strong>: for each kind of
        search, how many requests were made and how long they took (p50 is the typical one, p95 the slow end), and how many results they returned, counted over a rolling window in memory (it
        starts again when the node restarts). <strong>The encrypted search index</strong>: how many segments it has sealed, how many documents wait in its hot buffer, and whether it was warm-started
        from disk. Only counts and timings are shown here: no query text, title or article content is ever recorded or shown.
    </p>
    <p>
        <strong>Generate embeddings on this node</strong> decides whether this node computes its own semantic embeddings, which meaning-based and hybrid search need. Embeddings never sync between
        nodes: each node that wants semantic search has to generate its own. Turning it off saves CPU, but semantic and hybrid search then silently fall back to exact matching on this node.
        <strong>Backfill pending now</strong> drains the pending embeddings and index entries at once, instead of waiting for the normal schedule (one batch every 5 minutes). Use it right after
        switching the toggle on or after a large import; pressing it again is harmless when nothing is pending.
    </p>
}

<div class="card" style="padding:12px 16px;margin-bottom:20px;max-width:920px;">
    <div style="display:flex;align-items:center;gap:10px;">
        <sl-switch id="embeddings-enabled-toggle" size="small">Generate embeddings on this node</sl-switch>
    </div>
    <div style="display:flex;align-items:center;gap:10px;margin-top:12px;">
        <sl-button id="embeddings-backfill-btn" size="small">
            <sl-icon slot="prefix" name="arrow-repeat"></sl-icon> Backfill pending now
        </sl-button>
        <span id="embeddings-backfill-status" class="text-muted text-sm"></span>
    </div>
</div>

<div style="max-width:920px;">
    @if (Model.SearchMetrics is { } searchMetricsEl)
    {
        var latency = searchMetricsEl.TryGetProperty("latency", out var latEl) && latEl.ValueKind == JsonValueKind.Array ? latEl.EnumerateArray().ToArray() : Array.Empty<JsonElement>();

        <h4 style="margin:8px 0;"><sl-icon name="stopwatch"></sl-icon> Latency &amp; volume</h4>
        @if (latency.Length == 0)
        {
            <p class="text-muted text-sm" style="margin-bottom:16px;">No searches recorded yet in this process's lifetime.</p>
        }
        else
        {
            <div class="card" style="padding:0;overflow:hidden;margin-bottom:16px;">
                @* Below a card of 560px (site.css, Admin) the header rows, the group "Result counts" with its four columns among them, are hidden and a row stacks: the name, then one
                   line per number with its own label, so that the four counts keep what the group said ("0 results" ... "100+ results"). *@
                <table class="version-table admin-stack-sm">
                    <thead>
                        <tr>
                            <th class="col-name">Search type</th>
                            <th>Requests</th>
                            <th>p50 (ms)</th>
                            <th>p95 (ms)</th>
                            <th colspan="4" class="col-center">Result counts</th>
                        </tr>
                        <tr>
                            <th></th><th></th><th></th><th></th>
                            <th class="col-center">0</th>
                            <th class="col-center">1–10</th>
                            <th class="col-center">11–100</th>
                            <th class="col-center">100+</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in latency)
                        {
                            var label = row.TryGetProperty("searchType", out var stEl) && stEl.ValueKind == JsonValueKind.String ? stEl.GetString() : "?";
                            <tr>
                                <td class="col-name"><strong>@label</strong></td>
                                <td data-label="Requests">@(row.TryGetProperty("count", out var cEl) ? cEl.GetInt64().ToString("N0") : "0")</td>
                                <td data-label="p50 (ms)">@FmtMs(row, "p50Ms")</td>
                                <td data-label="p95 (ms)">@FmtMs(row, "p95Ms")</td>
                                <td class="col-center" data-label="0 results">@BucketVal(row, "bucketZero")</td>
                                <td class="col-center" data-label="1–10 results">@BucketVal(row, "bucketOneToTen")</td>
                                <td class="col-center" data-label="11–100 results">@BucketVal(row, "bucketElevenToHundred")</td>
                                <td class="col-center" data-label="100+ results">@BucketVal(row, "bucketOverHundred")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (searchMetricsEl.TryGetProperty("indexHealth", out var ihEl) && ihEl.ValueKind == JsonValueKind.Object)
        {
            var warm = ihEl.TryGetProperty("warmStartAttempted", out var wEl) && wEl.ValueKind == JsonValueKind.False;
            <h4 style="margin:8px 0;"><sl-icon name="hdd-stack"></sl-icon> Encrypted search index</h4>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px 24px;margin-bottom:8px;">
                <div><span class="text-muted text-sm">Sealed segments</span><br><strong>@GetInt(ihEl, "sealedSegmentCount")</strong></div>
                <div><span class="text-muted text-sm">Hot buffer docs</span><br><strong>@GetInt(ihEl, "hotBufferCount")</strong></div>
                <div><span class="text-muted text-sm">Warm-start run</span><br>
                    @if (warm)
                    {
                        <sl-badge variant="warning" pill>not yet</sl-badge>
                    }
                    else
                    {
                        <sl-badge variant="success" pill>yes</sl-badge>
                    }
                </div>
                <div><span class="text-muted text-sm">Lifetime seals</span><br><strong>@GetInt(ihEl, "sealCount")</strong></div>
                <div><span class="text-muted text-sm">Lifetime merges</span><br><strong>@GetInt(ihEl, "mergeCount")</strong></div>
            </div>
            <p class="text-muted text-sm" style="margin-top:8px;">
                @if (warm)
                {
                    <text>The index has not been warm-started from disk yet this session; it builds as pending articles are processed.</text>
                }
                else
                {
                    <text>The index was warm-started from persisted segments (or a rebuild was triggered) this session.</text>
                }
            </p>
        }
    }
    else
    {
        <sl-alert variant="warning" open>
            <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
            Search diagnostics are unavailable (the API returned no data — the session may be locked or the request lacked admin rights).
        </sl-alert>
    }
</div>

@{
    // Local helpers keep the table markup above readable. They read from a JsonElement row/column
    // defensively (any missing field renders as "—" rather than throwing).
    static string FmtMs(JsonElement row, string prop)
    {
        if (row.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number)
        {
            var ms = v.GetDouble();
            return ms <= 0 ? "—" : ms.ToString("0.###");
        }
        return "—";
    }
    static string BucketVal(JsonElement row, string prop)
    {
        if (row.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number)
        {
            var n = v.GetInt64();
            return n == 0 ? "—" : n.ToString("N0");
        }
        return "—";
    }
    static string GetInt(JsonElement el, string prop)
    {
        if (el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number)
            return v.GetInt32().ToString("N0");
        return "—";
    }
}
