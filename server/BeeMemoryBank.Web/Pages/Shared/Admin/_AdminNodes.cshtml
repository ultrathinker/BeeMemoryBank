@using System.Text.Json
@model BeeMemoryBank.Web.Pages.AdminModel

@if (Model.RestoredPeers.Count > 0)
{
    <!-- Devices a restore kept inactive -->
    <h3 style="margin-bottom:12px;"><sl-icon name="shield-exclamation"></sl-icon> Restored devices awaiting confirmation</h3>
    <div class="card" style="margin-bottom:32px;" id="restored-peers">
        <p style="margin-top:0;color:var(--text-secondary);">No integrity anchor under your master key vouched for these devices when
            this node was restored, so they cannot sync with it yet. Confirm the ones you recognise; pair the others again.</p>
        @foreach (var peer in Model.RestoredPeers)
        {
            <div style="display:flex;align-items:center;gap:12px;margin-top:8px;">
                <span style="flex:1;"><strong>@peer.DisplayName</strong> <code style="font-size:0.78rem;">@peer.NodeId</code> @peer.ApiAddress</span>
                <form method="post" asp-page-handler="ConfirmRestoredPeer" style="display:inline;">
                    <input type="hidden" name="nodeId" value="@peer.NodeId" />
                    <sl-button size="small" type="submit">Confirm</sl-button>
                </form>
            </div>
        }
    </div>
}

<!-- Node Identity -->
<h3 style="margin-bottom:12px;"><sl-icon name="fingerprint"></sl-icon> Node Identity</h3>
@if (Model.Identity != null)
{
    <div class="card" style="margin-bottom:32px;">
        <div class="article-meta">
            <span><strong>ID:</strong>
                <span class="article-id-badge" title="Click to copy" data-bmb-copy="@Model.Identity.NodeId">
                    @Model.Identity.NodeId
                </span>
            </span>
            <span><strong>Name:</strong> @Model.Identity.DisplayName</span>
        </div>
        <div style="margin-top:12px;">
            <label style="font-size:0.85rem;color:var(--text-secondary);">Ed25519 Public Key</label>
            <div style="display:flex;align-items:center;gap:8px;margin-top:4px;">
                <code style="font-size:0.78rem;word-break:break-all;flex:1;" id="pubkey-val">@Model.Identity.Ed25519PublicKeyB64</code>
                <sl-icon-button id="btn-copy-pubkey" class="btn-copy-pubkey" data-target="pubkey-val" name="clipboard" label="Copy"></sl-icon-button>
            </div>
        </div>
    </div>
}
else
{
    <sl-alert variant="warning" open style="margin-bottom:32px;">
        <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
        Could not retrieve node identity. Check API connection.
    </sl-alert>
}

<!-- Devices on my network — open this node to the local network, permanently, or leave it closed (the default) -->
@{
    var devices = Model.DevicesCard;
}
<h3 style="margin-bottom:12px;"><sl-icon name="wifi"></sl-icon> Devices on my network</h3>
<div class="card mt-md" id="devices-on-my-network" style="margin-bottom:32px;max-width:640px;">
    @if (devices.Kind == DevicesCardKind.NotADesktopNode)
    {
        <p class="text-muted text-sm" style="margin-bottom:8px;">
            There is no switch here: this node is not the desktop app. Which computers can reach it is decided by how it was
            started. With Docker, the published ports in <code>docker-compose.yml</code> decide: the web page is published on
            this computer only (<code>127.0.0.1</code>) unless you set <code>BMB_WEB_BIND</code>, and the API port, which AI
            assistants and other nodes use, is not published at all unless you add it. See <code>docs/deployment.md</code>.
        </p>
    }
    else
    {
        <p class="text-muted text-sm" style="margin-bottom:8px;">
            Off by default: this node answers this computer only. Switched on, it also serves its web page and API over
            HTTPS on port 5311 and announces itself on your local network, so another computer running Bee Memory Bank can
            find it and join, and a phone can open it in a browser.
        </p>
        <p class="text-muted text-sm" style="margin-bottom:8px;">
            <strong>What this exposes:</strong> everything this node serves, not only a join page. Anyone on the same network can
            reach the sign-in page and try passwords (the node limits attempts). The certificate comes from this node's own
            certificate authority, not from a public one: a phone or another computer must trust it once
            (<a href="/Connect">Connect a device</a> has the file and the steps), and until it does the browser warns.
            Use it on a home or office network you trust, not on a public Wi-Fi.
        </p>

        @if (devices.Error != null)
        {
            <sl-alert variant="danger" open style="margin-bottom:12px;">
                <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
                @devices.Error
            </sl-alert>
        }

        @if (devices.Kind == DevicesCardKind.ForcedByEnvironment)
        {
            <sl-alert variant="warning" open style="margin-bottom:12px;">
                <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                <strong>On, set by <code>BMB_HTTPS_ENABLED=1</code>.</strong> This node was started with that environment variable,
                which keeps the network listener open whatever is chosen here. Remove the variable and restart the node to
                control it from this page.
            </sl-alert>
        }
        else if (devices.ListenerFailed)
        {
            <sl-alert variant="danger" open style="margin-bottom:12px;">
                <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
                <strong>Switched on, but the node could not open port 5311.</strong> Another program may be using that port.
                Close it and try again, or switch this off.
            </sl-alert>
            <div style="display:flex;gap:8px;">
                <form method="post" asp-page-handler="SetDevicesOnMyNetwork">
                    <input type="hidden" name="enabled" value="true" />
                    <sl-button type="submit" variant="primary" size="small">Try again</sl-button>
                </form>
                <form method="post" asp-page-handler="SetDevicesOnMyNetwork">
                    <input type="hidden" name="enabled" value="false" />
                    <sl-button type="submit" variant="default" size="small">Switch off</sl-button>
                </form>
            </div>
        }
        else if (devices.On)
        {
            <p style="margin:0 0 8px;"><sl-badge variant="warning">On</sl-badge>
                Other devices on this network can reach this node.</p>
            <form method="post" asp-page-handler="SetDevicesOnMyNetwork">
                <input type="hidden" name="enabled" value="false" />
                <sl-button type="submit" variant="default" size="small">Switch off</sl-button>
            </form>
        }
        else
        {
            <p style="margin:0 0 8px;"><sl-badge variant="neutral">Off</sl-badge>
                This node answers this computer only.</p>
            <form method="post" asp-page-handler="SetDevicesOnMyNetwork">
                <input type="hidden" name="enabled" value="true" />
                <sl-button type="submit" variant="primary" size="small">Switch on</sl-button>
            </form>
        }

        @if (devices.Urls.Count > 0)
        {
            <p class="text-muted text-sm" style="margin:16px 0 4px;">Address to open on the other device:</p>
            @foreach (var url in devices.Urls)
            {
                <div><code data-bmb-copy="@url" title="Click to copy">@url</code></div>
            }
        }
        else if (devices.On)
        {
            <p class="text-muted text-sm" style="margin:16px 0 0;">No network address was found on this computer. Connect to a network first.</p>
        }

        @switch (devices.Firewall)
        {
            case DevicesFirewallStep.AddRule:
                <div style="margin-top:16px;border:1px solid var(--sl-color-warning-600);border-radius:10px;padding:12px;">
                    <p class="text-sm" style="margin:0 0 8px;"><strong>Windows Firewall will block other devices.</strong>
                        One rule, for this computer's local network only on port 5311, lets them in. Windows asks for
                        administrator permission; Bee Memory Bank never changes the firewall without asking.</p>
                    <form method="post" asp-page-handler="DevicesFirewall">
                        <input type="hidden" name="action" value="add" />
                        <sl-button type="submit" size="small"><sl-icon slot="prefix" name="shield-check"></sl-icon> Allow in Windows Firewall&hellip;</sl-button>
                    </form>
                </div>
                break;
            case DevicesFirewallStep.RuleInPlace:
                <p class="text-muted text-sm" style="margin:16px 0 0;">The Windows Firewall rule for port 5311 is in place (local network only).</p>
                break;
            case DevicesFirewallStep.RemoveRule:
                <div style="margin-top:16px;">
                    <p class="text-muted text-sm" style="margin:0 0 8px;">The Windows Firewall rule for port 5311 is still in place. Nothing is listening now,
                        but you can remove it. This also removes the rule the Connect a device page uses; it asks again when needed.</p>
                    <form method="post" asp-page-handler="DevicesFirewall">
                        <input type="hidden" name="action" value="remove" />
                        <sl-button type="submit" size="small"><sl-icon slot="prefix" name="shield-x"></sl-icon> Remove the Windows Firewall rule&hellip;</sl-button>
                    </form>
                </div>
                break;
            case DevicesFirewallStep.MacAsksOnFirstConnection:
                <p class="text-muted text-sm" style="margin:16px 0 0;">
                    <strong>On a Mac:</strong> macOS asks, when the first device connects, whether &ldquo;Bee Memory Bank&rdquo; may accept
                    incoming network connections. Choose Allow. Bee Memory Bank does not change the firewall itself.
                </p>
                break;
            case DevicesFirewallStep.ServiceInstaller:
                <p class="text-muted text-sm" style="margin:16px 0 0;">
                    <strong>Windows service:</strong> the firewall is not changed from here. The installer's
                    &ldquo;Configure Windows Firewall Exception&rdquo; option opens port 5311; if you did not choose it, add an
                    inbound rule for TCP 5311 yourself.
                </p>
                break;
        }
    }
</div>

<!-- Connect a device — join a phone or another computer to this one over the LAN, without a permanent setting -->
<h3 style="margin-bottom:12px;"><sl-icon name="phone"></sl-icon> Connect a device</h3>
<div class="card mt-md" style="margin-bottom:32px;max-width:640px;">
    <p class="text-muted text-sm" style="margin-bottom:12px;">
        Let a phone or another computer on your local network join this one for 15 minutes, with a join code
        that also proves to the other device it reached this computer. Nothing stays open afterwards. On a computer,
        paste the code in <strong>Connect to another device</strong> on its first-run page.
    </p>
    <sl-button variant="primary" size="small" href="/Connect">
        <sl-icon slot="prefix" name="qr-code"></sl-icon> Connect a device
    </sl-button>
</div>

<!-- Blind nodes — an encrypted backup relay; the page that adds one by its pair code (superadmin, like this page) -->
<h3 style="margin-bottom:12px;"><sl-icon name="shield-lock"></sl-icon> Blind nodes</h3>
<div class="card mt-md" style="margin-bottom:32px;max-width:640px;">
    <p class="text-muted text-sm" style="margin-bottom:12px;">
        Add a blind node by the pair code from its console: an encrypted copy of this network and its
        backups on another machine. See its status, reseed or disconnect it.
    </p>
    <sl-button variant="primary" size="small" href="/BlindNodes">
        <sl-icon slot="prefix" name="shield-lock"></sl-icon> Blind nodes
    </sl-button>
</div>

<!-- Software Updates -->
<h3 style="margin-bottom:12px;"><sl-icon name="arrow-up-circle"></sl-icon> Software Updates</h3>
<div class="card mt-md" style="margin-bottom:32px;max-width:640px;">
    <p style="margin:0 0 12px;">
        Current version: <strong>v@(Model.CurrentVersion ?? "unknown")</strong>
    </p>

    @if (Model.UpdateStatus is { } st)
    {
        var step = st.TryGetProperty("currentStep", out var cs) && cs.ValueKind == JsonValueKind.String ? cs.GetString() : "Idle";
        var availableVersion = st.TryGetProperty("availableVersion", out var av) && av.ValueKind == JsonValueKind.String ? av.GetString() : null;
        var percentageComplete = st.TryGetProperty("percentageComplete", out var pc) && pc.ValueKind == JsonValueKind.Number ? pc.GetInt32() : 0;
        var statusMessage = st.TryGetProperty("statusMessage", out var sm) && sm.ValueKind == JsonValueKind.String ? sm.GetString() : null;
        var errorMessage = st.TryGetProperty("errorMessage", out var em) && em.ValueKind == JsonValueKind.String ? em.GetString() : null;
        var isUpdating = step == "Checking" || step == "Downloading" || step == "Applying";

        List<string> blockedGates = new();
        if (st.TryGetProperty("blockedGates", out var bg) && bg.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in bg.EnumerateArray())
            {
                if (item.ValueKind == JsonValueKind.String)
                    blockedGates.Add(item.GetString()!);
            }
        }

        <div style="margin-bottom:16px;">
            <strong>State:</strong> <sl-badge id="update-state-badge" variant="@(step == "Failed" ? "danger" : (step == "Completed" ? "success" : (step == "Idle" ? "neutral" : "primary")))">@step</sl-badge>
        </div>

        @if (percentageComplete > 0 && percentageComplete <= 100)
        {
            <div style="margin-bottom:16px;">
                <sl-progress-bar value="@percentageComplete" style="margin-top:8px;"></sl-progress-bar>
            </div>
        }

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <p class="text-muted" style="margin-top:4px;margin-bottom:12px;">@statusMessage</p>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <sl-alert variant="danger" open style="margin-bottom:16px;">
                <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
                <strong>Error:</strong> @errorMessage
            </sl-alert>
        }

        @if (blockedGates.Count > 0)
        {
            <sl-alert variant="warning" open style="margin-bottom:16px;">
                <sl-icon slot="icon" name="shield-exclamation"></sl-icon>
                <strong>Blocked by safety gates:</strong>
                <ul style="margin:4px 0 0 16px;padding:0;">
                    @foreach (var gate in blockedGates)
                    {
                        <li>@gate</li>
                    }
                </ul>
            </sl-alert>
        }

        <!-- Action buttons based on state -->
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;" @(isUpdating ? "data-is-updating=\"true\"" : "")>
            @if (step == "Idle")
            {
                <sl-button variant="default" size="small" id="btn-open-check-update">
                    <sl-icon slot="prefix" name="arrow-repeat"></sl-icon> Check for updates
                </sl-button>
            }
            else if (step == "UpdateAvailable")
            {
                <form method="post" asp-page-handler="DownloadUpdate" style="display:inline;">
                    <input type="hidden" name="manifestJson" value="@Model.CheckedManifestJson" />
                    <sl-button type="submit" variant="primary" size="small" id="btn-download-update">
                        <sl-icon slot="prefix" name="download"></sl-icon> Download update
                    </sl-button>
                </form>
            }
            else if (step == "ReadyToApply")
            {
                <form method="post" asp-page-handler="ApplyUpdate" style="display:inline;"
                      class="form-confirm" data-confirm="Apply update to v@(availableVersion)?&#10;&#10;The server will fetch the new version, rebuild, and restart.&#10;&#10;Continue?">
                    <sl-button type="submit" variant="success" size="small" id="btn-apply-update">
                        <sl-icon slot="prefix" name="play-fill"></sl-icon> Apply update
                    </sl-button>
                </form>
            }
            else if (step == "Failed" || step == "Completed")
            {
                <form method="post" asp-page-handler="ResetUpdate" style="display:inline;">
                    <sl-button type="submit" variant="warning" size="small" id="btn-reset-update">
                        <sl-icon slot="prefix" name="arrow-counterclockwise"></sl-icon> Reset state
                    </sl-button>
                </form>
            }
        </div>
    }
</div>

<!-- Trusted Nodes -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
    <h3 style="margin:0;"><sl-icon name="people"></sl-icon> Trusted Nodes</h3>
    <span id="local-events-counter" class="text-muted text-sm"></span>
</div>

@{ var passwordPeersToPromote = BeeMemoryBank.Web.Pages.PromotePasswordPeersModel.CandidatesOf(Model.Whitelist); }
@if (passwordPeersToPromote.Count > 0)
{
    <!-- BMB-42: devices joined before "whoever knows the master password is a superadmin" -->
    <sl-alert variant="warning" open style="margin-bottom:16px;">
        <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
        <strong>@passwordPeersToPromote.Count device(s) joined with the master password are not superadmins yet.</strong>
        Their hard deletes and password changes are refused by the rest of the network, so the copies drift apart.
        <div style="margin-top:8px;">
            <sl-button size="small" variant="warning" href="/PromotePasswordPeers">
                <sl-icon slot="prefix" name="shield-check"></sl-icon> Grant superadmin to all devices joined with the password&hellip;
            </sl-button>
        </div>
    </sl-alert>
}

@if (Model.Whitelist != null && Model.Whitelist.Count > 0)
{
    <div class="card" style="padding:0;overflow:hidden;margin-bottom:32px;">
        <table class="version-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Node ID</th>
                    <th>API Address</th>
                    <th>Status</th>
                    <th>
                        Auto-restore
                        <sl-tooltip content="When ON, snapshot restores initiated by this peer apply automatically without your confirmation. The peer can replace your articles, folders, and tags. Enable only for peers you fully trust (e.g. your own devices). When OFF, a received restore remains pending; there is no UI prompt or manual approval path. If you later switch it on, the node applies the pending restore after its next sync or unlock." placement="top">
                            <sl-icon name="info-circle" style="color:var(--text-secondary);font-size:0.85rem;cursor:help;"></sl-icon>
                        </sl-tooltip>
                    </th>
                    <th>
                        Auto-DEK rotation
                        <sl-tooltip content="When ON, DEK rotation events initiated by this peer apply automatically without your confirmation. DEK rotation is more destructive than snapshot restore — it re-encrypts ALL article bodies, versions, and media with a new key. Enable only for peers you fully trust." placement="top">
                            <sl-icon name="info-circle" style="color:var(--text-secondary);font-size:0.85rem;cursor:help;"></sl-icon>
                        </sl-tooltip>
                    </th>
                    <th>Added</th>
                    <th>Last Sync</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Whitelist)
                {
                    var isSelf = Model.Identity != null && entry.NodeId == Model.Identity.NodeId;
                    DateTime lastSync = DateTime.MinValue;
                    if (!isSelf && Model.NodeSyncStatus != null)
                        Model.NodeSyncStatus.TryGetValue(entry.NodeId, out lastSync);
                    <tr>
                        <td><strong>@entry.DisplayName</strong></td>
                        <td><code class="text-sm">@entry.NodeId.ToString()[..8]&hellip;</code></td>
                        <td class="text-muted text-sm">@(entry.ApiAddress ?? "\u2014")</td>
                        <td>
                            <sl-badge variant="@(entry.Status == "active" ? "success" : "neutral")" pill>
                                @entry.Status
                            </sl-badge>
                            @if (entry.CanGenerateEmbeddings)
                            {
                                <sl-badge variant="primary" pill style="margin-left:4px;">embeddings</sl-badge>
                            }
                            @if (entry.IsSuperadmin && !isSelf)
                            {
                                <sl-tooltip content="This peer can revoke other peers, hard-delete content across the whole network, and restore every node from its own snapshot. Every device that joins with the master password starts this way." placement="top">
                                    <sl-badge variant="warning" pill style="margin-left:4px;">superadmin</sl-badge>
                                </sl-tooltip>
                            }
                            @if (entry.TlsTrust == "pin" || entry.TlsTrust == "public-ca")
                            {
                                var hubIsPinned = entry.TlsTrust == "pin";
                                var hubHttps = entry.ApiAddress != null && entry.ApiAddress.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
                                <sl-tooltip content="@(!hubHttps ? "The address of this node is not https, so blind copies cannot be paired to it. Set an https address with the button next to this badge." : hubIsPinned ? "Blind copies can be told to call this node. They accept only the certificate key pinned for it (" + (entry.TlsSpki ?? "") + ")." : "Blind copies can be told to call this node. They accept only a certificate a public authority vouches for, for this name.")" placement="top">
                                    <sl-badge variant="@(hubHttps ? "primary" : "warning")" pill style="margin-left:4px;" class="badge-blind-callable">blind copies: @(hubIsPinned ? "pinned certificate" : "normal certificate")@(hubHttps ? "" : " (address not https)")</sl-badge>
                                </sl-tooltip>
                            }
                        </td>
                        <td>
                            @if (!isSelf)
                            {
                                <form method="post" asp-page-handler="SetAutoAcceptRestore" style="display:inline;" id="autoaccept-form-@entry.NodeId">
                                    <input type="hidden" name="nodeId" value="@entry.NodeId" />
                                    <input type="hidden" name="autoAccept" value="@((!entry.AutoAcceptRestore).ToString().ToLower())" id="autoaccept-value-@entry.NodeId" />
                                    <sl-switch
                                        @(entry.AutoAcceptRestore ? "checked" : "")
                                        data-node-id="@entry.NodeId"
                                        data-node-name="@entry.DisplayName"
                                        class="switch-auto-accept">
                                    </sl-switch>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted text-sm">—</span>
                            }
                        </td>
                        <td>
                            @if (!isSelf)
                            {
                                <form method="post" asp-page-handler="SetAutoAcceptDekRotation" style="display:inline;" id="autoaccept-dek-form-@entry.NodeId">
                                    <input type="hidden" name="nodeId" value="@entry.NodeId" />
                                    <input type="hidden" name="autoAccept" value="@((!entry.AutoAcceptDekRotation).ToString().ToLower())" id="autoaccept-dek-value-@entry.NodeId" />
                                    <sl-switch
                                        @(entry.AutoAcceptDekRotation ? "checked" : "")
                                        data-node-id="@entry.NodeId"
                                        data-node-name="@entry.DisplayName"
                                        class="switch-auto-accept-dek">
                                    </sl-switch>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted text-sm">—</span>
                            }
                        </td>
                        <td class="text-muted text-sm">@entry.CreatedAt.ToString("d")</td>
                        <td class="text-muted text-sm">@(isSelf ? "\u2014" : AdminModel.RelativeTime(lastSync))</td>
                        <td style="text-align:right;">
                            @if (!isSelf)
                            {
                                <sl-icon-button name="link-45deg" label="Change URL"
                                    class="btn-open-change-url"
                                    data-node-id="@entry.NodeId" data-node-name="@entry.DisplayName" data-current-url="@entry.ApiAddress">
                                </sl-icon-button>
                                @* A blind node is called by the pin in its pair code; only a full node is set up here. *@
                                @if (!BeeMemoryBank.Core.Models.BlindNodeId.IsBlind(entry.NodeId))
                                {
                                <sl-icon-button name="broadcast-pin" label="Let blind copies call this node"
                                    class="btn-open-hub"
                                    data-node-id="@entry.NodeId" data-node-name="@entry.DisplayName" data-current-url="@entry.ApiAddress"
                                    data-trust="@entry.TlsTrust">
                                </sl-icon-button>
                                }
                                @* A blind node can never be promoted (the Api refuses it too); demoting one stays possible. *@
                                @if (entry.IsSuperadmin || !BeeMemoryBank.Core.Models.BlindNodeId.IsBlind(entry.NodeId))
                                {
                                <form method="post" asp-page-handler="SetPeerSuperadmin" style="display:inline;">
                                    <input type="hidden" name="nodeId" value="@entry.NodeId" />
                                    <input type="hidden" name="isSuperadmin" value="@((!entry.IsSuperadmin).ToString().ToLower())" />
                                    <sl-icon-button
                                        name="@(entry.IsSuperadmin ? "shield-slash" : "shield-check")"
                                        label="@(entry.IsSuperadmin ? "Demote from superadmin" : "Promote to superadmin")"
                                        class="btn-confirm-superadmin"
                                        data-node-name="@entry.DisplayName"
                                        data-demote="@(entry.IsSuperadmin.ToString().ToLower())">
                                    </sl-icon-button>
                                </form>
                                }
                                <form method="post" asp-page-handler="RevokeNode" style="display:inline;">
                                    <input type="hidden" name="nodeId" value="@entry.NodeId" />
                                    <sl-icon-button name="trash" label="Revoke"
                                        class="btn-confirm-submit"
                                        data-confirm-pattern="Revoke node {name}?"
                                        data-name="@entry.DisplayName">
                                    </sl-icon-button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card" style="text-align:center;padding:40px;margin-bottom:32px;">
        <sl-icon name="people" style="font-size:2rem;color:var(--text-secondary);display:block;margin-bottom:12px;"></sl-icon>
        <p class="text-muted">No trusted nodes</p>
    </div>
}

<!-- Change Node URL Dialog -->
<sl-dialog id="dlg-change-url" label="Change Node URL">
    <form method="post" asp-page-handler="ChangeNodeAddress" class="sl-form">
        <input type="hidden" id="change-url-node-id" name="nodeId" />
        <p id="change-url-node-name" style="margin:0 0 16px;color:var(--text-secondary);"></p>
        <div style="margin-bottom:16px;">
            <sl-input id="change-url-input" name="newApiAddress" label="New API Address" placeholder="https://example.com" required></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input name="password" label="Master Password" type="password" password-toggle required autocomplete="off"></sl-input>
        </div>
        <sl-button type="button" slot="footer" variant="default" data-dlg-cancel="dlg-change-url">Cancel</sl-button>
        <sl-button type="submit" slot="footer" variant="primary">
            <sl-icon slot="prefix" name="link-45deg"></sl-icon> Change URL
        </sl-button>
    </form>
</sl-dialog>

<!-- Let blind copies call this node (ADR 0007) -->
<sl-dialog id="dlg-hub" label="Let blind copies call this node">
    <form method="post" asp-page-handler="SetBlindCallable" class="sl-form">
        <input type="hidden" id="hub-node-id" name="nodeId" />
        <p id="hub-node-name" style="margin:0 0 12px;color:var(--text-secondary);"></p>
        <p class="text-muted text-sm" style="margin:0 0 16px;">
            A blind copy (the Windows, macOS or Android app) never listens: it calls a node over https. Choose how it should trust
            this node's certificate. This server checks the address and the certificate before it saves anything.
        </p>
        <div id="hub-address-row" style="margin-bottom:16px;">
            <sl-input id="hub-address" name="address" label="Address (https)" placeholder="https://bmb.example.org"
                      help-text="Replaces this node's address for every device in the network."></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-select id="hub-trust" name="trust" label="Certificate" value="public-ca" hoist>
                <sl-option value="public-ca">Normal certificate (Let's Encrypt or another public authority)</sl-option>
                <sl-option value="pin">Pinned certificate</sl-option>
                <sl-option value="off">Do not let blind copies call this node</sl-option>
            </sl-select>
        </div>
        <sl-alert id="hub-help-public-ca" variant="primary" open style="margin-bottom:16px;">
            Use this for a node behind a reverse proxy with a real certificate. A blind copy accepts only a certificate that a public
            authority vouches for, issued for exactly this name. Because anyone a public authority can be made to issue a certificate for
            this name to could impersonate the node to a blind copy, "Pinned certificate" is stronger. Make sure the proxy forwards
            <code>/api/sync/</code> and <code>/api/blind/replica</code> to this node (see the Internet Access guide).
        </sl-alert>
        <sl-alert id="hub-help-pin" variant="warning" open style="margin-bottom:16px;display:none;">
            Use this for a node with a certificate of its own. This server connects once, reads the key the node presents and pins it:
            every device then accepts only that key for this node. That key is taken on trust from this one connection, so compare it
            with the key the node shows for itself if you can (paste it below). A certificate from a public authority that is renewed
            with a new key breaks the pin; use "Normal certificate" for those.
        </sl-alert>
        <sl-alert id="hub-help-off" variant="neutral" open style="margin-bottom:16px;display:none;">
            Blind copies can no longer be paired to call this node. Copies that are already paired keep calling it until it stops
            answering them; revoke a lost copy under Trusted Nodes.
        </sl-alert>
        <div id="hub-pin-row" style="margin-bottom:16px;display:none;">
            <sl-input name="expectedPin" label="Expected key pin (optional)" placeholder="43 characters" autocomplete="off"></sl-input>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input name="password" label="Master Password" type="password" password-toggle required autocomplete="off"></sl-input>
        </div>
        <sl-button type="button" slot="footer" variant="default" data-dlg-cancel="dlg-hub">Cancel</sl-button>
        <sl-button type="submit" slot="footer" variant="primary">
            <sl-icon slot="prefix" name="broadcast-pin"></sl-icon> Save
        </sl-button>
    </form>
</sl-dialog>

<!-- Check for updates dialog -->
<sl-dialog id="dlg-check-update" label="Check for Updates">
    <form method="post" asp-page-handler="CheckUpdate">
        <p class="text-muted text-sm" style="margin-bottom:16px;">
            Checking for updates requires a signed manifest. Since no feed is configured, you can paste manifest JSON and its Base64 signature below, or leave them empty to perform a dummy check (which will fail and allow you to test the Reset action).
        </p>
        <div style="margin-bottom:16px;">
            <sl-textarea name="manifestJson" label="Manifest JSON" placeholder='e.g. {"schemaVersion": 1, ...}'></sl-textarea>
        </div>
        <div style="margin-bottom:16px;">
            <sl-input name="manifestSignatureBase64" label="Manifest Signature (Base64)" placeholder="e.g. AAAA..."></sl-input>
        </div>
        <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-check-update">Cancel</sl-button>
        <sl-button type="submit" slot="footer" variant="primary">
            <sl-icon slot="prefix" name="arrow-repeat"></sl-icon> Check
        </sl-button>
    </form>
</sl-dialog>
