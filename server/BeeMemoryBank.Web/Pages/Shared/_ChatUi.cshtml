@* Shared AI-chat UI fragment: empty/not-configured state, message list, pill composer,
   "Save to Bee" dialog, image lightbox. Rendered by BOTH /AI and /Tree (homepage chat) so the
   two pages can never drift — chat.js dereferences several of these ids UNGUARDED
   (#chat-empty-state, #chat-messages, #chat-input), so any page loading chat.js MUST render
   this partial. Styles: wwwroot/css/chat.css (scoped body.chat-ui). *@

<!-- Empty / not-configured states -->
<div id="chat-empty-state" class="card" style="display:none;text-align:center;padding:32px;margin-bottom:8px;">
    <sl-icon id="chat-empty-icon" name="robot" style="font-size:2rem;color:var(--text-secondary);display:block;margin-bottom:12px;"></sl-icon>
    <p id="chat-empty-text" class="text-muted" style="margin:0;"></p>
</div>

<!-- Message list -->
<div id="chat-messages" style="overflow-y:auto;padding:4px 0 8px 0;"></div>

<!-- Composer: pill card. "+" menu (image attach) bottom-left; effective text-model
     label + streaming Stop button bottom-right. No Send button — Enter sends
     (see chat.js keydown handler). Drag-and-drop an image anywhere on the pill. -->
<div class="chat-composer-outer">
    <div id="chat-composer" class="chat-composer">
        <div id="chat-attach-preview" style="display:none;margin-bottom:6px;"></div>
        <sl-textarea id="chat-input" placeholder="Ask about your vault, or ask it to create/edit a note…"
            rows="2" resize="auto"></sl-textarea>
        <div class="chat-composer-bottom">
            <sl-dropdown id="chat-plus-dropdown" placement="top-start">
                <sl-icon-button slot="trigger" id="chat-plus-btn" name="plus-lg"
                    label="Add to chat"></sl-icon-button>
                <sl-menu id="chat-plus-menu">
                    <sl-menu-item value="add-image">
                        <sl-icon slot="prefix" name="image"></sl-icon> Add image
                    </sl-menu-item>
                </sl-menu>
            </sl-dropdown>
            <input type="file" id="chat-attach-input" multiple
                accept="image/png,image/jpeg,image/webp,image/gif" style="display:none;" />
            <div class="chat-composer-right">
                <span id="chat-model-label" title="Text model (set by admin)"></span>
                <sl-icon-button id="chat-stop" name="stop-circle-fill"
                    label="Stop generating" style="display:none;"></sl-icon-button>
            </div>
        </div>
    </div>
    <div id="chat-attach-hint" class="text-muted" style="font-size:0.72rem;margin-top:4px;display:none;"></div>
</div>

<!-- "Save to Bee" dialog — uploads a chat image to the vault media store (ACL-checked),
     attached to a user-picked note via the EXISTING /api-proxy/media/upload flow. -->
<sl-dialog id="chat-save-to-bee" label="Save image to Bee">
    <div style="display:flex;flex-direction:column;gap:10px;">
        <div id="chat-save-preview" style="text-align:center;"></div>
        <p class="text-muted" style="font-size:0.82rem;margin:0;">
            Adds this image to the end of a note you pick, as a new line at the bottom. Folder
            access is checked server-side — only folders you can write to are allowed.
        </p>
        <sl-input id="chat-save-search" placeholder="Search for a note…" clearable>
            <sl-icon slot="prefix" name="search"></sl-icon>
        </sl-input>
        <div id="chat-save-results" style="max-height:220px;overflow:auto;border:1px solid var(--sl-panel-border-color);border-radius:6px;"></div>
        <div id="chat-save-selected" class="text-muted" style="font-size:0.8rem;min-height:1.1rem;"></div>
    </div>
    <sl-button slot="footer" variant="default" data-save-close="1">Cancel</sl-button>
    <sl-button slot="footer" variant="primary" id="chat-save-confirm" disabled>Save</sl-button>
</sl-dialog>

<!-- Full-size image lightbox — click any chat image (uploaded or generated) to open it here.
     Reuses the SAME src as the thumbnail (full-resolution bytes). -->
<sl-dialog id="chat-image-lightbox" no-header style="--width: auto;">
    <img id="chat-lightbox-img" src="" alt="Full-size image" />
</sl-dialog>

@if (User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Role && c.Value == "superadmin"))
{
    <!-- Default-models quick editor (superadmin only; partial not rendered with this block
         for regular users). Same three pinned-default dropdowns as Admin -> AI / Chat ->
         "Default models", saving to the SAME global setting. This is a shortcut, not a
         per-conversation override. -->
    <sl-dialog id="chat-defaults-dialog" label="Default models (global)" style="--width:420px;">
        <p class="text-muted" style="font-size:0.82rem;margin:0 0 12px 0;">
            These are the node-wide defaults from Admin &rarr; AI / Chat. Saving changes them
            permanently for <strong>every conversation and every user</strong> on this node
            (applies from the next message).
        </p>
        <div style="display:flex;flex-direction:column;gap:12px;">
            <div>
                <label style="font-size:0.85rem;color:var(--text-secondary);display:block;margin-bottom:4px;">Default text model</label>
                <sl-select id="chat-dm-text" size="small" placeholder="Default"></sl-select>
            </div>
            <div>
                <label style="font-size:0.85rem;color:var(--text-secondary);display:block;margin-bottom:4px;">Default vision model</label>
                <sl-select id="chat-dm-vision" size="small" placeholder="Default"></sl-select>
            </div>
            <div>
                <label style="font-size:0.85rem;color:var(--text-secondary);display:block;margin-bottom:4px;">Default image-gen model</label>
                <sl-select id="chat-dm-imagegen" size="small" placeholder="Default"></sl-select>
            </div>
        </div>
        <div id="chat-dm-error" class="text-muted" style="font-size:0.8rem;color:var(--sl-color-danger-600);min-height:1rem;margin-top:8px;"></div>
        <sl-button slot="footer" variant="default" id="chat-dm-cancel">Cancel</sl-button>
        <sl-button slot="footer" variant="primary" id="chat-dm-save">Save for everyone</sl-button>
    </sl-dialog>
}
