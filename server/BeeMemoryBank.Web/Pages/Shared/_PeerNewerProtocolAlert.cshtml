@inject BeeMemoryBank.Web.Services.ApiClient ApiClient

@* The layout's sync warnings, from one /api/sync/status call: a peer on a newer protocol, and a node that cannot catch up. *@
@{
    var hasNewer = false;
    string? snapshotRequired = null;
    try
    {
        (hasNewer, snapshotRequired) = await ApiClient.GetSyncAlertsAsync();
    }
    catch {}
}

@if (hasNewer)
{
    <sl-alert variant="warning" open style="margin:12px 16px 0;">
        <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
        <strong>A peer node has a newer protocol version — update this node.</strong>
    </sl-alert>
}
@if (snapshotRequired != null)
{
    <sl-alert variant="danger" open style="margin:12px 16px 0;" data-testid="snapshot-required-alert">
        <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
        <strong>@snapshotRequired</strong>
    </sl-alert>
}
