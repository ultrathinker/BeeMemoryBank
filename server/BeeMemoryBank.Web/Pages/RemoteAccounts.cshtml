@page
@model BeeMemoryBank.Web.Pages.RemoteAccountsModel
@{
    ViewData["Title"] = "Remote Accounts";
}
<partial name="_Sidebar" />
<div id="page-content">
<div class="main-content">
    <h2 style="font-size:1.4rem;font-weight:700;margin:0 0 16px 0;">
        <sl-icon name="cloud-arrow-down" style="margin-right:6px;"></sl-icon>Remote Accounts
    </h2>
    <p class="text-muted" style="margin-bottom:18px;">
        Mirror folders read-only from another BMB node. Provide that node's URL plus the username/password
        of a guest account it created for you. The credentials are exchanged once for a 90-day token; the
        password itself is never persisted.
    </p>

    <sl-button id="btn-add-account" size="small" variant="primary" style="margin-bottom:14px;">
        <sl-icon slot="prefix" name="plus-lg"></sl-icon> Add Remote Account
    </sl-button>

    <div id="accounts-list"></div>

    <sl-dialog id="dlg-add-account" label="Add Remote Account" style="--width:520px;">
        <sl-alert id="add-error" variant="danger" closable style="margin-bottom:12px;display:none;">
            <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
            <span id="add-error-msg"></span>
        </sl-alert>
        <sl-input id="add-display" label="Display name" placeholder="Alice's BMB" required></sl-input>
        <sl-input id="add-url" label="Base URL" placeholder="https://her-node.example" required style="margin-top:8px;"></sl-input>
        <sl-input id="add-username" label="Username (on remote node)" required style="margin-top:8px;"></sl-input>
        <sl-input id="add-password" label="Password" type="password" required style="margin-top:8px;"></sl-input>
        <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-add-account">Cancel</sl-button>
        <sl-button id="btn-save-account" slot="footer" variant="primary">Connect</sl-button>
    </sl-dialog>

    <sl-dialog id="dlg-subs" label="Subscriptions" style="--width:620px;">
        <p class="text-muted text-sm" id="dlg-subs-account-info"></p>
        <sl-alert id="subs-error" variant="danger" closable style="margin-bottom:12px;display:none;">
            <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
            <span id="subs-error-msg"></span>
        </sl-alert>
        <h4 style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.8px;color:var(--text-secondary);margin:10px 0 8px;">
            Currently mirrored
        </h4>
        <div id="subs-current" style="margin-bottom:14px;"></div>
        <h4 style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.8px;color:var(--text-secondary);margin:10px 0 8px;">
            Available folders
        </h4>
        <div id="subs-available"></div>
        <sl-button slot="footer" variant="default" data-dlg-cancel="dlg-subs">Close</sl-button>
    </sl-dialog>
</div>
</div>

<script src="/js/pages/remote-accounts.js"></script>
