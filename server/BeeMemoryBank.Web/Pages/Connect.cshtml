@page
@model ConnectModel
@{
    ViewData["Title"] = "Connect a device";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BeeMemoryBank</title>
    <script type="module" src="/js/shoelace-init.js"></script>
    <link rel="stylesheet" href="/lib/shoelace/themes/dark.css" />
    <link href="/css/site.css" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <style>
        body { display: flex; align-items: flex-start; justify-content: center; min-height: 100vh; padding: 24px 0; }
        .connect-card { width: 520px; max-width: calc(100vw - 32px); background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 32px; }
        .connect-card h2 { margin-bottom: 8px; font-size: 1.3rem; text-align: center; }
        .connect-subtitle { text-align: center; color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 24px; }
        .endpoint { display: flex; flex-direction: column; align-items: center; gap: 12px; border: 1px solid var(--border); border-radius: 10px; padding: 20px; margin-bottom: 16px; background: var(--bg-app); }
        .endpoint .qr { width: 256px; height: 256px; image-rendering: pixelated; }
        .endpoint .url { font-family: monospace; font-size: 0.95rem; word-break: break-all; text-align: center; color: var(--sl-color-primary-400); }
        .download-row { text-align: center; margin: 20px 0; }
        .instructions { font-size: 0.85rem; line-height: 1.5; color: var(--text-secondary); }
        .instructions h3 { color: var(--text-primary); font-size: 0.95rem; margin: 18px 0 6px 0; }
        .instructions code { background: var(--bg-app); padding: 1px 5px; border-radius: 4px; font-size: 0.82rem; }
        .no-lan { text-align: center; color: var(--text-secondary); font-size: 0.9rem; padding: 24px 0; }
        .endpoint .code { font-size: 0.72rem; word-break: break-all; color: var(--text-secondary); }
        .firewall { border: 1px solid var(--sl-color-warning-600); border-radius: 10px; padding: 16px; margin-bottom: 16px; font-size: 0.85rem; line-height: 1.5; }
        .firewall form, .action-row { text-align: center; margin-top: 12px; }
    </style>
</head>
<body class="sl-theme-dark">
    <div class="connect-card">
        <h2>
            <sl-icon name="qr-code" style="font-size:1.4rem;vertical-align:middle;margin-right:6px;"></sl-icon>
            Connect a device
        </h2>
        <p class="connect-subtitle">Join a phone to this computer's network, without a hub. <a href="/Admin">Back to Admin</a></p>

        @if (Model.Lan.Error != null)
        {
            <sl-alert variant="danger" open style="margin-bottom:16px;">
                <sl-icon slot="icon" name="exclamation-octagon"></sl-icon>
                @Model.Lan.Error
            </sl-alert>
        }

        @if (Model.Lan.Mode == "unavailable")
        {
            <sl-alert variant="warning" open style="margin-bottom:16px;">
                <sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
                <strong>This node cannot open a LAN listener.</strong> Connecting a device this way
                works in the BeeMemoryBank Windows app. Other devices can join through a hub.
            </sl-alert>
        }
        else
        {
            @if (!Model.Lan.FirewallRule)
            {
                <div class="firewall">
                    <p><strong>Windows Firewall will block the phone.</strong> To let devices on your
                       local network reach this computer on port @Model.Lan.Port, BeeMemoryBank needs
                       to add one firewall rule. Windows will ask for administrator permission; this
                       happens once, and BeeMemoryBank never changes the firewall without asking.</p>
                    <form method="post" asp-page-handler="Firewall">
                        <sl-button type="submit" variant="default">
                            <sl-icon slot="prefix" name="shield-check"></sl-icon>
                            Allow in Windows Firewall&hellip;
                        </sl-button>
                    </form>
                </div>
            }

            @if (!Model.Lan.Active)
            {
                <p class="instructions">This computer is not listening on the network right now.
                   Opening it lets one phone join in the next 15 minutes; it closes by itself once
                   the phone has joined or the time is up. The vault stays unlocked.</p>
                <form method="post" asp-page-handler="Enable" class="action-row">
                    <sl-button type="submit" variant="primary">
                        <sl-icon slot="prefix" name="phone"></sl-icon>
                        Connect a device
                    </sl-button>
                </form>
            }
            else if (Model.HasLanAddress)
            {
                @if (Model.Lan.ExpiresAt is { } expiresAt)
                {
                    <p class="connect-subtitle">Open until @expiresAt.ToLocalTime().ToString("HH:mm"), or until a phone has joined.</p>
                }
                @foreach (var ep in Model.Endpoints)
                {
                    <div class="endpoint">
                        <img class="qr" src="@ep.QrDataUri" alt="Join code for @ep.Url" />
                        <span class="url">@ep.Url</span>
                        <sl-copy-button value="@ep.Code" copy-label="Copy join code"></sl-copy-button>
                        <code class="code">@ep.Code</code>
                    </div>
                }
                <div class="instructions">
                    <p>On the phone, choose <strong>Join</strong>, paste this join code (or scan the
                       QR with the camera and copy its text), and enter the master password. The
                       phone checks this computer's key from the code before it sends the password
                       anywhere.</p>
                </div>
                @if (Model.Lan.Mode == "on-demand")
                {
                    <form method="post" asp-page-handler="Disable" class="action-row">
                        <sl-button type="submit" variant="default">Stop listening</sl-button>
                    </form>
                }
            }
            else
            {
                <p class="no-lan">No LAN IPv4 address was detected on this machine. Connect to a network and refresh.</p>
            }
        }

        <div class="download-row">
            <sl-button variant="primary" href="/connect/ca.crt" download>
                <sl-icon slot="prefix" name="download"></sl-icon>
                Download CA certificate (ca.crt)
            </sl-button>
        </div>

        <div class="instructions">
            <p>Joining with the code above needs no certificate. To open this node's web pages from
               another device's browser, that device must trust this node's CA certificate: open
               the downloaded <code>ca.crt</code> on it and install it.</p>

            <h3>Android</h3>
            <p>Open the file, name the certificate (e.g. <code>BeeMemoryBank</code>), and choose
               <strong>VPN and apps</strong> as the use. Then in
               <em>Settings &rarr; Security &rarr; Encryption &amp; credentials &rarr; Trusted
               credentials</em>, confirm it appears under the user tab.</p>

            <h3>iOS</h3>
            <p>Open the file to add a profile under
               <em>Settings &rarr; Profile Downloaded &rarr; Install</em>. <strong>This is not
               enough on iOS</strong> &mdash; afterwards go to
               <em>Settings &rarr; General &rarr; About &rarr; Certificate Trust Settings</em> and
               enable full trust for this CA. Until that switch is on, iOS still rejects the
               connection.</p>

            <h3>Windows / macOS</h3>
            <p>Double-click <code>ca.crt</code> and place it in the <strong>Trusted Root
               Certification Authorities</strong> (Windows) or <strong>System</strong> keychain
               (macOS, mark it as <em>Always Trust</em>).</p>
        </div>
    </div>
</body>
</html>
