<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <!-- AddMdnsBrowser (join-wizard LAN discovery) and LocalCaService (the /api/connect/ca.crt
         endpoint) live in BeeMemoryBank.Infrastructure. -->
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Infrastructure\BeeMemoryBank.Infrastructure.csproj" />
    <!-- Hosting helpers used by Program.cs (ReadyFileInfo / StdinLifeline / AssemblyVersion) and
         Hosting.AspNetCore helpers used by Endpoints and Middleware (UserContentResponseHeaders,
         PublicRateLimitMiddleware). -->
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Hosting\BeeMemoryBank.Hosting.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Hosting.AspNetCore\BeeMemoryBank.Hosting.AspNetCore.csproj" />
    <!-- LegacyMigrationService uses Storage.Sqlite for the legacy-data rescue path. -->
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- QR-code generation for the "Connect a device" page (Connect.cshtml). Pure-managed,
         dependency-free; PngByteQRCode produces a PNG byte array rendered as a data URI. -->
    <PackageReference Include="QRCoder" />
  </ItemGroup>

</Project>