<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>bmb</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <!-- AddOnnxEmbeddings now lives here. Cli's `bmb seed` etc. wire it the same way
         the Api does, just without the image transcoder (the CLI has no upload path). -->
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Embeddings\BeeMemoryBank.Embeddings.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Sync\BeeMemoryBank.Sync.csproj" />
  </ItemGroup>

  <!-- model.onnx is NOT in git — download separately (see docs/deployment.md). The conditional
       keeps a clean clone buildable. Windows packaging passes BmbBundleModel=false: there the CLI
       sits next to api\ and uses its copy (see CliServiceProvider), saving 113 MB per install. -->
  <ItemGroup>
    <Content Include="..\..\libs\BeeMemoryBank.Embeddings\Models\model.onnx"
             Condition="Exists('..\..\libs\BeeMemoryBank.Embeddings\Models\model.onnx') And '$(BmbBundleModel)' != 'false'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>model.onnx</Link>
    </Content>
  </ItemGroup>

</Project>