<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The blind node's host. Not a fork of BeeMemoryBank.Api: it links the Api source files a blind node needs
    (same types, same namespaces, one definition - see linked-api-files.props) and adds its own, much smaller
    composition root, pipeline and startup. What is not linked cannot be in the container: MCP, agent auth, chat,
    embeddings, media, update, DEK rotation, the web UI proxy. tools/blind-link recomputes the linked set.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>BeeMemoryBank.BlindNode</RootNamespace>
    <!-- The Api's global-namespace Program is the Api's; this host has its own. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\BeeMemoryBank.AppPaths\BeeMemoryBank.AppPaths.csproj" />
    <!-- The shared libraries only. BeeMemoryBank.Vault (sessions, master-key handling, content crypto, full snapshot encrypt/restore, node
         management) is deliberately not referenced, and the shared libraries cannot reference it: the blind binaries do not contain that code. -->
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Crypto\BeeMemoryBank.Crypto.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Search\BeeMemoryBank.Search.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Sync\BeeMemoryBank.Sync.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Hosting\BeeMemoryBank.Hosting.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Hosting.AspNetCore\BeeMemoryBank.Hosting.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
  </ItemGroup>

  <Import Project="linked-api-files.props" Condition="Exists('linked-api-files.props')" />

  <ItemGroup>
    <InternalsVisibleTo Include="BeeMemoryBank.BlindNode.Tests" />
  </ItemGroup>

</Project>
