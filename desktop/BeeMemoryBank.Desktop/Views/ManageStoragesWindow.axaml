<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BeeMemoryBank.Desktop.Views"
        x:Class="BeeMemoryBank.Desktop.Views.ManageStoragesWindow"
        Title="Управление хранилищами"
        Width="720"
        Height="560"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#111119"
        Icon="avares://BeeMemoryBank.Desktop/Assets/icon.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Хранилища"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   Margin="0,0,0,16" />

        <Border Grid.Row="1"
                Background="#1A1A26"
                CornerRadius="6"
                Padding="2">
            <ScrollViewer>
                <ItemsControl Name="ProfilesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="views:ProfileRow">
                            <Border Background="#1E1E2A"
                                    CornerRadius="6"
                                    Padding="14,12"
                                    Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding DataPath}"
                                                   FontSize="11"
                                                   Foreground="#6B6B7B"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ActiveBadge}"
                                                   FontSize="11"
                                                   Foreground="#F59E0B"
                                                   IsVisible="{Binding IsActive}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button Content="Переименовать"
                                                Click="OnRenameClick"
                                                Tag="{Binding Id}"
                                                Padding="10,6"
                                                FontSize="12"
                                                Background="#2D2D3D"
                                                Foreground="#FFFFFF"
                                                CornerRadius="6" />
                                        <Button Content="Открыть папку"
                                                Click="OnOpenFolderClick"
                                                Tag="{Binding Id}"
                                                Padding="10,6"
                                                FontSize="12"
                                                Background="#2D2D3D"
                                                Foreground="#FFFFFF"
                                                CornerRadius="6" />
                                        <Button Content="Забыть"
                                                Click="OnForgetClick"
                                                Tag="{Binding Id}"
                                                Padding="10,6"
                                                FontSize="12"
                                                Background="#3D1F1F"
                                                Foreground="#FCA5A5"
                                                CornerRadius="6" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Autostart settings (§4.6): two-mode toggle, not per-profile checkboxes. -->
        <Border Grid.Row="2"
                Background="#1A1A26"
                CornerRadius="6"
                Padding="14,12"
                Margin="0,12,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Открывать при автозапуске"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF" />
                <RadioButton Name="AutostartLastUsedRadio"
                             Content="Последнее использованное хранилище"
                             Foreground="#D1D5DB"
                             FontSize="13"
                             Margin="0,4,0,0" />
                <RadioButton Name="AutostartFixedRadio"
                             Content="Фиксированное хранилище:"
                             Foreground="#D1D5DB"
                             FontSize="13" />
                <ComboBox Name="AutostartProfileCombo"
                          Margin="24,0,0,0"
                          MinWidth="300"
                          Background="#1E1E2A"
                          Foreground="#FFFFFF" />
                <TextBlock Name="AutostartHint"
                           Text=""
                           FontSize="11"
                           Foreground="#6B6B7B"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
