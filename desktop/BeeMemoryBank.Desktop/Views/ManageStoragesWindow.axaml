<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BeeMemoryBank.Desktop.Views"
        x:Class="BeeMemoryBank.Desktop.Views.ManageStoragesWindow"
        Title="Profiles"
        Width="760"
        Height="520"
        MinWidth="600"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#111119"
        Icon="avares://BeeMemoryBank.Desktop/Assets/icon.png">

    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0"
                       Text="Profiles"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="New profile..."
                        Click="OnNewProfileClick"
                        Padding="12,7"
                        Background="#F59E0B"
                        Foreground="#111119"
                        FontWeight="SemiBold"
                        CornerRadius="6" />
                <Button Content="Add existing..."
                        Click="OnAddExistingClick"
                        Padding="12,7"
                        Background="#2D2D3D"
                        Foreground="#FFFFFF"
                        CornerRadius="6" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="Each profile is a separate memory bank with its own data folder, password and sync network. Only one profile is open at a time."
                   FontSize="12"
                   Foreground="#A0A0B0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <Border Grid.Row="2"
                Background="#1A1A26"
                CornerRadius="6"
                Padding="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="ProfilesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="views:ProfileRow">
                            <Border Background="#1E1E2A"
                                    CornerRadius="6"
                                    Padding="14,12"
                                    Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding DataPath}"
                                                   FontSize="11"
                                                   Foreground="#6B6B7B"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding DataPath}" />
                                        <TextBlock Text="{Binding ActiveBadge}"
                                                   FontSize="11"
                                                   Foreground="#F59E0B"
                                                   IsVisible="{Binding IsActive}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <WrapPanel Grid.Column="1"
                                               Orientation="Horizontal"
                                               VerticalAlignment="Center"
                                               MaxWidth="330">
                                        <Button Content="Rename"
                                                Click="OnRenameClick"
                                                Tag="{Binding Id}"
                                                Margin="0,3,6,3"
                                                Padding="10,6"
                                                FontSize="12"
                                                Background="#2D2D3D"
                                                Foreground="#FFFFFF"
                                                CornerRadius="6" />
                                        <Button Content="Move..."
                                                Click="OnMoveClick"
                                                Tag="{Binding Id}"
                                                Margin="0,3,6,3"
                                                Padding="10,6"
                                                FontSize="12"
                                                Background="#2D2D3D"
                                                Foreground="#FFFFFF"
                                                CornerRadius="6" />
                                        <Button Content="Open folder"
                                                Click="OnOpenFolderClick"
                                                Tag="{Binding Id}"
                                                Margin="0,3,6,3"
                                                Padding="10,6"
                                                FontSize="12"
                                                Background="#2D2D3D"
                                                Foreground="#FFFFFF"
                                                CornerRadius="6" />
                                        <Button Content="Forget"
                                                Click="OnForgetClick"
                                                Tag="{Binding Id}"
                                                Margin="0,3,0,3"
                                                Padding="10,6"
                                                FontSize="12"
                                                Background="#3D1F1F"
                                                Foreground="#FCA5A5"
                                                CornerRadius="6" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="Which profile opens when Windows starts is set in Settings."
                   FontSize="11"
                   Foreground="#6B6B7B"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />
    </Grid>
</Window>
