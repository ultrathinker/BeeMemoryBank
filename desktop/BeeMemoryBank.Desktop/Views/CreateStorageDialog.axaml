<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BeeMemoryBank.Desktop.Views.CreateStorageDialog"
        Title="New profile"
        Width="520"
        MinWidth="420"
        MinHeight="240"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#111119"
        Icon="avares://BeeMemoryBank.Desktop/Assets/icon.png">

    <!-- Dialog layout used by every window of the shell: the buttons are docked at the bottom
         and always visible; everything else scrolls. SizeToContent grows the window when the
         Advanced section opens, up to MaxHeight, after which the content scrolls. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="24,12,24,20">
            <Button Name="CancelButton"
                    Content="Cancel"
                    Click="OnCancelClick"
                    IsCancel="True"
                    Padding="20,10"
                    Background="#2D2D3D"
                    Foreground="#FFFFFF"
                    CornerRadius="6" />
            <Button Name="CreateButton"
                    Content="Create"
                    Click="OnCreateClick"
                    IsDefault="True"
                    Padding="20,10"
                    Background="#F59E0B"
                    Foreground="#111119"
                    FontWeight="SemiBold"
                    CornerRadius="6" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,0" Spacing="12">
                <TextBlock Text="New profile"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           Margin="0,0,0,4" />

                <TextBlock Text="A profile is a separate memory bank with its own articles, password and sync network."
                           FontSize="12"
                           Foreground="#A0A0B0"
                           TextWrapping="Wrap" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Name"
                               FontSize="13"
                               Foreground="#A0A0B0" />
                    <TextBox Name="NameBox"
                             PlaceholderText="For example: Work"
                             FontSize="14"
                             Background="#1E1E2A"
                             Foreground="#FFFFFF" />
                </StackPanel>

                <Expander Name="AdvancedExpander"
                          Header="Advanced"
                          IsExpanded="False"
                          HorizontalAlignment="Stretch"
                          Foreground="#A0A0B0">
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="Data folder"
                                   FontSize="13"
                                   Foreground="#A0A0B0" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0"
                                     Name="DataPathBox"
                                     PlaceholderText="Standard location"
                                     FontSize="13"
                                     Background="#1E1E2A"
                                     Foreground="#FFFFFF" />
                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Click="OnBrowseClick"
                                    Margin="8,0,0,0"
                                    Padding="12,6"
                                    Background="#2D2D3D"
                                    Foreground="#FFFFFF"
                                    CornerRadius="6" />
                        </Grid>
                        <TextBlock Text="Leave empty to keep the data in the standard location. Otherwise pick an empty folder."
                                   FontSize="11"
                                   Foreground="#6B6B7B"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Expander>

                <TextBlock Name="ErrorText"
                           Text=""
                           FontSize="12"
                           Foreground="#EF4444"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
