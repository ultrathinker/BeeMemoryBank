<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BeeMemoryBank.Desktop.Views.ConfirmDialog"
        Title="Bee Memory Bank"
        Width="500"
        MinWidth="360"
        MinHeight="180"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#111119"
        Icon="avares://BeeMemoryBank.Desktop/Assets/icon.png">

    <!-- Same layout as CreateStorageDialog: buttons docked at the bottom, content scrolls. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="24,12,24,20">
            <Button Content="Cancel"
                    Name="CancelButton"
                    Click="OnCancelClick"
                    IsCancel="True"
                    Padding="20,10"
                    Background="#2D2D3D"
                    Foreground="#FFFFFF"
                    CornerRadius="6" />
            <Button Content="OK"
                    Name="ConfirmButton"
                    Click="OnConfirmClick"
                    Padding="20,10"
                    Background="#F59E0B"
                    Foreground="#111119"
                    FontWeight="SemiBold"
                    CornerRadius="6" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,0" Spacing="12">
                <TextBlock Name="TitleText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#F59E0B"
                           TextWrapping="Wrap" />
                <TextBlock Name="BodyText"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="#D1D5DB" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
