<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BeeMemoryBank.Desktop.Views.RekeyPasswordDialog"
        Title="Re-key the vault"
        Width="520"
        MinWidth="400"
        MinHeight="220"
        MaxHeight="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#111119"
        Icon="avares://BeeMemoryBank.Desktop/Assets/icon.png">

    <!-- Same layout as RenameStorageDialog: buttons docked at the bottom, content scrolls. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="24,12,24,20">
            <Button Content="Cancel"
                    Click="OnCancelClick"
                    IsCancel="True"
                    Padding="20,10"
                    Background="#2D2D3D"
                    Foreground="#FFFFFF"
                    CornerRadius="6" />
            <Button Content="Re-key"
                    Name="RekeyButton"
                    Click="OnRekeyClick"
                    IsDefault="True"
                    Padding="20,10"
                    Background="#F59E0B"
                    Foreground="#111119"
                    FontWeight="SemiBold"
                    CornerRadius="6" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,0" Spacing="12">
                <TextBlock Name="HeadingText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap" />
                <TextBlock FontSize="13"
                           Foreground="#D1D5DB"
                           TextWrapping="Wrap"
                           Text="Every note, file and chat in this vault is sealed again under a new key, so the old key opens none of it. The profile closes while this runs and opens again when it is done. Afterwards only your password opens the vault: other users reset their passwords, devices join again, and agents and recovery codes are created again. Blind nodes must be paired again. The old vault folder is kept until you delete it." />
                <TextBlock Text="Your password"
                           FontSize="13"
                           Foreground="#FFFFFF" />
                <TextBox Name="PasswordBox"
                         PasswordChar="•"
                         FontSize="14"
                         Background="#1E1E2A"
                         Foreground="#FFFFFF" />
                <TextBlock Name="ErrorText"
                           Text=""
                           FontSize="12"
                           Foreground="#EF4444"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
