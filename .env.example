# BeeMemoryBank — Docker environment configuration
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# Host ports (optional, defaults shown)
# BMB_WEB_PORT=5301   # Web UI (for browser) — the only port docker-compose.yml publishes
#
# Which host address the Web port is published on (optional, default 127.0.0.1 = this computer only).
# Set 0.0.0.0 to expose the login page on every network interface of the host ON PURPOSE (a trusted
# LAN). Docker's port publishing skips ufw, so this is reachable from anywhere the host is; put TLS in
# front of it (the session cookie is Secure) and read docs/internet-access.md first.
# BMB_WEB_BIND=127.0.0.1
#
# The API port (5300, REST + MCP for AI agents and the bmb CLI) is intentionally NOT published:
# /api/session/unlock, /api/session/status and /api/join answer without an internal key, so an
# internet-reachable API port is a master-password oracle. To reach it from other nodes, bind it
# to the host's loopback and path-filter through a reverse proxy — see docs/deployment.md.
#
# AI assistants on this computer (optional): uncomment the two marked lines in docker-compose.yml
# ("OPTIONAL: let AI assistants on THIS computer reach the node") to publish the API port on the
# host's loopback only. BMB_API_PORT is the host port it uses (default 5300).
# BMB_API_PORT=5300
#
# The address the Profile page prints in the connection snippet for an AI assistant. Normally you do
# not set it: docker-compose.reverse-proxy.yml (or the two lines above) already tell the page which
# port the API is on. Set it to print one fixed address instead, for example your public name when
# your reverse proxy forwards /mcp: https://bee.example.com/mcp
# BMB_MCP_URL=

# Data directory on host (optional, defaults to ./data)
# BMB_DATA_PATH=./data
