# BeeMemoryBank — Docker environment configuration
# Copy this file to .env and edit as needed:
#   cp .env.example .env
# It serves docker-compose.yml (build from source), docker-compose.image.yml (the ready-made image) and
# docker-compose.reverse-proxy.yml alike.

# Which release of the ready-made image to run (docker-compose.image.yml, docker/blind/compose.image.yaml; optional,
# default latest = the newest release). A release line (2.4) takes patch updates only; an exact version (2.4.0)
# never moves. Data migrations only go forward: to go back, restore the snapshot you made before updating.
# BMB_VERSION=latest

# Host ports (optional, defaults shown)
# BMB_WEB_PORT=5301   # Web UI (for browser) — the only port docker-compose.yml publishes
#
# Which host address the Web port is published on (optional, default 127.0.0.1 = this computer only).
# Set 0.0.0.0 to expose the login page on every network interface of the host ON PURPOSE (a trusted
# LAN). Docker's port publishing skips ufw, so this is reachable from anywhere the host is; put TLS in
# front of it (the session cookie is Secure) and read docs/internet-access.md first.
# BMB_WEB_BIND=127.0.0.1
#
# The API port (5300, REST + MCP for AI agents and the bmb CLI) is intentionally NOT published:
# /api/session/unlock, /api/session/status and /api/join answer without an internal key, so an
# internet-reachable API port is a master-password oracle. To reach it from other nodes, bind it
# to the host's loopback and path-filter through a reverse proxy — see docs/deployment.md.
#
# AI assistants on this computer (optional): uncomment the two marked lines in docker-compose.yml
# ("OPTIONAL: let AI assistants on THIS computer reach the node") to publish the API port on the
# host's loopback only. BMB_API_PORT is the host port it uses (default 5300).
# BMB_API_PORT=5300
#
# The address the Profile page prints in the connection snippet for an AI assistant. Normally you do
# not set it: docker-compose.reverse-proxy.yml (or the two lines above) already tell the page which
# port the API is on. Set it to print one fixed address instead, for example your public name when
# your reverse proxy forwards /mcp: https://bee.example.com/mcp
# BMB_MCP_URL=

# Where the node's data lives on the host (optional). A path (./data, /srv/bmb) is a folder on the host;
# unset, docker-compose.yml uses ./data and docker-compose.image.yml the Docker volume bmb-data.
# Set it BEFORE the first start: changing it later points the node at an empty place (move the data first).
# BMB_DATA_PATH=./data

# Start unlocked after a restart (optional, OFF unless the owner turns it on in the app; docs/deployment.md "Start unlocked after a restart").
# A restarted server stays locked until the master password is entered. The owner can switch that off for this server (Admin,
# "Start unlocked after a restart", two warnings and the typed phrase START UNLOCKED); the key that opens the vault is then kept in a
# FILE on the server, and anyone who gets this server's disk, a copy of its data folder or a backup of it can read the whole vault.
# Nothing here switches it on: this variable only names where the secret lives once the owner has done that. Set without the
# checkbox the node logs "key file configured, auto-unlock is off" and does nothing; a key file that merely appears is inert.
#
# BMB_AUTO_UNLOCK_KEY_FILE is the path INSIDE the container of a file that holds the secret (64 hex characters, mode 0400 or 0600
# for the user the node runs as, which is root in the shipped image). Keep that file OUTSIDE the data volume, so that no backup of
# the volume carries the key that opens it, and mount it read-only; the node reads it and never writes, moves or deletes it.
# docker-compose.yml shows the mount as a Docker secret (commented out). Left unset, the node creates its own owner-only file
# <data>/server-auto-unlock.key when the owner turns the checkbox on, and removes it when they turn it off.
#
# A restore never turns it on again: a server restored from a backup into a fresh folder, onto another machine, or with a changed
# slot starts LOCKED even with this file still mounted, because the enable record (<data>/server-auto-unlock.enabled) is local to
# the server and is in no backup. The one exception is a restore in place over the very server that enabled it, with a byte-identical
# slot: that keeps the owner's earlier choice. Back up with the data folder stopped and leave out the key and the record:
#   --exclude 'server-auto-unlock.*' --exclude os-auto-unlock.dat
# BMB_AUTO_UNLOCK_KEY_FILE=/run/secrets/bmb-auto-unlock-key
