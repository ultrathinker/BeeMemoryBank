<!--
  Central Package Management: every NuGet version for the whole repository lives here,
  and project files reference packages by name only. Before this, the same package was
  pinned separately in up to 18 .csproj files, so a bump that touched some of them and
  not the others produced a "package downgrade" (NU1605) build failure across the
  solution — which is exactly what Dependabot kept doing, since it updates one project
  directory at a time. With one version per package there is nothing left to desync.

  Add a package: put its <PackageVersion> here, then reference it from the project
  without a Version attribute. A project that genuinely needs a different version uses
  VersionOverride on its own PackageReference.
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Indiko.Maui.Controls.Markdown" Version="1.5.0" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageVersion Include="Markdig" Version="0.44.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Microsoft.Data.Sqlite.Core is the managed API only: the native SQLite comes from SQLite3MC.PCLRaw.bundle below. The full
         Microsoft.Data.Sqlite package would add a second SQLitePCLRaw bundle (e_sqlite3) next to it - never reference it. -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
    <!-- The Microsoft.Extensions.* family moves in lockstep: these packages reference each other
         with a ">= same patch" floor, so raising one of them alone makes every project that still
         pins the others fail with NU1605 — which is exactly why they are all on 10.0.11 here.
         Microsoft.AspNetCore.* and Microsoft.Data.Sqlite.Core ride the same .NET 10 servicing train and
         are kept level with it. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <!-- These, and Markdig above, were floating ("10.*", "*", "1.19.*", "0.44.*") in the mobile
         project, i.e. the build was not reproducible — a restore months apart could pull different packages. They are pinned to
         the versions that restore last resolved. Keep Xamarin.AndroidX.Core and Core.Core.Ktx on the
         same train when bumping (see the comment in BeeMemoryBank.Mobile.csproj). -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.100" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <!-- Image decoding and JPEG encoding (docs/adr/0008-image-library-skiasharp.md). Kept on the 3.119 line on purpose: it is the version
         Avalonia.Skia 12.1.x and SkiaSharp.Views.Maui (through Indiko.Maui.Controls.Markdown) already pin, so the desktop and mobile apps carry
         one SkiaSharp and one libSkiaSharp. The Linux native asset is the NoDependencies build (no libfontconfig on the Docker base image);
         the Win32 and macOS ones come with SkiaSharp itself. Decoder tests: Core.Tests SkiaImageTranscoderTests. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- The native SQLite of every node and app, and the only one a product project references: SQLite3 Multiple Ciphers (MIT; the
         SQLite amalgamation it embeds is public domain), used WITHOUT a key - every database stays a plain SQLite file, readable by
         the stock SQLite that 2.5.1 shipped. The package carries the native libraries for Windows, Linux (glibc and musl), macOS,
         Mac Catalyst, Android and iOS, and a SQLitePCLRaw provider that needs SQLitePCLRaw.core 3.0.2 or newer (NuGet resolves it,
         above the 2.1.12 Microsoft.Data.Sqlite.Core asks for). Its SQLite must never be older than 3.50.2 (CVE-2025-6965):
         tests/BeeMemoryBank.Storage.Tests/Engine/NativeEngineTests.cs reads sqlite_version() and sqlite3mc_version() at run time.
         Read the release notes of every bump (docs/sqlite-engine.md) before changing this line. -->
    <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.4.0" />
    <!-- The stock native SQLite 2.5.1 shipped (SQLite 3.53.3), for ONE use: tests/BeeMemoryBank.Storage.Tests loads the native file to
         prove that a database file written by the current engine opens on the old one and back. No product project references it. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageVersion Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />
    <!-- Same version Microsoft.ML.Tokenizers resolves, so Storage and Embeddings agree. -->
    <PackageVersion Include="System.Numerics.Tensors" Version="9.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageVersion Include="Velopack" Version="1.2.0" />
    <PackageVersion Include="Xamarin.AndroidX.Biometric" Version="1.1.0.33" />
    <!-- WorkManager 2.11 pulls Lifecycle 2.11 / Collection 1.6, while MAUI 10 pulls the 2.9.2 Lifecycle and 1.5 Collection.Ktx bindings, whose
         dependency ranges stop below 2.9.3 / 1.5.1 (NU1608 warnings; the ordinary app also had them for Activity.Ktx and Fragment.Ktx, which
         Biometric lifts). These transitive bindings are referenced directly by the Android apps and raised to the train WorkManager needs, so
         one coherent AndroidX set is resolved. Keep them level with Work.Runtime. -->
    <PackageVersion Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.3" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModel.Android" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState.Android" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Work.Runtime" Version="2.11.2.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
