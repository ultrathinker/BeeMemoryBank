<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\server\BeeMemoryBank.Api\BeeMemoryBank.Api.csproj" />
    <!-- Aliased: Api and Web both declare a global-namespace `Program`, which would make
         WebApplicationFactory<Program> ambiguous; the unaliased Program stays the API's. Web types are
         reached via `extern alias WebApp;` / `extern alias WebProject;` in the files that need them
         (BmbWebHostFactory, and the real-socket Web->API identity test for non-ASCII display names). -->
    <ProjectReference Include="..\..\server\BeeMemoryBank.Web\BeeMemoryBank.Web.csproj" Aliases="WebApp,WebProject" />
    <!-- Aliased for the same reason: the console page's own `Program` (BlindConsolePasswordTests hosts it
         in front of a real blind node, so the password change is tested through both processes). -->
    <ProjectReference Include="..\..\server\BeeMemoryBank.BlindConsole\BeeMemoryBank.BlindConsole.csproj" Aliases="BlindConsoleApp" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Sync\BeeMemoryBank.Sync.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Crypto\BeeMemoryBank.Crypto.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Rekey\BeeMemoryBank.Rekey.csproj" />
    <!-- Tests construct MediaService directly with a real ImageSharpImageTranscoder. -->
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Media\BeeMemoryBank.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
