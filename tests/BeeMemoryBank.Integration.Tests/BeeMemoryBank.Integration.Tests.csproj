<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Blind.AppCore\BeeMemoryBank.Blind.AppCore.csproj" />
    <ProjectReference Include="..\..\server\BeeMemoryBank.Api\BeeMemoryBank.Api.csproj" />
    <!-- NodeLockEndToEndTests: the real front's POST /node/lock in front of the real Api (the desktop node, in this process). -->
    <ProjectReference Include="..\..\desktop\BeeMemoryBank.Node\BeeMemoryBank.Node.csproj" />
    <!-- Aliased: Api and Web both declare a global-namespace `Program`, which would make
         WebApplicationFactory<Program> ambiguous; the unaliased Program stays the API's. Web types are
         reached via `extern alias WebApp;` / `extern alias WebProject;` in the files that need them
         (BmbWebHostFactory, and the real-socket Web->API identity test for non-ASCII display names). -->
    <ProjectReference Include="..\..\server\BeeMemoryBank.Web\BeeMemoryBank.Web.csproj" Aliases="WebApp,WebProject" />
    <!-- Aliased for the same reason: the console page's own `Program` (BlindConsolePasswordTests hosts it
         in front of a real blind node, so the password change is tested through both processes). -->
    <ProjectReference Include="..\..\server\BeeMemoryBank.BlindConsole\BeeMemoryBank.BlindConsole.csproj" Aliases="BlindConsoleApp" />
    <!-- CliJoinTests runs the real `bmb join` against a real Api on Kestrel (BMB-81). Aliased: the CLI's own `Program`. -->
    <ProjectReference Include="..\..\server\BeeMemoryBank.Cli\BeeMemoryBank.Cli.csproj" Aliases="CliApp" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Sync\BeeMemoryBank.Sync.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Crypto\BeeMemoryBank.Crypto.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Vault\BeeMemoryBank.Vault.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Blind.PhoneClient\BeeMemoryBank.Blind.PhoneClient.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Rekey\BeeMemoryBank.Rekey.csproj" />
    <!-- Tests construct MediaService directly with a real SkiaImageTranscoder. -->
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Media\BeeMemoryBank.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>


  <ItemGroup>
    <!-- The assembly-boundary scanner and the vault boundary (BMB-99): one source in tests/shared, linked into every project that proves the boundary. -->
    <Compile Include="..\shared\AssemblyBoundaryScanner.cs" Link="Shared\AssemblyBoundaryScanner.cs" />
    <Compile Include="..\shared\VaultBoundary.cs" Link="Shared\VaultBoundary.cs" />
    <!-- A throw-away CA and a loopback TLS server (public-CA trust mode, ADR 0007): one source in tests/shared. -->
    <Compile Include="..\shared\TestPki.cs" Link="Shared\TestPki.cs" />
    <!-- Windows-ACL facts and helpers (review release-a #7). -->
    <Compile Include="..\shared\WindowsAcl.cs" Link="Shared\WindowsAcl.cs" />
  </ItemGroup>

</Project>
