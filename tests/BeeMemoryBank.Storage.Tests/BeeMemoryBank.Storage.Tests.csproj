<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Vault\BeeMemoryBank.Vault.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- The stock SQLite 2.5.1 and older nodes shipped, as a native file only (this package carries no SQLitePCLRaw provider, so
         there is still one provider in the process: SQLite3 Multiple Ciphers). Engine/StockSqlite.cs loads it to prove that a
         database written by the current engine opens on the old one and back. Test project only; no product project references it. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- A vault written by the 2.5.1 tree on the stock engine; Fixtures/README.md says how it was made. -->
    <None Include="Fixtures\plain-2.5.1.sqlite" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Step B red tests (docs/design/step-b-spec.md 15.1.3): the walk that looks for a key in the managed object graph, one source in tests/shared. -->
    <Compile Include="..\shared\KeyGraphWalker.cs" Link="Shared\KeyGraphWalker.cs" />
    <Compile Include="..\shared\SealedCorpus.cs" Link="Shared\SealedCorpus.cs" />
    <Compile Include="..\shared\PlatformFacts.cs" Link="Shared\PlatformFacts.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
