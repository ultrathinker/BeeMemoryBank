<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the blind assemblies: the shared blind core and the phone's client. The original Core/Storage/Sync/Crypto
         libraries must NOT be referenced next to them (same types twice), and the trimmed APK then contains only what a
         blind node uses. -->
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Blind\BeeMemoryBank.Blind.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Blind.PhoneClient\BeeMemoryBank.Blind.PhoneClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindIdentityRecord.cs" Link="Shared\BlindIdentityRecord.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\IBlindNodeKeys.cs" Link="Shared\IBlindNodeKeys.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindMobilePairing.cs" Link="Shared\BlindMobilePairing.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindKeystoreNodeAuthSigner.cs" Link="Shared\BlindKeystoreNodeAuthSigner.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindReplicaSource.cs" Link="Shared\BlindReplicaSource.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindPhoneSync.cs" Link="Shared\BlindPhoneSync.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindPackageFetcher.cs" Link="Shared\BlindPackageFetcher.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindRunReport.cs" Link="Shared\BlindRunReport.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindBackupExport.cs" Link="Shared\BlindBackupExport.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindPhoneReset.cs" Link="Shared\BlindPhoneReset.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\PreferencesBlindStore.cs" Link="Shared\PreferencesBlindStore.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindHttpHandler.cs" Link="Shared\BlindHttpHandler.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindHttpClientProvider.cs" Link="Shared\BlindHttpClientProvider.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\SqliteBlindIdentityRecorder.cs" Link="Shared\SqliteBlindIdentityRecorder.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindStartup.cs" Link="Shared\BlindStartup.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\Blind\BlindMobileServices.cs" Link="Shared\BlindMobileServices.cs" />
    <!-- The PC's side of pairing a phone (a full node does this); the tests play the PC, the app never does, so the
         file is compiled into the tests only and is in neither blind assembly. -->
    <Compile Include="..\..\libs\BeeMemoryBank.Core\Services\BlindPhone\BlindPhoneBackupSeal.cs" Link="Shared\BlindPhoneBackupSeal.cs" />
    <Compile Include="..\..\libs\BeeMemoryBank.Core\Services\BlindPhone\BlindPhoneEnrollment.cs" Link="Shared\BlindPhoneEnrollment.cs" />
    <Compile Include="..\..\mobile\BeeMemoryBank.BlindMobile\Services\MaintenanceDetectingHandler.cs" Link="Shared\MaintenanceDetectingHandler.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
