<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeeMemoryBank.BlindIos.Pages.AccountsPage"
             Title="Accounts"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="520">

            <!-- A damaged list of accounts, or another copy of the app holding the folder: the screen says so and touches no account -->
            <Label x:Name="ProblemLabel" IsVisible="False" TextColor="{StaticResource ErrorColor}" FontAttributes="Bold" LineBreakMode="WordWrap" />
            <Label x:Name="NoticeLabel" IsVisible="False" FontSize="12" LineBreakMode="WordWrap" />

            <!-- The list of accounts and the disk disagree: each difference with the explicit action that settles it (never taken by the app on its own) -->
            <VerticalStackLayout x:Name="RepairsHost" Spacing="8" />

            <Label x:Name="DeviceLineLabel" AutomationId="BlindDeviceLine" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="WordWrap" />

            <!-- One card per account, built in code from BlindAccountsView -->
            <VerticalStackLayout x:Name="CardsHost" Spacing="8" />
            <Label x:Name="EmptyLabel" IsVisible="False" LineBreakMode="WordWrap"
                   Text="No accounts yet. Add one with the invitation of the person whose memory bank you keep a copy of: paste it, or scan its QR code with the Camera app." />

            <Button x:Name="AddButton" AutomationId="BlindAddAccount" Text="Add account" Style="{StaticResource PrimaryButton}" Clicked="OnAddClicked" />
            <Label x:Name="AddHintLabel" IsVisible="False" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="WordWrap" />

            <!-- Limits of the whole phone, over every account -->
            <Frame BorderColor="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="8" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="This phone" FontAttributes="Bold" />
                    <Label Text="What all the copies together may keep and use. An account has limits of its own too; the smaller one holds."
                           FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="WordWrap" />
                    <Label Text="Storage, all accounts" FontSize="12" />
                    <Entry x:Name="DeviceStoredEntry" Placeholder="no limit, e.g. 10 GB" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" Style="{StaticResource BaseEntry}" />
                    <Label Text="Traffic a day, all accounts" FontSize="12" />
                    <Entry x:Name="DeviceTrafficEntry" Placeholder="no limit, e.g. 500 MB" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" Style="{StaticResource BaseEntry}" />
                    <Label x:Name="DeviceLimitsHintLabel" FontSize="11" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="WordWrap" />
                    <Label x:Name="DeviceLimitsErrorLabel" IsVisible="False" TextColor="{StaticResource ErrorColor}" LineBreakMode="WordWrap" />
                    <Button x:Name="SaveDeviceLimitsButton" Text="Save the limits of this phone" Style="{StaticResource SecondaryButton}" Clicked="OnSaveDeviceLimitsClicked" />
                    <Label x:Name="DeviceUsageProblemLabel" IsVisible="False" TextColor="{StaticResource ErrorColor}" LineBreakMode="WordWrap" />
                    <Button x:Name="RepairDeviceUsageButton" IsVisible="False" Text="Start new counts for this phone" Style="{StaticResource SecondaryButton}" Clicked="OnRepairDeviceUsageClicked" />
                </VerticalStackLayout>
            </Frame>

            <Label x:Name="BackgroundLabel" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="WordWrap" />
            <Label x:Name="AlertsLabel" IsVisible="False" FontSize="12" TextColor="{StaticResource WarningColor}" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
