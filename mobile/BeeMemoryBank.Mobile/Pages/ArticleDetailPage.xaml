<?xml version="1.0" encoding="UTF-8" ?>
<!-- The mock-up's article screen: the headline, the meta bar (path chip, tag pills, date),
     the markdown body (or the raw text), the lock card of a protected article, the related
     articles and the comments with their input row. The header carries Edit and the ⋮ menu. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:idk="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
             xmlns:controls="clr-namespace:BeeMemoryBank.Mobile.Controls"
             xmlns:loc="clr-namespace:BeeMemoryBank.Mobile.Localization"
             x:Class="BeeMemoryBank.Mobile.Pages.ArticleDetailPage"
             Title="Article">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{loc:Translate Edit}" Order="Primary" Clicked="OnEditClicked" AutomationId="EditButton" />
        <ToolbarItem x:Name="MoveItem" Text="{loc:Translate Move}" Order="Secondary" Clicked="OnMoveClicked" AutomationId="MoveButton" />
        <ToolbarItem x:Name="ToggleViewItem" Text="{loc:Translate ShowRaw}" Order="Secondary" Clicked="OnToggleViewClicked" AutomationId="ToggleViewButton" />
        <ToolbarItem x:Name="PasswordItem" Text="{loc:Translate SetPassword}" Order="Secondary" Clicked="OnPasswordClicked" AutomationId="PasswordButton" />
        <ToolbarItem Text="{loc:Translate Delete}" Order="Secondary" Clicked="OnDeleteClicked" AutomationId="DeleteButton" />
    </ContentPage.ToolbarItems>

    <RefreshView x:Name="PullRefresh" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" IsVisible="True" />

                <Label x:Name="TitleLabel"
                       AutomationId="TitleLabel"
                       FontSize="22"
                       FontFamily="{StaticResource FontBodyBold}"
                       LineBreakMode="WordWrap"
                       IsVisible="False" />

                <!-- .article-meta-bar: the path chip and the date, then the tag pills.
                     No FlexLayout inside a FlexLayout: the inner one is measured with an unbounded
                     width and MAUI's FlexLayoutManager throws "something is deeply wrong" on the
                     first article that has tags (seen on the test phone 14.11). -->
                <VerticalStackLayout x:Name="MetaCard" IsVisible="False">
                <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BmbSurfaceLight}, Dark={StaticResource BmbSurface}}"
                            Stroke="{AppThemeBinding Light={StaticResource BmbBorderLight}, Dark={StaticResource BmbBorder}}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 10"
                            Padding="12,6" Margin="0,0,8,8" MinimumHeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPathChipTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Image Source="{AppThemeBinding Light=icon_row_folder_light.svg, Dark=icon_row_folder_dark.svg}"
                                   WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                            <Label x:Name="PathLabel" FontSize="13"
                                   FontFamily="{StaticResource FontBodyMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource BmbTextSecondaryLight}, Dark={StaticResource BmbTextSecondary}}"
                                   VerticalOptions="Center" LineBreakMode="TailTruncation" MaximumWidthRequest="220" />
                        </HorizontalStackLayout>
                    </Border>
                    <Label x:Name="UpdatedLabel" Style="{StaticResource ItemMeta}" Margin="0,0,8,8" VerticalOptions="Center" />
                </FlexLayout>
                    <controls:TagLine x:Name="ConceptTagsLayout" IsVisible="False" />
                </VerticalStackLayout>

                <!-- Lock card for password-protected articles: enter the passphrase to decrypt locally.
                     No server involved — the BMBENC1 body is unwrapped on-device. The field is the
                     SecretEntry (no eye button: Android must not treat it as a credential field). -->
                <Border x:Name="LockCard" IsVisible="False"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BmbSurfaceLight}, Dark={StaticResource BmbSurface}}"
                        Stroke="{AppThemeBinding Light={StaticResource BmbAccentBorderLight}, Dark={StaticResource BmbAccentBorder}}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 24" Padding="18,22">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BmbAccentSoftLight}, Dark={StaticResource BmbAccentSoft}}">
                                <Image Source="{AppThemeBinding Light=icon_row_lock_light.svg, Dark=icon_row_lock_dark.svg}"
                                       WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Translate ProtectedTitle}" Style="{StaticResource ItemTitle}" />
                                <Label x:Name="LockHintLabel" IsVisible="False" Style="{StaticResource ItemMeta}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{loc:Translate ArticlePasswordLabel}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputShell}">
                                <controls:SecretEntry x:Name="UnlockPassEntry" Placeholder="{loc:Translate EnterArticlePassword}"
                                       AutomationId="UnlockPassEntry"
                                       BackgroundColor="Transparent"
                                       IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                       ReturnType="Go" Completed="OnUnlockClicked" />
                            </Border>
                            <Label x:Name="UnlockErrorLabel" IsVisible="False" Style="{StaticResource FieldError}" />
                        </VerticalStackLayout>
                        <Button Text="{loc:Translate OpenArticle}"
                                AutomationId="UnlockButton"
                                Style="{StaticResource PrimaryButton}"
                                Clicked="OnUnlockClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- The body: rendered markdown, or the raw text in the .raw-body card -->
                <Border x:Name="ContentCard" IsVisible="False"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BmbSurfaceLight}, Dark={StaticResource BmbSurface}}"
                        Stroke="{AppThemeBinding Light={StaticResource BmbBorderLight}, Dark={StaticResource BmbBorder}}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="0">
                        <idk:MarkdownView x:Name="ContentMarkdown" AutomationId="ContentMarkdown" />
                        <Label x:Name="ContentRawLabel"
                               AutomationId="ContentRawLabel"
                               IsVisible="False"
                               LineBreakMode="WordWrap"
                               FontSize="13"
                               FontFamily="Monospace"
                               TextColor="{AppThemeBinding Light={StaticResource BmbTextSecondaryLight}, Dark={StaticResource BmbTextSecondary}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Related articles (.article-footer-section) -->
                <VerticalStackLayout x:Name="RelatedArticlesCard" IsVisible="False" Spacing="10" Margin="0,10,0,0">
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BmbBorderLight}, Dark={StaticResource BmbBorder}}" Margin="0,0,0,6" />
                    <Label x:Name="RelatedHeaderLabel" Style="{StaticResource CardTitle}" />
                    <VerticalStackLayout x:Name="RelatedArticlesList" AutomationId="RelatedArticlesList" Spacing="6"
                                        >
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BmbSurfaceHighLight}, Dark={StaticResource BmbSurfaceHigh}}"
                                        Stroke="{AppThemeBinding Light={StaticResource BmbBorderLight}, Dark={StaticResource BmbBorder}}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 12"
                                        Padding="12,10" MinimumHeightRequest="46">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRelatedArticleTapped" CommandParameter="{Binding Id}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Image Grid.Column="0" Source="{AppThemeBinding Light=icon_row_file_light.svg, Dark=icon_row_file_dark.svg}"
                                               WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                               FontFamily="{StaticResource FontBodyMedium}"
                                               LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                        <Image Grid.Column="2" Source="{AppThemeBinding Light=icon_row_chevron_light.svg, Dark=icon_row_chevron_dark.svg}"
                                               WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Button x:Name="RelatedShowMoreButton" AutomationId="RelatedShowMoreButton"
                                Text="{loc:Translate ShowMore}" IsVisible="False"
                                Style="{StaticResource TextButton}" Clicked="OnRelatedShowMoreClicked" />
                        <Button x:Name="RelatedShowAllButton" AutomationId="RelatedShowAllButton"
                                Text="{loc:Translate ShowAll}" IsVisible="False"
                                Style="{StaticResource TextButton}" Clicked="OnRelatedShowAllClicked" />
                        <Button x:Name="RelatedShowLessButton" AutomationId="RelatedShowLessButton"
                                Text="{loc:Translate ShowLess}" IsVisible="False"
                                Style="{StaticResource TextButton}"
                                TextColor="{AppThemeBinding Light={StaticResource BmbTextSecondaryLight}, Dark={StaticResource BmbTextSecondary}}"
                                Clicked="OnRelatedShowLessClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Comments (.article-footer-section) -->
                <VerticalStackLayout x:Name="CommentsCard" IsVisible="False" Spacing="10" Margin="0,10,0,0">
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BmbBorderLight}, Dark={StaticResource BmbBorder}}" Margin="0,0,0,6" />
                    <Label x:Name="CommentsHeaderLabel" Style="{StaticResource CardTitle}" />
                    <Label x:Name="NoCommentsLabel" Text="{loc:Translate NoComments}" Style="{StaticResource ItemMeta}" IsVisible="False" />
                    <VerticalStackLayout x:Name="CommentsList" AutomationId="CommentsList" Spacing="8"
                                        >
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BmbSurfaceLight}, Dark={StaticResource BmbSurface}}"
                                        Stroke="{AppThemeBinding Light={StaticResource BmbBorderLight}, Dark={StaticResource BmbBorder}}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding CreatedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource BmbTextSecondaryLight}, Dark={StaticResource BmbTextSecondary}}" />
                                            <Button Grid.Column="1" Text="{loc:Translate Delete}"
                                                    Style="{StaticResource TextButton}"
                                                    FontSize="12" MinimumHeightRequest="28" Padding="6,2"
                                                    TextColor="{AppThemeBinding Light={StaticResource BmbErrorLight}, Dark={StaticResource BmbError}}"
                                                    AutomationId="DeleteCommentButton"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnDeleteCommentClicked" />
                                        </Grid>
                                        <Label Text="{Binding Text}" FontSize="14" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                        <Border Grid.Column="0" Style="{StaticResource InputShell}">
                            <Editor x:Name="CommentEntry"
                                    AutomationId="CommentEntry"
                                    Placeholder="{loc:Translate AddCommentPlaceholder}"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="40"
                                    BackgroundColor="Transparent"
                                    Margin="0" />
                        </Border>
                        <Button Grid.Column="1" Text="{loc:Translate Send}"
                                AutomationId="AddCommentButton"
                                Style="{StaticResource PrimaryButton}"
                                VerticalOptions="End"
                                Clicked="OnAddCommentClicked" />
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
