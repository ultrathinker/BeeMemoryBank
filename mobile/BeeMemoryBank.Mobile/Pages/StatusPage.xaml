<?xml version="1.0" encoding="UTF-8" ?>
<!-- The mock-up's Sync screen. When the phone knows no way to reach a peer (the old "Action
     Required" state) only the approval card is shown; otherwise the state banners, the state card
     with "Sync now", the invisible-mode switch, the devices and the recent events. Device rows open
     a sheet (change / remove address, remove device); the address work stays in the one service. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BeeMemoryBank.Mobile.Controls"
             xmlns:loc="clr-namespace:BeeMemoryBank.Mobile.Localization"
             x:Class="BeeMemoryBank.Mobile.Pages.StatusPage"
             Title="{loc:Translate TabSync}">

    <RefreshView x:Name="RefreshView" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Waits for approval: the whole screen while the phone has no peer channel. -->
                <Border x:Name="PendingCard" Style="{StaticResource CardBorder}" IsVisible="False">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{loc:Translate SyncPendingTitle}" Style="{StaticResource CardTitle}" />
                        <Label Text="{loc:Translate SyncPendingDesc}" Style="{StaticResource ItemMeta}" />
                        <VerticalStackLayout Spacing="6">
                            <controls:InfoRow Label="{loc:Translate SyncThisDevice}">
                                <Label x:Name="PendingDeviceName" Style="{StaticResource ItemTitle}" />
                            </controls:InfoRow>
                            <controls:InfoRow Label="{loc:Translate SyncDeviceIdLabel}">
                                <Label x:Name="PendingDeviceId"
                                       FontFamily="monospace" FontSize="15" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BmbAccentTextLight}, Dark={StaticResource BmbAccentText}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCopyNodeIdClicked" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </controls:InfoRow>
                        </VerticalStackLayout>
                        <Button x:Name="CheckAgainButton" AutomationId="CheckAgainButton"
                                Text="{loc:Translate SyncCheckAgain}" Style="{StaticResource PrimaryButton}"
                                Clicked="OnCheckAgainClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- The normal screen. -->
                <VerticalStackLayout x:Name="NormalScreen" Spacing="12">

                    <Border x:Name="OfflineBanner" IsVisible="False" Style="{StaticResource CardBorder}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BmbSurfaceHighLight}, Dark={StaticResource BmbSurfaceHigh}}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate SyncOfflineTitle}" Style="{StaticResource CardTitle}" />
                            <Label Text="{loc:Translate SyncOfflineDesc}" Style="{StaticResource ItemMeta}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="ErrorBanner" IsVisible="False" Style="{StaticResource CardBorder}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BmbErrorBackgroundLight}, Dark={StaticResource BmbErrorBackground}}"
                            Stroke="{AppThemeBinding Light={StaticResource BmbErrorBorderLight}, Dark={StaticResource BmbErrorBorder}}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{loc:Translate SyncErrorTitle}" Style="{StaticResource CardTitle}"
                                   TextColor="{AppThemeBinding Light={StaticResource BmbErrorLight}, Dark={StaticResource BmbError}}" />
                            <Label x:Name="ErrorText" Style="{StaticResource ItemMeta}" />
                            <Button x:Name="RetryButton" AutomationId="RetryButton"
                                    Text="{loc:Translate Retry}" Style="{StaticResource PrimaryButton}"
                                    Clicked="OnSyncNowClicked" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- An administrator disconnected this phone (2.12): one calm sentence in the plain card colours, not an error. -->
                    <Border x:Name="DisconnectedBanner" IsVisible="False" AutomationId="DisconnectedBanner" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate SyncDisconnectedTitle}" Style="{StaticResource CardTitle}" />
                            <Label Text="{loc:Translate SyncProblemDisconnected}" Style="{StaticResource ItemMeta}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- A computer that is simply away: yellow, never red. -->
                    <Border x:Name="UnreachableBanner" IsVisible="False" AutomationId="UnreachableBanner" Style="{StaticResource CardBorder}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BmbWarningBackgroundLight}, Dark={StaticResource BmbWarningBackground}}"
                            Stroke="{AppThemeBinding Light={StaticResource BmbWarningBorderLight}, Dark={StaticResource BmbWarningBorder}}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate SyncUnreachableTitle}" Style="{StaticResource CardTitle}"
                                   TextColor="{AppThemeBinding Light={StaticResource BmbWarningLight}, Dark={StaticResource BmbWarning}}" />
                            <Label x:Name="UnreachableText" Style="{StaticResource ItemMeta}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="BgWarningBanner" IsVisible="False" AutomationId="BgWarningBanner" Style="{StaticResource CardBorder}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BmbWarningBackgroundLight}, Dark={StaticResource BmbWarningBackground}}"
                            Stroke="{AppThemeBinding Light={StaticResource BmbWarningBorderLight}, Dark={StaticResource BmbWarningBorder}}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate SyncBgOffTitle}" Style="{StaticResource CardTitle}"
                                   TextColor="{AppThemeBinding Light={StaticResource BmbWarningLight}, Dark={StaticResource BmbWarning}}" />
                            <Label Text="{loc:Translate SyncBgOffDesc}" Style="{StaticResource ItemMeta}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- State -->
                    <Border x:Name="StateCard" AutomationId="SyncStateCard" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{loc:Translate SyncStateCard}" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                                <Border Grid.Column="1" x:Name="StatePill" StrokeThickness="1" StrokeShape="RoundRectangle 11" Padding="10,4" VerticalOptions="Center">
                                    <Label x:Name="StatePillLabel" FontSize="12" FontFamily="{StaticResource FontBodySemibold}" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Spacing="6">
                                <controls:InfoRow x:Name="LastSyncRow" Label="{loc:Translate SyncLastSync}">
                                    <Label x:Name="LastSyncValue" Style="{StaticResource ItemTitle}" />
                                </controls:InfoRow>
                                <controls:InfoRow Label="{loc:Translate SyncBgLabel}">
                                    <Label x:Name="BgSyncValue" Style="{StaticResource ItemTitle}" />
                                </controls:InfoRow>
                            </VerticalStackLayout>
                            <Button x:Name="SyncNowButton" AutomationId="SyncNowButton"
                                    Text="{loc:Translate SyncNow}" Style="{StaticResource PrimaryButton}"
                                    Clicked="OnSyncNowClicked" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Invisible mode -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Translate SyncInvisibleTitle}" Style="{StaticResource ItemTitle}" />
                                <Label Text="{loc:Translate SyncInvisibleDesc}" Style="{StaticResource ItemMeta}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" x:Name="InvisibleSwitch" AutomationId="InvisibleSwitch"
                                    VerticalOptions="Center" Toggled="OnInvisibleToggled" />
                        </Grid>
                    </Border>

                    <!-- Devices -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{loc:Translate SyncDevicesCard}" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                                <Button Grid.Column="1" x:Name="AddAddressButton" AutomationId="AddAddressButton"
                                        Text="{loc:Translate SyncAddAddress}" Style="{StaticResource TextButton}"
                                        Clicked="OnAddAddressClicked" />
                            </Grid>
                            <Label x:Name="NoDevicesLabel" Text="{loc:Translate SyncNoDevices}" Style="{StaticResource ItemMeta}" IsVisible="False" />
                            <VerticalStackLayout x:Name="DevicesList" AutomationId="PeersList" Spacing="8" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Recent events -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{loc:Translate SyncEventsCard}" Style="{StaticResource CardTitle}" />
                            <Label x:Name="NoEventsLabel" Text="{loc:Translate SyncNoEvents}" Style="{StaticResource ItemMeta}" IsVisible="False" />
                            <VerticalStackLayout x:Name="EventsList" AutomationId="ActivityList" Spacing="6" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
