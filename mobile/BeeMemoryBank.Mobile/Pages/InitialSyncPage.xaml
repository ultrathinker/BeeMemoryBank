<?xml version="1.0" encoding="UTF-8" ?>
<!-- The mock-up's first-sync screen: the spinner, the title, the progress counter, and on error the
     retry and the cancel-and-delete. The counter is the existing one - events applied - because the
     initial sync reports events, not "N of M articles". -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BeeMemoryBank.Mobile.Localization"
             x:Class="BeeMemoryBank.Mobile.Pages.InitialSyncPage"
             Title="Initial Sync"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <Grid Padding="24" RowDefinitions="*,Auto,Auto,Auto,Auto,*,Auto">

        <VerticalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="Center">
            <Label Text="{loc:Translate InitialSyncTitle}"
                   FontSize="22" FontAttributes="Bold"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Label Text="{loc:Translate InitialSyncDesc}"
                   Style="{StaticResource ItemMeta}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="2" x:Name="Spinner" IsRunning="True" Margin="0,24,0,16" />

        <Label Grid.Row="3" x:Name="CounterLabel" AutomationId="InitialSyncCounter"
               Text="{loc:Translate InitialSyncConnecting}"
               FontSize="16" FontAttributes="Bold"
               HorizontalOptions="Center" HorizontalTextAlignment="Center" />

        <Label Grid.Row="4" x:Name="ErrorLabel" IsVisible="False"
               Style="{StaticResource FieldError}"
               HorizontalTextAlignment="Center" Margin="0,16,0,0" />

        <VerticalStackLayout Grid.Row="6" Spacing="12">
            <Button x:Name="RetryButton" AutomationId="InitialSyncRetryButton"
                    Text="{loc:Translate Retry}" IsVisible="False"
                    Clicked="OnRetryClicked" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="CancelButton" AutomationId="InitialSyncCancelButton"
                    Text="{loc:Translate InitialSyncCancel}"
                    Clicked="OnCancelClicked" Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
