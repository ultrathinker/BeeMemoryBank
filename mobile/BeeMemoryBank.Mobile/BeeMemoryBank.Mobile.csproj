<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <ApplicationId>com.beememorybank.mobile</ApplicationId>
    <ApplicationTitle>BeeMemoryBank</ApplicationTitle>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <RootNamespace>BeeMemoryBank.Mobile</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Both versions come from the repo-root VERSION file (Directory.Build.props sets $(Version)),
         like every other app in the repo. Android's versionCode must be an increasing integer:
         major*10000 + minor*100 + patch, so 1.0.7 -> 10007. A pre-release label is ignored here. -->
    <_BmbCoreVersion>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+').Value)</_BmbCoreVersion>
    <_BmbCoreVersion Condition="'$(_BmbCoreVersion)' == ''">1.0.0</_BmbCoreVersion>
    <ApplicationDisplayVersion>$(_BmbCoreVersion)</ApplicationDisplayVersion>
    <_BmbMajor>$(_BmbCoreVersion.Split('.')[0])</_BmbMajor>
    <_BmbMinor>$(_BmbCoreVersion.Split('.')[1])</_BmbMinor>
    <_BmbPatch>$(_BmbCoreVersion.Split('.')[2])</_BmbPatch>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(_BmbMajor), 10000)), $([MSBuild]::Multiply($(_BmbMinor), 100)))), $(_BmbPatch)))</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#FFFFFF" ForegroundScale="0.62" />
    <MauiImage Include="Resources\Images\*.svg" />
    <!-- The ONNX model (~87 MB) is gitignored and fetched at build time (see CI / docs).
         Keep this asset conditional so a clean clone without the model still builds;
         the app falls back to downloading it at runtime when it is absent. -->
    <MauiAsset Include="Resources\Raw\model.onnx" LogicalName="model.onnx" Condition="Exists('Resources\Raw\model.onnx')" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <AndroidResource Include="Platforms\Android\Resources\xml\network_security_config.xml" LogicalName="res\xml\network_security_config.xml" />
    <AndroidResource Include="Platforms\Android\Resources\xml\data_extraction_rules.xml" LogicalName="res\xml\data_extraction_rules.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Indiko.Maui.Controls.Markdown" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Core and Core.Core.Ktx are pinned to the SAME train (1.19.x). WorkManager transitively pulls an
         older Core.Core.Ktx (1.17.x) which duplicates androidx.core.animation.AnimatorKt with a newer
         Core → R8 "defined multiple times". A floating "*" on only one of them can re-introduce that on
         a future restore, so both are pinned together. Bump both in lockstep when upgrading AndroidX. -->
    <PackageReference Include="Xamarin.AndroidX.Core" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Biometric" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" />
    <!-- The AndroidX bindings MAUI pulls at an older train than Work.Runtime needs: same versions as Directory.Packages.props, so NU1608 is gone. -->
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Android" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState.Android" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" />
    <PackageReference Include="Markdig" />
    <!-- The native SQLite is SQLite3MC.PCLRaw.bundle, referenced by BeeMemoryBank.Storage: its package carries libsqlite3mc.so for
         android-arm, android-arm64, android-x64 and android-x86 (runtimes/<rid>/native), which .NET for Android packs into the APK.
         Nothing to exclude here: the glibc libe_sqlite3.so that the old engine's package handed this app through the RID fallback
         (linux-arm64 for android-arm64, NEEDED libc.so.6, a launch crash on bionic) has no counterpart any more, because the new
         package has android RIDs of its own. tests/BeeMemoryBank.BlindMobile.Tests/NativeSqliteAssetsTests reads the resolved graph of both apps. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <!-- OnnxEmbeddingGenerator for offline semantic search; the camera-roll upload path needs
         the IImageTranscoder from Media (separately carved out from Infrastructure so this app
         does not pull in mDNS / DPAPI). -->
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Embeddings\BeeMemoryBank.Embeddings.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Media\BeeMemoryBank.Media.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Crypto\BeeMemoryBank.Crypto.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Sync\BeeMemoryBank.Sync.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Vault\BeeMemoryBank.Vault.csproj" />
  </ItemGroup>

</Project>
