<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <ApplicationId>com.beememorybank.mobile</ApplicationId>
    <ApplicationTitle>BeeMemoryBank</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <RootNamespace>BeeMemoryBank.Mobile</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiImage Include="Resources\Images\*.svg" />
    <!-- The ONNX model (~87 MB) is gitignored and fetched at build time (see CI / docs).
         Keep this asset conditional so a clean clone without the model still builds;
         the app falls back to downloading it at runtime when it is absent. -->
    <MauiAsset Include="Resources\Raw\model.onnx" LogicalName="model.onnx" Condition="Exists('Resources\Raw\model.onnx')" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <AndroidResource Include="Platforms\Android\Resources\xml\network_security_config.xml" LogicalName="res\xml\network_security_config.xml" />
    <AndroidResource Include="Platforms\Android\Resources\xml\data_extraction_rules.xml" LogicalName="res\xml\data_extraction_rules.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Indiko.Maui.Controls.Markdown" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Core and Core.Core.Ktx are pinned to the SAME train (1.19.x). WorkManager transitively pulls an
         older Core.Core.Ktx (1.17.x) which duplicates androidx.core.animation.AnimatorKt with a newer
         Core → R8 "defined multiple times". A floating "*" on only one of them can re-introduce that on
         a future restore, so both are pinned together. Bump both in lockstep when upgrading AndroidX. -->
    <PackageReference Include="Xamarin.AndroidX.Core" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Biometric" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" />
    <PackageReference Include="Markdig" />
    <!-- BeeMemoryBank.Storage references SQLitePCLRaw.lib.e_sqlite3 directly, to force the native
         SQLite above the vulnerable 2.1.11 (CVE-2025-6965). That package ships desktop RIDs only
         — the Android build lives in the separate SQLitePCLRaw.lib.e_sqlite3.android AAR — but
         the RID graph lets android-arm64 fall back to linux-arm64, so without this line NuGet
         hands this app a GLIBC libe_sqlite3.so (NEEDED: libc.so.6, ld-linux-aarch64.so.1). It
         wins the packaging race, the correct AAR copy is dropped as a duplicate (warning XA4301),
         and the app dies on launch with a TypeInitializationException out of
         Microsoft.Data.Sqlite.SqliteConnection — dlopen cannot resolve glibc on bionic. The
         managed assets are still wanted; only the native ones are wrong here. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" ExcludeAssets="native;runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Crypto\BeeMemoryBank.Crypto.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Sync\BeeMemoryBank.Sync.csproj" />
  </ItemGroup>

</Project>
