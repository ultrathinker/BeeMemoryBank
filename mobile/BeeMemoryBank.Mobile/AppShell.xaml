<?xml version="1.0" encoding="UTF-8" ?>
<!-- The mock-up's main shell: four bottom tabs (Tree, Search, Sync, Settings) and the header with
     the sync state badge. The first-run and unlock gates live outside the tabs, as before.
     Tab icons are assigned in code (AppShell.xaml.cs): they follow the appearance and the
     selected tab, the colours the mock-up gives .nav-tab and .nav-tab.is-active. -->
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:BeeMemoryBank.Mobile.Pages"
       xmlns:controls="clr-namespace:BeeMemoryBank.Mobile.Controls"
       xmlns:loc="clr-namespace:BeeMemoryBank.Mobile.Localization"
       x:Class="BeeMemoryBank.Mobile.AppShell"
       Title="BeeMemoryBank"
       FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{AppThemeBinding Light={StaticResource BmbBackgroundLight}, Dark={StaticResource BmbBackground}}"
       Shell.ForegroundColor="{AppThemeBinding Light={StaticResource BmbTextLight}, Dark={StaticResource BmbText}}"
       Shell.TitleColor="{AppThemeBinding Light={StaticResource BmbTextLight}, Dark={StaticResource BmbText}}"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource BmbSurfaceLight}, Dark={StaticResource BmbSurface}}"
       Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource BmbAccentTextLight}, Dark={StaticResource BmbAccentText}}"
       Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource BmbAccentTextLight}, Dark={StaticResource BmbAccentText}}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource BmbTextSecondaryLight}, Dark={StaticResource BmbTextSecondary}}"
       Shell.NavBarHasShadow="False">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="{Binding HeaderPadding, Source={RelativeSource AncestorType={x:Type Shell}}}" HorizontalOptions="Fill">
            <Label Text="{Binding HeaderTitle, Source={RelativeSource AncestorType={x:Type Shell}}}"
                   Style="{StaticResource HeaderTitle}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
            <controls:SyncIndicatorView Grid.Column="1" VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <!-- The gates and the side rooms: outside the tab bar, no tab of their own -->
    <ShellContent Route="welcome" ContentTemplate="{DataTemplate pages:WelcomePage}"
                  FlyoutItemIsVisible="False" />
    <ShellContent Route="unlock" ContentTemplate="{DataTemplate pages:UnlockPage}"
                  FlyoutItemIsVisible="False" />
    <ShellContent Route="setup" ContentTemplate="{DataTemplate pages:SetupPage}"
                  FlyoutItemIsVisible="False" />
    <ShellContent Route="initialSync" ContentTemplate="{DataTemplate pages:InitialSyncPage}"
                  FlyoutItemIsVisible="False" />

    <TabBar>
        <Tab x:Name="TreeTab" Title="{loc:Translate TabTree}">
            <ShellContent Route="tree" ContentTemplate="{DataTemplate pages:TreePage}" />
        </Tab>
        <Tab x:Name="SearchTab" Title="{loc:Translate TabSearch}">
            <ShellContent Route="articles" ContentTemplate="{DataTemplate pages:ArticlesPage}" />
        </Tab>
        <Tab x:Name="SyncTab" Title="{loc:Translate TabSync}">
            <ShellContent Route="status" ContentTemplate="{DataTemplate pages:StatusPage}" />
        </Tab>
        <Tab x:Name="SettingsTab" Title="{loc:Translate TabSettings}">
            <ShellContent Route="security" ContentTemplate="{DataTemplate pages:SecurityPage}" />
        </Tab>
    </TabBar>

</Shell>
