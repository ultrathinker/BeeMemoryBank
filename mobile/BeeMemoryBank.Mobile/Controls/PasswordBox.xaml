<?xml version="1.0" encoding="UTF-8" ?>
<!-- The mock-up's .input-shell with the eye button (.icon-btn[data-toggle-pass]): one rounded
     field that shows or hides what was typed. The inner Entry is transparent: the shell draws
     the surface, and the platform mapper leaves a transparent field without a background. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeeMemoryBank.Mobile.Controls.PasswordBox">
    <Border Style="{StaticResource InputShell}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
            <Entry x:Name="InnerEntry"
                   Grid.Column="0"
                   BackgroundColor="Transparent"
                   IsPassword="True"
                   VerticalOptions="Center" />
            <Button x:Name="ToggleButton"
                    Grid.Column="1"
                    Style="{StaticResource IconButton}"
                    WidthRequest="40"
                    HeightRequest="40"
                    VerticalOptions="Center"
                    Clicked="OnToggleClicked" />
        </Grid>
    </Border>
</ContentView>
