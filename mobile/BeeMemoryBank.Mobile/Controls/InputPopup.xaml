<?xml version="1.0" encoding="UTF-8" ?>
<!-- The mock-up's dialog (dialog.bmb-dialog): a centered surface card with 24dp corners, a bold
     title, a secondary message, one field and the button row. It is hosted in a modal page
     (PopupExtensions) whose scrim dims the whole window, tab bar and status bar included, the
     same way the bottom sheets do. The card itself is transparent around the panel. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeeMemoryBank.Mobile.Controls.InputPopup"
             BackgroundColor="Transparent"
             InputTransparent="False">

    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource BmbSurfaceLight}, Dark={StaticResource BmbSurface}}"
           BorderColor="{AppThemeBinding Light={StaticResource BmbBorderStrongLight}, Dark={StaticResource BmbBorderStrong}}"
           CornerRadius="24"
           Padding="20"
           HasShadow="False"
           WidthRequest="320"
           VerticalOptions="Center"
           HorizontalOptions="Center">
        <Frame.GestureRecognizers>
            <!-- A tap inside the card is the card's own, not the dim's (which would cancel). -->
            <TapGestureRecognizer />
        </Frame.GestureRecognizers>
        <VerticalStackLayout Spacing="0">

            <Label x:Name="TitleLabel"
                   Style="{StaticResource DialogTitle}" />

            <Label x:Name="MessageLabel"
                   Style="{StaticResource DialogBody}" />

            <Entry x:Name="InputEntry"
                   AutomationId="PopupInputEntry"
                   Style="{StaticResource BaseEntry}"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False"
                   Margin="0,0,0,16" />

            <HorizontalStackLayout Spacing="12" HorizontalOptions="End">
                <Button x:Name="CancelButton"
                        AutomationId="PopupCancelButton"
                        Text="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnCancelClicked" />
                <Button x:Name="AcceptButton"
                        AutomationId="PopupAcceptButton"
                        Text="OK"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnAcceptClicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </Frame>
</ContentView>
