<?xml version="1.0" encoding="utf-8" ?>
<!-- The design's dialog (dialog.bmb-dialog): a surface card with 24dp corners, a bold title, a
     secondary message, one field and the button row. It is hosted in a modal page
     (PopupExtensions) whose scrim dims the whole window, tab bar included, the same way the
     bottom sheets do. On iOS the card sits at the TOP of the dim, not centered: the keyboard
     rises from the bottom and the card with its buttons must stay fully above it while typing. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeeMemoryBank.FullIos.Controls.InputPopup"
             BackgroundColor="Transparent"
             InputTransparent="False">

    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BmbSurfaceLight}, Dark={StaticResource BmbSurface}}"
            Stroke="{AppThemeBinding Light={StaticResource BmbBorderStrongLight}, Dark={StaticResource BmbBorderStrong}}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 24"
            Padding="20"
            MaximumWidthRequest="400"
            Margin="16,24,16,0"
            VerticalOptions="Start"
            HorizontalOptions="Center">
        <Border.GestureRecognizers>
            <!-- A tap inside the card is the card's own, not the dim's (which would cancel). -->
            <TapGestureRecognizer />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="0">

            <Label x:Name="TitleLabel"
                   Style="{StaticResource DialogTitle}" />

            <Label x:Name="MessageLabel"
                   Style="{StaticResource DialogBody}" />

            <Entry x:Name="InputEntry"
                   AutomationId="PopupInputEntry"
                   Style="{StaticResource BaseEntry}"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False"
                   Margin="0,0,0,16" />

            <HorizontalStackLayout Spacing="12" HorizontalOptions="End">
                <Button x:Name="CancelButton"
                        AutomationId="PopupCancelButton"
                        Text="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnCancelClicked" />
                <Button x:Name="AcceptButton"
                        AutomationId="PopupAcceptButton"
                        Text="OK"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnAcceptClicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </Border>
</ContentView>
