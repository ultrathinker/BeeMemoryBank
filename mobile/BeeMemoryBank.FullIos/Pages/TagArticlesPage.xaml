<?xml version="1.0" encoding="utf-8" ?>
<!-- The articles carrying one tag (the Android TagArticlesPage's behaviour): the design's rows,
     tap opens the note. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BeeMemoryBank.FullIos.Localization"
             x:Class="BeeMemoryBank.FullIos.Pages.TagArticlesPage"
             Title="Tag">
    <Grid RowDefinitions="Auto,*">
        <!-- The tag is the page's own heading (it can be long); the header stays empty so the
             caption wraps here instead of cutting in the bar at a large system font. -->
        <Label x:Name="HeadingLabel" FontSize="22" Style="{StaticResource TitleLabel}"
               LineBreakMode="WordWrap" Margin="16,8,16,0" AutomationId="TagArticlesTitle" />
        <CollectionView Grid.Row="1" x:Name="ArticlesList" SelectionMode="None" Margin="16,8,16,100">
        <CollectionView.EmptyView>
            <Label Text="{loc:Translate NothingFoundTitle}" Style="{StaticResource EmptyTitle}"
                   HorizontalOptions="Center" Margin="0,36" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BmbSurfaceLight}, Dark={StaticResource BmbSurface}}"
                        Stroke="{AppThemeBinding Light={StaticResource BmbBorderLight}, Dark={StaticResource BmbBorder}}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 16"
                        Padding="6" Margin="0,4">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,4" MinimumHeightRequest="48">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnArticleTapped" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12" VerticalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BmbSurfaceHighLight}, Dark={StaticResource BmbSurfaceHigh}}">
                            <Image Source="{AppThemeBinding Light=icon_row_file_light.png, Dark=icon_row_file_dark.png}"
                                   WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Title}" Style="{StaticResource ItemTitle}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Path, Converter={StaticResource DisplayPath}}" Style="{StaticResource ItemMeta}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
