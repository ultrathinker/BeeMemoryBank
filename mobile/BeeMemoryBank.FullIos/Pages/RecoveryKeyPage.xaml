<?xml version="1.0" encoding="utf-8" ?>
<!-- The recovery key, shown once, in the design's cards: the key itself, Copy, the clipboard
     warning, the saved-it check and Continue. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BeeMemoryBank.FullIos.Localization"
             x:Class="BeeMemoryBank.FullIos.Pages.RecoveryKeyPage"
             Title="Recovery key"
             NavigationPage.HasBackButton="False">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="{loc:Translate RecoveryShowTitle}" Style="{StaticResource TitleLabel}" />
            <Label Text="{loc:Translate RecoveryShowDesc}" Style="{StaticResource SubtitleLabel}" />
            <Border Style="{StaticResource CardBorder}">
                <!-- Breaks between the groups of four (the spaces), never inside a group. -->
                <Label x:Name="KeyLabel" FontFamily="Menlo" FontSize="18" LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center" AutomationId="RecoveryKey" />
            </Border>
            <Button x:Name="CopyButton" Text="{loc:Translate RecoveryCopy}" Style="{StaticResource SecondaryButton}" Clicked="OnCopy" />
            <Label Text="{loc:Translate RecoveryCopyWarn}" Style="{StaticResource ItemMeta}" />
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{loc:Translate RecoverySavedCheck}" VerticalOptions="Center" />
                    <Switch x:Name="ConfirmSwitch" Grid.Column="1" Toggled="OnConfirmToggled" AutomationId="ConfirmSwitch" VerticalOptions="Center" />
                </Grid>
            </Border>
            <Button x:Name="ContinueButton" Text="{loc:Translate RecoveryContinue}" Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" Clicked="OnContinue" AutomationId="ContinueButton" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
