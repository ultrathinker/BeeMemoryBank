<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeeMemoryBank.FullIos.Pages.UnlockPage"
             Title="Locked"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="*,Auto" Padding="24,64,24,24">
        <VerticalStackLayout Spacing="12">
            <Label Text="Bee Memory Bank" Style="{StaticResource Title}" />
            <Label x:Name="NodeLabel" Style="{StaticResource Muted}" />
            <Label Text="Locked" FontSize="20" Margin="0,24,0,0" />
            <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="Master password" ReturnType="Go" Completed="OnUnlock" AutomationId="PasswordEntry" />
            <Label x:Name="ErrorLabel" Style="{StaticResource Error}" IsVisible="False" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <Button x:Name="QuickButton" Style="{StaticResource Secondary}" IsVisible="False" Clicked="OnQuickUnlock" AutomationId="QuickUnlockButton" />
            <Button x:Name="UnlockButton" Text="Unlock" Clicked="OnUnlock" AutomationId="UnlockButton" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
