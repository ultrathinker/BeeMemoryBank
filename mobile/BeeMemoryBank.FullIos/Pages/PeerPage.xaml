<?xml version="1.0" encoding="utf-8" ?>
<!-- One peer in the design's cards: its state, the addresses this iPhone has for it (each with
     its own card and Remove), and Add an address at the bottom of the scroll. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BeeMemoryBank.FullIos.Controls"
             xmlns:loc="clr-namespace:BeeMemoryBank.FullIos.Localization"
             x:Class="BeeMemoryBank.FullIos.Pages.PeerPage"
             Title="Device">
    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,100" Spacing="12">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="NameLabel" Style="{StaticResource TitleLabel}" />
                    <Label x:Name="StatusLabel" Style="{StaticResource ItemMeta}" AutomationId="PeerStatus" />
                    <Label x:Name="LocalNetworkLabel" Style="{StaticResource FieldError}" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate PeerWaysTitle}" Style="{StaticResource CardTitle}" />
                    <VerticalStackLayout x:Name="ChannelsList" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="controls:PeerChannelDisplay">
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Address}" Style="{StaticResource ItemTitle}" LineBreakMode="CharacterWrap" />
                                        <Label Text="{Binding Line}" Style="{StaticResource ItemMeta}" />
                                        <Label Text="{loc:Translate PeerOnlyIphone}" Style="{StaticResource ItemMeta}"
                                               IsVisible="{Binding ThisIPhoneOnly}" />
                                        <Button Text="{loc:Translate Remove}" Style="{StaticResource DangerButton}" Clicked="OnRemove"
                                                CommandParameter="{Binding Address}" IsVisible="{Binding ThisIPhoneOnly}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label x:Name="NoChannelsLabel" Text="{loc:Translate PeerNoChannels}" Style="{StaticResource ItemMeta}" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:Translate PeerDesc}" Style="{StaticResource ItemMeta}" />
            <Button x:Name="AddButton" Text="{loc:Translate SyncAddAddress}" Style="{StaticResource PrimaryButton}"
                    Clicked="OnAddAddress" AutomationId="AddAddressButton" />
            <Button x:Name="RemoveDeviceButton" Text="{loc:Translate DeviceRemoveDevice}" Style="{StaticResource DangerButton}"
                    Clicked="OnRemoveDevice" AutomationId="RemoveDeviceButton" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
