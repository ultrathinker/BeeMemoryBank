<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:BeeMemoryBank.FullIos.Services"
             x:Class="BeeMemoryBank.FullIos.Pages.PeerPage"
             Title="Device">
    <Grid RowDefinitions="*,Auto" Padding="20,8,20,20">
        <ScrollView>
            <VerticalStackLayout Spacing="8">
                <Label x:Name="NameLabel" FontSize="20" FontAttributes="Bold" />
                <Label x:Name="StatusLabel" AutomationId="PeerStatus" />
                <Label x:Name="LocalNetworkLabel" Style="{StaticResource Error}" IsVisible="False" />
                <Label Text="Ways to reach it" Style="{StaticResource Section}" />
                <VerticalStackLayout x:Name="ChannelsList" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="services:PeerChannelItem">
                            <Border Style="{StaticResource Card}" Padding="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Address}" FontAttributes="Bold" LineBreakMode="CharacterWrap" />
                                    <Label Text="{Binding Line}" Style="{StaticResource Muted}" FontSize="12" />
                                    <Label Text="Typed on this iPhone only: no other device knows it." Style="{StaticResource Muted}" FontSize="12"
                                           IsVisible="{Binding ThisIPhoneOnly}" />
                                    <Button Text="Remove" Style="{StaticResource Danger}" Clicked="OnRemove" CommandParameter="{Binding Address}"
                                            IsVisible="{Binding ThisIPhoneOnly}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label x:Name="NoChannelsLabel" Style="{StaticResource Muted}" IsVisible="False"
                       Text="This iPhone has no address for this device yet." />
                <Label Style="{StaticResource Muted}" Margin="0,16,0,0"
                       Text="This iPhone tries these addresses in turn and keeps using the one that worked. It never accepts an address because it answers: the device there must be this one, with its key." />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1" x:Name="AddButton" Text="Add an address" Clicked="OnAddAddress" AutomationId="AddAddressButton" />
    </Grid>
</ContentPage>
