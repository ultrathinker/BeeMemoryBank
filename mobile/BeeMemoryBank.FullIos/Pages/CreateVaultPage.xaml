<?xml version="1.0" encoding="utf-8" ?>
<!-- A new memory bank, in the design's gate shape (the Android SetupPage's card): brand centred,
     one card with the name, the master password twice, the required hint and the password rules,
     Create inside the card. The fields, checks and flow are unchanged. Centres when it fits,
     scrolls when it does not. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BeeMemoryBank.FullIos.Controls"
             xmlns:loc="clr-namespace:BeeMemoryBank.FullIos.Localization"
             x:Class="BeeMemoryBank.FullIos.Pages.CreateVaultPage"
             Title="">
    <ScrollView x:Name="GateViewer">
        <Grid x:Name="GateRoot" Padding="24,32,24,24">
            <VerticalStackLayout Spacing="18" MaximumWidthRequest="400"
                                 HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{loc:Translate AppTitle}" Style="{StaticResource BrandTitle}" HorizontalOptions="Center" />
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{loc:Translate CreateTitle}" Style="{StaticResource CardTitle}" />
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate ConnectDeviceNameLabel}" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="NameEntry" Placeholder="{loc:Translate ConnectDeviceNamePlaceholder}"
                                   ReturnType="Next" AutomationId="NameEntry" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate MasterPasswordLabel}" Style="{StaticResource FieldLabel}" />
                            <controls:PasswordBox x:Name="PasswordEntry" Placeholder="{loc:Translate MasterPasswordPlaceholder}"
                                                  ReturnType="Next" AutomationId="PasswordEntry" />
                            <controls:PasswordBox x:Name="RepeatEntry" Placeholder="{loc:Translate CreateRepeatPlaceholder}"
                                                  ReturnType="Done" Completed="OnCreate" AutomationId="RepeatEntry" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate ConnectHintLabel}" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="HintEntry" Placeholder="{loc:Translate MasterHintPlaceholder}"
                                   ReturnType="Next" AutomationId="PasswordHintEntry" />
                            <Label Text="{loc:Translate ConnectHintMeta}" Style="{StaticResource ItemMeta}" />
                        </VerticalStackLayout>
                        <Label Text="{loc:Translate CreatePasswordMeta}" Style="{StaticResource ItemMeta}" />
                        <Label x:Name="ErrorLabel" Style="{StaticResource FieldError}" IsVisible="False" />
                        <Button x:Name="CreateButton" Text="{loc:Translate Create}" Style="{StaticResource PrimaryButton}"
                                Clicked="OnCreate" AutomationId="CreateVaultButton" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
