<?xml version="1.0" encoding="utf-8" ?>
<!-- A phone without a vault, in the design's gate shape (the Android WelcomePage's card): brand
     centred, one card with the welcome words and the two ways in - join the owner's bank, or make
     a new one here (iOS has both). Centres when it fits, scrolls when it does not. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BeeMemoryBank.FullIos.Localization"
             x:Class="BeeMemoryBank.FullIos.Pages.WelcomePage"
             Title="Welcome"
             NavigationPage.HasNavigationBar="False">
    <ScrollView x:Name="GateViewer">
        <Grid x:Name="GateRoot" Padding="24,32,24,24">
            <VerticalStackLayout Spacing="18" MaximumWidthRequest="400"
                                 HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{loc:Translate AppTitle}" Style="{StaticResource BrandTitle}" HorizontalOptions="Center" />
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{loc:Translate WelcomeTitle}" Style="{StaticResource CardTitle}" HorizontalTextAlignment="Center" />
                        <Label Text="{loc:Translate WelcomeDesc}" Style="{StaticResource DialogBody}" HorizontalTextAlignment="Center" />
                        <Label Text="{loc:Translate WelcomeIosDesc}" Style="{StaticResource ItemMeta}" HorizontalTextAlignment="Center" />
                        <Button x:Name="JoinButton" Text="{loc:Translate WelcomeConnect}" Style="{StaticResource PrimaryButton}"
                                Clicked="OnJoin" AutomationId="JoinButton" />
                        <Button x:Name="CreateButton" Text="{loc:Translate WelcomeCreate}" Style="{StaticResource SecondaryButton}"
                                Clicked="OnCreate" AutomationId="CreateButton" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
