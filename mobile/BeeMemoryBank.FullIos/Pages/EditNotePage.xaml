<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeeMemoryBank.FullIos.Pages.EditNotePage"
             Title="Edit">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSave" AutomationId="SaveToolbarButton" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,4,16,12" RowSpacing="8">
        <Entry x:Name="TitleEntry" Placeholder="Title" FontSize="20" FontAttributes="Bold" TextChanged="OnChanged" AutomationId="TitleEntry" />
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Label Text="Folder" Style="{StaticResource Muted}" VerticalOptions="Center" />
            <Entry Grid.Column="1" x:Name="PathEntry" Placeholder="/" FontSize="15" Keyboard="Url" TextChanged="OnChanged" />
        </Grid>
        <Editor Grid.Row="2" x:Name="BodyEditor" Placeholder="Write in Markdown…" TextChanged="OnChanged" AutomationId="BodyEditor" />
        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <Label x:Name="ErrorLabel" Style="{StaticResource Error}" IsVisible="False" />
            <Button x:Name="SaveButton" Text="Save" Clicked="OnSave" AutomationId="SaveButton" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
