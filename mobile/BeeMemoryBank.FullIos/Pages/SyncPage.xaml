<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:BeeMemoryBank.FullIos.Services"
             x:Class="BeeMemoryBank.FullIos.Pages.SyncPage"
             Title="Sync">
    <Grid RowDefinitions="*,Auto" Padding="20,8,20,20">
        <ScrollView>
            <VerticalStackLayout Spacing="8">
                <Label x:Name="NodeLabel" FontSize="20" FontAttributes="Bold" />
                <Label x:Name="NodeIdLabel" Style="{StaticResource Muted}" FontSize="12" />
                <Label x:Name="CountLabel" AutomationId="NoteCount" />
                <Label Text="Last round" Style="{StaticResource Section}" />
                <Label x:Name="RoundLabel" AutomationId="LastRound" />
                <Label x:Name="ProblemLabel" Style="{StaticResource Error}" IsVisible="False" />
                <Label x:Name="LocalNetworkLabel" Style="{StaticResource Error}" IsVisible="False" AutomationId="LocalNetworkOff" />
                <Label Text="Syncs with" Style="{StaticResource Section}" />
                <VerticalStackLayout x:Name="PeersList" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="services:PeerStatus">
                            <Border Style="{StaticResource Card}" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPeerTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding Address}" Style="{StaticResource Muted}" FontSize="12" />
                                    <Label Text="{Binding ReachabilityText}" FontSize="14" IsVisible="{Binding HasReachabilityText}" />
                                    <Label Text="{Binding Summary}" FontSize="14" />
                                    <Label Text="Ways to reach it ›" Style="{StaticResource Muted}" FontSize="12" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label x:Name="NoPeersLabel" Style="{StaticResource Muted}" IsVisible="False"
                       Text="No other device yet. Join this iPhone to a computer, or connect a computer to this memory bank." />
                <Label Style="{StaticResource Muted}" Margin="0,16,0,0"
                       Text="This iPhone calls your other devices while the app is open, after every change and once a minute, and once more when you leave the app. While the app is open it also looks for your computers on this Wi-Fi, so it can sync with them directly. It never waits for calls: iOS stops apps in the background." />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <ActivityIndicator x:Name="Busy" IsVisible="False" IsRunning="False" />
            <Button x:Name="SyncButton" Text="Sync now" Clicked="OnSyncNow" AutomationId="SyncNowButton" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
