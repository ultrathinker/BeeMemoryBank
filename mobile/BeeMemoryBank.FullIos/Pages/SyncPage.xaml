<?xml version="1.0" encoding="utf-8" ?>
<!-- Sync in the design's shape (the Android StatusPage's cards): the state card with the pill,
     the last sync and Sync now inside it, this device's card, the devices card with their state,
     and the banners for no network / a failed round / the local network iOS refused. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:BeeMemoryBank.FullIos.Services"
             xmlns:controls="clr-namespace:BeeMemoryBank.FullIos.Controls"
             xmlns:loc="clr-namespace:BeeMemoryBank.FullIos.Localization"
             x:Class="BeeMemoryBank.FullIos.Pages.SyncPage"
             Title="Sync">
    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,100" Spacing="12">

            <Border x:Name="OfflineBanner" Style="{StaticResource CardBorder}" IsVisible="False">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate SyncOfflineTitle}" Style="{StaticResource CardTitle}" />
                    <Label Text="{loc:Translate SyncOfflineDesc}" Style="{StaticResource ItemMeta}" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="ErrorBanner" Style="{StaticResource CardBorder}" IsVisible="False"
                    Stroke="{AppThemeBinding Light={StaticResource BmbErrorBorderLight}, Dark={StaticResource BmbErrorBorder}}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate SyncErrorTitle}" Style="{StaticResource CardTitle}"
                           TextColor="{AppThemeBinding Light={StaticResource BmbErrorLight}, Dark={StaticResource BmbError}}" />
                    <Label x:Name="ProblemText" Style="{StaticResource ItemMeta}" />
                </VerticalStackLayout>
            </Border>

            <!-- An administrator disconnected this phone (2.12): one calm sentence in the plain card colours, not an error. -->
            <Border x:Name="DisconnectedBanner" Style="{StaticResource CardBorder}" IsVisible="False" AutomationId="SyncDisconnected">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate SyncDisconnectedTitle}" Style="{StaticResource CardTitle}" />
                    <Label Text="{loc:Translate SyncProblemDisconnected}" Style="{StaticResource ItemMeta}" />
                </VerticalStackLayout>
            </Border>

            <!-- A computer that is simply away: yellow, never red. -->
            <Border x:Name="UnreachableBanner" Style="{StaticResource CardBorder}" IsVisible="False" AutomationId="SyncUnreachable"
                    Stroke="{AppThemeBinding Light={StaticResource BmbWarningBorderLight}, Dark={StaticResource BmbWarningBorder}}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate SyncUnreachableTitle}" Style="{StaticResource CardTitle}"
                           TextColor="{AppThemeBinding Light={StaticResource BmbWarningLight}, Dark={StaticResource BmbWarning}}" />
                    <Label x:Name="UnreachableText" Style="{StaticResource ItemMeta}" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="LanBanner" Style="{StaticResource CardBorder}" IsVisible="False" AutomationId="LocalNetworkOff"
                    Stroke="{AppThemeBinding Light={StaticResource BmbWarningBorderLight}, Dark={StaticResource BmbWarningBorder}}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate SyncLanOffTitle}" Style="{StaticResource CardTitle}"
                           TextColor="{AppThemeBinding Light={StaticResource BmbWarningLight}, Dark={StaticResource BmbWarning}}" />
                    <Label x:Name="LanText" Style="{StaticResource ItemMeta}" />
                </VerticalStackLayout>
            </Border>

            <!-- State -->
            <Border Style="{StaticResource CardBorder}" AutomationId="SyncStateCard">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{loc:Translate SyncStateCard}" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                        <Border Grid.Column="1" x:Name="StatePill" StrokeThickness="1" StrokeShape="RoundRectangle 11" Padding="10,4" VerticalOptions="Center">
                            <Label x:Name="StatePillLabel" FontSize="12" FontFamily="{StaticResource FontBodySemibold}" />
                        </Border>
                    </Grid>
                    <controls:InfoRow Label="{loc:Translate SyncLastSync}">
                        <Label x:Name="LastSyncValue" Style="{StaticResource ItemTitle}" />
                    </controls:InfoRow>
                    <Label x:Name="RoundDetail" Style="{StaticResource ItemMeta}" AutomationId="LastRound" IsVisible="False" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="{loc:Translate SyncInvisibleTitle}" Style="{StaticResource ItemTitle}" />
                            <Label Text="{loc:Translate SyncInvisibleDesc}" Style="{StaticResource ItemMeta}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="InvisibleSwitch" VerticalOptions="Center" Toggled="OnInvisibleToggled" AutomationId="InvisibleSwitch" />
                    </Grid>
                    <Button x:Name="SyncButton" Text="{loc:Translate SyncNow}" Style="{StaticResource PrimaryButton}"
                            Clicked="OnSyncNow" AutomationId="SyncNowButton" />
                </VerticalStackLayout>
            </Border>

            <!-- This device -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate SyncThisDevice}" Style="{StaticResource CardTitle}" />
                    <controls:InfoRow Label="{loc:Translate SettingsDeviceName}">
                        <Label x:Name="NodeLabel" Style="{StaticResource ItemTitle}" />
                    </controls:InfoRow>
                    <controls:InfoRow Label="{loc:Translate SyncDeviceIdLabel}">
                        <Label x:Name="NodeIdLabel" FontFamily="Menlo" FontSize="12" LineBreakMode="CharacterWrap"
                               TextColor="{AppThemeBinding Light={StaticResource BmbTextSecondaryLight}, Dark={StaticResource BmbTextSecondary}}" />
                    </controls:InfoRow>
                    <controls:InfoRow Label="{loc:Translate SyncNotesLabel}">
                        <Label x:Name="CountLabel" Style="{StaticResource ItemTitle}" AutomationId="NoteCount" />
                    </controls:InfoRow>
                </VerticalStackLayout>
            </Border>

            <!-- Devices -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SyncDevicesCard}" Style="{StaticResource CardTitle}" />
                    <Label x:Name="NoPeersLabel" Text="{loc:Translate SyncNoDevices}" Style="{StaticResource ItemMeta}" IsVisible="False" />
                    <VerticalStackLayout x:Name="PeersList" Spacing="8" AutomationId="PeersList" />
                </VerticalStackLayout>
            </Border>

            <!-- Recent events -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SyncEventsCard}" Style="{StaticResource CardTitle}" />
                    <Label x:Name="NoEventsLabel" Text="{loc:Translate SyncNoEvents}" Style="{StaticResource ItemMeta}" IsVisible="False" />
                    <VerticalStackLayout x:Name="EventsList" Spacing="6" AutomationId="ActivityList" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:Translate SyncIosNote}" Style="{StaticResource ItemMeta}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
