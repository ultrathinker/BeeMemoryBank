<?xml version="1.0" encoding="utf-8" ?>
<!-- Joining the owner's memory bank, in the design's gate shape (the Android SetupPage's card): brand centred, one card with as
     few words as possible: "Scan QR code" first, then the join code field at full width with Paste beside its label,
     the master password with one line under it, this phone's name, Join. Where the code comes from and the rest of the explanation
     sit under "More", folded. No password hint here: joining does not create a password, it reuses the computer's. The checks and
     the join itself are unchanged. Centres when it fits, scrolls when it does not. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BeeMemoryBank.FullIos.Controls"
             xmlns:loc="clr-namespace:BeeMemoryBank.FullIos.Localization"
             x:Class="BeeMemoryBank.FullIos.Pages.JoinPage"
             Title="">
    <ScrollView x:Name="GateViewer">
        <Grid x:Name="GateRoot" Padding="24,32,24,24">
            <VerticalStackLayout Spacing="18" MaximumWidthRequest="400"
                                 HorizontalOptions="Fill" VerticalOptions="Center">
                <Label Text="{loc:Translate AppTitle}" Style="{StaticResource BrandTitle}" HorizontalOptions="Center" />
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{loc:Translate ConnectTitle}" Style="{StaticResource CardTitle}" />
                        <Button x:Name="ScanButton" Text="{loc:Translate JoinScanQr}" Style="{StaticResource SecondaryButton}"
                                Clicked="OnScan" AutomationId="ScanQrButton" />
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{loc:Translate ConnectAddrLabel}" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="{loc:Translate JoinPaste}" Style="{StaticResource TextButton}"
                                        Clicked="OnPaste" AutomationId="PasteCodeButton" />
                            </Grid>
                            <Editor x:Name="CodeEditor" Placeholder="bmb-join:?a=..." AutoSize="TextChanges"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BmbSurfaceHighLight}, Dark={StaticResource BmbSurfaceHigh}}"
                                    MinimumHeightRequest="48" HorizontalOptions="Fill" AutomationId="CodeEditor" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate MasterPasswordLabel}" Style="{StaticResource FieldLabel}" />
                            <controls:PasswordBox x:Name="PasswordEntry" ReturnType="Next" AutomationId="PasswordEntry" />
                            <Label Text="{loc:Translate JoinPasswordMeta}" Style="{StaticResource ItemMeta}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate ConnectDeviceNameLabel}" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="NameEntry" Placeholder="{loc:Translate ConnectDeviceNamePlaceholder}"
                                   ReturnType="Done" Completed="OnJoin" AutomationId="NameEntry" />
                        </VerticalStackLayout>
                        <Label x:Name="ErrorLabel" Style="{StaticResource FieldError}" IsVisible="False" />
                        <Button x:Name="JoinButton" Text="{loc:Translate ConnectStart}" Style="{StaticResource PrimaryButton}"
                                Clicked="OnJoin" AutomationId="JoinVaultButton" />
                        <Button x:Name="MoreButton" Text="{loc:Translate JoinMore}" Style="{StaticResource TextButton}"
                                HorizontalOptions="Center" Clicked="OnMore" AutomationId="JoinMoreButton" />
                        <Label x:Name="MoreLabel" Text="{loc:Translate JoinCodeMeta}" Style="{StaticResource ItemMeta}"
                               IsVisible="False" AutomationId="JoinMoreText" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
