<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BeeMemoryBank.FullIos.Controls"
             x:Class="BeeMemoryBank.FullIos.App">
    <Application.Resources>
        <ResourceDictionary>
            <controls:ShortDateConverter x:Key="ShortDate" />
            <controls:DisplayPathConverter x:Key="DisplayPath" />
            <ResourceDictionary.MergedDictionaries>
                <!-- The design's tokens (dark + light) and control styles, linked from the Android
                     app so both phones read one source; then the iPhone-only parts. -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/IosStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
