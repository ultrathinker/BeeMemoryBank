<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <!-- Without this the MAUI build ignores Platforms/Android/AndroidManifest.xml: the first Release APK had no INTERNET,
         no foreground-service or notification permission, and android:allowBackup=true. BlindManifestTests reads the result. -->
    <SingleProject>true</SingleProject>
    <ApplicationId>com.beememorybank.blind</ApplicationId>
    <ApplicationTitle>Bee Memory Bank Blind</ApplicationTitle>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <RootNamespace>BeeMemoryBank.BlindMobile</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <_BmbCoreVersion>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+').Value)</_BmbCoreVersion>
    <_BmbCoreVersion Condition="'$(_BmbCoreVersion)' == ''">1.0.0</_BmbCoreVersion>
    <ApplicationDisplayVersion>$(_BmbCoreVersion)</ApplicationDisplayVersion>
    <_BmbMajor>$(_BmbCoreVersion.Split('.')[0])</_BmbMajor>
    <_BmbMinor>$(_BmbCoreVersion.Split('.')[1])</_BmbMinor>
    <_BmbPatch>$(_BmbCoreVersion.Split('.')[2])</_BmbPatch>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(_BmbMajor), 10000)), $([MSBuild]::Multiply($(_BmbMinor), 100)))), $(_BmbPatch)))</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#FFFFFF" ForegroundScale="0.62" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <AndroidResource Include="Platforms\Android\Resources\xml\network_security_config.xml" LogicalName="res\xml\network_security_config.xml" />
    <AndroidResource Include="Platforms\Android\Resources\xml\data_extraction_rules.xml" LogicalName="res\xml\data_extraction_rules.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one busy helper of the MAUI apps (BMB-311), shared as source with the other three. -->
    <Compile Include="..\BeeMemoryBank.Mobile\Services\BusyAction.cs" Link="Shared\BusyAction.cs" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="Linker.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Xamarin.AndroidX.Core" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" />
    <!-- The AndroidX bindings MAUI pulls at an older train than Work.Runtime needs: same versions as Directory.Packages.props, so NU1608 is gone. -->
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Android" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState.Android" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" />
    <PackageReference Include="QRCoder" />
    <!-- The native SQLite (SQLite3MC.PCLRaw.bundle, through BeeMemoryBank.Storage) ships libsqlite3mc.so for every Android ABI
         itself: no exclusion is needed (see the ordinary app's project for the story of the old engine's glibc library). -->
  </ItemGroup>

  <!-- In-app QR scanning of an invitation (slice 11): Google Play services' code scanner, shown by Play services, so the app needs and asks for no CAMERA permission. OFF unless the build
       says -p:BmbQrScanner=true. Why it is not on by default: the binding drags ML Kit's common library, Firebase's component registry and Google's DataTransport (the library ML Kit logs its
       usage through) into an app whose PRIVACY.md says "no telemetry, no analytics"; whether anything is sent has to be seen on a phone first, and PRIVACY.md would name Google Play services.
       Paste and the bmb-invite: link (the phone's Camera opens it) work without it. docs/blind-node/ACCOUNTS.md has the findings. -->
  <PropertyGroup>
    <BmbQrScanner Condition="'$(BmbQrScanner)' == ''">false</BmbQrScanner>
    <DefineConstants Condition="'$(BmbQrScanner)' == 'true'">$(DefineConstants);BMB_QR_SCANNER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(BmbQrScanner)' == 'true'">
    <PackageReference Include="Xamarin.GooglePlayServices.Code.Scanner" />
    <!-- Play services Base/Basement need AndroidX Fragment 1.9 (and Tracing 2.0 through it). Fragment 1.9 carries the Kotlin extensions itself, so the older fragment-ktx / tracing-ktx
         bindings MAUI brings define the same classes twice and the dexer stops (Type androidx.fragment.app.FragmentKt is defined multiple times). Their 1.9 / 2.0 releases are the
         empty successors: raised for this app only (the ordinary app has no Play services and keeps the central versions). -->
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" VersionOverride="1.9.0" />
    <PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" VersionOverride="2.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(BmbQrScanner)' != 'true'">
    <Compile Remove="Platforms\Android\AndroidQrScanner.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared libraries and the phone's client of a blind node. BeeMemoryBank.Vault is deliberately not referenced (the shared
         libraries cannot reference it), so the trimmed APK contains no master-key, session or content-crypto code. -->
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Core\BeeMemoryBank.Core.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Crypto\BeeMemoryBank.Crypto.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Search\BeeMemoryBank.Search.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Storage\BeeMemoryBank.Storage.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Sync\BeeMemoryBank.Sync.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Blind.PhoneClient\BeeMemoryBank.Blind.PhoneClient.csproj" />
    <ProjectReference Include="..\..\libs\BeeMemoryBank.Blind.AppCore\BeeMemoryBank.Blind.AppCore.csproj" />
  </ItemGroup>

</Project>
