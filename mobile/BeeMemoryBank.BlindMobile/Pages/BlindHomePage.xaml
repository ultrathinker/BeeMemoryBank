<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeeMemoryBank.BlindMobile.Pages.BlindHomePage"
             Title="Blind copy"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="520">

            <!-- What went wrong, when the screen could not be filled; the way out is always Remove this account at the bottom -->
            <Label x:Name="StatusErrorLabel" IsVisible="False" TextColor="{StaticResource ErrorColor}" FontAttributes="Bold" LineBreakMode="WordWrap" />
            <Label x:Name="StartErrorLabel" IsVisible="False" TextColor="{StaticResource ErrorColor}" FontAttributes="Bold" LineBreakMode="WordWrap" />
            <Label x:Name="KeyStoreLabel" IsVisible="False" TextColor="{StaticResource ErrorColor}" LineBreakMode="WordWrap" />
            <Label x:Name="NoticeLabel" IsVisible="False" FontSize="12" LineBreakMode="WordWrap" />

            <!-- The account in one line: what it is doing, or why it is not, and what it used (the sentences are the shared card's) -->
            <Frame BorderColor="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="8" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="CardStateLabel" LineBreakMode="WordWrap" />
                    <Label x:Name="CardUsageLabel" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="WordWrap" />
                    <Button x:Name="ReconnectButton" Text="Try again" IsVisible="False" Clicked="OnReconnectClicked" />
                    <Button x:Name="RepairUsageButton" Text="Start new counts" IsVisible="False" Clicked="OnRepairUsageClicked" />
                </VerticalStackLayout>
            </Frame>

            <!-- State -->
            <Frame x:Name="StateFrame" BorderColor="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="8" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="State" FontAttributes="Bold" />
                    <Label x:Name="NameLabel" />
                    <Label x:Name="NodeLabel" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" />
                    <Label x:Name="PairLabel" LineBreakMode="WordWrap" />
                    <Label x:Name="LoadLabel" LineBreakMode="WordWrap" />
                    <Label x:Name="StoreLabel" LineBreakMode="WordWrap" />
                    <Label x:Name="SyncLabel" />
                    <Button x:Name="SyncNowButton" Text="Sync now" Style="{StaticResource PrimaryButton}" Clicked="OnSyncNowClicked" />
                    <Label x:Name="BackupLabel" />
                    <ProgressBar x:Name="JobProgress" IsVisible="False" ProgressColor="{StaticResource PrimaryColor}" />
                    <Label x:Name="JobLabel" IsVisible="False" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <!-- Limits: what this copy may use up on this phone -->
            <Frame BorderColor="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="8" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Limits" FontAttributes="Bold" />
                    <Label Text="An empty box is no limit; 0 pauses the account."
                           FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="WordWrap" />
                    <Label Text="Storage" FontSize="12" />
                    <Entry x:Name="StoredEntry" Placeholder="for example 2 GB" IsSpellCheckEnabled="False" Style="{StaticResource BaseEntry}" />
                    <Label Text="Traffic a day" FontSize="12" />
                    <Entry x:Name="TrafficEntry" Placeholder="for example 200 MB" IsSpellCheckEnabled="False" Style="{StaticResource BaseEntry}" />
                    <Label Text="Requests a day" FontSize="12" />
                    <Entry x:Name="RequestsEntry" Placeholder="for example 5000" Keyboard="Numeric" IsSpellCheckEnabled="False" Style="{StaticResource BaseEntry}" />
                    <HorizontalStackLayout Spacing="8">
                        <Switch x:Name="UnmeteredSwitch" VerticalOptions="Center" />
                        <Label Text="Only on Wi-Fi or other unmetered networks" VerticalOptions="Center" LineBreakMode="WordWrap" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Switch x:Name="BatterySwitch" VerticalOptions="Center" />
                        <Label Text="Pause on battery saver" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label x:Name="LimitsProblemLabel" IsVisible="False" TextColor="{StaticResource ErrorColor}" LineBreakMode="WordWrap" />
                    <Button x:Name="SaveLimitsButton" Text="Save limits" Clicked="OnSaveLimitsClicked" />
                    <Button x:Name="PauseButton" Text="Pause this account" Clicked="OnPauseClicked" />
                </VerticalStackLayout>
            </Frame>

            <!-- Codes: the old way of pairing, for an account that was added with a pairing code. An account from an invitation has none. -->
            <Frame x:Name="CodesFrame" BorderColor="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="8" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="1. Add this phone on the computer" FontAttributes="Bold" />
                    <Label Text="On the Windows computer, open Blind nodes, choose Add Android blind copy, and scan or paste this code. It carries this phone's key and a one-time secret; show it only to your own computer."
                           FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="WordWrap" />
                    <Image x:Name="PhoneCodeImage" HeightRequest="240" WidthRequest="240" HorizontalOptions="Center" />
                    <Label x:Name="PhoneCodeLabel" FontSize="11" LineBreakMode="CharacterWrap" />
                    <Button x:Name="CopyCodeButton" Text="Copy this phone's code" Clicked="OnCopyPhoneCodeClicked" />
                    <Button x:Name="RePairButton" Text="Re-pair…" IsVisible="False" Clicked="OnRePairClicked" />

                    <Label Text="2. Paste the code the computer shows back" FontAttributes="Bold" Margin="0,12,0,0" />
                    <Entry x:Name="CallCodeEntry" AutomationId="BlindCallCodeEntry" Placeholder="bmb-blind-call:?…"
                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" Style="{StaticResource BaseEntry}" />
                    <Button x:Name="ConnectButton" Text="Connect" Style="{StaticResource PrimaryButton}" Clicked="OnConnectClicked" />
                    <Label x:Name="CallErrorLabel" TextColor="{StaticResource ErrorColor}" IsVisible="False" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

            <!-- Backups -->
            <Frame x:Name="BackupsFrame" BorderColor="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="8" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Backups" FontAttributes="Bold" />
                    <Label Text="Encrypted with this phone's backup key; the computer can open them with the master password."
                           FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="WordWrap" />
                    <Label x:Name="KeyLostLabel" IsVisible="False" TextColor="{StaticResource ErrorColor}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                    <Button x:Name="BackupNowButton" Text="Back up now" Style="{StaticResource PrimaryButton}" Clicked="OnBackupNowClicked" />
                    <Button x:Name="SaveToButton" Text="Save the latest backup to…" Clicked="OnSaveToClicked" />
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Schedule" VerticalOptions="Center" />
                        <Picker x:Name="SchedulePicker" WidthRequest="160" SelectedIndexChanged="OnScheduleChanged" />
                    </HorizontalStackLayout>
                    <Label x:Name="BackupsLabel" FontSize="12" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

            <!-- Log -->
            <Frame BorderColor="{StaticResource BorderColor}" BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="8" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Log" FontAttributes="Bold" />
                    <Label x:Name="LogLabel" FontSize="11" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

            <!-- This account: its name, and taking it off this phone -->
            <Frame BorderColor="{StaticResource ErrorColor}" BackgroundColor="{StaticResource SurfaceColor}" CornerRadius="8" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="This account" FontAttributes="Bold" />
                    <Button x:Name="RenameButton" Text="Rename…" Clicked="OnRenameClicked" />
                    <Label Text="Remove deletes this copy, its backups on the phone and its keys. The computer is told if the phone is online; revoke the phone on the computer too. Backups you saved elsewhere stay where you saved them."
                           FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="WordWrap" />
                    <Button x:Name="RemoveButton" Text="Remove this account…" BackgroundColor="Transparent" TextColor="{StaticResource ErrorColor}" Clicked="OnRemoveClicked" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
