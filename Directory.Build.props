<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <RootNamespace>$(MSBuildProjectName.Replace("-","_"))</RootNamespace>

    <!-- Single source of truth for the version: the repo-root VERSION file.
         Compiled into every assembly so the running app reports exactly what was built
         (read at runtime via AssemblyInformationalVersion). The Condition guards against
         a missing file so the build never breaks; the Dockerfile must `COPY VERSION .`
         into the build context or the Docker build (every deploy) would skip it silently. -->
    <Version Condition="Exists('$(MSBuildThisFileDirectory)VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <InformationalVersion Condition="Exists('$(MSBuildThisFileDirectory)VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</InformationalVersion>

    <!-- One product name on every binary. SignPath (free code signing for open source) requires
         the product name attribute of each signed file to be the project's name; without this
         each exe reports its own assembly name (BeeMemoryBank.Api, BeeMemoryBank.Web, ...). -->
    <Product>Bee Memory Bank</Product>
  </PropertyGroup>

  <!-- Windows packaging (scripts/publish-node.ps1, pack-windows.ps1) publishes every exe
       framework-dependent and ships ONE .NET runtime in the app's dotnet\ folder. The apphost is
       told where to find it: components in a subfolder (bmbd\, api\, web\, cli\) use ..\dotnet, the
       Desktop shell at the root uses dotnet. Set here, not on the command line, because the dotnet
       CLI mangles a -p: value that starts with "..". -->
  <PropertyGroup Condition="'$(BmbSharedRuntime)' == 'subfolder'">
    <AppHostRelativeDotNet>..\dotnet</AppHostRelativeDotNet>
    <AppHostDotNetSearch>AppRelative</AppHostDotNetSearch>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BmbSharedRuntime)' == 'root'">
    <AppHostRelativeDotNet>dotnet</AppHostRelativeDotNet>
    <AppHostDotNetSearch>AppRelative</AppHostDotNetSearch>
  </PropertyGroup>
</Project>
